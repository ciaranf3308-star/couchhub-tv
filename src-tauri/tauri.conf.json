{
  "productName": "CouchHub TV",
  "mainBinaryName": "couchhub-tv",
  "version": "0.11.2",
  "identifier": "com.couchhub.tv",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321",
    "beforeDevCommand": "node ./src/scripts/ensure-ffmpeg-sidecar.mjs && pnpm run dev",
    "beforeBuildCommand": "node ./src/scripts/ensure-ffmpeg-sidecar.mjs && pnpm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "NylahBox Studios",
        "width": 1300,
        "height": 850,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "center": true,
        "focus": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#170a0c"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOWNLOAD/**",
          "$VIDEO/**",
          "$HOME/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CouchHub",
    "category": "public.app-category.video",
    "copyright": "© 2026 NylahBox Studios — fork of Extreme InfiniTV (© 2025 Ludovico Ferrara), GPL-3.0-or-later",
    "createUpdaterArtifacts": true,
    "android": {
      "versionCode": 2019000
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://ciaranf3308-star.github.io/couchhub-updates/couchhub-tv/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBRENGREFENjQ3NTIyMjcKUldRbkluVmtyZjNjcWprMENnNUN1NlNrckI1c2NFWjNRUUhrZlRvc3BaeXlQbG1oRUpXM0NId1UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
