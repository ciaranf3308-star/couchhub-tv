---
 // Couch Movie detail — full-width backdrop layout (NOT a pop-up).
// Painted client-side by src/scripts/movies/couch-detail.ts from
// `get_vod_info` + the cached catalogue row: backdrop, title, plot,
// year/runtime/genres/rating, Play/Resume, Favourite, Watch Later,
// Trailer, cast, and More Like This. Playback mounts the shared
// engine (mountPlayer) with the TvOsd Couch controls; B / Escape
// while playing returns to this detail page, never to Home.
import CouchLayout from "@/layouts/CouchLayout.astro";
import TvDialog from "@/components/couch/TvDialog.astro";
import TvOsd from "@/components/couch/TvOsd.astro";
---

<CouchLayout pageTitle="Movie" activeNav="browse" view="movies-detail">
  <a class="rs-hero__action rs-hero__action--secondary" href="/browse?type=movies">
    ‹ Movies
  </a>

  <section id="movie-detail-hero" class="rs-hero" hidden aria-label="Movie">
    <div id="movie-detail-backdrop" class="rs-hero__backdrop" aria-hidden="true"></div>
    <div class="rs-hero__scrim" aria-hidden="true"></div>
    <div class="rs-hero__content">
      <h1 id="movie-detail-title" class="rs-hero-title"></h1>
      <p id="movie-detail-meta" class="rs-hero__meta"></p>
      <p id="movie-detail-plot" class="rs-hero__description"></p>
      <div class="rs-hero__actions">
        <button id="movie-detail-play" type="button" class="rs-hero__action">
          ▶ <span id="movie-detail-play-label">Play</span>
          <span id="movie-detail-play-sub" class="rs-hero__meta"></span>
        </button>
        <button
          id="movie-detail-fav"
          type="button"
          class="rs-hero__action rs-hero__action--secondary"
          aria-pressed="false"
        >
          ☆ Favourite
        </button>
        <button
          id="movie-detail-watch"
          type="button"
          class="rs-hero__action rs-hero__action--secondary"
          aria-pressed="false"
        >
          + Watch Later
        </button>
        <button
          id="movie-detail-trailer"
          type="button"
          class="rs-hero__action rs-hero__action--secondary"
          hidden
        >
          ▶ Trailer
        </button>
      </div>
    </div>
  </section>

  <p id="movie-detail-status" class="rs-meta" role="status"></p>

  <div id="movie-detail-poster-wrap" class="rs-detail-media" hidden>
    <div id="movie-detail-poster" class="rs-detail-poster" aria-hidden="true"></div>
  </div>

  <div
    id="movie-detail-player-wrap"
    class="rs-detail-player"
    hidden
  >
    <video id="movie-player" playsinline></video>
    <TvOsd autoHideMs={4500}>
      <h3 slot="info" class="rs-osd__title" id="movie-osd-title"></h3>
      <p slot="info" class="rs-osd__subtitle" id="movie-osd-subtitle"></p>
      <div class="rs-osd__timeline">
        <input
          id="movie-osd-timeline"
          type="range"
          min="0"
          max="1"
          value="0"
          step="1"
          aria-label="Seek"
        />
        <span id="movie-osd-time" class="rs-meta">0:00</span>
      </div>
      <button slot="controls" id="movie-osd-back10" type="button" class="rs-osd__btn">−10s</button>
      <button slot="controls" id="movie-osd-play-pause" type="button" class="rs-osd__btn">▶ Play</button>
      <button slot="controls" id="movie-osd-fwd10" type="button" class="rs-osd__btn">+10s</button>
      <button slot="controls" id="movie-osd-subtitles" type="button" class="rs-osd__btn" hidden>Subtitles</button>
      <span slot="controls" id="movie-osd-subtitles-list" class="rs-osd__tracklist"></span>
      <button slot="controls" id="movie-osd-audio" type="button" class="rs-osd__btn" hidden>Audio</button>
      <span slot="controls" id="movie-osd-audio-list" class="rs-osd__tracklist"></span>
      <button slot="controls" id="movie-osd-fullscreen" type="button" class="rs-osd__btn">⛶ Fullscreen</button>
      <button slot="controls" id="movie-osd-back" type="button" class="rs-osd__btn">‹ Back</button>
    </TvOsd>
  </div>

  <section id="movie-detail-cast" class="rs-detail-section" hidden>
    <h2 class="rs-section-title">Cast</h2>
    <div id="movie-detail-cast-list" class="rs-detail-chips"></div>
  </section>

  <section id="movie-detail-similar" class="rs-rail" hidden aria-label="More like this">
    <div class="rs-rail__head">
      <h2 class="rs-section-title">More Like This</h2>
    </div>
    <div id="movie-detail-similar-list" class="rs-rail__row"></div>
  </section>

  <TvDialog id="movie-trailer-dialog" title="Trailer">
    <iframe
      id="movie-detail-trailer-frame"
      title="Trailer"
      allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
      allowfullscreen></iframe>
  </TvDialog>

  <script>
    import "@/scripts/movies/couch-detail.ts";
  </script>

  <style>
    .rs-detail-media {
      display: flex;
      justify-content: center;
    }
    .rs-detail-poster {
      width: min(22rem, 80vw);
      aspect-ratio: 2 / 3;
      border-radius: 1rem;
      overflow: hidden;
      background: var(--rs-surface);
      display: grid;
      place-items: center;
      color: var(--rs-text-2);
      font-family: var(--rs-font-display);
      font-size: 1.5rem;
      text-align: center;
      padding: 1rem;
    }
    .rs-detail-poster img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .rs-detail-player {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 1.25rem;
      overflow: hidden;
      background: #000;
    }
    .rs-detail-player video {
      width: 100%;
      height: 100%;
    }
    .rs-osd__timeline {
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
    }
    .rs-osd__timeline input[type="range"] {
      flex: 1;
      accent-color: var(--rs-accent);
      min-height: 2rem;
    }
    .rs-osd__tracklist {
      display: inline-flex;
      gap: 0.5rem;
    }
    .rs-detail-section {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .rs-detail-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .rs-detail-chips .rs-meta {
      background: var(--rs-surface);
      border: 1px solid var(--rs-line);
      border-radius: 999px;
      padding: 0.5rem 1rem;
    }
    #movie-detail-trailer-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
    }
  </style>
</CouchLayout>
