---
// Couch Movie detail — cinematic detail splash (Browse 0.8.0, W5).
// Full-width backdrop hero with the poster seated inside it, gradient
// metadata (eyebrow, title, meta chips, plot), prominent Play/Resume
// with a progress bar, and Favourite / Watch Later / Trailer actions.
// Painted client-side by src/scripts/movies/couch-detail.ts from
// `get_vod_info` + the cached catalogue row. Artwork paints through
// the shared TvImage fallback system (couch-image.ts) — a title with
// no art still gets the intentional initials fallback, never a broken
// image. Playback mounts the shared engine (mountPlayer) with the
// TvOsd Couch controls; B / Escape while playing returns to this
// detail page, never to Home. The back link returns to Browse and
// history.back()s when you arrived from there, so focus restores to
// the exact Browse card (couch-focus memory).
import CouchLayout from "@/layouts/CouchLayout.astro";
import TvDialog from "@/components/couch/TvDialog.astro";
import TvOsd from "@/components/couch/TvOsd.astro";
import TvSkeleton from "@/components/couch/TvSkeleton.astro";
---

<CouchLayout pageTitle="Movie" activeNav="browse" view="movies-detail">
  <a
    id="movie-detail-back"
    class="rs-detail-back rs-hero__action rs-hero__action--secondary"
    href="/browse?type=movies"
    data-nylah-item
    aria-label="Back to Browse"
  >
    ‹ Movies
  </a>

  <div id="movie-detail-skeleton" aria-hidden="true">
    <TvSkeleton kind="hero" />
  </div>

  <section id="movie-detail-hero" class="rs-hero rs-detail-hero" hidden aria-label="Movie">
    <div id="movie-detail-backdrop" class="rs-hero__backdrop" aria-hidden="true"></div>
    <div class="rs-hero__scrim" aria-hidden="true"></div>
    <div class="rs-hero__content rs-detail-hero__content">
      <div id="movie-detail-poster" class="rs-detail-poster" aria-hidden="true"></div>
      <div class="rs-detail-hero__text">
        <span class="rs-hero__eyebrow">Movie</span>
        <h1 id="movie-detail-title" class="rs-hero-title"></h1>
        <div id="movie-detail-meta" class="rs-detail-chips" aria-label="Details"></div>
        <p id="movie-detail-plot" class="rs-hero__description"></p>
        <div id="movie-detail-progress" class="rs-detail-progress" hidden>
          <div class="rs-detail-progress__track" aria-hidden="true">
            <span data-role="detail-progress-fill"></span>
          </div>
          <span data-role="detail-progress-label" class="rs-meta"></span>
        </div>
        <div class="rs-hero__actions" data-nylah-rail="detail-actions">
          <button id="movie-detail-play" type="button" class="rs-hero__action" data-nylah-item>
            ▶ <span id="movie-detail-play-label">Play</span>
            <span id="movie-detail-play-sub" class="rs-hero__meta"></span>
          </button>
          <button
            id="movie-detail-fav"
            type="button"
            class="rs-hero__action rs-hero__action--secondary"
            data-nylah-item
            aria-pressed="false"
          >
            ☆ Favourite
          </button>
          <button
            id="movie-detail-watch"
            type="button"
            class="rs-hero__action rs-hero__action--secondary"
            data-nylah-item
            aria-pressed="false"
          >
            + Watch Later
          </button>
          <button
            id="movie-detail-trailer"
            type="button"
            class="rs-hero__action rs-hero__action--secondary"
            data-nylah-item
            hidden
          >
            ▶ Trailer
          </button>
        </div>
        <p class="rs-detail-hints" aria-hidden="true">
          <span class="rs-detail-hint-key">A</span> Select
          <span class="rs-detail-hint-key">B</span> Back to Browse
        </p>
      </div>
    </div>
  </section>

  <p id="movie-detail-status" class="rs-meta" role="status"></p>

  <div
    id="movie-detail-player-wrap"
    class="rs-detail-player"
    hidden
  >
    <video id="movie-player" playsinline></video>
    <TvOsd autoHideMs={4500}>
      <h3 slot="info" class="rs-osd__title" id="movie-osd-title"></h3>
      <p slot="info" class="rs-osd__subtitle" id="movie-osd-subtitle"></p>
      <div class="rs-osd__timeline">
        <input
          id="movie-osd-timeline"
          type="range"
          min="0"
          max="1"
          value="0"
          step="1"
          aria-label="Seek"
        />
        <span id="movie-osd-time" class="rs-meta">0:00</span>
      </div>
      <button slot="controls" id="movie-osd-back10" type="button" class="rs-osd__btn">−10s</button>
      <button slot="controls" id="movie-osd-play-pause" type="button" class="rs-osd__btn">▶ Play</button>
      <button slot="controls" id="movie-osd-fwd10" type="button" class="rs-osd__btn">+10s</button>
      <button slot="controls" id="movie-osd-subtitles" type="button" class="rs-osd__btn" hidden>Subtitles</button>
      <span slot="controls" id="movie-osd-subtitles-list" class="rs-osd__tracklist"></span>
      <button slot="controls" id="movie-osd-audio" type="button" class="rs-osd__btn" hidden>Audio</button>
      <span slot="controls" id="movie-osd-audio-list" class="rs-osd__tracklist"></span>
      <button slot="controls" id="movie-osd-fullscreen" type="button" class="rs-osd__btn">⛶ Fullscreen</button>
      <button slot="controls" id="movie-osd-back" type="button" class="rs-osd__btn">‹ Back</button>
    </TvOsd>
  </div>

  <section id="movie-detail-cast" class="rs-detail-section" hidden>
    <h2 class="rs-section-title">Cast</h2>
    <div id="movie-detail-cast-list" class="rs-detail-chips"></div>
  </section>

  <section id="movie-detail-similar" class="rs-rail" hidden aria-label="More like this">
    <div class="rs-rail__head">
      <h2 class="rs-section-title">More Like This</h2>
    </div>
    <div id="movie-detail-similar-list" class="rs-rail__row" data-nylah-rail="detail-similar"></div>
  </section>

  <TvDialog id="movie-trailer-dialog" title="Trailer">
    <iframe
      id="movie-detail-trailer-frame"
      title="Trailer"
      allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
      allowfullscreen></iframe>
  </TvDialog>

  <script>
    import "@/scripts/movies/couch-detail.ts";
  </script>

  <style>
    /* Detail splash — scoped to this page; the shared tokens,
       .rs-hero / .rs-image / focus ring all stay in couch.css. */
    .rs-detail-back {
      align-self: flex-start;
    }
    .rs-hero.rs-detail-hero {
      min-height: clamp(30rem, 62vh, 46rem);
    }
    .rs-detail-hero .rs-hero__scrim {
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--rs-bg) 92%, transparent) 0%, color-mix(in srgb, var(--rs-bg) 62%, transparent) 52%, color-mix(in srgb, var(--rs-bg) 18%, transparent) 100%),
        linear-gradient(0deg, var(--rs-bg) 0%, color-mix(in srgb, var(--rs-bg) 55%, transparent) 45%, transparent 75%),
        linear-gradient(180deg, color-mix(in srgb, var(--rs-bg) 45%, transparent) 0%, transparent 22%);
    }
    /* Actions wrap as whole buttons, never mid-label. */
    .rs-detail-hero .rs-hero__actions {
      flex-wrap: wrap;
    }
    .rs-detail-hero .rs-hero__action {
      white-space: nowrap;
    }
    .rs-detail-hero .rs-detail-hero__content {
      flex-direction: row;
      align-items: flex-end;
      gap: 2.5rem;
      max-width: none;
      width: 100%;
      padding: 3rem;
    }
    .rs-detail-poster {
      width: clamp(11rem, 15vw, 17rem);
      flex-shrink: 0;
      border-radius: var(--rs-radius);
      box-shadow: var(--rs-shadow-lift);
    }
    .rs-detail-hero__text {
      display: flex;
      flex-direction: column;
      gap: 0.875rem;
      min-width: 0;
      max-width: 52rem;
    }
    .rs-detail-hero__text .rs-hero__description {
      -webkit-line-clamp: 5;
    }
    .rs-detail-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    /* Chips are painted client-side — :global() so the scoped rule
       reaches the JS-created spans. */
    .rs-detail-chips :global(.rs-detail-chip) {
      display: inline-flex;
      align-items: center;
      padding: 0.375rem 0.875rem;
      border-radius: 999px;
      border: 1px solid var(--rs-line);
      background: color-mix(in srgb, var(--rs-bg) 55%, transparent);
      color: var(--rs-text);
      font-size: var(--rs-meta-size);
      line-height: 1.3;
      white-space: nowrap;
    }
    .rs-detail-chips :global(.rs-detail-chip--rating) {
      border-color: color-mix(in srgb, var(--rs-accent) 65%, transparent);
      background: color-mix(in srgb, var(--rs-accent) 32%, transparent);
      font-weight: 700;
    }
    .rs-detail-chips :global(.rs-detail-chip--progress) {
      border-color: color-mix(in srgb, var(--rs-focus) 55%, transparent);
      color: var(--rs-focus);
      font-weight: 700;
    }
    .rs-detail-progress {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      max-width: 30rem;
    }
    .rs-detail-progress__track {
      flex: 1;
      height: 0.5rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--rs-text) 22%, transparent);
      overflow: hidden;
    }
    .rs-detail-progress__track :global([data-role="detail-progress-fill"]) {
      display: block;
      height: 100%;
      width: 0;
      border-radius: 999px;
      background: var(--rs-accent);
    }
    .rs-detail-hints {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin: 0.25rem 0 0;
      font-size: 1rem;
      color: var(--rs-text-2);
    }
    .rs-detail-hint-key {
      display: inline-grid;
      place-items: center;
      min-width: 1.75rem;
      height: 1.75rem;
      padding: 0 0.375rem;
      border-radius: 999px;
      border: 1px solid var(--rs-line);
      background: var(--rs-surface);
      color: var(--rs-text);
      font-size: 0.875rem;
      font-weight: 800;
    }
    .rs-detail-player {
      position: relative;
      aspect-ratio: 16 / 9;
      border-radius: 1.25rem;
      overflow: hidden;
      background: #000;
    }
    .rs-detail-player video {
      width: 100%;
      height: 100%;
    }
    .rs-osd__timeline {
      display: flex;
      align-items: center;
      gap: 1rem;
      width: 100%;
    }
    .rs-osd__timeline input[type="range"] {
      flex: 1;
      accent-color: var(--rs-accent);
      min-height: 2rem;
    }
    .rs-osd__tracklist {
      display: inline-flex;
      gap: 0.5rem;
    }
    .rs-detail-section {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .rs-detail-section .rs-detail-chips :global(.rs-meta) {
      background: var(--rs-surface);
      border: 1px solid var(--rs-line);
      border-radius: 999px;
      padding: 0.5rem 1rem;
    }
    #movie-detail-trailer-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
    }
    @media (max-width: 70rem) {
      .rs-detail-hero .rs-detail-hero__content {
        flex-direction: column;
        align-items: flex-start;
        padding: 2rem;
      }
      .rs-detail-poster {
        width: clamp(9rem, 26vw, 12rem);
      }
    }
  </style>
</CouchLayout>
