---
// Watch Later — RedSilk Couch (W5). Library behaviour unchanged
// (preferences watchlist store as-is); CouchLayout + couch cards.
import CouchLayout from "@/layouts/CouchLayout.astro";
import AllWatchlistView from "@/components/AllWatchlistView.svelte";
---

<CouchLayout pageTitle="Watch Later" activeNav="watchlist" view="watchlist">
  <header class="couch-library-head">
    <h1 class="rs-page-title">Watch later</h1>
    <p class="rs-meta">
      Movies and series saved for later, across all your playlists. Newest first.
    </p>
  </header>

  <AllWatchlistView client:load />

  <script>
    import "@/scripts/updater-startup.js";
  </script>

  <style>
    .couch-library-head {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
  </style>
</CouchLayout>
