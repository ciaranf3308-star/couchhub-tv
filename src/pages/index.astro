---
// Nylah Studios home (v0.2.0 redesign): a vertical stack of rails.
// Up/down moves between rails, left/right within a rail — see
// src/scripts/lib/gamepad.ts for the navigation model.
//
// Rail order is fixed: Continue Watching, Trending this week, AI
// suggestions for Ciaran, AI suggestions for Aisling, IMDb top-rated.
// The last four rails are built by worker 2; this page imports them
// from ../components/rails/ — they must exist before this page builds.
import Layout from "@/layouts/Layout.astro";
import WelcomeCard from "@/components/WelcomeCard.astro";
import ContinueWatchingRail from "../components/rails/ContinueWatchingRail.astro";
import TrendingRail from "../components/rails/TrendingRail.astro";
import SuggestionsCiaranRail from "../components/rails/SuggestionsCiaranRail.astro";
import SuggestionsAislingRail from "../components/rails/SuggestionsAislingRail.astro";
import TopRatedRail from "../components/rails/TopRatedRail.astro";
---

<Layout>
	<script is:inline>
		try {
			var raw = localStorage.getItem("xt_playlists") || "";
			var hasEntries = false;
			if (raw) {
				var parsed = JSON.parse(raw);
				hasEntries = !!(
					parsed &&
					Array.isArray(parsed.entries) &&
					parsed.entries.length
				);
			}
			if (!hasEntries) {
				document.documentElement.setAttribute("data-first-run", "true");
			}
		} catch (e) {}
	</script>

	<main
		class="flex-1 w-full mx-auto px-4 py-6 md:px-6 lg:px-8 max-w-480 flex flex-col gap-6">

		<a
			id="hub-expiration-banner"
			href="/settings"
			data-account-expiration="hub-banner"
			hidden
			class="rounded-xl px-4 py-3 text-sm font-medium
				border border-warn/35 bg-warn/10 text-warn
				data-[state=critical]:border-bad/45 data-[state=critical]:bg-bad/12 data-[state=critical]:text-bad
				data-[state=expired]:border-bad/55 data-[state=expired]:bg-bad/14 data-[state=expired]:text-bad
				hover:border-current
				outline-none transition-colors no-underline">
		</a>

		<section
			id="welcome"
			aria-labelledby="welcome-heading"
			class="welcome-section hidden flex-1 min-h-0 items-center justify-center py-6">
			<WelcomeCard />
		</section>

		<header data-nylah-hero class="nylah-hero nylah-art-backdrop">
			<h1 id="hero-greeting" class="nylah-hero__title">Good evening</h1>
			<p
				id="hero-eyebrow"
				class="nylah-hero__meta tabular-nums"
				aria-hidden="true">
			</p>
		</header>

		<div data-nylah-rails class="nylah-rails">
			<ContinueWatchingRail />
			<TrendingRail />
			<SuggestionsCiaranRail />
			<SuggestionsAislingRail />
			<TopRatedRail />
		</div>
	</main>
</Layout>

<style>
	html[data-first-run="true"] #welcome {
		display: flex;
	}
</style>

<script>
	import "../scripts/updater-startup.js";
	import { log } from "@/scripts/lib/log.js";
	import { t, LOCALE_EVENT } from "@/scripts/lib/i18n.js";
	import { getEntries, getActiveEntry } from "@/scripts/lib/creds.js";
	import { hydrate as hydrateCache } from "@/scripts/lib/cache.js";
	import { readCachedLiveChannels } from "@/scripts/lib/live-catalog.ts";

	// Hero: time-based greeting (big serif) + live meta line (time ·
	// real channel count from the provider catalog). The greeting and
	// the count are the only hero signals kept from the old hub tiles.
	const greetingEl = document.getElementById("hero-greeting");
	const eyebrow = document.getElementById("hero-eyebrow");
	let heroChannelCount = 0;
	const setHeroChannelCount = (count) => {
		const next = Number.isFinite(count) ? Math.max(0, count) : 0;
		if (next === heroChannelCount) return;
		heroChannelCount = next;
		window.__refreshHeroEyebrow?.();
	};
	if (eyebrow) {
		const greet = (hour) => {
			if (hour < 5) return t("hub.greeting.night");
			if (hour < 12) return t("hub.greeting.morning");
			if (hour < 18) return t("hub.greeting.afternoon");
			if (hour < 22) return t("hub.greeting.evening");
			return t("hub.greeting.night");
		};
		const update = () => {
			const now = new Date();
			if (greetingEl) greetingEl.textContent = greet(now.getHours());
			const time = new Intl.DateTimeFormat(undefined, {
				hour: "numeric",
				minute: "2-digit",
			}).format(now);
			const parts = [time];
			if (heroChannelCount > 0) {
				parts.push(t("hub.channelCount", { count: heroChannelCount.toLocaleString() }));
			}
			eyebrow.textContent = parts.join(" · ");
		};
		update();
		setInterval(update, 30_000);
		window.__refreshHeroEyebrow = update;
		document.addEventListener(LOCALE_EVENT, update);
	}

	async function reconcileFirstRun() {
		const entries = await getEntries();
		const hasEntries = entries.length > 0;
		document.documentElement.toggleAttribute("data-first-run", !hasEntries);
		return hasEntries;
	}

	window.addEventListener("load", async () => {
		const hasEntries = await reconcileFirstRun();
		if (!hasEntries) {
			document
				.querySelector("#welcome a.btn-primary")
				?.focus({ preventScroll: true });
		}
	});

	document.addEventListener("xt:entries-updated", reconcileFirstRun);
	document.addEventListener("xt:active-changed", reconcileFirstRun);

	// Hero signals: hydrate the live catalog once and publish the real
	// channel count. (The old hub-tile artwork rotators and on-air
	// line went away with the tiles; Continue Watching hydrates its
	// own data.)
	async function setupHeroSignals() {
		try {
			const active = await getActiveEntry();
			if (!active) return;
			await hydrateCache(active._id, "live").catch(() => {});
			setHeroChannelCount(readCachedLiveChannels(active._id).length);
		} catch (e) {
			log.warn("[hub] setupHeroSignals failed:", e);
		}
	}

	if (typeof window !== "undefined") {
		window.requestIdleCallback
			? window.requestIdleCallback(setupHeroSignals, { timeout: 1500 })
			: setTimeout(setupHeroSignals, 400);
		document.addEventListener("xt:active-changed", setupHeroSignals);
		document.addEventListener("xt:catalog-warmed", setupHeroSignals);
	}
</script>
