---
// Nylah Studios home (W2, RedSilk Couch): cinematic hero from a real
// catalogue title + rails in the fixed order — Continue Watching
// (Movies & Series only), New Episodes, Picked for You, Trending,
// Recently Added Movies, Continue Your Series, Favourite Live
// Channels, Hidden Gems. All data loads client-side in HomeView from
// the existing services; a rail renders only when it has meaningful
// data, so an empty library is an honest empty state, never invented
// titles. Top navigation, focus memory, gamepad and return-home all
// come from CouchLayout.
import CouchLayout from "@/layouts/CouchLayout.astro";
import HomeView from "@/components/HomeView.svelte";
---

<CouchLayout pageTitle="Home" activeNav="home" view="home">
  <HomeView client:load />
</CouchLayout>
