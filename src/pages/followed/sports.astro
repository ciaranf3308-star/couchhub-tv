---
// Sports Corner — Manchester United hub (0.11.13).
// Lives inside Followed: /followed/sports. All fixture content is
// derived at runtime from the EPG by followed-sports-page.ts; this
// shell carries the header, the state/content regions, and the
// global styles the runtime-built rows need.
import CouchLayout from "@/layouts/CouchLayout.astro";
import TvEmpty from "@/components/couch/TvEmpty.astro";
---

<CouchLayout pageTitle="Manchester United" activeNav="followed" view="followed-sports">
  <div data-sports-hub-shell class="rs-sports-shell">
    <header class="rs-sports-head">
      <div class="rs-sports-head-text">
        <p class="rs-sports-breadcrumb">
          <a href="/followed">Followed</a><span aria-hidden="true"> / </span>
          Manchester United
        </p>
        <p data-sports-hub-meta class="rs-meta">
          Fixtures from your programme guide
        </p>
        <p data-sports-hub-stale class="rs-sports-stale" hidden>
          Programme guide data may be out of date.
        </p>
      </div>
      <button
        data-sports-hub-follow
        data-couch-key="sports:unfollow"
        type="button"
        class="rs-hero__action rs-hero__action--secondary"
      >
        Unfollow
      </button>
    </header>

    <div data-sports-hub-states>
      <TvEmpty
        title="Loading the programme guide…"
        message="Fixtures from your programme guide will appear here."
        art="library"
      />
    </div>
    <div data-sports-hub-content></div>
  </div>

  <script>
    import { mountSportsHubPage } from "@/scripts/followed-sports-page.ts";
    import "@/scripts/updater-startup.js";
    mountSportsHubPage();
  </script>

  <style is:global>
    /* Hub content is built at runtime by followed-sports-page.ts,
       so these rules must be global (Astro's scoped styles cannot
       reach DOM created after render). All colours come from the
       W1 tokens. Fixture rows are image cards in a grid (visual
       rebuild, fix-3) — no raw text lists anywhere below the hero;
       the hero stays the banner, the table the panel card. */
    html[data-couch] .rs-sports-shell {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    html[data-couch] .rs-sports-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
    }
    html[data-couch] .rs-sports-head-text {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-width: 0;
    }
    /* Mockup breadcrumb (0.11.17): "Followed / Manchester United",
       muted, above the hub — the old "Sports Corner" eyebrow + H1
       are gone; the UNITED CORNER hero title carries the name now. */
    html[data-couch] .rs-sports-breadcrumb {
      margin: 0;
      font-size: 1.125rem;
      color: var(--rs-text-2);
    }
    html[data-couch] .rs-sports-breadcrumb a {
      color: var(--rs-text);
      text-decoration: none;
    }
    html[data-couch] .rs-sports-breadcrumb a:hover,
    html[data-couch] .rs-sports-breadcrumb a:focus-visible {
      text-decoration: underline;
      outline: none;
    }
    /* Mockup top block (0.11.17): hero left, League position
       panel right (~280px). DOM order stays table-first (the
       section-order test pins it); grid placement puts the hero
       in column 1 and the panel in column 2. */
    html[data-couch] .rs-sports-top {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 19.5rem;
      gap: 2.5rem;
      align-items: stretch;
    }
    html[data-couch] .rs-sports-top > .rs-sports-hero {
      grid-column: 1;
      grid-row: 1;
    }
    html[data-couch] .rs-sports-top > .rs-sports-table-section {
      grid-column: 2;
      grid-row: 1;
      margin-bottom: 0;
    }
    @media (max-width: 1100px) {
      html[data-couch] .rs-sports-top {
        grid-template-columns: minmax(0, 1fr);
      }
      html[data-couch] .rs-sports-top > .rs-sports-hero,
      html[data-couch] .rs-sports-top > .rs-sports-table-section {
        grid-column: 1;
        grid-row: auto;
      }
    }
    html[data-couch] .rs-sports-eyebrow {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--rs-focus);
    }
    html[data-couch] .rs-sports-stale {
      margin: 0;
      font-size: 1.125rem;
      color: var(--rs-text-2);
    }
    /* Brutal red-to-black fades over the Old Trafford art (user:
       "brutal fade gradients" — heavy, not subtle). The crest and
       the hero text sit in the bottom-up black fade; a United-red
       wash comes in from the left; the top edge is darkened too so
       the photo never glares. */
    html[data-couch] .rs-sports-hero {
      position: relative;
      overflow: hidden;
      border-radius: var(--rs-radius);
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 24%),
        linear-gradient(100deg, rgba(218, 41, 28, 0.5) 0%, rgba(120, 8, 8, 0.35) 45%, rgba(0, 0, 0, 0) 78%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.96) 0%, rgba(0, 0, 0, 0.82) 34%, rgba(0, 0, 0, 0.35) 60%, rgba(0, 0, 0, 0) 82%),
        linear-gradient(135deg, #da291c 0%, #5c0703 48%, #000000 100%);
      box-shadow: var(--rs-shadow);
      min-height: 16rem;
      display: flex;
      align-items: flex-end;
    }
    html[data-couch] .rs-sports-hero-has-art {
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 24%),
        linear-gradient(100deg, rgba(218, 41, 28, 0.5) 0%, rgba(120, 8, 8, 0.35) 45%, rgba(0, 0, 0, 0) 78%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.96) 0%, rgba(0, 0, 0, 0.82) 34%, rgba(0, 0, 0, 0.35) 60%, rgba(0, 0, 0, 0) 82%),
        var(--rs-sports-hero-art) center 30% / cover no-repeat,
        linear-gradient(135deg, #da291c 0%, #5c0703 48%, #000000 100%);
    }
    /* Feed hero (mockup, 0.11.17): the bundled Old Trafford night
       photo is the hero background — same brutal fades, photo
       positioned right so the signage shows beside the text column.
       (Item 8, 2026-11-21: it is the only Old Trafford photo in the
       bundle — a night shot, not the mockup's dusk shot with the
       Trinity statue; no better bundled photo exists, so it stays.)
       DOM order keeps the crest first in the body; the grid puts
       crest + UNITED CORNER on one row. */
    html[data-couch] .rs-sports-hero-feed {
      min-height: 25rem;
      background:
        linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 24%),
        linear-gradient(100deg, rgba(218, 41, 28, 0.5) 0%, rgba(120, 8, 8, 0.35) 45%, rgba(0, 0, 0, 0) 78%),
        linear-gradient(0deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.68) 30%, rgba(0, 0, 0, 0.30) 55%, rgba(0, 0, 0, 0) 80%),
        url("/art/sports/football-man-utd-old-trafford.jpg") 50% 22% / cover no-repeat,
        linear-gradient(135deg, #da291c 0%, #5c0703 48%, #000000 100%);
    }
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-body {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1.25rem;
      align-items: center;
      width: 100%;
      max-width: none;
    }
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-crest {
      grid-row: 1;
      grid-column: 1;
      height: 4rem;
      margin-bottom: 0;
    }
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-title {
      grid-row: 1;
      grid-column: 2;
      font-size: 2.5rem;
    }
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-eyebrow,
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-match,
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-meta,
    html[data-couch] .rs-sports-hero-feed .rs-sports-hero-actions {
      grid-column: 1 / -1;
    }
    html[data-couch] .rs-sports-hero-match {
      margin: 0;
      font-size: 2.75rem;
      font-weight: 700;
      line-height: 1.1;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-hero-actions {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      margin-top: 0.75rem;
      flex-wrap: wrap;
    }
    html[data-couch] .rs-sports-hero-remind {
      font-size: 1.25rem;
      padding: 0.75rem 1.5rem;
      border-color: rgba(240, 150, 160, 0.65);
    }
    html[data-couch] .rs-sports-hero-station {
      font-size: 1.125rem;
      font-style: italic;
      color: var(--rs-text-2);
      border-left: 1px solid var(--rs-line-soft);
      padding-left: 1.25rem;
    }
    html[data-couch] .rs-sports-hero-crest {
      height: 6.5rem;
      width: auto;
      margin-bottom: 0.5rem;
      filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.75));
    }
    html[data-couch] .rs-sports-hero-body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 2rem;
      max-width: 52rem;
    }
    html[data-couch] .rs-sports-hero-eyebrow {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--rs-focus);
    }
    html[data-couch] .rs-sports-hero-title {
      font-family: var(--rs-font-display);
      font-size: 2.75rem;
      line-height: 1.1;
      margin: 0;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-hero-meta,
    html[data-couch] .rs-sports-hero-also {
      margin: 0;
      font-size: 1.25rem;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-hero-desc {
      margin: 0.25rem 0 0;
      font-size: 1.125rem;
      line-height: 1.45;
      color: var(--rs-text-2);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    html[data-couch] .rs-sports-hero-watch {
      margin-top: 0.75rem;
      font-size: 1.25rem;
      font-weight: 700;
      padding: 0.75rem 1.75rem;
      border-radius: 0.75rem;
      border: 1px solid var(--rs-accent);
      background: var(--rs-accent);
      color: var(--rs-text);
      cursor: pointer;
    }
    html[data-couch] .rs-sports-hero-watch:hover,
    html[data-couch] .rs-sports-hero-watch:focus-visible {
      box-shadow:
        0 0 0 2px var(--rs-focus),
        0 0 20px 2px var(--rs-focus-glow);
      outline: none;
    }
    html[data-couch] .rs-sports-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }
    html[data-couch] .rs-sports-section-title {
      font-family: var(--rs-font-display);
      font-size: 1.75rem;
      line-height: 1.2;
      margin: 0.75rem 0 0;
      color: var(--rs-text);
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.75rem;
    }
    /* Cinematic section header (visual rebuild, fix-3): a short
       United-red rule under the title, and a count pill so a
       section reads as a designed block, never a bare heading
       over a text list. The rule is a background gradient (a flex
       ::after gets clamped inline by max-width), painted under
       the title row. */
    html[data-couch] .rs-sports-section-title {
      background:
        linear-gradient(90deg, var(--rs-sports-united-red) 0%, var(--rs-sports-united-red) 100%) left bottom / 3rem 3px no-repeat;
      padding-bottom: 0.625rem;
    }
    html[data-couch] .rs-sports-section-count {
      font-family: var(--rs-font-body, inherit);
      font-size: 0.9375rem;
      font-weight: 700;
      line-height: 1;
      padding: 0.3125rem 0.625rem;
      border-radius: 999px;
      background: rgba(218, 41, 28, 0.18);
      border: 1px solid rgba(218, 41, 28, 0.45);
      color: var(--rs-text);
      white-space: nowrap;
    }
    html[data-couch] .rs-sports-section-note {
      margin: 0;
      font-size: 1.125rem;
      color: var(--rs-text-2);
    }
    html[data-couch] .rs-sports-subhead {
      font-size: 1.25rem;
      font-weight: 700;
      margin: 0.5rem 0 0;
      color: var(--rs-text-2);
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
    }
    /* United visuals (v2, hard-coded): Manchester United red.
       The RedSilk accent is burgundy; the corner's own red is the
       club red, used for the United table row, the table expand
       action and the Next Matches Watch buttons. Old Trafford art
       stays on the hero + entry card (enrichment L3). The genuine
       crest ships as a repo brand asset
       (public/brand/man-utd-crest.svg) and is rendered in the
       hero and on the entry card; no feed-supplied crests are ever
       rendered (terms §9.2). */
    html[data-couch] .rs-sports-shell {
      --rs-sports-united-red: #da291c;
    }
    /* League position panel (mockup, 0.11.17): heading + big
       position/points + compact 4-column table, no card chrome. */
    /* League position panel as a designed card (visual rebuild,
       fix-3): warm surface, hairline border, red accent bar on
       top, crest + competition head. The mini-table itself keeps
       its layout — only the chrome around it changes. */
    html[data-couch] .rs-sports-table-section {
      background: var(--rs-surface);
      border: 1px solid var(--rs-line-soft);
      border-radius: var(--rs-radius);
      box-shadow: var(--rs-shadow);
      padding: 1.25rem 1.25rem 1rem;
      overflow: hidden;
      position: relative;
    }
    html[data-couch] .rs-sports-table-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #da291c 0%, #7a0d06 60%, transparent 100%);
    }
    html[data-couch] .rs-sports-table-panel-head {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 0.25rem;
    }
    html[data-couch] .rs-sports-table-panel-crest {
      height: 1.75rem;
      width: auto;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
    }
    html[data-couch] .rs-sports-table-panel-comp {
      font-size: 0.9375rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--rs-text-2);
    }
    html[data-couch] .rs-sports-table-heading {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.2;
      color: var(--rs-focus);
    }
    html[data-couch] .rs-sports-table-position {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 0.5rem 0 0.75rem;
    }
    html[data-couch] .rs-sports-table-big {
      font-size: 3rem;
      font-weight: 800;
      line-height: 1;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-table-points-rule {
      width: 1px;
      align-self: stretch;
      background: var(--rs-line-soft);
    }
    html[data-couch] .rs-sports-table-points {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--rs-text);
      white-space: nowrap;
    }
    html[data-couch] .rs-sports-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 1.125rem;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-table th,
    html[data-couch] .rs-sports-table td {
      padding: 0.5rem 0.625rem;
      border-bottom: 1px solid var(--rs-line-soft);
      text-align: left;
    }
    html[data-couch] .rs-sports-table th {
      font-size: 0.9375rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--rs-text-2);
    }
    html[data-couch] .rs-sports-table-num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }
    html[data-couch] .rs-sports-table-row-united {
      background: rgba(218, 41, 28, 0.16);
      box-shadow: inset 3px 0 0 var(--rs-sports-united-red);
    }
    html[data-couch] .rs-sports-table-row-united td {
      font-weight: 700;
    }
    /* Last five chips (mockup right panel, 0.11.17): "Last five"
       label + W/D/L squares, most recent first. W green, D grey,
       L United red — the mockup's colours. */
    html[data-couch] .rs-sports-form-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin: 0.75rem 0 0;
    }
    html[data-couch] .rs-sports-form-label {
      margin-right: 0.25rem;
      font-size: 1.125rem;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-form-chip {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 0.375rem;
      font-size: 1rem;
      font-weight: 800;
      line-height: 1;
      color: #ffffff;
    }
    html[data-couch] .rs-sports-form-chip--w {
      background: #22a35a;
    }
    html[data-couch] .rs-sports-form-chip--d {
      background: #6f6f6f;
    }
    html[data-couch] .rs-sports-form-chip--l {
      background: var(--rs-sports-united-red);
    }
    html[data-couch] .rs-sports-table-meta,
    html[data-couch] .rs-sports-attribution {
      margin: 0.5rem 0 0;
      font-size: 1rem;
      color: var(--rs-text-2);
    }
    html[data-couch] .rs-sports-table-stale {
      margin: 0.5rem 0 0;
      font-size: 1.0625rem;
      color: var(--rs-text-2);
    }
    /* "View full table ›" is a text link in the mockup, not a
       bordered button — same focus ring, same couch key. */
    html[data-couch] .rs-sports-table-expand {
      margin-top: 0.75rem;
      padding: 0.5rem 0;
      font-size: 1.125rem;
      font-weight: 700;
      border: none;
      background: transparent;
      color: var(--rs-focus);
      cursor: pointer;
      text-align: left;
    }
    html[data-couch] .rs-sports-table-expand:hover,
    html[data-couch] .rs-sports-table-expand:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px var(--rs-focus);
      background: transparent;
      text-decoration: underline;
    }
    /* Next Matches rows are divs, not whole-row buttons: the row
       carries the fixture facts, the actions area carries the
       Watch button (when tunable) and the Phase 3 reminder slot. */
    /* Next Matches cards (visual rebuild, fix-3): the mockup's
       five text columns become five image cards — stadium-photo
       thumb with a red-to-black fade and a date badge, opponent
       and competition below, station line, bell + Watch. Title
       sits above the row now: five cards need the full width. */
    html[data-couch] .rs-sports-next-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    html[data-couch] .rs-sports-next-section > .rs-sports-section-title {
      margin: 0.75rem 0 0;
    }
    html[data-couch] .rs-sports-next-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.25rem;
    }
    html[data-couch] .rs-sports-next-row {
      display: flex;
      flex-direction: column;
      min-width: 0;
      overflow: hidden;
      border-radius: var(--rs-radius);
      border: 1px solid var(--rs-line-soft);
      background: var(--rs-surface);
      box-shadow: var(--rs-shadow);
      color: var(--rs-text);
      transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
    }
    html[data-couch] .rs-sports-next-row:hover {
      transform: translateY(-2px);
      border-color: rgba(218, 41, 28, 0.55);
    }
    html[data-couch] .rs-sports-next-thumb {
      position: relative;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.85) 0%, rgba(0, 0, 0, 0.25) 55%, rgba(0, 0, 0, 0) 100%),
        linear-gradient(135deg, #da291c 0%, #5c0703 48%, #000000 100%);
    }
    html[data-couch] .rs-sports-next-thumb::after {
      /* Crest watermark on the gradient fallback: club identity,
         never a fake stadium photo. Hidden once real art lands. */
      content: "";
      position: absolute;
      right: -0.75rem;
      bottom: -1.25rem;
      width: 6.5rem;
      height: 6.5rem;
      background: url("/brand/man-utd-crest.svg") center / contain no-repeat;
      opacity: 0.22;
      pointer-events: none;
    }
    html[data-couch] .rs-sports-next-thumb-has-art {
      background:
        linear-gradient(0deg, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.35) 55%, rgba(0, 0, 0, 0.15) 100%),
        linear-gradient(100deg, rgba(218, 41, 28, 0.35) 0%, rgba(0, 0, 0, 0) 60%),
        var(--rs-sports-next-art) center / cover no-repeat,
        linear-gradient(135deg, #da291c 0%, #5c0703 48%, #000000 100%);
    }
    html[data-couch] .rs-sports-next-thumb-has-art::after {
      content: none;
    }
    html[data-couch] .rs-sports-next-date {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 3rem;
      padding: 0.375rem 0.5rem 0.5rem;
      border-radius: 0.625rem;
      background: rgba(0, 0, 0, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
      line-height: 1;
    }
    html[data-couch] .rs-sports-next-date-day {
      font-size: 1.5rem;
      font-weight: 800;
    }
    html[data-couch] .rs-sports-next-date-mon {
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.12em;
