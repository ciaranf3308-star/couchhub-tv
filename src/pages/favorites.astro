---
// Favourites — RedSilk Couch (W5). Library behaviour unchanged
// (preferences favourites store as-is); CouchLayout + couch cards.
import CouchLayout from "@/layouts/CouchLayout.astro";
import AllFavoritesView from "@/components/AllFavoritesView.svelte";
---

<CouchLayout pageTitle="Favourites" activeNav="favorites" view="favorites">
  <header class="couch-library-head">
    <h1 class="rs-page-title">Favourites</h1>
    <p class="rs-meta">
      Every starred channel, movie, and series across all your playlists.
      Opening a favourite from a different playlist switches you over first.
    </p>
  </header>

  <AllFavoritesView client:load />

  <script>
    import "@/scripts/updater-startup.js";
  </script>

  <style>
    .couch-library-head {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
  </style>
</CouchLayout>
