---
// Followed Series (W2 rebuild onto the W1 shared system):
// New Episodes + followed shows, rendered by followed-page.ts into
// the rs-* card system. All data comes from followed.ts (unchanged);
// checks still run in the background and the notifications.json Rust
// writer is untouched.
import CouchLayout from "@/layouts/CouchLayout.astro";
import TvEmpty from "@/components/couch/TvEmpty.astro";
---

<CouchLayout pageTitle="Followed Series" activeNav="followed" view="followed">
  <header class="rs-followed-head">
    <h1 data-i18n="page.followed.heading" class="rs-page-title">Followed Series</h1>
    <p data-i18n="page.followed.sub" class="rs-meta">
      New episodes for the shows you follow, and the shows themselves. Checks run in the background — you never have to go looking.
    </p>
  </header>

  <div class="rs-followed-actions">
    <button id="followed-check-now" type="button" class="rs-hero__action rs-hero__action--secondary">
      <span data-i18n="followed.checkNow">Check now</span>
    </button>
    <a href="/settings/followed#card-followed" data-couch-key="check-settings" class="rs-hero__action rs-hero__action--secondary">
      <span data-i18n="followed.checkSettings">Check settings</span>
    </a>
    <span id="followed-last-check" class="rs-meta" aria-live="polite"></span>
  </div>

  <!-- Sports Corner entry (0.11.13): rendered by followed-page.ts
       into the rs-sports-card system. Hidden until a playlist is
       resolved; the section heading stays out of the way when the
       card has nothing to show. -->
  <section aria-labelledby="sports-corner-heading" class="rs-followed-section" data-sports-entry-section hidden>
    <h2 id="sports-corner-heading" class="rs-section-title">Sports Corner</h2>
    <div data-sports-entry-card></div>
  </section>

  <section aria-labelledby="followed-new-heading" class="rs-followed-section">
    <h2 id="followed-new-heading" class="rs-section-title">
      <span data-i18n="followed.newEpisodes">New Episodes</span>
      <span id="followed-unread-count" class="rs-meta"></span>
    </h2>
    <div id="followed-new-list" class="rs-followed-list"></div>
    <div id="followed-new-empty" hidden>
      <TvEmpty
        title="No new episodes right now"
        message="When a followed show adds an episode, it will appear here."
        art="library"
      />
    </div>
  </section>

  <section aria-labelledby="followed-list-heading" class="rs-followed-section">
    <h2 id="followed-list-heading" class="rs-section-title" data-i18n="followed.followedShows">Followed shows</h2>
    <div id="followed-list" class="rs-followed-list"></div>
    <div id="followed-list-empty" hidden>
      <TvEmpty
        title="Nothing followed yet"
        message="Open a series and tap Follow — new episodes will be checked for you in the background."
        art="library"
        actionLabel="Browse series"
        actionHref="/series"
      />
    </div>
  </section>

  <script>
    import "@/scripts/followed-page.ts"
    import "@/scripts/updater-startup.js"
  </script>

  <style is:global>
    /* Followed cards are built at runtime by followed-page.ts, so
       these rules must be global (Astro's scoped styles cannot reach
       DOM created after render). All colours come from the W1 tokens. */
    html[data-couch] .rs-followed-head {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.5rem;
    }
    html[data-couch] .rs-followed-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    html[data-couch] .rs-followed-actions .rs-hero__action {
      font-size: 1.25rem;
      padding: 0.75rem 1.5rem;
    }
    html[data-couch] .rs-followed-section {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
    }
    html[data-couch] .rs-followed-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    html[data-couch] .rs-followed-card {
      display: flex;
      gap: 1.25rem;
      padding: 1.25rem;
      background: var(--rs-surface);
      border: 1px solid var(--rs-line-soft);
      border-radius: var(--rs-radius);
      box-shadow: var(--rs-shadow);
      min-width: 0;
    }
    html[data-couch] .rs-followed-card:focus-within {
      box-shadow:
        0 0 0 2px var(--rs-focus),
        0 0 20px 2px var(--rs-focus-glow);
    }
    html[data-couch] .rs-followed-poster {
      width: 6rem;
      flex-shrink: 0;
      border-radius: 0.75rem;
      overflow: hidden;
      box-shadow: var(--rs-shadow);
    }
    html[data-couch] .rs-followed-poster .rs-image--poster {
      aspect-ratio: 2 / 3;
    }
    html[data-couch] .rs-followed-body {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      min-width: 0;
      flex: 1;
    }
    html[data-couch] .rs-followed-title {
      font-family: var(--rs-font-display);
      font-size: 2rem;
      line-height: 1.2;
      margin: 0;
      color: var(--rs-text);
    }
    html[data-couch] .rs-followed-episodes {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }
    html[data-couch] .rs-followed-episode {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.25rem;
      color: var(--rs-text);
    }
    html[data-couch] .rs-followed-episode-label {
      min-width: 0;
      flex: 1;
    }
    html[data-couch] .rs-followed-btn {
      font-size: 1.125rem;
      font-weight: 600;
      padding: 0.625rem 1.25rem;
      border-radius: 0.75rem;
      border: 1px solid var(--rs-line);
      background: var(--rs-bg-2);
      color: var(--rs-text);
      cursor: pointer;
      white-space: nowrap;
    }
    html[data-couch] .rs-followed-btn:hover,
    html[data-couch] .rs-followed-btn:focus-visible {
      background: var(--rs-surface);
      border-color: var(--rs-focus);
    }
    html[data-couch] .rs-followed-btn--primary {
      background: var(--rs-accent);
      border-color: var(--rs-accent);
    }
    html[data-couch] .rs-followed-btn:disabled {
      opacity: 0.55;
      cursor: default;
    }
    /* Sports Corner entry card (0.11.13): built at runtime by
       followed-sports-page.ts, so these rules must be global. The
       artwork panel is a branded gradient until enrichment resolves
       a real backdrop — never a stretched logo. */
    html[data-couch] .rs-sports-card {
      display: flex;
      gap: 1.25rem;
      padding: 1.25rem;
      background: var(--rs-surface);
      border: 1px solid var(--rs-line-soft);
      border-radius: var(--rs-radius);
      box-shadow: var(--rs-shadow);
      min-width: 0;
    }
    html[data-couch] .rs-sports-card-art {
      width: 12rem;
      flex-shrink: 0;
      border-radius: 0.75rem;
      background: linear-gradient(135deg, var(--rs-accent), var(--rs-bg-2));
      min-height: 7rem;
    }
    html[data-couch] .rs-sports-card-art-has-art {
      background:
        var(--rs-sports-card-art) center 30% / cover no-repeat,
        linear-gradient(135deg, var(--rs-accent), var(--rs-bg-2));
    }
    html[data-couch] .rs-sports-card-body {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      min-width: 0;
      flex: 1;
    }
    html[data-couch] .rs-sports-card-team {
      margin: 0;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: var(--rs-focus);
    }
    html[data-couch] .rs-sports-card-line {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 1.25;
      color: var(--rs-text);
    }
    html[data-couch] .rs-sports-card-meta {
      margin: 0;
      font-size: 1.125rem;
      color: var(--rs-text-2);
    }
    html[data-couch] .rs-sports-card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 0.5rem;
    }
    html[data-couch] .rs-sports-card-button {
      font-size: 1.125rem;
      font-weight: 600;
      padding: 0.625rem 1.25rem;
      border-radius: 0.75rem;
      border: 1px solid var(--rs-line);
      background: var(--rs-bg-2);
      color: var(--rs-text);
      cursor: pointer;
      text-decoration: none;
      white-space: nowrap;
    }
    html[data-couch] .rs-sports-card-button:hover,
    html[data-couch] .rs-sports-card-button:focus-visible {
      background: var(--rs-surface);
      border-color: var(--rs-focus);
      outline: none;
    }
    @media (prefers-reduced-motion: reduce) {
      html[data-couch] .rs-followed-card:focus-within,
      html[data-couch] .rs-followed-btn:focus-visible {
        box-shadow: 0 0 0 2px var(--rs-focus);
      }
    }
  </style>
</CouchLayout>
