---
// RedSilk Browse — the ONE Browse destination (Browse consolidation).
//
//   /browse               -> Discover landing (type=all, the default)
//   /browse?type=movies   -> movies catalogue view
//   /browse?type=series   -> series catalogue view
//
// The landing IS the Discover experience, rehoused: DiscoverView
// (same component + engines as /discover — mood search, quick picks,
// personalised rails, feedback) mounts client:visible inside the
// Discover section, which starts hidden in the markup so it never
// hydrates on a movies/series visit; the page controller unhides the
// section for the current ?type=.
//
// The Movies/Series sections reproduce the standalone /movies and
// /series page markup verbatim (same DOM contract, same rails,
// filters/sort, search + on-screen keyboard, skeleton/empty/error,
// detail flow) with "browse-movies-" / "browse-series-" id prefixes,
// so the shared browse controller can mount each kind's adapter here
// without duplicating any data fetching. The standalone pages are
// untouched and keep working.
//
// Search entry: #browse-search-slot is a clearly-marked placeholder —
// W2 builds the search button and the integration wires it in.
import CouchLayout from "@/layouts/CouchLayout.astro";
import DiscoverView from "@/components/DiscoverView.svelte";
import TvDialog from "@/components/couch/TvDialog.astro";
import TvKeyboard from "@/components/couch/TvKeyboard.svelte";
import TvSkeleton from "@/components/couch/TvSkeleton.astro";
import TvEmpty from "@/components/couch/TvEmpty.astro";
import { MOVIE_SORT_MODES } from "@/scripts/movies/couch-movies.ts";
import { SERIES_SORT_MODES } from "@/scripts/series/couch-series.ts";
import { YEAR_ORDER, RATING_OPTIONS } from "@/scripts/lib/browse-filters.ts";
---

<CouchLayout pageTitle="Browse" activeNav="browse" view="browse">
  <header class="rs-browse-head">
    <h1 class="rs-page-title">Browse</h1>
    <p class="rs-meta">
      Personal picks from your own library — no account, no cloud, nothing invented.
    </p>
  </header>

  <div class="rs-browse-topbar">
    <div
      class="rs-browse-type"
      role="group"
      aria-label="Browse type"
      data-nylah-rail="browse-type"
    >
      <button
        type="button"
        class="rs-hero__action rs-hero__action--secondary"
        data-browse-type="all"
        data-nylah-item
        aria-pressed="true"
      >
        All
      </button>
      <button
        type="button"
        class="rs-hero__action rs-hero__action--secondary"
        data-browse-type="movies"
        data-nylah-item
        aria-pressed="false"
      >
        Movies
      </button>
      <button
        type="button"
        class="rs-hero__action rs-hero__action--secondary"
        data-browse-type="series"
        data-nylah-item
        aria-pressed="false"
      >
        Series
      </button>
    </div>

    <!--
      SEARCH SLOT (W2): the Browse search button mounts here.
      Placeholder only — W1 does not build a search button.
    -->
    <div id="browse-search-slot" data-browse-search-slot></div>
  </div>

  <section id="browse-discover" aria-label="Discover" hidden>
    <DiscoverView client:visible />
  </section>

  <section id="browse-movies" aria-label="Movies" hidden>
    <header class="rs-browse-head">
      <h1 class="rs-page-title">Movies</h1>
      <p class="rs-meta">
        <span id="browse-movies-couch-browse-hero-count">—</span>
        <span aria-hidden="true"> · </span>
        <span id="browse-movies-couch-browse-status">Loading…</span>
      </p>
    </header>

    <section class="rs-browse-toolbar" aria-label="Browse controls">
      <div class="rs-browse-search">
        <label class="rs-browse-label" for="browse-movies-couch-browse-search">Search movies</label>
        <input
          id="browse-movies-couch-browse-search"
          type="search"
          placeholder="Search movies…"
          autocomplete="off"
        />
        <button
          id="browse-movies-couch-search-open"
          type="button"
          class="rs-hero__action rs-hero__action--secondary"
          data-couch-dialog-open="browse-movies-couch-search-dialog"
        >
          ⌨ On-screen keyboard
        </button>
      </div>

      <div class="rs-browse-selects">
        <label class="rs-browse-label" for="browse-movies-couch-browse-sort">Sort</label>
        <select id="browse-movies-couch-browse-sort">
          {
            MOVIE_SORT_MODES.map((mode) => (
              <option value={mode.value}>{mode.label}</option>
            ))
          }
        </select>
        <label class="rs-browse-label" for="browse-movies-couch-browse-year">Decade</label>
        <select id="browse-movies-couch-browse-year">
          <option value="">Any decade</option>
          {
            YEAR_ORDER.map((year) => (
              <option value={year}>{year}</option>
            ))
          }
        </select>
        <label class="rs-browse-label" for="browse-movies-couch-browse-rating">Rating</label>
        <select id="browse-movies-couch-browse-rating">
          {
            RATING_OPTIONS.map((min) => (
              <option value={min}>
                {min === 0 ? "Any rating" : `${min}+`}
              </option>
            ))
          }
        </select>
      </div>
    </section>

    <div
      id="browse-movies-couch-browse-tabs"
      class="rs-browse-tabs"
      role="group"
      aria-label="Movie lists"
    >
    </div>

    <div
      id="browse-movies-couch-browse-genres"
      class="rs-browse-genres"
      role="group"
      aria-label="Filter by genre"
    >
    </div>

    <div id="browse-movies-couch-browse-rails"></div>

    <div id="browse-movies-couch-browse-skeleton">
      <TvSkeleton kind="poster" count={12} />
    </div>

    <div id="browse-movies-couch-browse-empty" hidden>
      <TvEmpty
        title="No movies yet"
        message="This playlist has no movies."
        art="library"
        actionLabel="Open Settings"
        actionHref="/settings"
      />
    </div>

    <div id="browse-movies-couch-browse-error" hidden role="alert">
      <p class="rs-body-text" data-role="error-message"></p>
      <p>
        <a class="rs-hero__action rs-hero__action--secondary" href="/settings">
          Check Settings
        </a>
      </p>
    </div>

    <div
      id="browse-movies-couch-browse-grid"
      class="rs-grid"
      data-couch-grid
      aria-label="All movies"
      hidden
    >
    </div>

    <TvDialog id="browse-movies-couch-search-dialog" title="Search movies">
      <TvKeyboard client:load placeholder="Type a movie title…" />
      <p class="rs-meta">Type to filter the grid. The keyboard closes with B / Escape.</p>
    </TvDialog>
  </section>

  <section id="browse-series" aria-label="Series" hidden>
    <header class="rs-browse-head">
      <h1 class="rs-page-title">Series</h1>
      <p class="rs-meta">
        <span id="browse-series-couch-browse-hero-count">—</span>
        <span aria-hidden="true"> · </span>
        <span id="browse-series-couch-browse-status">Loading…</span>
      </p>
    </header>

    <section class="rs-browse-toolbar" aria-label="Browse controls">
      <div class="rs-browse-search">
        <label class="rs-browse-label" for="browse-series-couch-browse-search">Search series</label>
        <input
          id="browse-series-couch-browse-search"
          type="search"
          placeholder="Search series…"
          autocomplete="off"
        />
        <button
          id="browse-series-couch-search-open"
          type="button"
          class="rs-hero__action rs-hero__action--secondary"
          data-couch-dialog-open="browse-series-couch-search-dialog"
        >
          ⌨ On-screen keyboard
        </button>
      </div>

      <div class="rs-browse-selects">
        <label class="rs-browse-label" for="browse-series-couch-browse-sort">Sort</label>
        <select id="browse-series-couch-browse-sort">
          {
            SERIES_SORT_MODES.map((mode) => (
              <option value={mode.value}>{mode.label}</option>
            ))
          }
        </select>
        <label class="rs-browse-label" for="browse-series-couch-browse-year">Decade</label>
        <select id="browse-series-couch-browse-year">
          <option value="">Any decade</option>
          {
            YEAR_ORDER.map((year) => (
              <option value={year}>{year}</option>
            ))
          }
        </select>
        <label class="rs-browse-label" for="browse-series-couch-browse-rating">Rating</label>
        <select id="browse-series-couch-browse-rating">
          {
            RATING_OPTIONS.map((min) => (
              <option value={min}>
                {min === 0 ? "Any rating" : `${min}+`}
              </option>
            ))
          }
        </select>
      </div>
    </section>

    <div
      id="browse-series-couch-browse-tabs"
      class="rs-browse-tabs"
      role="group"
      aria-label="Series lists"
    >
    </div>

    <div
      id="browse-series-couch-browse-genres"
      class="rs-browse-genres"
      role="group"
      aria-label="Filter by genre"
    >
    </div>

    <div id="browse-series-couch-browse-rails"></div>

    <div id="browse-series-couch-browse-skeleton">
      <TvSkeleton kind="poster" count={12} />
    </div>

    <div id="browse-series-couch-browse-empty" hidden>
      <TvEmpty
        title="No series yet"
        message="This playlist has no series."
        art="library"
        actionLabel="Open Settings"
        actionHref="/settings"
      />
    </div>

    <div id="browse-series-couch-browse-error" hidden role="alert">
      <p class="rs-body-text" data-role="error-message"></p>
      <p>
        <a class="rs-hero__action rs-hero__action--secondary" href="/settings">
          Check Settings
        </a>
      </p>
    </div>

    <div
      id="browse-series-couch-browse-grid"
      class="rs-grid"
      data-couch-grid
      aria-label="All series"
      hidden
    >
    </div>

    <TvDialog id="browse-series-couch-search-dialog" title="Search series">
      <TvKeyboard client:load placeholder="Type a series title…" />
      <p class="rs-meta">Type to filter the grid. The keyboard closes with B / Escape.</p>
    </TvDialog>
  </section>

  <script>
    import { mountBrowsePage } from "@/scripts/browse/couch-browse-page.ts";
    mountBrowsePage();
  </script>

  <style>
    .rs-browse-head {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .rs-browse-topbar {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }
    .rs-browse-type {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .rs-browse-type .rs-hero__action[aria-pressed="true"] {
      background: var(--rs-accent);
      border-color: var(--rs-focus);
      color: #fff;
    }
    .rs-browse-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      align-items: end;
    }
    .rs-browse-search {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: end;
      flex: 1 1 32rem;
    }
    .rs-browse-search input {
      flex: 1 1 16rem;
      min-height: 3rem;
      padding: 0.5rem 1rem;
      border-radius: 0.75rem;
      border: 1px solid var(--rs-line);
      background: var(--rs-surface);
      color: var(--rs-text);
      font-size: 1.25rem;
    }
    .rs-browse-selects {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
    }
    .rs-browse-selects select {
      min-height: 3rem;
      padding: 0.5rem 0.75rem;
      border-radius: 0.75rem;
      border: 1px solid var(--rs-line);
      background: var(--rs-surface);
      color: var(--rs-text);
      font-size: 1.125rem;
    }
    .rs-browse-label {
      font-size: 1.125rem;
      color: var(--rs-text-2);
    }
    .rs-browse-tabs,
    .rs-browse-genres {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .rs-browse-tabs .rs-hero__action[aria-pressed="true"],
    .rs-browse-genres .rs-hero__action[aria-pressed="true"] {
      background: var(--rs-accent);
      border-color: var(--rs-focus);
      color: #fff;
    }
  </style>
</CouchLayout>
