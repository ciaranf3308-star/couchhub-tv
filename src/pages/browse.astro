---
// /browse is retired as a destination (0.10.0 reverses the 0.8.0 Browse
// consolidation — user's explicit call). It stays only as a thin
// redirect so old links / bookmarks keep working:
//
//   /browse?type=movies  -> /movies
//   /browse?type=series  -> /series
//   anything else         -> /discover
//
// The redirect is client-side on purpose: this app ships as a static
// build (Tauri serves dist files, no server), so a frontmatter
// redirect would bake in one target at build time and could
// never branch on the query string. The script below runs during
// parse, before first paint; without JS the page offers plain links.
// Movies, Series and Discover are real pages again at /movies,
// /series and /discover. The catalogue markup that lived in this
// file's browse-movies / browse-series sections moved back out to
// src/pages/movies/index.astro and src/pages/series/index.astro.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting… | NylahBox Studios</title>
    <meta name="theme-color" content="#170A0C" />
  </head>
  <body>
    <script>
      var type = new URLSearchParams(window.location.search).get("type");
      var target =
        type === "movies"
          ? "/movies"
          : type === "series"
            ? "/series"
            : "/discover";
      window.location.replace(target);
    </script>
    <noscript>
      <p>
        Browse has moved — continue to
        <a href="/movies">Movies</a>,
        <a href="/series">Series</a> or
        <a href="/discover">Discover</a>.
      </p>
    </noscript>
  </body>
</html>
