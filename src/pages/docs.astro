---
import Layout from "@/layouts/Layout.astro"
---

<Layout pageTitle="Documentation" showVersion={false}>
  <main class="flex flex-1 min-h-0 flex-col">
    <noscript>
      <p class="m-4 text-sm text-fg-2">
        Documentation requires JavaScript and a network connection. Open it directly at
        <a class="underline" href="https://infinitel8p.github.io/Extreme-InfiniTV/" target="_blank" rel="noopener">infinitel8p.github.io/Extreme-InfiniTV</a>.
      </p>
    </noscript>
    <div id="xt-docs-skeleton" class="xt-docs-skeleton grid flex-1 place-items-center text-fg-3 text-sm">
      <span data-i18n="docs.loading">Loading documentation…</span>
    </div>
    <iframe
      id="xt-docs-frame"
      title="Nylah Studios documentation"
      data-i18n-attr="title:docs.frameTitle"
      class="hidden flex-1 w-full border-0 bg-bg"
      referrerpolicy="no-referrer"
      sandbox="allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
    ></iframe>
  </main>

  <!-- W6 branding — GPL attribution (the only user-facing place the
       upstream name appears). NylahBox Studios is a fork of upstream
       Extreme InfiniTV; the GPL requires this credit to stay. -->
  <footer class="xt-docs-legal">
    <p>
      NylahBox Studios is based on
      <a href="https://github.com/infinitel8p/Extreme-InfiniTV" target="_blank" rel="noopener">Extreme InfiniTV</a>
      by infinitel8p (Ludovico Ferrara), &copy; 2025, licensed under the
      <a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noopener">GNU General Public License v3.0 or later</a>.
      No IPTV subscription is included.
    </p>
  </footer>

  <script is:inline>
    (() => {
      const DOCS_BASE = "https://infinitel8p.github.io/Extreme-InfiniTV"
      const DOCS_ORIGIN = "https://infinitel8p.github.io"
      const iframe = document.getElementById("xt-docs-frame")
      const skeleton = document.getElementById("xt-docs-skeleton")
      if (!(iframe instanceof HTMLIFrameElement)) return

      const preconnect = document.createElement("link")
      preconnect.rel = "preconnect"
      preconnect.href = DOCS_ORIGIN
      preconnect.crossOrigin = ""
      document.head.appendChild(preconnect)

      const sanitizePath = (raw) => {
        if (!raw) return ""
        const cleaned = raw.replace(/[^a-zA-Z0-9/_-]/g, "")
        const noLead = cleaned.replace(/^\/+/, "")
        return noLead.endsWith("/") || noLead === "" ? noLead : noLead + "/"
      }

      const resolveTheme = () => {
        const stored = localStorage.getItem("xt_theme") || "system"
        if (stored === "light" || stored === "dark") return stored
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
      }

      const ACCENT_PRESETS = ["fuchsia", "rose", "ember", "emerald", "cyan", "blue", "violet"]
      const resolveAccent = () => {
        const stored = localStorage.getItem("xt_accent") || "fuchsia"
        return ACCENT_PRESETS.includes(stored) ? stored : "fuchsia"
      }

      const buildSrc = () => {
        const params = new URLSearchParams(window.location.search)
        const path = sanitizePath(params.get("p") || "")
        const url = new URL(`${DOCS_BASE}/${path}`)
        url.searchParams.set("embed", "1")
        url.searchParams.set("theme", resolveTheme())
        const accent = resolveAccent()
        if (accent !== "fuchsia") url.searchParams.set("accent", accent)
        return url.toString()
      }

      iframe.addEventListener("load", () => {
        if (skeleton) skeleton.classList.add("hidden")
        iframe.classList.remove("hidden")
      })

      iframe.src = buildSrc()

      const pushTheme = () => {
        try {
          iframe.contentWindow?.postMessage(
            { type: "xt-docs:theme", theme: resolveTheme() },
            DOCS_ORIGIN
          )
        } catch {}
      }
      const pushAccent = () => {
        try {
          iframe.contentWindow?.postMessage(
            { type: "xt-docs:accent", accent: resolveAccent() },
            DOCS_ORIGIN
          )
        } catch {}
      }
      window.addEventListener("storage", (event) => {
        if (event.key === "xt_theme") pushTheme()
        if (event.key === "xt_accent") pushAccent()
      })
      const systemMql = window.matchMedia("(prefers-color-scheme: dark)")
      systemMql.addEventListener?.("change", pushTheme)
    })()
  </script>
</Layout>

<style>
  #xt-docs-frame {
    color-scheme: light dark;
  }
  .xt-docs-legal {
    padding: 0.75rem 1rem 1rem;
    border-top: 1px solid var(--line, rgba(255, 255, 255, 0.1));
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--fg-3, #8a7a82);
  }
  .xt-docs-legal a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .xt-docs-skeleton {
    animation: xt-docs-skeleton-pulse 1.6s ease-in-out infinite;
    /* RedSilk: the loading line is serif display type, like every
       other page's hero copy — the wait reads as part of the app. */
    font-family: var(--nylah-font-display, var(--font-serif, Georgia, serif));
    font-size: 1.125rem;
    letter-spacing: 0.01em;
  }
  @keyframes xt-docs-skeleton-pulse {
    0%, 100% { opacity: 0.55; }
    50%      { opacity: 0.9; }
  }
  @media (prefers-reduced-motion: reduce) {
    .xt-docs-skeleton { animation: none; opacity: 0.7; }
  }
  :root[data-perf-mode="on"] .xt-docs-skeleton {
    animation: none;
    opacity: 0.7;
  }
</style>
