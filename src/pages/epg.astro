---
// Programme guide — RedSilk Couch rebuild (W3).
//
// CouchLayout shell + the W1 shared system. The guide engine is
// unchanged and stays in epg.ts / mapping.ts: this page keeps every
// DOM id they own (grid shell, time header, focus strip, toolbar,
// mapping + picker dialogs) and reskins the chrome around it.
//
// Controller-first timeline guide: channels vertically, programmes
// horizontally by time, current-time marker, now/next in the focus
// strip, D-pad movement between programmes (spatial nav), fast
// channel selection via the sticky channel column. Catch-up actions
// come only from epg.ts's own gating (channelSupportsCatchup /
// isCatchupPlayable) — never invented here. Rows are virtualised by
// epg.ts (visible window + overscan) with content-visibility as a
// second layer in TvEpgGrid.
import CouchLayout from "@/layouts/CouchLayout.astro";
import CategoryPickerDialog from "@/components/CategoryPickerDialog.astro";
import SearchInput from "@/components/SearchInput.astro";
import TvEpgGrid from "@/components/couch/TvEpgGrid.astro";
import { IconRefresh, IconArrowLeft, IconChevronDown, IconChevronLeft, IconChevronRight, IconClockHour3, IconLink } from "@tabler/icons-svelte";
---

<CouchLayout pageTitle="Programme guide" view="epg">
	<div class="rs-epg">
		<header class="rs-epg__head">
			<h1 class="rs-page-title">Programme guide</h1>
			<p
				id="epg-title"
				class="rs-meta">
				What's on right now and what's coming up across the active playlist's channels.
			</p>
		</header>

		<!-- Toolbar -->
		<section class="rs-epg__toolbar" aria-label="Guide controls">
			<a
				href="/livetv"
				aria-label="Back to Live TV"
				class="rs-epg__toolbtn">
				<IconArrowLeft aria-hidden="true" stroke={2} class="rs-epg__toolbtn-icon" />
				<span>Live TV</span>
			</a>
			<button
				id="epg-category-picker-trigger"
				type="button"
				aria-haspopup="dialog"
				aria-controls="epg-category-picker-dialog"
				class="rs-epg__toolbtn rs-epg__toolbtn--grow">
				<span class="rs-epg__toolbtn-label">Category</span>
				<span
					id="epg-category-picker-label"
					data-i18n="list.allCategories"
					class="rs-epg__toolbtn-value">All categories</span>
				<IconChevronDown
					aria-hidden="true"
					stroke={2}
					class="rs-epg__toolbtn-icon"
				/>
			</button>
			<button
				id="epg-prev-day"
				type="button"
				aria-label="Previous day"
				title="Previous day"
				class="rs-epg__toolbtn rs-epg__toolbtn--square">
				<IconChevronLeft aria-hidden="true" stroke={2} class="rs-epg__toolbtn-icon" />
			</button>
			<span
				id="epg-day-label"
				aria-live="polite"
				class="rs-epg__daylabel">
				Today
			</span>
			<button
				id="epg-next-day"
				type="button"
				aria-label="Next day"
				title="Next day"
				class="rs-epg__toolbtn rs-epg__toolbtn--square">
				<IconChevronRight aria-hidden="true" stroke={2} class="rs-epg__toolbtn-icon" />
			</button>
			<button
				id="epg-now"
				type="button"
				aria-label="Snap timeline to now"
				title="Snap to now"
				class="rs-epg__toolbtn">
				<IconClockHour3 aria-hidden="true" stroke={2} class="rs-epg__toolbtn-icon" />
				<span>Now</span>
			</button>
			<button
				id="epg-refresh"
				type="button"
				aria-label="Refresh EPG"
				class="rs-epg__toolbtn rs-epg__toolbtn--square">
				<IconRefresh aria-hidden="true" stroke={2} class="rs-epg__toolbtn-icon" />
			</button>
			<button
				id="epg-map-open"
				type="button"
				aria-haspopup="dialog"
				aria-controls="epg-map-dialog"
				aria-label="Manage EPG channel mapping"
				title="Manage EPG channel mapping"
				class="rs-epg__toolbtn">
				<IconLink aria-hidden="true" stroke={2} class="rs-epg__toolbtn-icon" />
				<span>Map channels</span>
			</button>
		</section>

		<TvEpgGrid />

		<CategoryPickerDialog idPrefix="epg-category-picker" showSyncToggle={true} />

		<!-- EPG channel-mapping dialog (Jellyfin-style manual map) -->
		<dialog
			id="epg-map-dialog"
			aria-labelledby="epg-map-title"
			class="rs-epg__dialog fixed inset-0 m-auto rounded-2xl border text-fg p-0
				w-[min(46rem,calc(100vw-2rem))] h-[min(85dvh,46rem)]
				backdrop:bg-black/60">
			<div class="flex flex-col h-full p-4 gap-3">
				<div class="flex items-center justify-between gap-3 shrink-0">
					<div class="flex flex-col gap-0.5 min-w-0">
						<h2 id="epg-map-title" data-i18n="epg.map.title" class="rs-epg__dialog-title">
							Map channels to EPG
						</h2>
						<span data-i18n="epg.map.help" class="text-xs text-fg-3 leading-relaxed">
							Each channel below is matched to an EPG entry by tvg-id. Use override to point a channel at a different EPG channel manually.
						</span>
					</div>
					<button
						id="epg-map-close"
						type="button"
						data-i18n="common.close"
						class="rounded-lg border border-line px-3 py-1.5 text-xs text-fg-2 shrink-0
							hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:border-accent">
						Close
					</button>
				</div>

				<SearchInput
					id="epg-map-search"
					label="Search channels"
					placeholder="Search channels…"
					labelKey="epg.map.search"
					placeholderKey="epg.map.searchPlaceholder"
				/>

				<div
					id="epg-map-filter"
					role="radiogroup"
					aria-label="Channel filter"
					data-i18n-attr="aria-label:epg.map.filterAria"
					class="flex p-0.5 rounded-lg border border-line bg-surface-2 text-xs shrink-0">
					<button
						type="button"
						role="radio"
						aria-checked="true"
						data-filter="all"
						data-i18n="epg.map.filterAll"
						class="flex-1 rounded-md px-3 py-1.5 font-medium transition-colors text-fg-2
							hover:text-fg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent
							aria-checked:bg-surface aria-checked:text-fg aria-checked:shadow-sm">
						All
					</button>
					<button
						type="button"
						role="radio"
						aria-checked="false"
						data-filter="unmapped"
						data-i18n="epg.map.filterUnmapped"
						class="flex-1 rounded-md px-3 py-1.5 font-medium transition-colors text-fg-2
							hover:text-fg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent
							aria-checked:bg-surface aria-checked:text-fg aria-checked:shadow-sm">
						Unmapped
					</button>
					<button
						type="button"
						role="radio"
						aria-checked="false"
						data-filter="auto"
						data-i18n="epg.map.filterAuto"
						class="flex-1 rounded-md px-3 py-1.5 font-medium transition-colors text-fg-2
							hover:text-fg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent
							aria-checked:bg-surface aria-checked:text-fg aria-checked:shadow-sm">
						Auto
					</button>
					<button
						type="button"
						role="radio"
						aria-checked="false"
						data-filter="overridden"
						data-i18n="epg.map.filterOverridden"
						class="flex-1 rounded-md px-3 py-1.5 font-medium transition-colors text-fg-2
							hover:text-fg focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent
							aria-checked:bg-surface aria-checked:text-fg aria-checked:shadow-sm">
						Overridden
					</button>
				</div>

				<div
					id="epg-map-list"
					class="relative flex-1 min-h-0 overflow-auto custom-scroll
						rounded-xl border border-line bg-bg">
				</div>

				<div
					id="epg-map-status"
					class="px-2 text-xs text-fg-3 tabular-nums shrink-0">
				</div>
			</div>
		</dialog>

		<!-- EPG tvg-id picker (opens from inside the mapping dialog) -->
		<dialog
			id="epg-pick-dialog"
			aria-labelledby="epg-pick-title"
			class="rs-epg__dialog fixed inset-0 m-auto rounded-2xl border text-fg p-0
				w-[min(40rem,calc(100vw-2rem))] h-[min(80dvh,42rem)]
				backdrop:bg-black/60">
			<div class="flex flex-col h-full p-4 gap-3">
				<div class="flex items-center justify-between gap-3 shrink-0">
					<div class="flex flex-col gap-0.5 min-w-0">
						<h2 id="epg-pick-title" data-i18n="epg.map.pickerTitle" class="rs-epg__dialog-title">
							Pick an EPG channel
						</h2>
						<span data-i18n="epg.map.pickerHelp" class="text-xs text-fg-3 leading-relaxed">
							Choose which XMLTV channel supplies programmes for this entry.
						</span>
					</div>
					<button
						id="epg-pick-close"
						type="button"
						data-i18n="common.close"
						class="rounded-lg border border-line px-3 py-1.5 text-xs text-fg-2 shrink-0
							hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:border-accent">
						Close
					</button>
				</div>

				<SearchInput
					id="epg-pick-search"
					label="Search EPG channels"
					placeholder="Search by name or tvg-id…"
					labelKey="epg.map.pickerSearch"
					placeholderKey="epg.map.pickerSearchPlaceholder"
				/>

				<div class="flex items-center gap-3 rounded-lg border border-line bg-surface-2 px-3 py-2 text-xs text-fg-3 shrink-0">
					<span id="epg-pick-current" class="truncate min-w-0 flex-1"></span>
					<button
						id="epg-pick-clear"
						type="button"
						data-i18n="epg.map.clearOverride"
						class="shrink-0 inline-flex items-center gap-1.5 rounded-md border border-line bg-bg px-2.5 py-1 text-xs text-fg-2
							hover:bg-surface hover:text-fg focus-visible:bg-surface hover:text-fg focus-visible:border-accent transition-colors
							disabled:opacity-50 disabled:cursor-not-allowed">
						Clear override
					</button>
				</div>

				<div
					id="epg-pick-list"
					class="relative flex-1 min-h-0 overflow-auto custom-scroll
						rounded-xl border border-line bg-bg">
				</div>

				<div
					id="epg-pick-status"
					class="px-2 text-xs text-fg-3 tabular-nums shrink-0">
				</div>
			</div>
		</dialog>
	</div>

	<style>
		.rs-epg {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			flex: 1;
			min-height: 0;
		}
		.rs-epg__head {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			flex-shrink: 0;
		}
		.rs-epg__toolbar {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			flex-wrap: wrap;
			flex-shrink: 0;
		}
		.rs-epg__toolbtn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			min-height: 3.5rem;
			padding: 0.625rem 1rem;
			border-radius: 0.75rem;
			border: 1px solid var(--rs-line);
			background: var(--rs-bg-2);
			color: var(--rs-text);
			font-size: 1.25rem;
			line-height: 1.2;
			cursor: pointer;
			white-space: nowrap;
		}
		.rs-epg__toolbtn:hover {
			background: var(--rs-surface-2);
		}
		.rs-epg__toolbtn--grow {
			flex: 1;
			min-width: 0;
			justify-content: flex-start;
			max-width: 22rem;
		}
		.rs-epg__toolbtn--square {
			padding-inline: 0.75rem;
		}
		.rs-epg__toolbtn-label {
			color: var(--rs-text-2);
			flex-shrink: 0;
		}
		.rs-epg__toolbtn-value {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			flex: 1;
			min-width: 0;
			text-align: left;
		}
		.rs-epg__toolbtn-icon {
			width: 1.25rem;
			height: 1.25rem;
			flex-shrink: 0;
		}
		.rs-epg__daylabel {
			font-size: 1.25rem;
			font-weight: 600;
			color: var(--rs-text-2);
			font-variant-numeric: tabular-nums;
			white-space: nowrap;
			padding-inline: 0.25rem;
			flex-shrink: 0;
		}
		/* Mapping + picker dialogs: RedSilk shell, serif titles,
		   layered wine shadow. Backdrop scrim stays black/60. Rows
		   inside the lists are rendered by mapping.ts at runtime. */
		.rs-epg__dialog {
			background: linear-gradient(180deg, var(--rs-surface) 0%, var(--rs-bg-2) 100%);
			border-color: var(--rs-line);
			color: var(--rs-text);
			box-shadow: var(--rs-shadow-lift);
		}
		.rs-epg__dialog-title {
			font-family: var(--rs-font-display);
			font-size: 1.75rem;
			font-weight: 400;
			letter-spacing: -0.01em;
			color: var(--rs-text);
		}
		/* Checked filter pill: warm halo, not just a flat fill. */
		#epg-map-filter [aria-checked="true"] {
			box-shadow:
				0 0 0 1px color-mix(in srgb, var(--rs-accent) 30%, transparent),
				0 0 0.875rem 1px color-mix(in srgb, var(--rs-accent) 20%, transparent);
		}
		/* Map/pick list rows are rendered at runtime; a focused row
		   inside them glows wine. */
		:global(#epg-map-list [tabindex]:focus-visible),
		:global(#epg-pick-list [tabindex]:focus-visible) {
			box-shadow:
				0 0 0 2px var(--rs-focus),
				0 0 1.25rem 0.25rem var(--rs-focus-glow);
		}
		@media (prefers-reduced-motion: reduce) {
			#epg-map-filter [aria-checked="true"] {
				box-shadow: none;
			}
		}
	</style>

	<script>
		import "../scripts/epg/epg.ts";
		import "../scripts/epg/mapping.ts";
	</script>
</CouchLayout>
