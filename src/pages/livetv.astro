---
// Live TV — RedSilk Couch rebuild (W3).
//
// CouchLayout shell + the W1 shared system. The data / playback wiring
// is unchanged and stays in stream.ts: this page keeps every DOM id
// stream.ts owns (player, channel list shell, EPG mini-panel, category
// picker, search/sort) and reskins the chrome around it.
//
// What this page adds on top of stream.ts:
//   - Favourites / Recently watched rails (TvRail shells; filled by
//     TvChannelList from the preferences store — never invented),
//   - the Live OSD (TvOsd shell): channel up/down, previous channel,
//     pause, mute, fullscreen, guide, quick channels, favourites,
//     audio / subtitle tracks, home — all dispatched through the
//     player's own keys / dialogs, never a reimplemented engine.
//     No seek UI: live streams have no seek to offer.
import CouchLayout from "@/layouts/CouchLayout.astro";
import SearchInput from "@/components/SearchInput.astro";
import SortMenu from "@/components/SortMenu.astro";
import CategoryPickerDialog from "@/components/CategoryPickerDialog.astro";
import WelcomeCard from "@/components/WelcomeCard.astro";
import TvChannelList from "@/components/couch/TvChannelList.astro";
import TvRail from "@/components/couch/TvRail.astro";
import TvDialog from "@/components/couch/TvDialog.astro";
import TvOsd from "@/components/couch/TvOsd.astro";
import { IconDeviceTv, IconChevronDown, IconCalendarTime, IconLayoutGrid } from "@tabler/icons-svelte";
---

<CouchLayout pageTitle="Live TV" view="livetv">
	<script is:inline>
		try {
			var raw = localStorage.getItem("xt_playlists") || "";
			var hasEntries = false;
			if (raw) {
				var parsed = JSON.parse(raw);
				hasEntries = !!(
					parsed &&
					Array.isArray(parsed.entries) &&
					parsed.entries.length
				);
			}
			if (!hasEntries) {
				document.documentElement.setAttribute("data-first-run", "true");
			}
		} catch (e) {}
	</script>

	<div class="rs-livetv">
		<header class="rs-livetv__head">
			<h1 class="rs-page-title">Live TV</h1>
			<p class="rs-meta">Live channels from your playlist — pick a channel to start watching.</p>
		</header>

		<section
			id="livetv-welcome"
			aria-labelledby="welcome-heading"
			class="rs-livetv__welcome hidden flex-1 min-h-0 items-center justify-center py-6">
			<WelcomeCard />
		</section>

		<div
			id="livetv-main"
			class="rs-livetv__main">

			<!-- Channel browser (left column) -->
			<aside class="rs-livetv__browser" aria-label="Channel browser">
				<div class="rs-livetv__panel">
					<div class="rs-livetv__toolbar">
						<button
							id="category-picker-trigger"
							type="button"
							aria-haspopup="dialog"
							aria-controls="category-picker-dialog"
							class="rs-livetv__toolbtn rs-livetv__toolbtn--grow">
							<span class="rs-livetv__toolbtn-label">Category</span>
							<span
								id="category-picker-label"
								data-i18n="list.allCategories"
								class="rs-livetv__toolbtn-value">All categories</span>
							<IconChevronDown
								aria-hidden="true"
								stroke={2}
								class="rs-livetv__toolbtn-icon"
							/>
						</button>
						<button
							id="epg-toggle"
							type="button"
							aria-pressed="true"
							aria-label="Show EPG for the current channel"
							title="Show EPG"
							class="rs-livetv__toolbtn">
							<IconCalendarTime
								aria-hidden="true"
								stroke={2}
								class="rs-livetv__toolbtn-icon"
							/>
							<span>EPG</span>
						</button>
						<a
							href="/epg"
							aria-label="Open the full EPG schedule grid"
							title="Open schedule grid"
							class="rs-livetv__toolbtn">
							<IconLayoutGrid
								aria-hidden="true"
								stroke={2}
								class="rs-livetv__toolbtn-icon"
							/>
							<span>Guide</span>
						</a>
					</div>

					<div class="rs-livetv__searchrow">
						<div class="rs-livetv__search">
							<SearchInput
								id="search"
								label="Search channels"
								placeholder="Search channels…"
								clearButtonId="clear-search"
								labelKey="list.searchChannels"
								placeholderKey="list.searchChannelsPlaceholder"
								clearKey="common.clear"
								inputClass="rs-livetv__search-input"
							/>
						</div>
						<SortMenu
							id="channel-sort"
							widthClass="w-40 shrink-0"
							options={[
								{ value: "default", label: "Source order", key: "sort.sourceOrder" },
								{ value: "number", label: "Channel number", key: "sort.channelNumber" },
								{ value: "az", label: "A-Z", key: "sort.az" },
								{ value: "za", label: "Z-A", key: "sort.za" },
								{ value: "cataz", label: "Category, A-Z", key: "sort.categoryAz" },
							]}
						/>
					</div>

					<TvChannelList />
				</div>
			</aside>

			<!-- Player + EPG (right column) -->
			<section class="rs-livetv__playercol" aria-label="Player">
				<div class="rs-livetv__panel">
					<div
						id="player-wrap"
						class="player-wrap relative aspect-video w-full mx-auto overflow-hidden bg-black flex items-center justify-center shrink-0">
						<div
							id="player-empty"
							class="nylah-art-backdrop--player-empty absolute inset-0 flex flex-col items-center justify-center gap-6 text-center px-6 pointer-events-none">
							<div class="player-empty-glow" aria-hidden="true"></div>
							<IconDeviceTv
								aria-hidden="true"
								stroke={0.6}
								class="size-24 sm:size-28 lg:size-36 text-fg-3/55 relative z-10"
							/>
							<div class="flex flex-col gap-2.5 relative z-10">
								<span class="inline-flex items-center gap-2 self-center text-eyebrow font-semibold uppercase tracking-[0.22em] text-fg-3">
									<span aria-hidden="true" class="size-1.5 rounded-full bg-accent shadow-[0_0_0_4px_var(--color-accent-soft)]"></span>
									<span data-i18n="livetv.idle">Idle</span>
								</span>
								<p data-i18n="livetv.pickChannel" class="font-serif text-fg leading-[0.95] tracking-[-0.03em] font-bold"
									style="font-size: clamp(1.75rem, 3vw + 1rem, 3.5rem);">
									Pick a channel.
								</p>
								<p data-i18n="livetv.pickChannelHelper" class="text-fg-3 text-xs sm:text-sm">
									Choose from the list, or change category.
								</p>
							</div>
						</div>
						<video
							id="player"
							class="video-js vjs-default-skin vjs-big-play-centered h-full w-full"
							controls
							hidden
							playsinline></video>
						<div
							id="radio-display"
							class="radio-display max-[480px]:flex-col max-[480px]:text-center max-[480px]:items-center"
							aria-hidden="true">
							<div
								class="radio-display__art relative shrink-0 aspect-square rounded-2xl bg-surface-2 overflow-hidden"
								data-radio-art>
								<div class="radio-display__art-fallback absolute inset-0 grid place-items-center" aria-hidden="true">
									<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 17a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M13 17a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"/><path d="M9 17v-13h10v13"/><path d="M9 8h10"/></svg>
								</div>
								<img
									alt=""
									decoding="async"
									referrerpolicy="no-referrer"
									data-radio-cover
									class="absolute inset-0 w-full h-full object-contain p-3 opacity-0 data-[loaded=true]:opacity-100 transition-opacity duration-240 ease-[cubic-bezier(0.16,1,0.3,1)]" />
							</div>
							<div class="radio-display__meta flex flex-col gap-2 min-w-0 flex-1 pb-14 max-[480px]:items-center max-[480px]:pb-16">
								<span
									class="radio-display__eyebrow inline-flex items-center gap-2 text-fg-3 text-[0.625rem] font-semibold uppercase tracking-[0.22em]"
									data-i18n="livetv.radioEyebrow"
								>On air · Radio</span>
								<p
									class="radio-display__name text-fg font-bold tracking-tight leading-tight min-w-0 line-clamp-2 text-[clamp(1.5rem,3vw,2.25rem)]"
									data-radio-name>-</p>
								<p
									class="radio-display__nowplaying text-fg-2 text-sm m-0 min-w-0 line-clamp-2"
									data-radio-nowplaying
									hidden></p>
								<p
									class="radio-display__desc text-fg-3 text-sm m-0 min-w-0 line-clamp-1 max-[480px]:hidden"
									data-radio-desc
									hidden></p>
								<div
									class="radio-display__meta-row flex flex-wrap items-center gap-x-3 gap-y-2 mt-1 max-[480px]:justify-center"
									data-radio-metarow
									hidden>
									<span class="radio-tags flex flex-wrap items-center gap-2" data-radio-tags></span>
									<span
										class="radio-elapsed inline-flex items-center gap-1.5 text-fg-3 text-xs"
										data-radio-elapsed
										hidden>
										<span data-i18n="livetv.radioListening">Listening</span>
										<span class="tabular-nums text-fg-2" data-radio-elapsed-time>0:00</span>
									</span>
								</div>
							</div>
						</div>

						<!-- Live OSD (TvOsd shell): channel / transport /
						     guide / track controls over the picture.
						     Auto-hides on inactivity; never hides under
						     focus. No seek — live streams have no seek. -->
						<TvOsd autoHideMs={4500}>
							<div slot="info" class="rs-livetv-osd__info">
								<h3 class="rs-osd__title" data-osd-title>Live TV</h3>
								<p class="rs-osd__subtitle" data-osd-subtitle>Pick a channel to start watching.</p>
								<div
									class="rs-livetv-osd__progress"
									data-osd-progress
									hidden>
									<span class="rs-livetv-osd__progress-fill" data-osd-progress-fill style="width: 0%"></span>
								</div>
							</div>
							<p class="rs-livetv-osd__hints">
								X pause · Y fullscreen · [ ] change channel · G guide · C channels
							</p>
							<div slot="controls" class="rs-livetv-osd__controls">
								<button type="button" class="rs-osd__btn" data-osd-action="channel-down" aria-label="Previous channel">‹ Ch</button>
								<button type="button" class="rs-osd__btn" data-osd-action="pause-toggle" aria-label="Pause or resume">⏯ Pause</button>
								<button type="button" class="rs-osd__btn" data-osd-action="channel-up" aria-label="Next channel">Ch ›</button>
								<button type="button" class="rs-osd__btn" data-osd-action="previous-channel" aria-label="Return to the previous channel">↩ Last</button>
								<button type="button" class="rs-osd__btn" data-osd-action="guide" aria-label="Open the programme guide">Guide</button>
								<button type="button" class="rs-osd__btn" data-osd-action="channels" aria-label="Open the quick channel list">Channels</button>
								<button type="button" class="rs-osd__btn" data-osd-action="favourites" aria-label="Show favourite channels">★ Favourites</button>
								<button type="button" class="rs-osd__btn" data-osd-action="mute" aria-label="Mute or unmute">Mute</button>
								<button type="button" class="rs-osd__btn" data-osd-action="fullscreen" aria-label="Toggle fullscreen">Fullscreen</button>
								<button type="button" class="rs-osd__btn" data-osd-action="audio" aria-label="Audio tracks">Audio</button>
								<button type="button" class="rs-osd__btn" data-osd-action="subtitles" aria-label="Subtitles">Subtitles</button>
								<button type="button" class="rs-osd__btn" data-osd-action="home" aria-label="Return to NylahBox Studios Home">Home</button>
							</div>
						</TvOsd>
					</div>

					<div
						id="current"
						class="flex items-center justify-between gap-2 px-1 text-base text-fg-2 shrink-0">
						<div class="flex items-center gap-2 min-w-0">
							<span data-i18n="livetv.statusOff" class="status-badge status-badge--off shrink-0">OFF</span>
							<span class="truncate">-</span>
						</div>
					</div>

					<div id="current-nownext" class="shrink-0 px-1" hidden>
						<div class="flex items-baseline gap-2 min-w-0">
							<span
								data-nownext-eyebrow
								class="text-xs font-bold uppercase tracking-[0.18em] text-accent shrink-0">Now</span>
							<span
								data-nownext-title
								class="truncate min-w-0 flex-1 font-serif text-xl leading-tight text-fg"></span>
							<span
								data-nownext-time
								class="text-sm text-fg-3 tabular-nums shrink-0"></span>
						</div>
						<div
							data-nownext-barwrap
							class="mt-1.5 h-1.5 rounded-full bg-surface-3 overflow-hidden"
							hidden>
							<div
								data-nownext-fill
								class="h-full rounded-full bg-accent transition-[width] duration-500"
								style="width: 0%"></div>
						</div>
						<div
							data-nownext-next
							class="mt-1 truncate text-sm text-fg-3"></div>
					</div>

					<div
						id="epg"
						data-epg-collapsed="true"
						class="border-t overflow-auto custom-scroll min-h-44 lg:flex-1 lg:min-h-56">
						<div class="flex items-center justify-between gap-2 text-sm font-medium text-fg sticky top-0 pt-3 pb-2 z-10">
							<span data-i18n="livetv.epgPanelHeading" class="ps-1">EPG</span>
							<div class="flex items-center gap-1 pe-1">
								<span id="epg-day-indicator" class="text-2xs font-semibold uppercase tracking-wide text-fg-3"></span>
								<button
									id="epg-expand-toggle"
									type="button"
									aria-expanded="false"
									aria-label="Show full guide"
									data-label-expand="Show full guide"
									data-label-collapse="Show now playing only"
									class="group lg:hidden -my-1.5 inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg text-fg-3
										hover:bg-surface-2 hover:text-fg focus-visible:bg-surface-2 focus-visible:text-fg
										outline-none focus-visible:ring-1 focus-visible:ring-accent
										transition-colors">
									<IconChevronDown
										aria-hidden="true"
										stroke={2}
										class="size-4 transition-transform duration-200 group-aria-expanded:rotate-180"
									/>
								</button>
							</div>
						</div>
						<div id="epg-list" class="space-y-2 text-sm px-1 pb-3"></div>
					</div>
				</div>
			</section>
		</div>

		<!-- Favourites / Recently watched rails (filled by TvChannelList
		     from the preferences store; hidden when empty). -->
		<TvRail id="livetv-favourites" title="Favourites" />
		<TvRail id="livetv-recents" title="Recently watched" />

		<CategoryPickerDialog idPrefix="category-picker" />
	</div>

	<!-- OSD dialogs: quick channels (real favourites / recents only),
	     audio + subtitle tracks (read live off the <video> element). -->
	<TvDialog id="livetv-quick-channels" title="Channels">
		<div class="rs-livetv-dialog">
			<h3 class="rs-livetv-dialog__sub">Favourites</h3>
			<div data-couch-quick-list="favourites"></div>
			<h3 class="rs-livetv-dialog__sub">Recently watched</h3>
			<div data-couch-quick-list="recents"></div>
			<button
				type="button"
				class="rs-hero__action rs-hero__action--secondary"
				data-livetv-show-all>
				Show all channels
			</button>
		</div>
	</TvDialog>

	<TvDialog id="livetv-audio" title="Audio">
		<div class="rs-livetv-dialog">
			<p class="rs-livetv-dialog__note">Audio tracks on the current stream. The player's own control bar carries the same choice.</p>
			<div data-audio-list></div>
			<button
				type="button"
				class="rs-hero__action rs-hero__action--secondary"
				data-osd-action="mute">
				Mute / unmute
			</button>
		</div>
	</TvDialog>

	<TvDialog id="livetv-subtitles" title="Subtitles">
		<div class="rs-livetv-dialog">
			<p class="rs-livetv-dialog__note">Subtitle tracks on the current stream. The player's own control bar carries the same choice.</p>
			<div data-subtitle-list></div>
		</div>
	</TvDialog>

	<style>
		html[data-first-run="true"] #livetv-main { display: none; }
		html[data-first-run="true"] #livetv-welcome { display: flex; }
		html[data-first-run="true"] .rs-livetv__head { display: none; }

		.rs-livetv {
			display: flex;
			flex-direction: column;
			gap: 2rem;
			min-height: 0;
			flex: 1;
		}
		.rs-livetv__head {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.rs-livetv__main {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			flex: 1;
			min-height: 0;
		}
		@media (min-width: 1024px) {
			.rs-livetv__main {
				flex-direction: row;
			}
		}
		/* Browser column: fixed width on desktop, full width below. */
		.rs-livetv__browser {
			flex-shrink: 0;
			min-width: 0;
		}
		@media (min-width: 1024px) {
			.rs-livetv__browser {
				width: 30rem;
			}
		}
		.rs-livetv__playercol {
			flex: 1;
			min-width: 0;
			min-height: 0;
		}
		/* Panels: warm RedSilk gradient, soft line, layered shadow. */
		.rs-livetv__panel {
			background: linear-gradient(180deg, var(--rs-surface) 0%, var(--rs-bg-2) 100%);
			border: 1px solid var(--rs-line);
			border-radius: 1.25rem;
			box-shadow: var(--rs-shadow);
			padding: 1rem;
			height: 100%;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			min-height: 0;
		}
		.rs-livetv__toolbar {
			display: flex;
			gap: 0.75rem;
			flex-shrink: 0;
		}
		.rs-livetv__toolbtn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.5rem;
			min-height: 3.5rem;
			padding: 0.625rem 1rem;
			border-radius: 0.75rem;
			border: 1px solid var(--rs-line);
			background: var(--rs-bg-2);
			color: var(--rs-text);
			font-size: 1.25rem;
			line-height: 1.2;
			cursor: pointer;
			white-space: nowrap;
		}
		.rs-livetv__toolbtn:hover {
			background: var(--rs-surface-2);
		}
		.rs-livetv__toolbtn--grow {
			flex: 1;
			min-width: 0;
			justify-content: flex-start;
		}
		.rs-livetv__toolbtn-label {
			color: var(--rs-text-2);
			flex-shrink: 0;
		}
		.rs-livetv__toolbtn-value {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			flex: 1;
			min-width: 0;
			text-align: left;
		}
		.rs-livetv__toolbtn-icon {
			width: 1.25rem;
			height: 1.25rem;
			flex-shrink: 0;
		}
		.rs-livetv__toolbtn[aria-pressed="true"] {
			border-color: var(--rs-accent);
			background: var(--rs-surface-2);
		}
		.rs-livetv__searchrow {
			display: flex;
			gap: 0.75rem;
			flex-shrink: 0;
			align-items: flex-start;
		}
		.rs-livetv__search {
			flex: 1;
			min-width: 0;
		}
		/* Couch-sized search field (SearchInput takes the extra class). */
		:global(.rs-livetv__search-input) {
			min-height: 3.5rem !important;
			font-size: 1.25rem !important;
			padding-left: 2.75rem !important;
		}
		:global(#clear-search) {
			min-height: 3.5rem !important;
			font-size: 1.125rem !important;
			padding-inline: 1rem !important;
		}
		/* Couch-sized sort select. */
		:global(#channel-sort select) {
			min-height: 3.5rem;
			font-size: 1.25rem;
			background: var(--rs-bg-2);
			border-color: var(--rs-line);
			color: var(--rs-text);
			border-radius: 0.75rem;
		}
		/* Rails hide when the client fill finds nothing — .rs-rail sets
		   display:flex, which beats the UA [hidden] rule without this. */
		:global([data-nylah-rail="livetv-favourites"][hidden]),
		:global([data-nylah-rail="livetv-recents"][hidden]) {
			display: none;
		}

		/* Player caps (v0.2.2 rule, preserved): on desktop/landscape
		   the player is capped at 46dvh so the EPG panel below it keeps
		   real room; portrait/mobile keeps 60dvh and the page scrolls. */
		.player-wrap {
			max-height: 60dvh;
			max-width: calc(60dvh * 16 / 9);
			border-radius: 1rem;
			border: 1px solid var(--rs-line);
		}
		@media (min-width: 1024px), (min-width: 768px) and (orientation: landscape) {
			.player-wrap {
				max-height: 46dvh;
				max-width: calc(46dvh * 16 / 9);
			}
		}

		/* Radio mode (structure preserved from the classic page). */
		.radio-display { display: none; }
		.player-wrap[data-radio-mode="on"] {
			aspect-ratio: auto;
			max-height: none;
			max-width: 100%;
			height: auto;
			min-height: clamp(14rem, 28dvh, 22rem);
			background:
				radial-gradient(
					120% 80% at 50% 0%,
					color-mix(in srgb, var(--rs-accent) 24%, transparent) 0%,
					transparent 60%
				),
				linear-gradient(180deg, var(--rs-surface-2), var(--rs-surface));
			padding: clamp(1rem, 3vw, 2rem);
			gap: clamp(1rem, 3vw, 2rem);
			justify-content: flex-start;
		}
		.player-wrap[data-radio-mode="on"] #player-empty { display: none !important; }
		.player-wrap[data-radio-mode="on"] .radio-display {
			display: flex;
			align-items: center;
			gap: clamp(1rem, 3vw, 2rem);
			width: 100%;
			min-width: 0;
		}
		.player-wrap[data-radio-mode="on"] :global(.video-js),
		.player-wrap[data-radio-mode="on"] :global(#player),
		.player-wrap[data-radio-mode="on"] :global(.art-video-player) {
