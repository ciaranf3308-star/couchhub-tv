		}
		.radio-display__art {
			width: clamp(7rem, 16vw, 11rem);
			box-shadow:
				0 0 0 1px var(--rs-line),
				0 0 40px 8px color-mix(in srgb, var(--rs-accent) 38%, transparent),
				var(--rs-shadow);
		}
		.radio-display__art-fallback {
			color: color-mix(in srgb, var(--rs-text-2) 80%, transparent);
		}
		.radio-display__eyebrow::before {
			content: "";
			width: 0.375rem;
			height: 0.375rem;
			border-radius: 999px;
			background: var(--rs-accent);
			animation: radio-onair-pulse 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite;
		}
		@keyframes radio-onair-pulse {
			0%        { box-shadow: 0 0 0 0 color-mix(in srgb, var(--rs-accent) 45%, transparent); }
			70%, 100% { box-shadow: 0 0 0 0.5rem transparent; }
		}
		@media (prefers-reduced-motion: reduce) {
			.radio-display__eyebrow::before {
				animation: none;
				box-shadow: 0 0 0 4px color-mix(in srgb, var(--rs-accent) 30%, transparent);
			}
		}
		@media (max-width: 480px) {
			.player-wrap[data-radio-mode="on"] {
				flex-direction: column;
				padding: 1rem;
			}
		}

		/* Collapsed mobile EPG shows only the now-playing row. */
		@media (max-width: 767.98px), (max-width: 1023.98px) and (orientation: portrait) {
			:global(#epg[data-epg-collapsed="true"] #epg-list > :is([data-epg-idx]:not([data-now-playing="true"]), .epg-day-sep, [data-epg-load-earlier])) {
				display: none;
			}
		}

		/* Channel rows (rendered by stream.ts, so :global()): couch
		   type, fitted 3rem logos, glowing focus, warm now-playing
		   row. Row height itself is stream.ts's (root font-size ×
		   density — 68px at 16px root, 59px in headless where the
		   window is shorter) — never overridden, or the virtual
		   list desyncs. The row content MUST fit inside it, so the
		   stack is budgeted: 4px button padding + 20px name +
		   (16px meta OR 22px now-line + 4px progress bar). When a
		   now/next line is present the meta line ("#n · category")
		   is hidden — it is the only expendable line, and the
		   channel number still shows on rows without EPG data. */
		:global(#list .channel-row .play-btn) {
			gap: 0.75rem;
			padding-block: 2px;
		}
		:global(#list .channel-row .play-btn > .logo-skel) {
			width: 3rem;
			height: 3rem;
		}
		:global(#list .channel-row .play-btn .text-sm) {
			font-size: 1.25rem;
		}
		:global(#list .channel-row .play-btn .text-xs) {
			font-size: 1.125rem;
		}
		:global(#list .channel-row:has(.channel-now-slot:not(:empty)) .play-btn .text-xs) {
			display: none;
		}
		:global(#list .channel-row .channel-now) {
			font-size: 1.125rem;
			margin-top: 2px;
		}
		:global(#list .channel-row .channel-now-bar) {
			height: 2px;
			margin-top: 2px;
		}
		:global(#list .channel-row .star-btn) {
			width: 3rem;
			height: 3rem;
			font-size: 1.5rem;
		}
		:global(#list .channel-row .play-btn:focus-visible) {
			box-shadow:
				0 0 0 2px var(--rs-focus),
				0 0 2rem 0.25rem var(--rs-focus-glow);
			background: var(--rs-surface);
		}
		:global(#list .channel-row[data-now-playing="true"] .play-btn) {
			background: linear-gradient(
				90deg,
				color-mix(in srgb, var(--rs-accent) 16%, transparent),
				color-mix(in srgb, var(--rs-accent) 5%, transparent)
			);
			box-shadow:
				inset 3px 0 0 var(--rs-accent),
				0 0 1.25rem 0.125rem color-mix(in srgb, var(--rs-accent) 22%, transparent);
		}
		:global(#list .channel-row[data-now-playing="true"] .play-btn:focus-visible) {
			box-shadow:
				inset 3px 0 0 var(--rs-accent),
				0 0 0 2px var(--rs-focus),
				0 0 2rem 0.25rem var(--rs-focus-glow);
		}
		/* Bigger status badge + serif channel line under the player. */
		:global(#current .status-badge) {
			height: 2rem;
			width: 2rem;
			font-size: 0.75rem;
		}
		:global(#current .status-badge--catchup) {
			width: auto;
			padding-inline: 0.625rem;
		}
		:global(#current .text-accent) {
			font-family: var(--rs-font-display);
			font-size: 1.5rem;
			letter-spacing: -0.01em;
		}
		:global(#current .status-badge--live),
		:global(#current .status-badge--on) {
			box-shadow:
				0 0 0 3px color-mix(in srgb, var(--rs-accent) 18%, transparent),
				0 0 1.125rem 0.125rem var(--rs-focus-glow);
		}
		/* Now/next strip: wine progress, warm track, couch type. */
		:global(#current-nownext [data-nownext-title]) {
			font-size: 1.5rem;
		}
		:global(#current-nownext [data-nownext-time]),
		:global(#current-nownext [data-nownext-next]) {
			font-size: 1.125rem;
		}
		:global(#current-nownext [data-nownext-fill]) {
			background: linear-gradient(90deg, var(--rs-accent), var(--rs-focus));
		}
		:global(#current-nownext [data-nownext-barwrap]) {
			background: color-mix(in srgb, var(--rs-accent) 22%, transparent);
		}
		/* EPG side-panel rows: focused rows glow wine, the
		   now-playing row carries a warm tint + accent edge. */
		:global(#epg-list .epg-entry:focus-visible) {
			box-shadow:
				0 0 0 2px var(--rs-focus),
				0 0 2rem 0.25rem var(--rs-focus-glow);
		}
		:global(#epg-list .epg-entry[data-now-playing="true"]) {
			background: linear-gradient(
				90deg,
				color-mix(in srgb, var(--rs-accent) 14%, transparent),
				color-mix(in srgb, var(--rs-accent) 4%, transparent)
			);
			box-shadow:
				0 0 0 1px color-mix(in srgb, var(--rs-accent) 55%, transparent),
				0 0 1.25rem 0.125rem color-mix(in srgb, var(--rs-accent) 25%, transparent);
		}
		:global(#epg-list .epg-entry[data-now-playing="true"]:focus-visible) {
			box-shadow:
				0 0 0 2px var(--rs-focus),
				0 0 2rem 0.25rem var(--rs-focus-glow);
		}
		:global(#epg) {
			border-color: var(--rs-line);
		}
		:global(#epg .sticky) {
			background: var(--rs-bg-2);
		}
		/* Empty state: the glow is the room's warm lamp. */
		.player-empty-glow {
			background: radial-gradient(
				50% 60% at 50% 55%,
				color-mix(in srgb, var(--rs-focus) 30%, transparent) 0%,
				color-mix(in srgb, var(--rs-accent) 14%, transparent) 45%,
				transparent 80%
			);
			opacity: 0.85;
		}
		#player-empty.nylah-art-backdrop--player-empty {
			background-image: var(--nylah-art-player-empty);
			background-size: cover;
			background-position: center;
		}
		#player-empty.nylah-art-backdrop--player-empty::after {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				to top,
				color-mix(in srgb, var(--rs-bg) 78%, transparent) 0%,
				transparent 60%
			);
		}
		@media (prefers-reduced-motion: reduce) {
			.player-empty-glow {
				animation: none;
				opacity: 0.7;
			}
		}

		/* OSD extras: programme progress + controller hints + the
		   wrapping controls row. The TvOsd shell owns the auto-hide. */
		.rs-livetv-osd__info {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			min-width: 0;
		}
		.rs-livetv-osd__progress {
			height: 0.375rem;
			border-radius: 999px;
			background: color-mix(in srgb, var(--rs-text) 22%, transparent);
			overflow: hidden;
			margin-top: 0.5rem;
			max-width: 28rem;
		}
		.rs-livetv-osd__progress-fill {
			display: block;
			height: 100%;
			background: linear-gradient(90deg, var(--rs-accent), var(--rs-focus));
		}
		.rs-livetv-osd__hints {
			font-size: 1.125rem;
			color: var(--rs-text-2);
			margin: 0;
		}
		.rs-livetv-osd__controls {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
		}
		/* OSD dialogs. */
		.rs-livetv-dialog {
			display: flex;
			flex-direction: column;
			gap: 1rem;
		}
		.rs-livetv-dialog__sub {
			font-family: var(--rs-font-display);
			font-size: 1.75rem;
			font-weight: 400;
			margin: 0;
		}
		.rs-livetv-dialog__note {
			font-size: 1.25rem;
			color: var(--rs-text-2);
			margin: 0;
		}
		:global([data-audio-list] .rs-quicklist__row),
		:global([data-subtitle-list] .rs-quicklist__row) {
			cursor: pointer;
		}
		:global([data-audio-list] .rs-quicklist__row[aria-pressed="true"]),
		:global([data-subtitle-list] .rs-quicklist__row[aria-pressed="true"]) {
			border-color: var(--rs-accent);
			background: var(--rs-surface);
		}
	</style>

	<script>
		import "../scripts/stream/stream.ts";
		import "../scripts/updater-startup.js";
		import { mountPauseOverlay } from "../scripts/lib/pause-overlay.ts";
		import { goCouch } from "../scripts/lib/couch-nav.ts";
		import { openCouchDialog } from "../scripts/lib/couch-focus.ts";
		import {
			isOsdOwnedKey,
			livetvOsdActionForKey,
		} from "../scripts/lib/couch-livetv-epg.ts";

		const playerEl = document.getElementById("player");
		const playerEmpty = document.getElementById("player-empty");
		if (playerEl && playerEmpty) {
			const sync = () => {
				playerEmpty.style.display = playerEl.hasAttribute("hidden") ? "" : "none";
			};
			sync();
			new MutationObserver(sync).observe(playerEl, {
				attributes: true,
				attributeFilter: ["hidden"],
			});
		}

		// Pause overlay — big transport hub over the picture. Title /
		// subtitle read text already on the page (channel name in
		// #current, now-playing row in the EPG side panel); nothing is
		// fetched or invented here.
		const playerWrap = document.getElementById("player-wrap");
		if (playerWrap) {
			mountPauseOverlay({
				wrap: playerWrap,
				getTitle: () =>
					document.querySelector("#current .text-accent")?.textContent?.trim() ||
					document.querySelector("#current .truncate")?.textContent?.trim() ||
					"",
				getSubtitle: () => {
					const row = document.querySelector(
						'#epg-list [data-now-playing="true"]'
					);
					if (!row) return "";
					const title =
						row.querySelector('[data-role="epg-title"]')?.textContent?.trim() || "";
					const time =
						row.querySelector('[data-role="epg-time"]')?.textContent?.trim() || "";
					return [title, time].filter(Boolean).join(" · ");
				},
				getBadge: () => {
					const badge =
						document.querySelector("#current .status-badge")?.textContent?.trim() ||
						"";
					if (!badge || badge === "ON" || badge === "OFF") return null;
					return badge;
				},
				isSuppressed: () => playerWrap.dataset.radioMode === "on",
				isPlayerVisible: () =>
					!!playerEl && !playerEl.hasAttribute("hidden"),
			});
		}

		// ── Live OSD ────────────────────────────────────────────
		// The OSD never reimplements tuning or transport: channel /
		// pause / mute / fullscreen buttons dispatch the same keys
		// stream.ts already handles ("]" / "[" / "\" / space / "m" /
		// "f"), so the player does the work. Guide / home navigate
		// through couch-nav; favourites filters through the category
		// picker's own "xt:cat-changed" contract (detail carries the
		// pseudo-category, which is what updates the picker's label).
		const osd = document.querySelector("[data-couch-osd]");
		const dispatchPlayerKey = (key) => {
			document.dispatchEvent(
				new KeyboardEvent("keydown", {
					key,
					code: key,
					bubbles: true,
					cancelable: true,
				}),
			);
		};
		const hideOsd = () => {
			if (osd) osd.setAttribute("data-hidden", "true");
		};
		const showOsd = () => {
			window.dispatchEvent(new Event("couch-osd:show"));
		};
		// The TvOsd shell re-shows on its own activity listeners and
		// on the couch-osd:show window event. A hidden OSD has
		// pointer-events:none, so pointer movement over the picture
		// would never reach it: the player wrap forwards activity
		// (pointer / keys while focus is on the player) as
		// couch-osd:show, which is the shell's documented re-show
		// path. Activity in the channel list does not bubble through
		// the wrap, so browsing never pops the OSD up.
		if (playerWrap) {
			for (const evt of ["pointermove", "pointerdown", "keydown"]) {
				playerWrap.addEventListener(evt, showOsd, { passive: true });
			}
		}

		// OSD info mirrors the channel line + now/next strip stream.ts
		// already paints — real text, copied, never invented.
		const osdTitle = document.querySelector("[data-osd-title]");
		const osdSubtitle = document.querySelector("[data-osd-subtitle]");
		const osdProgress = document.querySelector("[data-osd-progress]");
		const osdProgressFill = document.querySelector("[data-osd-progress-fill]");
		const syncOsdInfo = () => {
			const title =
				document.querySelector("#current .text-accent")?.textContent?.trim() ||
				document.querySelector("#current .truncate")?.textContent?.trim() ||
				"";
			if (osdTitle) osdTitle.textContent = title || "Live TV";
			const nowTitle = document
				.querySelector("[data-nownext-title]")
				?.textContent?.trim() || "";
			const nowTime = document
				.querySelector("[data-nownext-time]")
				?.textContent?.trim() || "";
			const nextLine = document
				.querySelector("[data-nownext-next]")
				?.textContent?.trim() || "";
			if (osdSubtitle) {
				osdSubtitle.textContent =
					[nowTitle, nowTime].filter(Boolean).join(" · ") ||
					nextLine ||
					(title ? "Pick a channel to start watching." : "");
			}
			const fill = document.querySelector("[data-nownext-fill]");
			const width = fill ? fill.style.width || "" : "";
			if (osdProgress && osdProgressFill) {
				if (width && width !== "0%") {
					osdProgress.removeAttribute("hidden");
					osdProgressFill.style.width = width;
				} else {
					osdProgress.setAttribute("hidden", "");
				}
			}
		};
		syncOsdInfo();
		const osdMirrorTargets = [
			document.getElementById("current"),
			document.getElementById("current-nownext"),
		].filter(Boolean);
		if (osdMirrorTargets.length) {
			const observer = new MutationObserver(syncOsdInfo);
			for (const target of osdMirrorTargets) {
				observer.observe(target, {
					subtree: true,
					childList: true,
					characterData: true,
					attributes: true,
					attributeFilter: ["style", "hidden"],
				});
			}
		}

		// Audio / subtitle tracks are read live off the <video>
		// element inside the player wrap (the player's own tech
		// element) — the same tracks its control bar offers. When a
		// stream carries no alternate tracks, the dialog says so
		// instead of inventing entries.
		const playerVideo = () =>
			playerWrap?.querySelector("video");
		const trackRow = (label, active, onSelect) => {
			const row = document.createElement("button");
			row.type = "button";
			row.className = "rs-quicklist__row";
			row.setAttribute("aria-pressed", String(active));
			const name = document.createElement("span");
			name.className = "rs-quicklist__name";
			name.textContent = label;
			const hint = document.createElement("span");
			hint.className = "rs-quicklist__hint";
			hint.textContent = active ? "Active" : "Select";
			row.append(name, hint);
			row.addEventListener("click", onSelect);
			return row;
		};
		const emptyTrackNote = (mount, text) => {
			const note = document.createElement("p");
			note.className = "rs-quicklist__empty";
			note.textContent = text;
			mount.appendChild(note);
		};
		const fillAudioTracks = () => {
			const mount = document.querySelector("[data-audio-list]");
			if (!mount) return;
			mount.replaceChildren();
			const video = playerVideo();
			const tracks = video?.audioTracks;
			if (!tracks || tracks.length === 0) {
				emptyTrackNote(
					mount,
					"No alternate audio tracks on this stream — the current audio is the only one available.",
				);
				return;
			}
			for (const track of Array.from(tracks)) {
				mount.appendChild(
					trackRow(
						track.label || track.language || "Audio track",
						!!track.enabled,
						() => {
							for (const other of Array.from(tracks)) {
								other.enabled = other === track;
							}
							fillAudioTracks();
						},
					),
				);
			}
		};
		const fillSubtitleTracks = () => {
			const mount = document.querySelector("[data-subtitle-list]");
			if (!mount) return;
			mount.replaceChildren();
			const video = playerVideo();
			const tracks = video?.textTracks;
			if (!tracks || tracks.length === 0) {
				emptyTrackNote(
					mount,
					"No subtitles on this stream.",
				);
				return;
			}
			mount.appendChild(
				trackRow("Off", Array.from(tracks).every((t) => t.mode === "disabled"), () => {
					for (const t of Array.from(tracks)) t.mode = "disabled";
					fillSubtitleTracks();
				}),
			);
			for (const track of Array.from(tracks)) {
				mount.appendChild(
					trackRow(
						track.label || track.language || "Subtitles",
						track.mode === "showing",
						() => {
							for (const other of Array.from(tracks)) {
								other.mode = other === track ? "showing" : "disabled";
							}
							fillSubtitleTracks();
						},
					),
				);
			}
		};

		const runOsdAction = (action) => {
			switch (action) {
				case "channel-up":
					dispatchPlayerKey("]");
					break;
				case "channel-down":
					dispatchPlayerKey("[");
					break;
				case "previous-channel":
					dispatchPlayerKey("\\");
					break;
				case "pause-toggle":
					dispatchPlayerKey(" ");
					break;
				case "mute":
					dispatchPlayerKey("m");
					break;
				case "fullscreen":
					dispatchPlayerKey("f");
					break;
				case "guide":
					goCouch("/epg");
					break;
				case "channels":
					openCouchDialog("livetv-quick-channels");
					break;
				case "favourites":
					// The category picker's own contract: detail carries
					// the pseudo-category; the picker updates its label
					// and stream.ts re-filters the list.
					document.dispatchEvent(
						new CustomEvent("xt:cat-changed", { detail: "__favorites__" }),
					);
					hideOsd();
					break;
				case "audio":
					fillAudioTracks();
					openCouchDialog("livetv-audio");
					break;
				case "subtitles":
					fillSubtitleTracks();
					openCouchDialog("livetv-subtitles");
					break;
				case "home":
					goCouch("/");
					break;
				case "dismiss":
					hideOsd();
					break;
				default:
					break;
			}
			if (action && action !== "dismiss") showOsd();
		};

		document.querySelectorAll("[data-osd-action]").forEach((btn) => {
			btn.addEventListener("click", () => {
				runOsdAction(btn.getAttribute("data-osd-action"));
			});
		});

		// OSD-owned keys (G guide, C channels, V favourites, H home,
		// Escape dismiss). Tuning / transport keys already have a
		// global handler in stream.ts and are never intercepted here.
		document.addEventListener("keydown", (e) => {
			if (e.ctrlKey || e.altKey || e.metaKey) return;
			const target = e.target;
			const tag = target?.tagName?.toLowerCase?.() || "";
			if (
				tag === "input" ||
				tag === "textarea" ||
				tag === "select" ||
				target?.isContentEditable
			) {
				return;
			}
			if (document.querySelector("dialog[open]")) return;
			if (!isOsdOwnedKey(e.key)) return;
			const action = livetvOsdActionForKey(e.key);
			if (!action) return;
			e.preventDefault();
			runOsdAction(action);
		});

		// "Show all channels" closes the quick list and puts focus on
		// the channel search.
		document
			.querySelector("[data-livetv-show-all]")
			?.addEventListener("click", () => {
				document
					.getElementById("livetv-quick-channels")
					?.close?.();
				document.getElementById("search")?.focus?.();
			});

		const epgToggle = /** @type {HTMLButtonElement|null} */ (
			document.getElementById("epg-toggle")
		);
		const epgPanel = document.getElementById("epg");
		if (epgToggle && epgPanel) {
			const KEY_VISIBLE = "xt_epg_visible";
			const KEY_DEFAULT = "xt_epg_open_default";

			const readDefault = () => {
				try {
					const v = localStorage.getItem(KEY_DEFAULT);
					return v === null ? true : v === "true";
				} catch {
					return true;
				}
			};
			const readVisible = () => {
				try {
					const v = localStorage.getItem(KEY_VISIBLE);
					return v === null ? readDefault() : v === "true";
				} catch {
					return true;
				}
			};

			const apply = (visible) => {
				epgPanel.classList.toggle("hidden", !visible);
				epgToggle.setAttribute("aria-pressed", String(visible));
			};

			apply(readVisible());

			epgToggle.addEventListener("click", () => {
				const next = epgToggle.getAttribute("aria-pressed") !== "true";
				try {
					localStorage.setItem(KEY_VISIBLE, String(next));
				} catch {}
				apply(next);
			});
		}

		const epgExpandToggle = /** @type {HTMLButtonElement|null} */ (
			document.getElementById("epg-expand-toggle")
		);
		if (epgExpandToggle && epgPanel) {
			const KEY_LIST_EXPANDED = "xt_epg_list_expanded";

			const readListExpanded = () => {
				try {
					return localStorage.getItem(KEY_LIST_EXPANDED) === "1";
				} catch {
					return false;
				}
			};

			const applyListExpanded = (expanded) => {
				epgPanel.setAttribute("data-epg-collapsed", expanded ? "false" : "true");
				epgExpandToggle.setAttribute("aria-expanded", String(expanded));
				const label = expanded
					? epgExpandToggle.dataset.labelCollapse
					: epgExpandToggle.dataset.labelExpand;
				if (label) epgExpandToggle.setAttribute("aria-label", label);
			};

			applyListExpanded(readListExpanded());

			epgExpandToggle.addEventListener("click", () => {
				const next = epgExpandToggle.getAttribute("aria-expanded") !== "true";
				try {
					localStorage.setItem(KEY_LIST_EXPANDED, next ? "1" : "0");
				} catch {}
				applyListExpanded(next);
			});
		}
	</script>
</CouchLayout>
