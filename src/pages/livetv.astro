---
// Live TV — RedSilk Couch rebuild (0.9.0: Landing + Browser + Playback + Guide).
//
// The Live TV landing + mode shell. NO auto-start stream on
// open: the landing screen is the default. Four mode mount points:
//
//   #livetv-mode-landing  — W1's TvLiveLanding mounts here
//   #livetv-mode-browser  — W2's TvChannelBrowser mounts here
//   #livetv-mode-playback — W3's TvPlaybackShell mounts here
//   #livetv-mode-guide    — W4's TvGuideView mounts here
//
// Mode switching is the shared window-event contract: the shell
// listens for `livetv:mode` {mode, browserFilter?, guideMode?,
// openSearch?} and shows / hides mount points, sets
// html[data-livetv-mode] (the gamepad layer reads it), and NEVER
// re-initialises the player session — the player DOM stays mounted
// across switches. The legacy mode name "home" is an alias for
// "landing" wherever a mode is accepted (setMode, requestLivetvMode,
// parseLivetvState) and is never stored.
//
// Playback handoff: selecting a channel dispatches cancelable
// `livetv:tune` {channelId} + `livetv:mode` {mode:"playback"} (see
// dispatchLivetvTune in livetv-data.ts). The engine seam in
// stream.ts consumes the tune (and claims it with preventDefault);
// TvPlaybackShell owns the playback chrome. There is NO ?channel=
// fallback navigation any more (removed at integration 0.7.0):
// tuning works purely through the event + shell. The engine still
// reads ?channel= / ?cstart= / ?cstop= itself on load
// (maybeAutoplayFromUrl), so deep links from Home cards, Discover
// and the legacy EPG keep working — they tune on load, and the
// player-visibility observer below flips the shell to playback.
//
// Guide: TvGuideView owns the guide mount; the hero Guide button
// dispatches `livetv:mode` {mode:"guide"} directly. /epg stays a
// redirect to /livetv?mode=guide as a bookmark safety net.
//
// The old desktop browser chrome is retired: no left-column channel
// list, no toolbar pills, no EPG mini-panel under the player, no
// category picker. ONE hidden exception lives inside the playback
// mount: the minimal DOM the legacy engine (stream.ts) needs to keep
// loading channels (#list / #spacer / #viewport / #list-status /
// #search) — visually hidden, aria-hidden, kept only until W2's
// shell replaces the engine wiring. The player DOM (#player-wrap,
// #player, #current, #current-nownext) is kept for the same reason.
//
// Home sections (directive order): (A) Resume Watching hero — last
// watched channel, else a favourite / live-now fallback, explicit
// Watch only; (B) Favourite Channels rail; (C) Recently Watched
// (live only, deduped by id); (D) What's On Now (EPG-based,
// favourites/watched/local first, hidden when no EPG); (E) Channel
// Collections — LARGE category cards built dynamically from provider
// groups (groupChannels), never hardcoded provider naming. Empty
// rails are hidden, never empty shells. Nothing here invents EPG,
// logos or viewing data.
import CouchLayout from "@/layouts/CouchLayout.astro";
import WelcomeCard from "@/components/WelcomeCard.astro";
import TvEmpty from "@/components/couch/TvEmpty.astro";
import TvLiveLanding from "@/components/couch/TvLiveLanding.astro";
import TvChannelBrowser from "@/components/couch/TvChannelBrowser.astro";
import TvPlaybackShell from "@/components/couch/TvPlaybackShell.astro";
import TvGuideView from "@/components/couch/TvGuideView.astro";
import { livetvEmptyProps } from "@/scripts/lib/livetv-data";
const providerEmpty = livetvEmptyProps("provider-lost");
---

<CouchLayout pageTitle="Live TV" view="livetv">
	<script is:inline>
		try {
			var raw = localStorage.getItem("xt_playlists") || "";
			var hasEntries = false;
			if (raw) {
				var parsed = JSON.parse(raw);
				hasEntries = !!(
					parsed &&
					Array.isArray(parsed.entries) &&
					parsed.entries.length
				);
			}
			if (!hasEntries) {
				document.documentElement.setAttribute("data-first-run", "true");
			}
		} catch (e) {}
	</script>

	<div class="rs-livetv-home">
		<header class="rs-livetv-home__head">
			<h1 class="rs-page-title">Live TV</h1>
			<p class="rs-meta">Live channels from your playlist — pick a channel to start watching.</p>
			<!-- The Xbox button-hint legend is the layout-level
			     TvButtonHints (CouchLayout), NOT a mount here: the
			     [data-livetv-legend] div that used to sit in this
			     header was never filled by anything (0.11.0 W1
			     removed it). -->
		</header>

		<section
			id="livetv-welcome"
			aria-labelledby="welcome-heading"
			class="rs-livetv-home__welcome hidden flex-1 min-h-0 items-center justify-center py-6">
			<WelcomeCard />
		</section>

		<div id="livetv-provider-empty" class="rs-livetv-home__empty" hidden>
			<TvEmpty
				title={providerEmpty.title}
				message={providerEmpty.message}
				art="player"
				actionLabel="Add a playlist"
				actionHref="/login"
			/>
		</div>

		<!-- ── Mode: Landing (W1's TvLiveLanding mounts here) ── -->
		<div id="livetv-mode-landing" data-livetv-mode="landing">
			<!-- 0.9.0: the 0.7.0 Home interior (hero / rails /
			     collections / All Channels section) is REPLACED by
			     W1's TvLiveLanding — nothing of it stays mounted. -->
			<TvLiveLanding />
		</div>

		<!-- ── Mode: Browser (W2's TvChannelBrowser mounts here) ──
		     The component's initialCategoryId / initialFocusId
		     props are server-rendered (no values known at SSR, so
		     they start unset); the mode detail ALSO arrives as
		     data attributes on this mount div (set by setMode from
		     the `livetv:mode` detail) so W2 can read either:
		     data-initial-category / data-initial-focus /
		     data-browser-filter-kind / data-browser-filter-value /
		     data-open-search. -->
		<div
			id="livetv-mode-browser"
			data-livetv-mode="browser"
			data-initial-category=""
			data-initial-focus=""
			data-browser-filter-kind=""
			data-browser-filter-value=""
			data-open-search="false"
			hidden>
			<div class="rs-livetv-home__playback-bar">
				<button
					type="button"
					class="rs-hero__action rs-hero__action--secondary"
					data-livetv-home
					data-nylah-item>
					‹ Live TV
				</button>
			</div>
			<TvChannelBrowser browserId="browser" screenMode />
		</div>

		<!-- ── Mode: Playback (W3's TvPlaybackShell mounts here) ── -->
		<div id="livetv-mode-playback" data-livetv-mode="playback" hidden>
			<div class="rs-livetv-home__playback-bar">
				<button
					type="button"
					class="rs-hero__action rs-hero__action--secondary"
					data-livetv-home
					data-nylah-item>
					‹ Live TV Home
				</button>
			</div>
			<!-- Player DOM the legacy engine (stream.ts) owns. W2's
			     shell takes over this mount; the engine tunes via
			     its livetv:tune seam — never via navigation. -->
			<div id="player-wrap" class="player-wrap relative aspect-video w-full mx-auto overflow-hidden bg-black flex items-center justify-center shrink-0">
				<div
					id="player-empty"
					class="nylah-art-backdrop--player-empty absolute inset-0 flex flex-col items-center justify-center gap-6 text-center px-6 pointer-events-none">
					<div class="player-empty-glow" aria-hidden="true"></div>
					<p class="font-serif text-fg leading-[0.95] tracking-[-0.03em] font-bold"
						style="font-size: clamp(1.75rem, 3vw + 1rem, 3.5rem);">
						Pick a channel.
					</p>
					<p class="text-fg-3 text-xs sm:text-sm">
						Choose from Live TV Home, or change channel.
					</p>
				</div>
				<video
					id="player"
					class="video-js vjs-default-skin vjs-big-play-centered h-full w-full"
					controls
					hidden
					playsinline></video>
				<div
					id="radio-display"
					class="radio-display max-[480px]:flex-col max-[480px]:text-center max-[480px]:items-center"
					aria-hidden="true">
					<div class="radio-display__meta flex flex-col gap-2 min-w-0 flex-1 pb-14 max-[480px]:items-center max-[480px]:pb-16">
						<p
							class="radio-display__name text-fg font-bold tracking-tight leading-tight min-w-0 line-clamp-2 text-[clamp(1.5rem,3vw,2.25rem)]"
							data-radio-name>-</p>
					</div>
				</div>
			</div>

			<div
				id="current"
				class="flex items-center justify-between gap-2 px-1 text-base text-fg-2 shrink-0">
				<div class="flex items-center gap-2 min-w-0">
					<span data-i18n="livetv.statusOff" class="status-badge status-badge--off shrink-0">OFF</span>
					<span class="truncate">-</span>
				</div>
			</div>

			<div id="current-nownext" class="shrink-0 px-1" hidden>
				<div class="flex items-baseline gap-2 min-w-0">
					<span
						data-nownext-eyebrow
						class="text-xs font-bold uppercase tracking-[0.18em] text-accent shrink-0">Now</span>
					<span
						data-nownext-title
						class="truncate min-w-0 flex-1 font-serif text-xl leading-tight text-fg"></span>
					<span
						data-nownext-time
						class="text-sm text-fg-3 tabular-nums shrink-0"></span>
				</div>
				<div
					data-nownext-barwrap
					class="mt-1.5 h-1.5 rounded-full bg-surface-3 overflow-hidden"
					hidden>
					<div
						data-nownext-fill
						class="h-full rounded-full bg-accent transition-[width] duration-500"
						style="width: 0%"></div>
				</div>
				<div
					data-nownext-next
					class="mt-1 truncate text-sm text-fg-3"></div>
			</div>

			<!-- Hidden engine scaffold: the DOM stream.ts needs to
			     load channels (loadChannels returns early without
			     #list / #viewport / #list-status). Visually hidden;
			     remove with the engine wiring when W2's shell lands. -->
			<div class="rs-livetv-engine" hidden aria-hidden="true">
				<input id="search" type="search" tabindex="-1" aria-hidden="true" />
				<div id="list" class="relative flex-1 min-h-0 overflow-auto pr-1 custom-scroll" role="listbox" aria-label="Channels">
					<div id="spacer"></div>
					<div id="viewport" class="absolute inset-x-0 top-0"></div>
				</div>
				<div id="list-status" class="px-2.5 text-sm shrink-0" aria-live="polite">No playlist selected.</div>
			</div>

			<!-- W2's fullscreen playback shell (OSD, Quick Surf,
			     Channel Browser, options + error overlays). Fixed
			     overlay; the player DOM above stays owned by the
			     engine. -->
			<TvPlaybackShell />
		</div>

		<!-- ── Mode: Guide (W3's TvGuideView mounts here) ── -->
		<div id="livetv-mode-guide" data-livetv-mode="guide" hidden>
			<div class="rs-livetv-home__playback-bar">
				<button
					type="button"
					class="rs-hero__action rs-hero__action--secondary"
					data-livetv-home
					data-nylah-item>
					‹ Live TV Home
				</button>
			</div>
			<div data-livetv-guide-mount>
				<TvGuideView />
			</div>
		</div>
	</div>

	<style>
		html[data-first-run="true"] #livetv-mode-landing { display: none; }
		html[data-first-run="true"] #livetv-welcome { display: flex; }
		html[data-first-run="true"] .rs-livetv-home__head { display: none; }
		html[data-first-run="true"] #livetv-provider-empty { display: none; }

		.rs-livetv-home {
			display: flex;
			flex-direction: column;
			gap: 2rem;
			min-height: 0;
			flex: 1;
		}
		/* INTEGRATION 0.11.0 — viewport-fit the Browser + Guide
		   screens. The flex chain below these mounts (browser
		   host/layout/main/list, guide panel/list) already carries
		   flex:1 + min-height:0, but the mode mounts are plain
		   block flex items, so min-height:auto refused to shrink
		   them below content height: the document grew to 1252px
		   (browser) / 1475px (guide) at 1080p, the lists sized to
		   content and never scrolled, and the 9th browser row /
		   8th guide row sat half-cut under the fixed hints bar —
		   list bottom padding alone could not fix it (it only grew
		   the list taller). With the mounts as shrinking flex
		   columns, body (min-height:100dvh) caps the page and the
		   lists scroll internally; the 4.5rem bottom padding then
		   clears the last row above the hints bar. Scoped to
		   browser/guide only — landing/playback keep block layout.
		   :not([hidden]) is load-bearing: setMode toggles modes
		   via the hidden attribute, and a bare display:flex would
		   override it and show every mount at once. */
		#livetv-mode-browser:not([hidden]),
		#livetv-mode-guide:not([hidden]) {
			display: flex;
			flex-direction: column;
			min-height: 0;
			flex: 1;
		}
		.rs-livetv-home__head {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.rs-livetv-home__playback-bar {
			display: flex;
			gap: 0.75rem;
			margin-bottom: 1rem;
		}
		/* 0.11.0 W1: the 0.7.0 Home interior rules that used to
		   live here (.rs-livetv-home-hero*,
		   .rs-livetv-home-collections__grid,
		   .rs-livetv-home-browser*) are deleted — no markup has
		   rendered them since TvLiveLanding replaced the Home
		   interior in 0.9.0, and the landing owns its own
		   classes in couch.css. */
		/* 0.9.0: the [hidden] guard for the retired 0.7.0 Home
		   rails / hero / collections was removed with them —
		   TvLiveLanding owns the landing now. */
		/* Player caps (v0.2.2 rule, preserved): on desktop/landscape
		   the player is capped at 46dvh so the strip below it keeps
		   real room; portrait/mobile keeps 60dvh. */
		.player-wrap {
			max-height: 60dvh;
			max-width: calc(60dvh * 16 / 9);
			border-radius: 1rem;
			border: 1px solid var(--rs-line);
		}
		@media (min-width: 1024px), (min-width: 768px) and (orientation: landscape) {
			.player-wrap {
				max-height: 46dvh;
				max-width: calc(46dvh * 16 / 9);
			}
		}
		.radio-display { display: none; }
		.player-empty-glow {
			background: radial-gradient(
				50% 60% at 50% 55%,
				color-mix(in srgb, var(--rs-focus) 30%, transparent) 0%,
				color-mix(in srgb, var(--rs-accent) 14%, transparent) 45%,
				transparent 80%
			);
			opacity: 0.85;
		}
		#player-empty.nylah-art-backdrop--player-empty {
			background-image: var(--nylah-art-player-empty);
			background-size: cover;
			background-position: center;
		}
		#player-empty.nylah-art-backdrop--player-empty::after {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				to top,
				color-mix(in srgb, var(--rs-bg) 78%, transparent) 0%,
				transparent 60%
			);
		}
		:global(#current .status-badge) {
			height: 2rem;
			width: 2rem;
			font-size: 0.75rem;
		}
		:global(#current .status-badge--catchup) {
			width: auto;
			padding-inline: 0.625rem;
		}
		:global(#current .text-accent) {
			font-size: 1.5rem;
			letter-spacing: -0.01em;
		}
		:global(#current-nownext [data-nownext-title]) {
			font-size: 1.5rem;
		}
		:global(#current-nownext [data-nownext-time]),
		:global(#current-nownext [data-nownext-next]) {
			font-size: 1.125rem;
		}
		:global(#current-nownext [data-nownext-fill]) {
			background: linear-gradient(90deg, var(--rs-accent), var(--rs-focus));
		}
		:global(#current-nownext [data-nownext-barwrap]) {
			background: color-mix(in srgb, var(--rs-accent) 22%, transparent);
		}
	</style>

	<!-- 0.11.0 W1: the global .rs-livetv-home-collection-card* /
     .rs-livetv-home-hero__logo* rules that used to live here are
     deleted — they styled the retired 0.7.0 Home interior, which no
     markup renders any more (TvLiveLanding owns the landing now).
     Nothing JS-built needs them: the landing builds its tiles with
     its own classes (see livetv-landing.ts). -->

	<script>
		import "../scripts/stream/stream.ts";
		import "../scripts/updater-startup.js";
		import {
			dispatchLivetvTune,
			loadLivetvHomeData,
			readActivePlaylistId,
			requestLivetvMode,
		} from "../scripts/lib/livetv-data.ts";
		import { getLivetvResumeLastChannel } from "../scripts/lib/app-settings.js";
		import { restoreLivetvState, parseLivetvModeParam } from "../scripts/lib/livetv-state.ts";
		import { persistLivetvMode } from "../scripts/lib/livetv-state.ts";

		// ── Mode shell (0.9.0: four modes + "home" alias) ─────────
		// Listens for livetv:mode {mode, browserFilter?, guideMode?,
		// openSearch?} and shows / hides the four mount points.
		// The player DOM is never re-created: switching modes only
		// toggles visibility, so the tuned session survives.
		// html[data-livetv-mode] is the gamepad layer's context
		// signal (W5) and the CSS hook for mode chrome. The legacy
		// mode name "home" maps to "landing" here, in
		// requestLivetvMode and in parseLivetvState — it is never
		// stored. Browser detail is ALSO mirrored onto data
		// attributes on #livetv-mode-browser so W2's browser can
		// read either the event detail or the mount div; guide
		// sub-mode is mirrored to html[data-livetv-guide-mode] for
		// the button-hint legend.
		const modeMounts = {
			landing: document.getElementById("livetv-mode-landing"),
			browser: document.getElementById("livetv-mode-browser"),
			playback: document.getElementById("livetv-mode-playback"),
			guide: document.getElementById("livetv-mode-guide"),
		};
		const browserMount = modeMounts.browser;
		let currentMode = "landing";
		const setMode = (mode, detail) => {
			if (mode === "home") mode = "landing";
			if (
				mode !== "landing" &&
				mode !== "browser" &&
				mode !== "playback" &&
				mode !== "guide"
			)
				return;
			currentMode = mode;
			for (const [key, mount] of Object.entries(modeMounts)) {
				if (!mount) continue;
				mount.toggleAttribute("hidden", key !== mode);
			}
			document.documentElement.dataset.livetvMode = mode;
			// 0.11.0 W1: the shell is the single writer of the
			// current mode — persist it (mode only; tuned /
			// previous / guide date survive via persistLivetvMode)
			// so a reload restores the mode on screen instead of
			// whatever TvGuideView last persisted. Leaving the
			// Guide also clears its stale sub-mode mirror.
			persistLivetvMode(mode);
			if (mode !== "guide") {
				delete document.documentElement.dataset.livetvGuideMode;
			}
			if (detail && typeof detail === "object") {
				if (mode === "browser" && browserMount) {
					const filter = detail.browserFilter;
					browserMount.dataset.initialCategory =
						filter?.kind === "category" ? String(filter.value ?? "") : "";
					browserMount.dataset.initialFocus =
						detail.initialFocusId != null ? String(detail.initialFocusId) : "";
					browserMount.dataset.browserFilterKind = filter?.kind ?? "";
					browserMount.dataset.browserFilterValue =
						filter?.value != null ? String(filter.value) : "";
					browserMount.dataset.openSearch =
						detail.openSearch === true ? "true" : "false";
				}
				if (mode === "guide" && detail.guideMode) {
					document.documentElement.dataset.livetvGuideMode =
						String(detail.guideMode);
				}
			}
		};
		window.addEventListener("livetv:mode", (event) => {
			const detail = event.detail ?? {};
			setMode(detail.mode, detail);
		});

		// Back-to-Landing buttons (browser + playback + guide mounts).
		document.querySelectorAll("[data-livetv-home]").forEach((btn) => {
			btn.addEventListener("click", () => requestLivetvMode("landing"));
		});

		// ── Guide entry ─────────────────────────────────────────
		// TvGuideView is mounted (above) and owns the guide mount,
		// so a Guide request just dispatches the mode — no /epg
		// fallback navigation any more. /epg itself redirects to
		// /livetv?mode=guide as a bookmark safety net.
		// 0.11.0 W1: the [data-livetv-guide] click binding that
		// used to live here is deleted — no element in any Live TV
		// screen carries that attribute (the hero Guide button is
		// [data-hero-guide], handled in livetv-landing.ts), so it
		// bound to nothing.

		// ── Player visibility ───────────────────────────────────
		// The engine unhides #player when a stream tunes (deep link
		// or livetv:tune). Mirror that into the mode shell, and keep
		// the idle art in sync.
		const playerEl = document.getElementById("player");
		const playerEmpty = document.getElementById("player-empty");
		const syncPlayerVisible = () => {
			const playing = !!playerEl && !playerEl.hasAttribute("hidden");
			if (playerEmpty) {
				playerEmpty.style.display = playing ? "none" : "";
			}
			if (playing && currentMode === "landing") setMode("playback");
		};
		if (playerEl) {
			syncPlayerVisible();
			new MutationObserver(syncPlayerVisible).observe(playerEl, {
				attributes: true,
				attributeFilter: ["hidden"],
			});
		}

		// ── Landing (0.9.0) ─────────────────────────────────────────
		// The 0.7.0 Home's hero / rails / collections / browser
		// rendering lived here and is RETIRED: W1's TvLiveLanding
		// (mounted above) owns the landing now, including its own
		// EPG / favourites / recents refresh listeners. The ONE
		// behaviour the shell keeps is the resume setting
		// (default OFF): straight to fullscreen playback of the
		// last channel. W1's landing does not implement it, and
		// dropping it silently would regress a user setting.
		const maybeResumeLastChannel = async () => {
			const playlistId = readActivePlaylistId();
			if (!playlistId) return;
			if (!getLivetvResumeLastChannel()) return;
			const params = new URLSearchParams(window.location.search);
			if (params.get("channel")) return;
			let data;
			try {
				data = await loadLivetvHomeData(playlistId);
			} catch {
				return;
			}
			if (data.recents.length) dispatchLivetvTune(data.recents[0].id);
		};

		// Initial mode (0.9.0): ?mode= mapping — guide→guide,
		// browser→browser, landing/home→landing, playback→
		// playback. A persisted guide mode (W3's state module) also
		// opens straight into the Guide — the Guide self-activates
		// on the same conditions, and this shell must not hide its
		// mount underneath it. An already-playing player opens into
		// playback (covers ?channel= deep links: the engine tunes
		// on load and unhides #player, and the observer above flips
		// the shell). Otherwise landing. (Mode persistence across
		// reloads is the state module's job — this shell never
		// restores playback on its own, or a reload would land on
		// an idle player.)
		const initialParams = new URLSearchParams(window.location.search);
		const modeFromParam = parseLivetvModeParam(initialParams.get("mode"));
		const initialMode =
			modeFromParam ??
			(restoreLivetvState().mode === "guide"
				? "guide"
				: !playerEl?.hasAttribute("hidden")
					? "playback"
					: "landing");
		setMode(initialMode);
		void maybeResumeLastChannel();

	</script>
</CouchLayout>
