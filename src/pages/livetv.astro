---
// Live TV — RedSilk Couch rebuild (W1: Home + Channel Browser).
//
// The Live TV Home landing + mode shell. NO auto-start stream on
// open: the landing screen is the default. Three mode mount points:
//
//   #livetv-mode-home     — this file's Home (hero, rails, collections, browser)
//   #livetv-mode-playback — W2's TvPlaybackShell mounts here
//   #livetv-mode-guide    — W3's TvGuideView mounts here
//
// Mode switching is the shared window-event contract: the shell
// listens for `livetv:mode` {mode} and shows / hides mount points,
// sets html[data-livetv-mode] (the gamepad layer reads it), and
// NEVER re-initialises the player session — the player DOM stays
// mounted across switches.
//
// Playback handoff: selecting a channel dispatches cancelable
// `livetv:tune` {channelId} + `livetv:mode` {mode:"playback"} (see
// dispatchLivetvTune in livetv-data.ts). The engine seam in
// stream.ts consumes the tune (and claims it with preventDefault);
// TvPlaybackShell owns the playback chrome. There is NO ?channel=
// fallback navigation any more (removed at integration 0.7.0):
// tuning works purely through the event + shell. The engine still
// reads ?channel= / ?cstart= / ?cstop= itself on load
// (maybeAutoplayFromUrl), so deep links from Home cards, Discover
// and the legacy EPG keep working — they tune on load, and the
// player-visibility observer below flips the shell to playback.
//
// Guide: TvGuideView owns the guide mount; the hero Guide button
// dispatches `livetv:mode` {mode:"guide"} directly. /epg stays a
// redirect to /livetv?mode=guide as a bookmark safety net.
//
// The old desktop browser chrome is retired: no left-column channel
// list, no toolbar pills, no EPG mini-panel under the player, no
// category picker. ONE hidden exception lives inside the playback
// mount: the minimal DOM the legacy engine (stream.ts) needs to keep
// loading channels (#list / #spacer / #viewport / #list-status /
// #search) — visually hidden, aria-hidden, kept only until W2's
// shell replaces the engine wiring. The player DOM (#player-wrap,
// #player, #current, #current-nownext) is kept for the same reason.
//
// Home sections (directive order): (A) Resume Watching hero — last
// watched channel, else a favourite / live-now fallback, explicit
// Watch only; (B) Favourite Channels rail; (C) Recently Watched
// (live only, deduped by id); (D) What's On Now (EPG-based,
// favourites/watched/local first, hidden when no EPG); (E) Channel
// Collections — LARGE category cards built dynamically from provider
// groups (groupChannels), never hardcoded provider naming. Empty
// rails are hidden, never empty shells. Nothing here invents EPG,
// logos or viewing data.
import CouchLayout from "@/layouts/CouchLayout.astro";
import WelcomeCard from "@/components/WelcomeCard.astro";
import TvEmpty from "@/components/couch/TvEmpty.astro";
import TvSkeleton from "@/components/couch/TvSkeleton.astro";
import TvChannelBrowser from "@/components/couch/TvChannelBrowser.astro";
import TvPlaybackShell from "@/components/couch/TvPlaybackShell.astro";
import TvGuideView from "@/components/couch/TvGuideView.astro";
---

<CouchLayout pageTitle="Live TV" view="livetv">
	<script is:inline>
		try {
			var raw = localStorage.getItem("xt_playlists") || "";
			var hasEntries = false;
			if (raw) {
				var parsed = JSON.parse(raw);
				hasEntries = !!(
					parsed &&
					Array.isArray(parsed.entries) &&
					parsed.entries.length
				);
			}
			if (!hasEntries) {
				document.documentElement.setAttribute("data-first-run", "true");
			}
		} catch (e) {}
	</script>

	<div class="rs-livetv-home">
		<header class="rs-livetv-home__head">
			<h1 class="rs-page-title">Live TV</h1>
			<p class="rs-meta">Live channels from your playlist — pick a channel to start watching.</p>
		</header>

		<section
			id="livetv-welcome"
			aria-labelledby="welcome-heading"
			class="rs-livetv-home__welcome hidden flex-1 min-h-0 items-center justify-center py-6">
			<WelcomeCard />
		</section>

		<div id="livetv-provider-empty" class="rs-livetv-home__empty" hidden>
			<TvEmpty
				title="No live playlist connected"
				message="Add a playlist to browse live channels."
				art="player"
				actionLabel="Add a playlist"
				actionHref="/login"
			/>
		</div>

		<!-- ── Mode: Home ── -->
		<div id="livetv-mode-home" data-livetv-mode="home">
			<!-- (A) Resume Watching hero -->
			<section
				id="livetv-resume"
				class="rs-livetv-home-hero"
				data-livetv-resume
				aria-label="Resume watching"
				hidden>
				<div class="rs-livetv-home-hero__logo" data-hero-logo></div>
				<div class="rs-livetv-home-hero__body">
					<p class="rs-livetv-home-hero__eyebrow" data-hero-eyebrow>Resume Watching</p>
					<h2 class="rs-livetv-home-hero__title" data-hero-title></h2>
					<div data-hero-programme></div>
					<p class="rs-livetv-home-hero__next" data-hero-next hidden></p>
					<div class="rs-livetv-home-hero__actions">
						<button
							type="button"
							class="rs-hero__action rs-hero__action--primary"
							data-hero-watch
							data-nylah-item>
							Watch Live
						</button>
						<button
							type="button"
							class="rs-hero__action rs-hero__action--secondary"
							data-livetv-guide
							data-nylah-item>
							Guide
						</button>
					</div>
				</div>
			</section>
			<div id="livetv-resume-skeleton" class="rs-livetv-home-hero" aria-hidden="true">
				<TvSkeleton kind="hero" />
			</div>

			<!-- (B) Favourite Channels -->
			<section
				class="rs-rail"
				data-livetv-rail="favourites"
				data-nylah-rail="livetv-favourites"
				aria-label="Favourite channels"
				hidden>
				<div class="rs-rail__head">
					<h2 class="rs-section-title">Favourite Channels</h2>
				</div>
				<div class="rs-rail__row" data-rail-row></div>
			</section>

			<!-- (C) Recently Watched -->
			<section
				class="rs-rail"
				data-livetv-rail="recents"
				data-nylah-rail="livetv-recents"
				aria-label="Recently watched"
				hidden>
				<div class="rs-rail__head">
					<h2 class="rs-section-title">Recently Watched</h2>
				</div>
				<div class="rs-rail__row" data-rail-row></div>
			</section>

			<!-- (D) What's On Now -->
			<section
				class="rs-rail"
				data-livetv-rail="whats-on-now"
				data-nylah-rail="livetv-whats-on-now"
				aria-label="What's on now"
				hidden>
				<div class="rs-rail__head">
					<h2 class="rs-section-title">What's On Now</h2>
				</div>
				<div class="rs-rail__row" data-rail-row></div>
			</section>

			<!-- (E) Channel Collections -->
			<section
				id="livetv-collections"
				class="rs-livetv-home-collections"
				data-livetv-collections
				aria-label="Channel collections"
				hidden>
				<div class="rs-rail__head">
					<h2 class="rs-section-title">Browse Channels</h2>
				</div>
				<div class="rs-livetv-home-collections__grid" data-collections-grid></div>
			</section>

			<!-- Channel Browser -->
			<section
				id="livetv-browser-section"
				class="rs-livetv-home-browser"
				aria-label="All channels">
				<div class="rs-rail__head">
					<h2 class="rs-section-title">All Channels</h2>
				</div>
				<TvChannelBrowser />
			</section>
		</div>

		<!-- ── Mode: Playback (W2's TvPlaybackShell mounts here) ── -->
		<div id="livetv-mode-playback" data-livetv-mode="playback" hidden>
			<div class="rs-livetv-home__playback-bar">
				<button
					type="button"
					class="rs-hero__action rs-hero__action--secondary"
					data-livetv-home
					data-nylah-item>
					‹ Live TV Home
				</button>
			</div>
			<!-- Player DOM the legacy engine (stream.ts) owns. W2's
			     shell takes over this mount; the engine tunes via
			     its livetv:tune seam — never via navigation. -->
			<div id="player-wrap" class="player-wrap relative aspect-video w-full mx-auto overflow-hidden bg-black flex items-center justify-center shrink-0">
				<div
					id="player-empty"
					class="nylah-art-backdrop--player-empty absolute inset-0 flex flex-col items-center justify-center gap-6 text-center px-6 pointer-events-none">
					<div class="player-empty-glow" aria-hidden="true"></div>
					<p class="font-serif text-fg leading-[0.95] tracking-[-0.03em] font-bold"
						style="font-size: clamp(1.75rem, 3vw + 1rem, 3.5rem);">
						Pick a channel.
					</p>
					<p class="text-fg-3 text-xs sm:text-sm">
						Choose from Live TV Home, or change channel.
					</p>
				</div>
				<video
					id="player"
					class="video-js vjs-default-skin vjs-big-play-centered h-full w-full"
					controls
					hidden
					playsinline></video>
				<div
					id="radio-display"
					class="radio-display max-[480px]:flex-col max-[480px]:text-center max-[480px]:items-center"
					aria-hidden="true">
					<div class="radio-display__meta flex flex-col gap-2 min-w-0 flex-1 pb-14 max-[480px]:items-center max-[480px]:pb-16">
						<p
							class="radio-display__name text-fg font-bold tracking-tight leading-tight min-w-0 line-clamp-2 text-[clamp(1.5rem,3vw,2.25rem)]"
							data-radio-name>-</p>
					</div>
				</div>
			</div>

			<div
				id="current"
				class="flex items-center justify-between gap-2 px-1 text-base text-fg-2 shrink-0">
				<div class="flex items-center gap-2 min-w-0">
					<span data-i18n="livetv.statusOff" class="status-badge status-badge--off shrink-0">OFF</span>
					<span class="truncate">-</span>
				</div>
			</div>

			<div id="current-nownext" class="shrink-0 px-1" hidden>
				<div class="flex items-baseline gap-2 min-w-0">
					<span
						data-nownext-eyebrow
						class="text-xs font-bold uppercase tracking-[0.18em] text-accent shrink-0">Now</span>
					<span
						data-nownext-title
						class="truncate min-w-0 flex-1 font-serif text-xl leading-tight text-fg"></span>
					<span
						data-nownext-time
						class="text-sm text-fg-3 tabular-nums shrink-0"></span>
				</div>
				<div
					data-nownext-barwrap
					class="mt-1.5 h-1.5 rounded-full bg-surface-3 overflow-hidden"
					hidden>
					<div
						data-nownext-fill
						class="h-full rounded-full bg-accent transition-[width] duration-500"
						style="width: 0%"></div>
				</div>
				<div
					data-nownext-next
					class="mt-1 truncate text-sm text-fg-3"></div>
			</div>

			<!-- Hidden engine scaffold: the DOM stream.ts needs to
			     load channels (loadChannels returns early without
			     #list / #viewport / #list-status). Visually hidden;
			     remove with the engine wiring when W2's shell lands. -->
			<div class="rs-livetv-engine" hidden aria-hidden="true">
				<input id="search" type="search" tabindex="-1" aria-hidden="true" />
				<div id="list" class="relative flex-1 min-h-0 overflow-auto pr-1 custom-scroll" role="listbox" aria-label="Channels">
					<div id="spacer"></div>
					<div id="viewport" class="absolute inset-x-0 top-0"></div>
				</div>
				<div id="list-status" class="px-2.5 text-sm shrink-0" aria-live="polite">No playlist selected.</div>
			</div>

			<!-- W2's fullscreen playback shell (OSD, Quick Surf,
			     Channel Browser, options + error overlays). Fixed
			     overlay; the player DOM above stays owned by the
			     engine. -->
			<TvPlaybackShell />
		</div>

		<!-- ── Mode: Guide (W3's TvGuideView mounts here) ── -->
		<div id="livetv-mode-guide" data-livetv-mode="guide" hidden>
			<div class="rs-livetv-home__playback-bar">
				<button
					type="button"
					class="rs-hero__action rs-hero__action--secondary"
					data-livetv-home
					data-nylah-item>
					‹ Live TV Home
				</button>
			</div>
			<div data-livetv-guide-mount>
				<TvGuideView />
			</div>
		</div>
	</div>

	<style>
		html[data-first-run="true"] #livetv-mode-home { display: none; }
		html[data-first-run="true"] #livetv-welcome { display: flex; }
		html[data-first-run="true"] .rs-livetv-home__head { display: none; }
		html[data-first-run="true"] #livetv-provider-empty { display: none; }

		.rs-livetv-home {
			display: flex;
			flex-direction: column;
			gap: 2rem;
			min-height: 0;
			flex: 1;
		}
		.rs-livetv-home__head {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
		}
		.rs-livetv-home__playback-bar {
			display: flex;
			gap: 0.75rem;
			margin-bottom: 1rem;
		}
		/* Hero: logo left, programme + actions right; warm RedSilk
		   gradient, never a white surface. */
		.rs-livetv-home-hero {
			display: flex;
			gap: 2rem;
			align-items: center;
			min-height: 16rem;
			padding: 2rem;
			border-radius: 1.25rem;
			border: 1px solid var(--rs-line);
			background:
				radial-gradient(120% 90% at 85% 0%, color-mix(in srgb, var(--rs-accent) 22%, transparent) 0%, transparent 55%),
				linear-gradient(180deg, var(--rs-surface) 0%, var(--rs-bg-2) 100%);
			box-shadow: var(--rs-shadow);
		}
		.rs-livetv-home-hero__logo {
			flex-shrink: 0;
			width: 14rem;
			height: 8rem;
			display: grid;
			place-items: center;
			border-radius: 1rem;
			background: color-mix(in srgb, var(--rs-bg) 55%, transparent);
			border: 1px solid var(--rs-line);
			overflow: hidden;
		}
		.rs-livetv-home-hero__logo img {
			width: 100%;
			height: 100%;
			object-fit: contain;
			padding: 1rem;
		}
		.rs-livetv-home-hero__logo-fallback {
			font-size: 4rem;
			font-weight: 800;
			color: var(--rs-text-2);
		}
		.rs-livetv-home-hero__body {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			min-width: 0;
			flex: 1;
		}
		.rs-livetv-home-hero__eyebrow {
			margin: 0;
			font-size: 0.875rem;
			font-weight: 700;
			letter-spacing: 0.22em;
			text-transform: uppercase;
			color: var(--rs-accent);
		}
		.rs-livetv-home-hero__title {
			margin: 0;
			font-size: clamp(2rem, 4vw, 3.25rem);
			line-height: 1.05;
			letter-spacing: -0.02em;
			font-weight: 800;
		}
		.rs-livetv-home-hero__next {
			margin: 0;
			font-size: 1.25rem;
			color: var(--rs-text-2);
		}
		.rs-livetv-home-hero__actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.75rem;
			margin-top: 0.5rem;
		}
		/* Collections: LARGE category cards, never tiny pills. */
		.rs-livetv-home-collections__grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
			gap: 1.25rem;
		}
		.rs-livetv-home-collection-card {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.75rem;
			min-height: 9rem;
			padding: 1.5rem;
			text-align: left;
			border-radius: 1.25rem;
			border: 1px solid var(--rs-line);
			background: linear-gradient(180deg, var(--rs-surface) 0%, var(--rs-bg-2) 100%);
			color: var(--rs-text);
			cursor: pointer;
			box-shadow: var(--rs-shadow);
		}
		.rs-livetv-home-collection-card:hover {
			border-color: var(--rs-accent);
		}
		.rs-livetv-home-collection-card:focus-visible {
			outline: none;
			border-color: var(--rs-focus);
			box-shadow:
				0 0 0 2px var(--rs-focus),
				0 0 2rem 0.25rem var(--rs-focus-glow);
		}
		.rs-livetv-home-collection-card__label {
			font-size: 1.75rem;
			font-weight: 800;
			letter-spacing: -0.01em;
			line-height: 1.1;
		}
		.rs-livetv-home-collection-card__count {
			font-size: 1.125rem;
			color: var(--rs-text-2);
		}
		.rs-livetv-home-collection-card__sample {
			display: flex;
			gap: 0.5rem;
			margin-top: auto;
		}
		.rs-livetv-home-collection-card__sample img,
		.rs-livetv-home-collection-card__sample span {
			width: 3.5rem;
			height: 2.25rem;
			object-fit: contain;
			border-radius: 0.5rem;
			background: color-mix(in srgb, var(--rs-bg) 60%, transparent);
			border: 1px solid var(--rs-line);
			display: grid;
			place-items: center;
			font-weight: 800;
			font-size: 1.125rem;
			color: var(--rs-text-2);
		}
		.rs-livetv-home-browser {
			display: flex;
			flex-direction: column;
			gap: 1rem;
			min-height: 0;
		}
		/* Rails hide when the client fill finds nothing — .rs-rail
		   sets display:flex, which beats the UA [hidden] rule. */
		.rs-livetv-home [data-livetv-rail][hidden],
		.rs-livetv-home [data-livetv-resume][hidden],
		.rs-livetv-home [data-livetv-collections][hidden] {
			display: none;
		}
		/* Player caps (v0.2.2 rule, preserved): on desktop/landscape
		   the player is capped at 46dvh so the strip below it keeps
		   real room; portrait/mobile keeps 60dvh. */
		.player-wrap {
			max-height: 60dvh;
			max-width: calc(60dvh * 16 / 9);
			border-radius: 1rem;
			border: 1px solid var(--rs-line);
		}
		@media (min-width: 1024px), (min-width: 768px) and (orientation: landscape) {
			.player-wrap {
				max-height: 46dvh;
				max-width: calc(46dvh * 16 / 9);
			}
		}
		.radio-display { display: none; }
		.player-empty-glow {
			background: radial-gradient(
				50% 60% at 50% 55%,
				color-mix(in srgb, var(--rs-focus) 30%, transparent) 0%,
				color-mix(in srgb, var(--rs-accent) 14%, transparent) 45%,
				transparent 80%
			);
			opacity: 0.85;
		}
		#player-empty.nylah-art-backdrop--player-empty {
			background-image: var(--nylah-art-player-empty);
			background-size: cover;
			background-position: center;
		}
		#player-empty.nylah-art-backdrop--player-empty::after {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				to top,
				color-mix(in srgb, var(--rs-bg) 78%, transparent) 0%,
				transparent 60%
			);
		}
		:global(#current .status-badge) {
			height: 2rem;
			width: 2rem;
			font-size: 0.75rem;
		}
		:global(#current .status-badge--catchup) {
			width: auto;
			padding-inline: 0.625rem;
		}
		:global(#current .text-accent) {
			font-size: 1.5rem;
			letter-spacing: -0.01em;
		}
		:global(#current-nownext [data-nownext-title]) {
			font-size: 1.5rem;
		}
		:global(#current-nownext [data-nownext-time]),
		:global(#current-nownext [data-nownext-next]) {
			font-size: 1.125rem;
		}
		:global(#current-nownext [data-nownext-fill]) {
			background: linear-gradient(90deg, var(--rs-accent), var(--rs-focus));
		}
		:global(#current-nownext [data-nownext-barwrap]) {
			background: color-mix(in srgb, var(--rs-accent) 22%, transparent);
		}
	</style>

	<script>
		import "../scripts/stream/stream.ts";
		import "../scripts/updater-startup.js";
		import {
			dispatchLivetvTune,
			favouriteChannels,
			groupChannels,
			loadLivetvHomeData,
			nowNextForChannel,
			pickResumeHero,
			readActivePlaylistId,
			recentlyWatchedChannels,
			requestLivetvMode,
			whatsOnNow,
		} from "../scripts/lib/livetv-data.ts";
		import {
			buildChannelCardElement,
			buildProgrammeMetaElement,
		} from "../scripts/lib/livetv-cards.ts";
		import { getLivetvResumeLastChannel } from "../scripts/lib/app-settings.js";
		import { restoreLivetvState } from "../scripts/lib/livetv-state.ts";

		// ── Mode shell ──────────────────────────────────────────
		// Listens for livetv:mode {mode} and shows / hides the three
		// mount points. The player DOM is never re-created: switching
		// modes only toggles visibility, so the tuned session
		// survives. html[data-livetv-mode] is the gamepad layer's
		// playback signal (W2) and the CSS hook for mode chrome.
		const modeMounts = {
			home: document.getElementById("livetv-mode-home"),
			playback: document.getElementById("livetv-mode-playback"),
			guide: document.getElementById("livetv-mode-guide"),
		};
		let currentMode = "home";
		const setMode = (mode) => {
			if (mode !== "home" && mode !== "playback" && mode !== "guide") return;
			currentMode = mode;
			for (const [key, mount] of Object.entries(modeMounts)) {
				if (!mount) continue;
				mount.toggleAttribute("hidden", key !== mode);
			}
			document.documentElement.dataset.livetvMode = mode;
		};
		window.addEventListener("livetv:mode", (event) => {
			setMode(event.detail?.mode);
		});

		// Back-to-Home buttons (playback + guide mounts).
		document.querySelectorAll("[data-livetv-home]").forEach((btn) => {
			btn.addEventListener("click", () => requestLivetvMode("home"));
		});

		// ── Guide entry ─────────────────────────────────────────
		// TvGuideView is mounted (above) and owns the guide mount,
		// so a Guide request just dispatches the mode — no /epg
		// fallback navigation any more. /epg itself redirects to
		// /livetv?mode=guide as a bookmark safety net.
		document.querySelectorAll("[data-livetv-guide]").forEach((btn) => {
			btn.addEventListener("click", () => {
				requestLivetvMode("guide");
			});
		});

		// ── Player visibility ───────────────────────────────────
		// The engine unhides #player when a stream tunes (deep link
		// or livetv:tune). Mirror that into the mode shell, and keep
		// the idle art in sync.
		const playerEl = document.getElementById("player");
		const playerEmpty = document.getElementById("player-empty");
		const syncPlayerVisible = () => {
			const playing = !!playerEl && !playerEl.hasAttribute("hidden");
			if (playerEmpty) {
				playerEmpty.style.display = playing ? "none" : "";
			}
			if (playing && currentMode === "home") setMode("playback");
		};
		if (playerEl) {
			syncPlayerVisible();
			new MutationObserver(syncPlayerVisible).observe(playerEl, {
				attributes: true,
				attributeFilter: ["hidden"],
			});
		}

		// ── Home render ─────────────────────────────────────────
		const heroSection = document.querySelector("[data-livetv-resume]");
		const heroSkeleton = document.getElementById("livetv-resume-skeleton");
		const providerEmpty = document.getElementById("livetv-provider-empty");

		const hideHero = () => {
			heroSection?.setAttribute("hidden", "");
			heroSkeleton?.remove();
		};

		const fillRail = (railId, cards) => {
			const section = document.querySelector(`[data-livetv-rail="${railId}"]`);
			if (!section) return;
			const row = section.querySelector("[data-rail-row]");
			if (!row) return;
			row.replaceChildren();
			if (!cards.length) {
				section.setAttribute("hidden", "");
				return;
			}
			section.removeAttribute("hidden");
			for (const card of cards) row.appendChild(card);
			window.SpatialNavigation?.makeFocusable?.();
		};

		const cardFor = (channel, data, focusPrefix) => {
			const nn = nowNextForChannel(channel, data.programmes, data.playlistId);
			return buildChannelCardElement(channel, {
				nowTitle: nn.current?.title ?? undefined,
				nextTitle: nn.next?.title ?? undefined,
				progress: nn.current?.progress ?? undefined,
				catchup: channel.catchup,
				favourite: channel.favourite,
				size: "large",
				focusKey: `${focusPrefix}-${channel.id}`,
			});
		};

		const renderHome = async () => {
			const playlistId = readActivePlaylistId();
			if (!playlistId) {
				hideHero();
				for (const railId of ["favourites", "recents", "whats-on-now"]) {
					fillRail(railId, []);
				}
				document.querySelector("[data-livetv-collections]")?.setAttribute("hidden", "");
				providerEmpty?.removeAttribute("hidden");
				return;
			}
			providerEmpty?.setAttribute("hidden", "");
			let data;
			try {
				data = await loadLivetvHomeData(playlistId);
			} catch {
				hideHero();
				return;
			}
			if (!data.channels.length) {
				hideHero();
				providerEmpty?.removeAttribute("hidden");
				return;
			}

			// Resume setting (default OFF): straight to fullscreen
			// playback of the last channel. The tune handoff below
			// handles the actual tune (event + shell, no navigation).
			const params = new URLSearchParams(window.location.search);
			if (getLivetvResumeLastChannel() && !params.get("channel") && data.recents.length) {
				dispatchLivetvTune(data.recents[0].id);
				return;
			}

			// (A) Resume hero: last watched, else a favourite with a
			// live programme, else any favourite, else the first
			// channel with a live programme now. No history and no
			// favourite and nothing live → no hero (never invented).
			const recents = recentlyWatchedChannels(data.channels, data.recents);
			const favourites = favouriteChannels(data.channels);
			const heroPick = pickResumeHero(
				data.channels,
				data.recents,
				data.programmes,
				data.playlistId,
			);
			const heroChannel = heroPick?.channel ?? null;
			const heroEyebrow = heroPick?.eyebrow ?? "";
			heroSkeleton?.remove();
			if (heroChannel) {
				const nn = nowNextForChannel(heroChannel, data.programmes, data.playlistId);
				const eyebrow = heroSection?.querySelector("[data-hero-eyebrow]");
				if (eyebrow) eyebrow.textContent = heroEyebrow;
				const title = heroSection?.querySelector("[data-hero-title]");
				if (title) title.textContent = heroChannel.displayName || heroChannel.name;
				const logoMount = heroSection?.querySelector("[data-hero-logo]");
				if (logoMount) {
					logoMount.replaceChildren();
					if (heroChannel.logo) {
						const img = document.createElement("img");
						img.src = heroChannel.logo;
						img.alt = "";
						img.loading = "eager";
						img.decoding = "async";
						img.addEventListener("error", () => img.remove());
						logoMount.appendChild(img);
					} else {
						const fallback = document.createElement("span");
						fallback.className = "rs-livetv-home-hero__logo-fallback";
						fallback.setAttribute("aria-hidden", "true");
						fallback.textContent = (heroChannel.displayName || heroChannel.name || "?").slice(0, 1);
						logoMount.appendChild(fallback);
					}
				}
				const programmeMount = heroSection?.querySelector("[data-hero-programme]");
				if (programmeMount) {
					programmeMount.replaceChildren();
					if (nn.current) {
						const meta = buildProgrammeMetaElement({
							title: nn.current.title,
							startMs: nn.current.start,
							stopMs: nn.current.stop,
							desc: nn.current.desc || undefined,
							catchup: heroChannel.catchup,
							live: true,
						});
						if (meta) programmeMount.appendChild(meta);
					} else {
						const live = document.createElement("p");
						live.className = "rs-livetv-home-hero__next";
						live.textContent = "Live TV";
						programmeMount.appendChild(live);
					}
				}
				const nextEl = heroSection?.querySelector("[data-hero-next]");
				if (nextEl) {
					if (nn.next) {
						nextEl.textContent = `Up next: ${nn.next.title}`;
						nextEl.removeAttribute("hidden");
					} else {
						nextEl.setAttribute("hidden", "");
					}
				}
				const watchBtn = heroSection?.querySelector("[data-hero-watch]");
				if (watchBtn && !watchBtn.dataset.armed) {
					watchBtn.dataset.armed = "1";
					watchBtn.setAttribute("data-channel-id", String(heroChannel.id));
					watchBtn.addEventListener("click", () => {
						const id = watchBtn.getAttribute("data-channel-id");
						if (id == null) return;
						dispatchLivetvTune(/^\d+$/.test(id) ? Number(id) : id);
					});
				} else if (watchBtn) {
					watchBtn.setAttribute("data-channel-id", String(heroChannel.id));
				}
				heroSection?.removeAttribute("hidden");
			} else {
				hideHero();
			}

			// (B) Favourite Channels rail.
			fillRail(
				"favourites",
				favourites.map((c) => cardFor(c, data, "livetv-home-fav")),
			);
			// (C) Recently Watched rail (live only, deduped by id).
			fillRail(
				"recents",
				recents.map((c) => cardFor(c, data, "livetv-home-recent")),
			);
			// (D) What's On Now rail — hidden when no EPG.
			const whatsOn = data.hasEpg
				? whatsOnNow(data.channels, data.programmes, {
						playlistId: data.playlistId,
						favouriteIds: favourites.map((c) => c.id),
						watchedIds: recents.map((c) => c.id),
					})
				: [];
			fillRail(
				"whats-on-now",
				whatsOn.map((item) =>
					buildChannelCardElement(item.channel, {
						nowTitle: item.current.title,
						nextTitle: item.next?.title ?? undefined,
						progress: item.progress,
						catchup: item.channel.catchup,
						favourite: item.channel.favourite,
						size: "large",
						focusKey: `livetv-home-now-${item.channel.id}`,
					}),
				),
			);

			// (E) Channel Collections — LARGE cards from provider
			// groups, never hardcoded provider naming.
			const collectionsSection = document.querySelector("[data-livetv-collections]");
			const collectionsGrid = document.querySelector("[data-collections-grid]");
			if (collectionsSection && collectionsGrid) {
				const groups = groupChannels(data.channels).filter(
					(g) => g.id !== "all" && g.channels.length > 0,
				);
				collectionsGrid.replaceChildren();
				if (!groups.length) {
					collectionsSection.setAttribute("hidden", "");
				} else {
					collectionsSection.removeAttribute("hidden");
					for (const group of groups) {
						const card = document.createElement("button");
						card.type = "button";
						card.className = "rs-livetv-home-collection-card";
						card.setAttribute("data-collection-id", group.id);
						card.setAttribute("data-nylah-item", "");
						card.setAttribute("data-focus-key", `livetv-home-collection-${group.id}`);
						const label = document.createElement("span");
						label.className = "rs-livetv-home-collection-card__label";
						label.textContent = group.label;
						const count = document.createElement("span");
						count.className = "rs-livetv-home-collection-card__count";
						count.textContent = `${group.channels.length} channel${group.channels.length === 1 ? "" : "s"}`;
						const sample = document.createElement("span");
						sample.className = "rs-livetv-home-collection-card__sample";
						sample.setAttribute("aria-hidden", "true");
						for (const sampleChannel of group.channels.slice(0, 3)) {
							if (sampleChannel.logo) {
								const img = document.createElement("img");
								img.src = sampleChannel.logo;
								img.alt = "";
								img.loading = "lazy";
								img.decoding = "async";
								img.addEventListener("error", () => img.remove());
								sample.appendChild(img);
							} else {
								const mark = document.createElement("span");
								mark.textContent = (sampleChannel.displayName || sampleChannel.name || "?").slice(0, 1);
								sample.appendChild(mark);
							}
						}
						card.append(label, count, sample);
						card.addEventListener("click", () => {
							window.dispatchEvent(
								new CustomEvent("livetv:browser-category", {
									detail: { browserId: "home", categoryId: group.id },
								}),
							);
							document
								.getElementById("livetv-browser-section")
								?.scrollIntoView({ behavior: "smooth", block: "start" });
						});
						collectionsGrid.appendChild(card);
					}
					window.SpatialNavigation?.makeFocusable?.();
				}
			}
		};

		// Card select (rails): explicit Watch only — a click on a
		// card tunes, focus/hover never does.
		document
			.getElementById("livetv-mode-home")
			?.addEventListener("click", (event) => {
				const target = event.target;
				const card = target?.closest?.("[data-channel-card]");
				if (!card) return;
				if (target?.closest?.("a[href]")) return; // link navigates; the tune event is the handoff
				const id = card.getAttribute("data-channel-id");
				if (id == null) return;
				dispatchLivetvTune(/^\d+$/.test(id) ? Number(id) : id);
			});
		document
			.getElementById("livetv-mode-home")
			?.addEventListener("keydown", (event) => {
				if (event.key !== "Enter" && event.key !== " ") return;
				const target = event.target;
				const card = target?.closest?.("[data-channel-card]");
				if (!card || target?.closest?.("a[href],button")) return;
				event.preventDefault();
				const id = card.getAttribute("data-channel-id");
				if (id == null) return;
				dispatchLivetvTune(/^\d+$/.test(id) ? Number(id) : id);
			});

		// Initial mode: a persisted guide mode (W3's state module)
		// or ?mode=guide opens straight into the Guide — the Guide
		// self-activates on the same conditions, and this shell must
		// not hide its mount underneath it. An already-playing
		// player opens into playback (covers ?channel= deep links:
		// the engine tunes on load and unhides #player, and the
		// observer above flips the shell). Otherwise Home.
		// (Mode persistence across reloads is W3's state module's
		// job — this shell never restores playback on its own, or a
		// reload would land on an idle player.)
		const initialParams = new URLSearchParams(window.location.search);
		const initialMode =
			initialParams.get("mode") === "guide" ||
			restoreLivetvState().mode === "guide"
				? "guide"
				: !playerEl?.hasAttribute("hidden")
					? "playback"
					: "home";
		setMode(initialMode);
		void renderHome();

		// Favourites / recents change → re-render the Home rails.
		let rerenderTimer = null;
		const scheduleRerender = () => {
			if (rerenderTimer) clearTimeout(rerenderTimer);
			rerenderTimer = setTimeout(() => void renderHome(), 250);
		};
		document.addEventListener("xt:favorites-changed", scheduleRerender);
		document.addEventListener("xt:recents-changed", scheduleRerender);
	</script>
</CouchLayout>
