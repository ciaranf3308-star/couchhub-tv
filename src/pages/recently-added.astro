---
import Layout from "@/layouts/Layout.astro"
import RecentlyAddedView from "@/components/RecentlyAddedView.svelte"
---

<Layout pageTitle="Recently added">
  <main
    class="w-full max-w-480 mx-auto px-4 md:px-6 lg:px-8 pt-4 lg:pt-6 md:landscape:pt-6 pb-6
           flex flex-col gap-4 flex-1 min-h-0">

    <header class="route-hero shrink-0">
      <h1 data-i18n="page.recentlyAdded.heading" class="route-hero__title">Recently added</h1>
      <p data-i18n="page.recentlyAdded.sub" class="route-hero__sub">
        Latest movies and series from your active playlist, newest first.
      </p>
    </header>

    <RecentlyAddedView client:load />
  </main>

  <script>
    import "@/scripts/updater-startup.js"
  </script>

  <style>
    /* Nylah Studios v0.3.0 (w7) — RedSilk hero: Instrument Serif title. */
    .route-hero__title {
      font-family: var(--nylah-font-display, var(--font-serif, Georgia, "Times New Roman", serif));
    }
  </style>
</Layout>
