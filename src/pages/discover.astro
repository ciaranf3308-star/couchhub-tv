---
// RedSilk Discover (W2 reskin onto the W1 shared system): mood search
// + personalised rows over the household's own library. Local engine
// only — the AI ranker seam lives in src/scripts/lib/discover.ts and
// is wired by DiscoverView at mount (registerAIRanker + initAI).
import CouchLayout from "@/layouts/CouchLayout.astro";
import DiscoverView from "@/components/DiscoverView.svelte";
---

<CouchLayout pageTitle="Discover" activeNav="discover" view="discover">
  <header class="rs-discover-head">
    <h1 class="rs-page-title">Discover</h1>
    <p class="rs-meta">
      Personal picks from your own library — no account, no cloud, nothing invented.
    </p>
  </header>

  <DiscoverView client:load />
</CouchLayout>

<style>
  .rs-discover-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
</style>
