---
// Settings home (0.11.4 W1).
//
// The old single page (6,305 lines, 9,608px tall) is gone: each section is
// now its own short page under /settings/*, and this home lists them with
// a one-line description each. No "Quick settings", no "Advanced" split —
// one Settings, every control exactly one home. The search box in the
// shell filters this list in place (no scroll yank).
//
// Exit row at the bottom: W3 builds the Exit button itself; this page
// only provides the row and its placement.
import SettingsShell from "@/components/settings/SettingsShell.astro"
import { SETTINGS_SECTIONS } from "@/scripts/settings/settings-index.ts"
---

<SettingsShell
  title="Settings"
  titleKey="settings.title"
  sub="Playlists, preferences, cache, and the app itself."
  subKey="page.settings.sub"
  current="home">
  <div id="settings-home-list" class="flex flex-col gap-3">
    {
      SETTINGS_SECTIONS.map((section) => (
        <a
          class="settings-home-row"
          data-search={section.slug}
          data-search-text={`${section.title} ${section.desc} ${section.keywords}`.toLowerCase()}
          href={section.href}
          data-nylah-item
          {...(section.danger ? { "data-danger": "true" } : {})}>
          <span class="settings-home-row__text">
            <span class="settings-home-row__title" data-i18n={section.titleKey || undefined}>
              {section.title}
            </span>
            <span class="settings-home-row__desc">{section.desc}</span>
          </span>
          <span class="settings-home-row__chev" aria-hidden="true">›</span>
        </a>
      ))
    }

    <!-- Exit row (W3 owns the button — placement only). -->
    <div
      class="settings-home-row settings-home-row--exit"
      id="settings-exit-row"
      data-search-text="exit quit the app completely."
      data-w3-slot="exit-button">
      <span class="settings-home-row__text">
        <span class="settings-home-row__title">Exit</span>
        <span class="settings-home-row__desc">Quit the app completely.</span>
        <span class="settings-home-row__note">Exit button lands here (W3).</span>
      </span>
    </div>
  </div>
</SettingsShell>
