---
// CouchLayout — the RedSilk Couch TV app shell.
//
// Horizontal TOP navigation (no sidebar, no desktop chrome), content
// occupying most of the screen. Props: pageTitle, activeNav (nav id —
// defaults to couchNavIdFor(Astro.url.pathname)), view (data-couch-view
// marker for screen workers).
//
// Bootstraps the focus layer + gamepad + return-home:
//   - spatial-navigation.js (arrow-key spatial nav, incl. the "main"
//     section the dialog trap suspends),
//   - gamepad.ts (controller -> keyboard events + rail model),
//   - return-home.ts (View+Menu 2s / Ctrl+Alt+Home -> launcher),
//   - couch-focus.ts (focus memory, scroll-into-view, replacement).
// Couch Mode only — there is no legacy/desktop toggle.
//
// Styles: global.css FIRST (Tailwind utilities + @theme tokens, needed
// by reused Svelte pieces such as OnScreenKeyboard), then couch.css,
// which is scoped under html[data-couch] and forces color-scheme: dark
// so no light/white surface can ever show through.
import "../styles/global.css";
import "../styles/couch.css";
import pkg from "../../package.json";
import TvLogo from "@/components/couch/TvLogo.astro";
import TvButtonHints from "@/components/couch/TvButtonHints.astro";
import {
  COUCH_NAV_PRIMARY,
  COUCH_NAV_LIBRARY,
  COUCH_NAV_SETTINGS,
  couchNavIdFor,
} from "@/scripts/lib/couch-nav.ts";

interface Props {
  pageTitle?: string;
  activeNav?: string;
  view?: string;
  /**
   * Hide the shared button-hint legend: pages that mount their
   * own contextual hints (Live TV 0.11.7 mounts TvLivetvHints)
   * set this so exactly ONE hints bar renders.
   */
  hideButtonHints?: boolean;
}
const { pageTitle, activeNav, view, hideButtonHints } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const active = activeNav ?? couchNavIdFor(path) ?? "home";
const documentTitle = pageTitle
  ? `${pageTitle} | NylahBox Studios`
  : "NylahBox Studios";
---

<!doctype html>
<html lang="en" data-couch="1">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{documentTitle}</title>
    <meta name="x-app-version" content={pkg.version} />
    <meta name="theme-color" content="#170A0C" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Single fixed theme (0.11.1 settings cull) — parity with
      // Layout.astro / TvLayout.astro. Couch routes never ran a pre-paint
      // theme script: they relied solely on couch.css's
      // html[data-couch] { color-scheme: dark } rule. That rule holds in
      // the normal case — verified headless: even a forced light scheme
      // + violet accent cannot change the paint (the :root[data-couch]
      // leak guard pins every --color-* token to burgundy) — but a
      // pre-paint pin also covers the stylesheet-failure mode: if
      // couch.css fails to load, light-dark() tokens still resolve to
      // their dark branch instead of the light fuchsia wash.
      // This is hardening, NOT a fix for the 0.11.1 purple-wash report:
      // no in-bundle cause for that report was found (see the 0.11.2 W2
      // notes), so nothing here claims to fix it.
      try {
        document.documentElement.style.colorScheme = "dark";
        document.documentElement.setAttribute("data-accent", "burgundy");
        // Per-playlist override cache (playlist-accent.ts) wins over the
        // fixed accent. That is playlist data, not a theme setting.
        var KNOWN_ACCENTS = ["fuchsia", "rose", "ember", "emerald", "cyan", "blue", "violet", "gold", "burgundy", "lime", "teal", "silver", "white"];
        var activeAccentOverride = localStorage.getItem("xt_accent_active") || "";
        if (activeAccentOverride && KNOWN_ACCENTS.indexOf(activeAccentOverride) !== -1) {
          if (activeAccentOverride === "fuchsia") document.documentElement.removeAttribute("data-accent");
          else document.documentElement.setAttribute("data-accent", activeAccentOverride);
        }
      } catch (e) {}
    </script>
  </head>

  <body class="rs-body">
    <header class="rs-topnav" data-couch-nav>
      <a class="rs-brand" href="/" aria-label="NylahBox Studios — Home">
        <TvLogo variant="lockup" size="nav" />
      </a>
      <nav class="rs-nav" aria-label="Primary">
        <div class="rs-nav__row" data-nylah-rail="couch-nav">
          {
            COUCH_NAV_PRIMARY.map((item) => (
              <a
                class={`rs-nav__link${active === item.id ? " is-active" : ""}`}
                data-nylah-item
                href={item.href}
                aria-current={active === item.id ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
          <span class="rs-nav__group" role="group" aria-label="Library">
            <span class="rs-nav__group-label" aria-hidden="true">Library</span>
            {
              COUCH_NAV_LIBRARY.map((item) => (
                <a
                  class={`rs-nav__link${active === item.id ? " is-active" : ""}`}
                  data-nylah-item
                  href={item.href}
                  aria-current={active === item.id ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </span>
          <a
            class={`rs-nav__settings${active === COUCH_NAV_SETTINGS.id ? " is-active" : ""}`}
            data-nylah-item
            href={COUCH_NAV_SETTINGS.href}
            aria-current={active === COUCH_NAV_SETTINGS.id ? "page" : undefined}
          >
            ⚙ {COUCH_NAV_SETTINGS.label}
          </a>
          <!-- 0.11.4 W3: in-app Exit at the far end of the nav, after
               Settings. Two-step arm (click once to arm, again to
               exit) so a stray press can never quit; never on any
               playback OSD. Reachable by controller (D-pad + A) and
               mouse; Ctrl+Q is the keyboard path. -->
          <button
            type="button"
            id="couch-exit-btn"
            data-nylah-item
            class="rs-nav__settings rs-nav__exit"
            aria-label="Exit app"
            data-i18n-attr="aria-label:app.exit.navLabel"
          >
            ⏻ Exit
          </button>
        </div>
      </nav>
    </header>

    <main id="main" class="rs-main" data-couch-view={view ?? active}>
      <slot />
    </main>

    <!-- Shared Xbox button legend (W6): one component, per-screen
         configs from couch-button-hints.ts; contextual via `view` +
         html[data-livetv-mode]. Rendered here so every Couch screen
         gets it with no per-screen edits — unless the page mounts
         its own hints (hideButtonHints), so only one bar shows. -->
    {!hideButtonHints && <TvButtonHints view={view ?? active} />}

    <script>
      import "@/scripts/spatial-navigation";
      import { mountGamepad } from "@/scripts/lib/gamepad";
      import { mountNativeGamepad } from "@/scripts/lib/native-gamepad";
      import { mountReturnHome } from "@/scripts/lib/return-home";
      import { initCouchFocus } from "@/scripts/lib/couch-focus";
      import { initTrayHandler } from "@/scripts/lib/tray-handler";
      import { mountExitShortcuts, requestAppExit } from "@/scripts/lib/app-exit";
      mountGamepad();
      mountNativeGamepad();
      mountReturnHome();
      initCouchFocus();
      // 0.11.4 W3: tray hide-release + Ctrl+Q must boot on Couch
      // pages too — previously initTrayHandler only ran in the
      // classic Layout, so Home/Settings never synced close-to-tray
      // nor released the stream on hide.
      initTrayHandler();
      mountExitShortcuts();
      // Top-nav Exit button: two-step arm, same as the Settings card.
      (function () {
        var exitBtn = document.getElementById("couch-exit-btn");
        if (!exitBtn) return;
        var armed = false;
        var armTimer = null;
        exitBtn.addEventListener("click", function () {
          if (exitBtn.hasAttribute("disabled")) return;
          if (!armed) {
            armed = true;
            exitBtn.classList.add("is-armed");
            exitBtn.textContent = "Exit?";
            armTimer = setTimeout(function () {
              armed = false;
              exitBtn.classList.remove("is-armed");
              exitBtn.textContent = "⏻ Exit";
            }, 4000);
            return;
          }
          if (armTimer) clearTimeout(armTimer);
          armed = false;
          exitBtn.classList.remove("is-armed");
          exitBtn.setAttribute("disabled", "");
          exitBtn.textContent = "Exiting…";
          requestAppExit().finally(function () {
            // Web preview: quit is a no-op, re-enable the button.
            exitBtn.removeAttribute("disabled");
            exitBtn.textContent = "⏻ Exit";
          });
        });
      })();
      // Spatial navigation is the arrow-key focus engine every Couch
      // screen moves through. It was never initialised on this
      // layout — only the legacy Layout.astro and the TvLayout shell
      // call init() + add() — so the window keydown listener was
      // never attached and _sectionCount stayed 0: arrows (physical
      // keyboard AND the gamepad bridge's synthetic keys) did nothing
      // on Home / Live TV / Movies / Series / Discover / Search /
      // Settings. Same "main" section shape as Layout.astro; the
      // duplicate-add throw is swallowed so a script re-run is a
      // no-op, and makeFocusable re-runs on load for content mounted
      // after this script (Svelte views).
      const sn = window.SpatialNavigation;
      if (sn) {
        sn.init();
        try {
          sn.add({
            id: "main",
            selector:
              "a, button, summary, input, textarea, [contenteditable='true'], select, [tabindex]:not([tabindex='-1'])",
            // Reject fullscreen-occluded, inert, offscreen-parked, invisible, or faded-out player-chrome targets
            navigableFilter: (elem: Element) => {
              const fullscreenEl = document.fullscreenElement;
              if (fullscreenEl && !fullscreenEl.contains(elem)) return false;
              if (elem.closest("[inert]")) return false;
              const rect = elem.getBoundingClientRect();
              if (rect.right <= 0 || rect.bottom <= 0) return false;
              if (getComputedStyle(elem).visibility !== "visible") return false;
              const playerChrome = elem.closest(
                ".vjs-control-bar, .vjs-volume-vertical, .vjs-menu",
              );
              if (playerChrome && parseFloat(getComputedStyle(playerChrome).opacity) === 0) {
                return false;
              }
              return true;
            },
          });
        } catch {
          // Section already registered (script re-run): keep it.
        }
        sn.makeFocusable();
        window.addEventListener("load", () => {
          try {
            sn.makeFocusable();
          } catch {
            // Focus engine unavailable: mouse/touch keep working.
          }
        });
      }
    </script>
  </body>
</html>
