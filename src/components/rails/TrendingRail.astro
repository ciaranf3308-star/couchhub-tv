---
// TrendingRail — what's trending this week, matched to this library.
//
// Loads its own data client-side (see src/scripts/lib/trending.ts):
// Google Trends first, TMDb "Trending this week" as fallback. The title
// always names the source that is actually live; on any failure the rail
// degrades honestly (label shows, row hides, plain message shows) —
// never invented entries.
---
<section
  data-nylah-rail="trending"
  class="nylah-rail flex flex-col gap-3 shrink-0"
  data-rail="trending"
  aria-label="Trending this week">
  <div class="hub-section-head px-1">
    <div class="hub-section-head__title">
      <h2 class="hub-section-head__heading" data-rail-title>Trending this week</h2>
      <p class="text-sm text-fg-3" data-rail-subtitle>Matched to what's in your library</p>
    </div>
  </div>

  <ul
    data-rail-row
    style="display: none"
    class="flex gap-3 sm:gap-4 overflow-x-auto custom-scroll snap-x snap-mandatory py-3 -my-2 -mx-2 px-2">
  </ul>
  <p data-rail-empty class="px-1 py-6 text-sm text-fg-3">Loading trending titles…</p>
</section>

<script>
  import { getActiveEntry } from "@/scripts/lib/creds.js"
  import { ensureLoaded as ensurePrefsLoaded } from "@/scripts/lib/preferences.js"
  import { TMDB_SETTINGS_EVENT } from "@/scripts/lib/app-settings.js"
  import { loadTrending, trendingSourceLabel } from "@/scripts/lib/trending.ts"
  import { renderRailCards } from "@/scripts/lib/rail-card.ts"

  const section = document.querySelector('[data-rail="trending"]')
  if (section) {
    const row = section.querySelector<HTMLElement>("[data-rail-row]")!
    const titleEl = section.querySelector<HTMLElement>("[data-rail-title]")!
    const subtitleEl = section.querySelector<HTMLElement>("[data-rail-subtitle]")!
    const emptyEl = section.querySelector<HTMLElement>("[data-rail-empty]")!
    let cleanup: (() => void) | null = null
    let requestToken = 0

    function showEmpty(message) {
      if (cleanup) {
        cleanup()
        cleanup = null
      }
      row.style.display = "none"
      emptyEl.textContent = message
      emptyEl.hidden = false
    }

    function showRow(items) {
      emptyEl.hidden = true
      row.style.display = ""
      if (cleanup) cleanup()
      cleanup = renderRailCards(row, items)
    }

    async function reload() {
      const token = ++requestToken
      const active = await getActiveEntry()
      if (!active) {
        showEmpty("Sign in to your playlist to see what's trending.")
        return
      }
      await ensurePrefsLoaded()
      const result = await loadTrending(active._id)
      if (token !== requestToken) return

      titleEl.textContent = trendingSourceLabel(result.source)
      if (result.items.length) {
        subtitleEl.textContent =
          result.source === "google"
            ? "What's searched most on Google this week — matched to your library"
            : "From TMDb — matched to your library"
        showRow(result.items)
        return
      }
      subtitleEl.textContent = "Matched to what's in your library"
      if (result.reason === "no-library-match") {
        showEmpty("Nothing trending this week is in your library yet.")
      } else if (result.reason === "no-tmdb-key") {
        showEmpty(
          "Trending needs a TMDb key — add a free one in Settings, under TMDb."
        )
      } else {
        showEmpty("Couldn't load trending titles right now. Try again later.")
      }
    }

    reload()
    document.addEventListener("xt:active-changed", reload)
    document.addEventListener("xt:catalog-warmed", reload)
    document.addEventListener(TMDB_SETTINGS_EVENT, reload)
  }
</script>
