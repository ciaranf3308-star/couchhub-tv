---
// SuggestionsCiaranRail — picks for Ciaran, from what Ciaran watched.
//
// V1 similarity matching only (genre/category, cast, director) against the
// library — no LLM. See src/scripts/lib/suggestions.ts. Cold start is
// honest: with no watch history the rail says so instead of inventing
// picks.
---
<section
  data-nylah-rail="suggestions-ciaran"
  class="nylah-rail flex flex-col gap-3 shrink-0"
  data-rail="suggestions-ciaran"
  aria-label="Picked for Ciaran">
  <div class="hub-section-head px-1">
    <div class="hub-section-head__title">
      <h2 class="hub-section-head__heading">Picked for Ciaran</h2>
      <p class="text-sm text-fg-3" data-rail-subtitle>Based on what Ciaran watched — similar titles from your library</p>
    </div>
  </div>

  <ul
    data-rail-row
    style="display: none"
    class="flex gap-3 sm:gap-4 overflow-x-auto custom-scroll snap-x snap-mandatory py-3 -my-2 -mx-2 px-2">
  </ul>
  <p data-rail-empty class="px-1 py-6 text-sm text-fg-3">Loading picks for Ciaran…</p>
</section>

<script>
  import { getActiveEntry } from "@/scripts/lib/creds.js"
  import { ensureLoaded as ensurePrefsLoaded } from "@/scripts/lib/preferences.js"
  import { loadSuggestions } from "@/scripts/lib/suggestions.ts"
  import { renderRailCards } from "@/scripts/lib/rail-card.ts"
  import {
    observeSharedActivity,
    PROFILE_CHANGED_EVENT,
  } from "@/scripts/lib/profiles.ts"

  const section = document.querySelector('[data-rail="suggestions-ciaran"]')
  if (section) {
    const row = section.querySelector<HTMLElement>("[data-rail-row]")!
    const emptyEl = section.querySelector<HTMLElement>("[data-rail-empty]")!
    let cleanup: (() => void) | null = null
    let requestToken = 0

    function showEmpty(message) {
      if (cleanup) {
        cleanup()
        cleanup = null
      }
      row.style.display = "none"
      emptyEl.textContent = message
      emptyEl.hidden = false
    }

    function showRow(items) {
      emptyEl.hidden = true
      row.style.display = ""
      if (cleanup) cleanup()
      cleanup = renderRailCards(row, items)
    }

    async function reload() {
      const token = ++requestToken
      const active = await getActiveEntry()
      if (!active) {
        showEmpty("Sign in to your playlist to see picks for Ciaran.")
        return
      }
      await ensurePrefsLoaded()
      observeSharedActivity(active._id)
      const result = await loadSuggestions(active._id, "ciaran")
      if (token !== requestToken) return

      if (!result.hasHistory) {
        showEmpty("Watch something first and suggestions will appear here.")
        return
      }
      if (!result.items.length) {
        showEmpty("Nothing similar found in your library yet.")
        return
      }
      showRow(result.items)
    }

    reload()
    document.addEventListener("xt:active-changed", reload)
    document.addEventListener("xt:catalog-warmed", reload)
    document.addEventListener("xt:progress-changed", reload)
    document.addEventListener(PROFILE_CHANGED_EVENT, reload)
  }
</script>
