---
// TopRatedRail — the highest-rated titles already in the library.
//
// The rating is the provider-supplied `rating` field on each catalog row
// — the same value the app already renders as an IMDb rating elsewhere.
// There is no live IMDb lookup (IMDb has no free official API). Cutoff is
// 8.0 and up; see loadTopRated in src/scripts/lib/suggestions.ts.
---
<section
  class="flex flex-col gap-3 shrink-0"
  data-rail="top-rated"
  aria-label="Top rated">
  <div class="hub-section-head px-1">
    <div class="hub-section-head__title">
      <h2 class="hub-section-head__heading">Top rated</h2>
      <p class="text-sm text-fg-3" data-rail-subtitle>The highest-rated titles in your library — 8.0 and up</p>
    </div>
  </div>

  <ul
    data-rail-row
    style="display: none"
    class="flex gap-3 sm:gap-4 overflow-x-auto custom-scroll snap-x snap-mandatory py-3 -my-2 -mx-2 px-2">
  </ul>
  <p data-rail-empty class="px-1 py-6 text-sm text-fg-3">Loading top-rated titles…</p>
</section>

<script>
  import { getActiveEntry } from "@/scripts/lib/creds.js"
  import { ensureLoaded as ensurePrefsLoaded } from "@/scripts/lib/preferences.js"
  import { loadTopRated } from "@/scripts/lib/suggestions.ts"
  import { renderRailCards } from "@/scripts/lib/rail-card.ts"

  const section = document.querySelector('[data-rail="top-rated"]')
  if (section) {
    const row = section.querySelector<HTMLElement>("[data-rail-row]")!
    const emptyEl = section.querySelector<HTMLElement>("[data-rail-empty]")!
    let cleanup: (() => void) | null = null
    let requestToken = 0

    function showEmpty(message) {
      if (cleanup) {
        cleanup()
        cleanup = null
      }
      row.style.display = "none"
      emptyEl.textContent = message
      emptyEl.hidden = false
    }

    function showRow(items) {
      emptyEl.hidden = true
      row.style.display = ""
      if (cleanup) cleanup()
      cleanup = renderRailCards(row, items)
    }

    async function reload() {
      const token = ++requestToken
      const active = await getActiveEntry()
      if (!active) {
        showEmpty("Sign in to your playlist to see top-rated titles.")
        return
      }
      await ensurePrefsLoaded()
      const result = await loadTopRated(active._id)
      if (token !== requestToken) return

      if (!result.items.length) {
        showEmpty("Nothing rated 8.0 or higher in your library yet.")
        return
      }
      showRow(result.items)
    }

    reload()
    document.addEventListener("xt:active-changed", reload)
    document.addEventListener("xt:catalog-warmed", reload)
  }
</script>
