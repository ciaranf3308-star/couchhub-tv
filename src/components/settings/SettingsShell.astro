    .settings-page .settings-xpage__hit-section {
      font-size: 0.8125rem;
      color: var(--color-fg-2);
      white-space: nowrap;
    }
    /* Exit action row (0.11.24): the jump grid is gone, and the home
       Exit copy lives here instead — one compact row above Playlists,
       clearly an action (bad-tinted border, no section orb/head), not
       a section. The card inside keeps its own row styling; the
       wrapper only frames it and kills the card's top border so the
       two don't double up. */
    .settings-page .settings-exit-row {
      border: 1px solid color-mix(in oklch, var(--color-bad) 35%, var(--color-line));
      border-radius: 1rem;
      background: linear-gradient(165deg, var(--color-surface), var(--color-surface-2));
      padding: 0.25rem 1.25rem;
    }
    .settings-page .settings-exit-row .settings-row {
      border-top: 0;
    }
    /* One control pattern per kind (f): the segmented On/Off pill
       groups are the boolean pattern; keep them from wrapping awkwardly. */
    .settings-page .settings-seg {
      flex-wrap: wrap;
    }

    /* ── Single-page rebuild (0.11.23) ───────────────────────────────
       Section heads: a small glowing orb (the Orbology nod) + a serif
       display title + one plain-English line, with breathing room above
       so each group reads as a chapter, not the next grey row. The head
       itself is the anchor target, so it carries the scroll margin the
       sticky header would otherwise eat. */
    .settings-page .settings-section-head {
      display: flex;
      align-items: flex-start;
      gap: 0.9rem;
      margin: 3.25rem 0 1.1rem;
      /* No scroll-margin here: the single .settings-page [id] rule
