---
// TvQuickSurf — Quick Surf overlay for fullscreen Live TV playback (0.11.11).
//
// Controller-first, INSIDE fullscreen playback (not a page). Up/Down
// browses ADJACENT channels while the current video KEEPS PLAYING:
// the highlight and the tuned channel are SEPARATE state — moving
// the highlight never connects to a stream. A (Enter) tunes to the
// highlighted channel; B (Escape / `livetv:back`) dismisses WITHOUT
// changing channels. A failed tune leaves the current stream
// playing; the shell's error overlay (not Quick Surf) offers the
// retry.
//
// 0.11.11 shape (brief §3–§7): ONE compact floating panel docked
// right, video visible behind it — a short window of nearby
// channels (two before, highlighted, two after) as shared
// TvChannelRow tiles (rounded, hairline border, gap between rows),
// never cards-in-cards. The header names the panel, shows the
// currently relevant channel group, and the highlight's position
// WITHIN the current scope ("Irish & UK · 5 / 42") — never a bare
// "15319 / 15319" without category context. Each row: number,
// logo, name, current programme; the highlighted row also shows
// the next programme. A row click highlights; clicking the
// highlighted row tunes. Confirmed switches go through
// `switchChannel` — the prior stream is released before the
// replacement opens.
//
// The raw provider-category button wall is DELETED (0.11.11): the
// old paint() built one button per raw provider category on EVERY
// highlight change. Quick Surf never builds category buttons and
// never recalculates categories on highlight change. Discovery is
// four real focusable actions below the list — Favourites,
// Recently Watched, Categories, Search — which hand off to the
// playback Channel Browser (W2) via the seam contract below.
//
// Navigation is BOUNDED: at either end of the scoped list the
// highlight retains its position — it never wraps to the other
// end of a 15,319-channel catalogue. When a scope is selected,
// stepping stays inside that scope only. The surfable list
// resolves through the shared Live TV 2.0 category index
// (livetv-category-index.ts) when the scope or catalogue changes
// ONLY; per-press work is an index lookup plus a ≤5-entry slice.
//
// Focus zones (one keydown listener — the existing v0.11.10 shared
// pipeline, no second handler): the channel list is the default
// zone (Up/Down steps, A watches, B closes). Left/Right move
// focus into the discovery actions (Up/Down return to the list,
// Left/Right move between actions, A activates). Focus movement
// never tunes. X (Guide) intentionally falls through to the
// playback shell's handler — Quick Surf never claims it. Y is
// Quick Surf's own key while the panel is open (the shell's Y
// handler returns early over Quick Surf): Y dispatches the seam
// event with action 'browse', the unfiltered full-browser open.
//
// Seam contract with W2 (playback browser handoff, exact):
//   Quick Surf dispatches `quick-surf:open-browser` with detail
//   `{ action, channelId, categoryScope }` when a discovery action
//   activates (`action` is 'favourites' | 'recents' |
//   'categories' | 'search'; `channelId` is the tuned channel's
//   id or null; `categoryScope` is the current scope group id or
//   null). Y dispatches the same event with action 'browse'
//   (unfiltered full-browser open, focus on the tuned channel's
//   row). Quick Surf listens for `quick-surf:close` and closes
//   itself as the active input owner, leaving the tuned stream
//   untouched — W2 dispatches `quick-surf:close` FIRST, then
//   opens the browser after its mount resolves. B still closes
//   Quick Surf directly when no browser handoff is in flight. Additive inbound seam:
//   `quick-surf:set-scope { categoryScope }` sets the surf scope.
//
// Opens on `livetv:overlay {overlay:"quicksurf"}` and on ArrowUp /
// ArrowDown while playback is active with no overlay open. Channel
// data is cache-only (livetv-data.ts) — no fetch, no invented EPG.
import TvChannelRow from "./TvChannelRow.astro";
---

<section
  class="rs-livetv-play-quicksurf"
  data-livetv-quicksurf
  data-hidden="true"
  aria-label="Quick Surf"
  hidden
>
  <div class="rs-livetv-play-quicksurf__panel">
    <div class="rs-livetv-play-quicksurf__header">
      <div class="rs-livetv-play-quicksurf__titles">
        <p class="rs-livetv-play-quicksurf__eyebrow">» Quick Surf</p>
        <p class="rs-livetv-play-quicksurf__group" data-qs-group aria-label="Channel group"></p>
      </div>
      <p class="rs-livetv-play-quicksurf__position" data-qs-position aria-label="Position in channel list"></p>
    </div>
    <button type="button" class="rs-livetv-play-quicksurf__step" data-qs-step="-1" aria-label="Previous channel">⌃</button>
    <div class="rs-livetv-play-quicksurf__list" data-qs-list role="listbox" aria-label="Nearby channels"></div>
    <button type="button" class="rs-livetv-play-quicksurf__step" data-qs-step="1" aria-label="Next channel">⌄</button>
    <!-- 0.11.11 — the raw provider-category button wall is DELETED,
         not hidden: paint() must never generate a button per
         category. Discovery is these four focusable actions, which
         dispatch `quick-surf:open-browser` (see the seam contract
         in the file header) for the W2 playback browser. They are
         static markup — paint() never rebuilds them. -->
    <div class="rs-livetv-play-quicksurf__discovery" data-qs-discovery-actions role="group" aria-label="Discover">
      <button type="button" class="rs-livetv-play-quicksurf__discovery-action" data-qs-discovery="favourites">Favourites</button>
      <button type="button" class="rs-livetv-play-quicksurf__discovery-action" data-qs-discovery="recents">Recently Watched</button>
      <button type="button" class="rs-livetv-play-quicksurf__discovery-action" data-qs-discovery="categories">Categories</button>
      <button type="button" class="rs-livetv-play-quicksurf__discovery-action" data-qs-discovery="search">Search</button>
    </div>
    <p class="rs-livetv-play-quicksurf__shortcuts" aria-hidden="true">
      ↑↓ browse · ←→ discovery · A select · B back · X guide · Y browser
    </p>
  </div>

  <!-- Row template: the shared TvChannelRow, cloned per channel by
       paintRow (see the script). Rendered with placeholder props so
       every [data-row-*] hook exists in the clone; paintRow fills
       them and drops the parts a row does not need. -->
  <template data-qs-row-template>
    <TvChannelRow
      id=""
      chno={null}
      name="—"
      nowTitle=""
      nextTitle="—"
      progress={0}
      highlighted={true}
    />
  </template>
</section>

<script>
  import {
    confirmHighlight,
    recordTune,
    switchChannel,
    artworkUrlForSurf,
    windowPlaybackEngine,
    type SurfProgrammeArtwork,
  } from "@/scripts/lib/livetv-playback";
  import {
    loadLivetvChannels,
    loadLivetvProgrammes,
    nowNextForChannel,
    activeLivetvPlaylistId,
    type LivetvChannel,
  } from "@/scripts/lib/livetv-data";
  import {
    getCategoryIndex,
    type CategoryIndex,
  } from "@/scripts/lib/livetv-category-index";
  import {
    stepHighlightBounded,
    surfWindowBounded,
    resolveQuickSurfList,
    quickSurfScopeLabel,
    groupLabelForChannel,
    resolveHighlightInList,
    quickSurfPositionText,
    createQuickSurfOpenBrowserDetail,
    parseQuickSurfScopeDetail,
    isQuickSurfBrowserAction,
    QUICK_SURF_OPEN_BROWSER_EVENT,
    QUICK_SURF_CLOSE_EVENT,
    QUICK_SURF_SET_SCOPE_EVENT,
    QUICK_SURF_WINDOW_SIZE,
    type QuickSurfBrowserRequestAction,
  } from "@/scripts/lib/livetv-quicksurf";
  import { programmeProgress } from "@/scripts/lib/couch-livetv-epg";
  import { getFavorites } from "@/scripts/lib/preferences.js";

  const root = document.querySelector<HTMLElement>("[data-livetv-quicksurf]");
  if (root && !root.dataset.qsArmed) {
    root.dataset.qsArmed = "1";
    let channels: LivetvChannel[] = [];
    let programmes: Map<string, any> = new Map();
    let playlistId = "";
    let tunedId: string | number | null = null;
    let previousId: string | number | null = null;
    let highlightedId: string | number | null = null;
    // 0.11.11 — scope is a category-index GROUP id (or null for
    // the whole catalogue). The surfable list is resolved from the
    // shared index ONLY when the scope or catalogue changes, and
    // cached in `scopedList`; highlight moves never re-filter.
    let scopeGroupId: string | null = null;
    let categoryIndex: CategoryIndex | null = null;
    let scopedList: LivetvChannel[] = [];
    // Focus zone: "channels" (default — Up/Down steps the
    // highlight) or "actions" (the four discovery actions).
    // Left/Right switch zones; focus movement never tunes.
    let focusZone: "channels" | "actions" = "channels";
    let lastActionIndex = 0;
    let open = false;
    let loaded = false;

    const $ = <T extends Element>(sel: string): T | null =>
      root.querySelector<T>(sel);

    // Resolve the surfable list for the current scope. Called ONLY
    // on load and on scope change — never per press. The index is
    // held by reference so other surfaces sharing the global
    // category-index cache cannot force a rebuild here.
    const resolveScopedList = () => {
      if (!categoryIndex) {
        categoryIndex = getCategoryIndex(channels, `quicksurf:${playlistId}`);
      }
      scopedList = resolveQuickSurfList(categoryIndex, scopeGroupId);
      if (scopedList.length === 0 && channels.length > 0 && scopeGroupId !== null) {
        // Unknown or stale scope: fall back to All channels
        // rather than stranding the user on an empty surf.
        scopeGroupId = null;
        scopedList = resolveQuickSurfList(categoryIndex, null);
      }
    };

    const highlightedChannel = () =>
      scopedList.find((c) => String(c.id) === String(highlightedId)) ?? null;

    // ── Highlighted-row programme artwork (0.11.0 W5) ──────────
    // W2's enrichment module (`livetv-enrichment.ts`) is loaded
    // through import.meta.glob with an ABSOLUTE-from-root pattern:
    // a relative glob silently resolves empty inside an Astro
    // component script (see W6's guide loader), so the relative
    // form must not be used here. Only the HIGHLIGHTED row is ever
    // enriched (never the whole surf list): a cache peek paints
    // instantly, the async enrich fires only after the highlight
    // settles 250 ms, and a highlight move / close cancels the
    // pending work via the generation counter — moving the highlight
    // never fires a request and never paints onto a moved highlight.
    type EnrichmentModule = {
      enrichProgramme?: (req: {
        title: string;
        channelName?: string;
        startMs?: number;
        endMs?: number;
      }) => Promise<SurfProgrammeArtwork | null>;
      getProgrammeArtworkSync?: (title: string) => SurfProgrammeArtwork | null;
    };
    const enrichmentLoaders = import.meta.glob(
      "/src/scripts/lib/livetv-enrichment.ts",
    ) as Record<string, () => Promise<unknown>>;
    let enrichmentModule: EnrichmentModule | null | undefined;
    const loadEnrichment = async (): Promise<EnrichmentModule | null> => {
      if (enrichmentModule !== undefined) return enrichmentModule;
      const loader = Object.values(enrichmentLoaders)[0];
      if (!loader) {
        enrichmentModule = null;
        return null;
      }
      try {
        enrichmentModule = (await loader()) as EnrichmentModule;
      } catch {
        enrichmentModule = null;
      }
      return enrichmentModule;
    };

    let artGeneration = 0;
    let artTimer: ReturnType<typeof setTimeout> | null = null;
    let highlightedArtKey = "";
    let highlightedArtUrl: string | null = null;

    const paintHighlightedArt = (url: string | null) => {
      root.querySelectorAll("[data-row-art]").forEach((n) => n.remove());
      if (!url) return;
      const row = root.querySelector<HTMLElement>(".rs-channel-row--highlighted");
      if (!row) return;
      const span = document.createElement("span");
      span.className = "rs-channel-row__art";
      span.dataset.rowArt = "";
      span.setAttribute("aria-hidden", "true");
      const img = document.createElement("img");
      img.src = url;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      span.appendChild(img);
      row.appendChild(span);
    };

    const scheduleHighlightedArt = () => {
      const gen = ++artGeneration;
      if (artTimer !== null) {
        clearTimeout(artTimer);
        artTimer = null;
      }
      const channel = highlightedChannel();
      const nn = channel ? nowNextForChannel(channel, programmes, playlistId) : null;
      const title = nn?.current?.title ?? "";
      const key = channel && title ? `${String(channel.id)}::${title}` : "";
      // Same highlight, art already resolved: paint() rebuilt the
      // rows and wiped the thumb — repaint it, no new request.
      if (key && key === highlightedArtKey && highlightedArtUrl) {
        paintHighlightedArt(highlightedArtUrl);
        return;
      }
      highlightedArtKey = key;
      highlightedArtUrl = null;
      paintHighlightedArt(null);
      if (!channel || !title) return;
      void loadEnrichment().then((mod) => {
        if (!mod || gen !== artGeneration || !open) return;
        try {
          const cached = mod.getProgrammeArtworkSync?.(title) ?? null;
          const url = artworkUrlForSurf(cached);
          if (url) {
            highlightedArtUrl = url;
            paintHighlightedArt(url);
            return;
          }
        } catch {}
        artTimer = setTimeout(() => {
          artTimer = null;
          void Promise.resolve(
            mod.enrichProgramme?.({
              title,
              channelName: channel.displayName || channel.name,
              startMs: nn.current?.start,
              endMs: nn.current?.stop,
            }),
          )
            .then((art) => {
              if (gen !== artGeneration || !open) return;
              const url = artworkUrlForSurf(art ?? null);
              if (url) {
                highlightedArtUrl = url;
                paintHighlightedArt(url);
              }
            })
            .catch(() => {});
        }, 250);
      });
    };

    const readTunedFromShell = () => {
      // Integration 0.7.0: the tuned/previous ids live on the
      // playback shell section ([data-livetv-playback]), NOT on the
      // #livetv-mode-playback mount div (the section no longer
      // carries that id — exactly one in the DOM).
      const shell = document.querySelector<HTMLElement>("[data-livetv-playback]");
      const fromShell = shell?.dataset.tunedChannelId;
      if (fromShell !== undefined && fromShell !== "") tunedId = fromShell;
      const fromPrev = shell?.dataset.previousChannelId;
      if (fromPrev !== undefined && fromPrev !== "") previousId = fromPrev;
    };

    const isFavourite = (channel: LivetvChannel) => {
      try {
        return playlistId ? getFavorites(playlistId, "live").has(Number(channel.id)) : false;
      } catch {
        return false;
      }
    };

    // Rows come from the shared TvChannelRow template (one source
    // of truth for row markup): clone it, fill the [data-row-*]
    // hooks, drop the parts this row does not need (Next + progress
    // only exist on the highlighted row; the favourite heart only
    // where the channel is one). Never build row markup by hand.
    // EPG lookups here run ONLY for the ≤5 mounted rows, through
    // the memoised now/next path (Map + binary search) — never a
    // catalogue scan. Artwork enrichment stays highlighted-only
    // (scheduleHighlightedArt, with cancellation).
    const rowTemplate = root.querySelector<HTMLTemplateElement>(
      "[data-qs-row-template]",
    );

    const paintRow = (channel: LivetvChannel, isHighlighted: boolean) => {
      const tpl = rowTemplate?.content?.querySelector<HTMLElement>("[data-channel-row]");
      const row = (
        tpl ? (tpl.cloneNode(true) as HTMLElement) : document.createElement("button")
      ) as HTMLButtonElement;
      row.type = "button";
      row.classList.toggle("rs-channel-row--highlighted", isHighlighted);
      row.dataset.qsRow = "";
      row.dataset.channelId = String(channel.id);
      row.setAttribute("aria-selected", isHighlighted ? "true" : "false");
      if (isHighlighted) row.setAttribute("aria-current", "true");
      else row.removeAttribute("aria-current");

      const setText = (sel: string, text: string) => {
        const el = row.querySelector<HTMLElement>(sel);
        if (el) el.textContent = text;
      };
      setText("[data-row-num]", channel.chno != null ? String(channel.chno) : "");
      const logoSlot = row.querySelector<HTMLElement>("[data-row-logo]");
      if (logoSlot) {
        logoSlot.innerHTML = "";
        if (channel.logo) {
          const img = document.createElement("img");
          img.src = channel.logo;
          img.alt = "";
          img.loading = "lazy";
          logoSlot.appendChild(img);
        } else {
          const initial = document.createElement("span");
          initial.className = "rs-channel-row__initial";
          initial.textContent = (channel.displayName || channel.name || "?").slice(0, 1);
          logoSlot.appendChild(initial);
        }
      }
      setText("[data-row-name]", channel.displayName || channel.name || `#${channel.id}`);
      const nn = nowNextForChannel(channel, programmes, playlistId);
      setText("[data-row-now]", nn.current?.title ? `Now: ${nn.current.title}` : "");
      const nextEl = row.querySelector<HTMLElement>("[data-row-next]");
      if (isHighlighted && nn.next?.title) {
        if (nextEl) nextEl.textContent = `Next: ${nn.next.title}`;
      } else {
        nextEl?.remove();
      }
      const favEl = row.querySelector<HTMLElement>("[data-row-fav]");
      if (isFavourite(channel)) {
        if (!favEl) {
          const fav = document.createElement("span");
          fav.className = "rs-channel-row__fav";
          fav.textContent = "♥";
          fav.setAttribute("aria-label", "Favourite");
          row.appendChild(fav);
        }
      } else {
        favEl?.remove();
      }
      const bar = row.querySelector<HTMLElement>("[data-row-progress]");
      if (isHighlighted && nn.current) {
        if (bar) {
          bar.style.width = `${Math.round(programmeProgress(nn.current.start, nn.current.stop) * 100)}%`;
        }
      } else {
        bar?.closest(".rs-channel-row__progress")?.remove();
      }
      return row;
    };

    const paint = () => {
      const { entries, position, total } = surfWindowBounded(
        scopedList,
        highlightedId,
        QUICK_SURF_WINDOW_SIZE,
      );
      const listEl = $("[data-qs-list]");
      if (listEl) {
        listEl.innerHTML = "";
        for (const channel of entries) {
          listEl.appendChild(
            paintRow(channel, String(channel.id) === String(highlightedId)),
          );
        }
      }
      // Header: the currently relevant group + position WITHIN the
      // current scope. A scope shows its own label; unscoped, the
      // highlighted channel's group gives the position context.
      const groupEl = $("[data-qs-group]");
      if (groupEl) {
        groupEl.textContent =
          scopeGroupId !== null && categoryIndex
            ? quickSurfScopeLabel(categoryIndex, scopeGroupId)
            : groupLabelForChannel(highlightedChannel());
      }
      const posEl = $("[data-qs-position]");
      if (posEl) posEl.textContent = quickSurfPositionText(position, total);
      // Enrich the highlighted row's current programme artwork only
      // (never the whole list) — scheduleHighlightedArt is a no-op
      // until W2's module lands.
      scheduleHighlightedArt();
      // 0.11.10 W4 §12: paint() rebuilds the rows, destroying
      // the focused node — every U/D step lost DOM focus while
      // the highlight ring moved on. Re-focus the highlighted
      // row whenever the surf is open AND the channel list owns
      // focus, so focus and highlight never diverge (A then
      // confirms the focused row). Never yank focus out of the
      // discovery actions: when that zone owns focus, paint()
      // leaves it alone (the actions are static markup and
      // survive every repaint).
      // openSurf paints BEFORE show() sets `open`, so this
      // does not double-focus on open (show() focuses once).
      if (open && focusZone === "channels") {
        const highlighted =
          listEl?.querySelector<HTMLElement>(".rs-channel-row--highlighted");
        highlighted?.focus?.({ preventScroll: true });
      }
    };

    // ── Discovery actions → W2 playback browser (seam contract) ──
    const discoveryButtons = () =>
      [...root.querySelectorAll<HTMLElement>("[data-qs-discovery]")];

    const focusDiscoveryAction = (index: number) => {
      const buttons = discoveryButtons();
      if (!buttons.length) return;
      lastActionIndex = Math.max(0, Math.min(index, buttons.length - 1));
      buttons[lastActionIndex]?.focus?.({ preventScroll: true });
    };

    const focusHighlightedRow = () => {
      const highlighted =
        root.querySelector<HTMLElement>(".rs-channel-row--highlighted");
      highlighted?.focus?.({ preventScroll: true });
    };

    const openBrowser = (action: QuickSurfBrowserRequestAction) => {
      // Exact seam detail: the tuned channel's id (or null) and
      // the current scope group id (or null). Quick Surf does NOT
      // hide itself here — W2's browser closes it via
      // `quick-surf:close` (or the `livetv:overlay` browser claim),
      // and B still closes it directly while no handoff is in
      // flight. No tune happens on this path.
      window.dispatchEvent(
        new CustomEvent(QUICK_SURF_OPEN_BROWSER_EVENT, {
          detail: createQuickSurfOpenBrowserDetail(action, tunedId, scopeGroupId),
        }),
      );
    };

    const emitOverlay = (overlay: string) => {
      window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay } }));
    };

    const show = () => {
      open = true;
      root.hidden = false;
      root.dataset.hidden = "false";
      emitOverlay("quicksurf");
      const first = root.querySelector<HTMLElement>(".rs-channel-row--highlighted");
      first?.focus?.({ preventScroll: true });
    };

    const hide = (dispatch = true) => {
      open = false;
      artGeneration++; // cancel any pending highlighted-row enrichment
      if (artTimer !== null) {
        clearTimeout(artTimer);
        artTimer = null;
      }
      // 0.11.10 W4: focus inside the panel must not survive the
      // hide — a hidden focused node strands the controller.
      // Blur BEFORE hiding so focus lands cleanly on <body>,
      // where the shell's playback keys (and the next surf
      // open) work from.
      const active = document.activeElement as HTMLElement | null;
      if (active && root.contains(active)) active.blur();
      root.hidden = true;
      root.dataset.hidden = "true";
      if (dispatch) emitOverlay("none");
    };

    const ensureLoaded = async () => {
      if (loaded) return;
      loaded = true;
      try {
        playlistId = await activeLivetvPlaylistId();
        channels = await loadLivetvChannels();
        programmes = await loadLivetvProgrammes();
      } catch {
        channels = [];
        programmes = new Map();
      }
    };

    const openSurf = async () => {
      await ensureLoaded();
      readTunedFromShell();
      resolveScopedList();
      // Highlight starts on the tuned channel (or the previous
      // highlight when it is still inside the scope); browsing
      // from there is adjacent stepping. Highlighting never tunes.
      highlightedId = resolveHighlightInList(scopedList, highlightedId, tunedId);
      focusZone = "channels";
      paint();
      show();
    };

    const tuneHighlighted = () => {
      const target = confirmHighlight(highlightedId);
      if (target === null) return;
      // A tune, not a highlight move: only now does the engine
      // connect — and the prior stream is released first
      // (switchChannel), so the one-stream limit is never exceeded.
      // tunedId/previousId update via the `livetv:tune` listener
      // below (the event dispatches synchronously) — updating them
      // here too would overwrite previousId with the new tune.
      if (switchChannel(windowPlaybackEngine, tunedId, target)) {
        hide();
      }
    };

    const tuneTo = (target: string | number) => {
      if (switchChannel(windowPlaybackEngine, tunedId, target)) {
        hide();
      }
    };

    // Focus truth for Tab / pointer focus as well as the D-pad:
    // whichever zone holds DOM focus owns the arrows. Without
    // this, tabbing into a discovery action would leave the
    // channel zone claiming Up/Down and paint() yanking focus
    // back to the highlighted row.
    root.addEventListener("focusin", (ev) => {
      const target = ev.target as HTMLElement | null;
      if (!target) return;
      const discovery = target.closest?.("[data-qs-discovery]") as HTMLElement | null;
      if (discovery) {
        focusZone = "actions";
        const at = discoveryButtons().indexOf(discovery);
        if (at >= 0) lastActionIndex = at;
        return;
      }
      if (target.closest?.("[data-qs-row]")) focusZone = "channels";
    });

    root.addEventListener("click", async (ev) => {
      // Discovery actions: hand off to the playback browser (W2)
      // via the seam contract — never a tune, never a category
      // button rebuild.
      const discoveryBtn = (ev.target as HTMLElement | null)?.closest?.("[data-qs-discovery]") as HTMLElement | null;
      if (discoveryBtn) {
        const action = discoveryBtn.dataset.qsDiscovery;
        if (isQuickSurfBrowserAction(action)) {
          const at = discoveryButtons().indexOf(discoveryBtn);
          if (at >= 0) lastActionIndex = at;
          openBrowser(action);
        }
        return;
      }
      // Step chevrons (^ / v above and below the list): move the
      // highlight one adjacent channel, never a tune. Bounded:
      // at either end the highlight retains its position.
      const stepBtn = (ev.target as HTMLElement | null)?.closest?.("[data-qs-step]") as HTMLElement | null;
      if (stepBtn) {
        const delta = stepBtn.dataset.qsStep === "-1" ? -1 : 1;
        const next = stepHighlightBounded(scopedList, highlightedId, delta as 1 | -1);
        if (next !== null) {
          highlightedId = next;
          paint();
        }
        return;
      }
      // Row click: highlight only — unless the row is already the
      // highlight, in which case the click confirms (tunes).
      const row = (ev.target as HTMLElement | null)?.closest?.("[data-qs-row]") as HTMLElement | null;
      if (row?.dataset.channelId) {
        const id = row.dataset.channelId;
        const canonical = scopedList.find((c) => String(c.id) === id)?.id ?? id;
        if (String(highlightedId) === id) {
          tuneTo(canonical);
        } else {
          highlightedId = canonical;
          paint();
        }
        return;
      }
    });

    window.addEventListener("livetv:overlay", (ev) => {
      const overlay = (ev as CustomEvent).detail?.overlay;
      if (overlay === "quicksurf" && !open) void openSurf();
      if (overlay !== "quicksurf" && open) hide(false);
    });

    // Seam contract: the playback browser (W2) closes Quick Surf
    // when it takes input ownership — W2 dispatches
    // `quick-surf:close` FIRST, then opens the browser after its
    // mount resolves. hide(false): no `livetv:overlay "none"`
    // emit to fight the browser's overlay claim, focus blurs to
    // <body> (the browser focuses the tuned channel's row once
    // mounted), and the tuned stream is untouched. B still closes
    // Quick Surf directly (keydown / shell back path) when no
    // browser handoff is in flight.
    window.addEventListener(QUICK_SURF_CLOSE_EVENT, () => {
      if (!open) return;
      hide(false);
    });

    // Additive inbound seam: a scope chosen in the browser
    // (`quick-surf:set-scope { categoryScope }`) re-scopes the
    // surf. Ignored when the detail carries no usable scope or
    // the scope is unchanged. The list re-resolves ONLY here (and
    // on load) — never per press. When closed, the scope is
    // stored and applied on the next open.
    window.addEventListener(QUICK_SURF_SET_SCOPE_EVENT, (ev) => {
      const scope = parseQuickSurfScopeDetail((ev as CustomEvent).detail);
      if (scope === undefined || scope === scopeGroupId) return;
      scopeGroupId = scope;
      if (!loaded) return;
      resolveScopedList();
      highlightedId = resolveHighlightInList(scopedList, highlightedId, tunedId);
      if (open) paint();
    });

    window.addEventListener("livetv:tune", (ev) => {
      const id = (ev as CustomEvent).detail?.channelId;
      if (id !== undefined && id !== null) {
        const record = recordTune(tunedId, previousId, id);
        tunedId = record.tunedId;
        previousId = record.previousId;
      }
    });

    window.addEventListener("keydown", (ev) => {
      const playbackActive =
        document.documentElement.dataset.livetvMode === "playback";
      if (!playbackActive) return;
      if (ev.target instanceof HTMLInputElement || ev.target instanceof HTMLTextAreaElement) return;
      if (open) {
        // X (Guide) intentionally falls through to the playback
        // shell's handler — Quick Surf never claims it.
        // Y is Quick Surf's own key while the panel is open: the
        // shell's Y handler returns early over Quick Surf
        // (overlay-owns-input discipline, W2), so without this
        // branch Y-from-Quick-Surf would do nothing. Y dispatches
        // the seam event with action 'browse' (unfiltered
        // full-browser open, focus on the tuned channel's row)
        // from EITHER focus zone. preventDefault keeps the shell
        // from ALSO firing its legacy browser-overlay path.
        if (ev.key === "y" || ev.key === "Y") {
          ev.preventDefault();
          openBrowser("browse");
          return;
        }
        if (focusZone === "actions") {
          if (ev.key === "ArrowLeft" || ev.key === "ArrowRight") {
            ev.preventDefault();
            focusDiscoveryAction(lastActionIndex + (ev.key === "ArrowRight" ? 1 : -1));
          } else if (ev.key === "ArrowUp" || ev.key === "ArrowDown") {
            ev.preventDefault();
            focusZone = "channels";
            focusHighlightedRow();
          } else if (ev.key === "Enter") {
            // A on a focused action button clicks it; Enter with
            // focus elsewhere activates the last-used action.
            const target = ev.target as HTMLElement | null;
            if (target && target.closest("button")) return;
            ev.preventDefault();
            const action = discoveryButtons()[lastActionIndex]?.dataset.qsDiscovery;
            if (isQuickSurfBrowserAction(action)) openBrowser(action);
          } else if (ev.key === "Escape") {
            // B dismisses WITHOUT changing channels — no tune here.
            ev.preventDefault();
            hide();
          }
          return;
        }
        if (ev.key === "ArrowUp" || ev.key === "ArrowDown") {
          ev.preventDefault();
          // Bounded: at either end stepHighlightBounded returns
          // null and the highlight retains its position — no
          // wrap to the other end of the catalogue, no repaint.
          const next = stepHighlightBounded(scopedList, highlightedId, ev.key === "ArrowDown" ? 1 : -1);
          if (next !== null) {
            highlightedId = next;
            paint();
          }
        } else if (ev.key === "Enter") {
          // A on a focused button clicks it; Enter with focus on a
          // row / panel confirms the highlight.
          const target = ev.target as HTMLElement | null;
          if (target && target.closest("button")) return;
          ev.preventDefault();
          tuneHighlighted();
        } else if (ev.key === "Escape") {
          // B dismisses WITHOUT changing channels — no tune here.
          ev.preventDefault();
          hide();
        } else if (ev.key === "ArrowLeft" || ev.key === "ArrowRight") {
          // 0.11.11: Left/Right move focus into the discovery
          // actions (Up/Down return to the list). The pre-0.11.11
          // claimed no-op is repurposed — the actions must be
          // controller-reachable, and no other directional input
          // is free. Focus movement never tunes; programme info
          // stays on the rows, and the shell's Left/Right → OSD
          // path still owns the arrows once the surf closes.
          ev.preventDefault();
          focusZone = "actions";
          focusDiscoveryAction(lastActionIndex);
        }
        return;
      }
      // Closed: Up/Down opens Quick Surf (highlight starts on the
      // tuned channel) instead of zapping — browsing never tunes.
      if (ev.key === "ArrowUp" || ev.key === "ArrowDown") {
        // 0.11.10 W4: never open over another overlay, or after
        // a handled key. The old branch opened the surf over
        // the options/browser/error overlays — the browser's
        // handler runs after this one, so its preventDefault
        // came too late and both surfaces owned the arrows.
        if (ev.defaultPrevented) return;
        const overlayVisible = (selector: string) => {
          const el = document.querySelector<HTMLElement>(selector);
          return !!el && !el.hidden;
        };
        if (
          overlayVisible("[data-livetv-options]") ||
          overlayVisible("[data-livetv-play-browser]") ||
          overlayVisible("[data-livetv-error]")
        ) {
          return;
        }
        ev.preventDefault();
        void openSurf();
      }
    });
  }
</script>
