---
// TvLivetvSortOverlay — Live TV 2.0 Sort overlay (0.11.7, W4).
//
// ONE simple controller-friendly sort overlay: Provider order,
// A–Z, Z–A, Category order. No filters, no extra controls. It
// renders hidden and opens ONLY on `livetv:open-sort`
// (dispatched by W2's browser with the current sort, when
// known). Selecting an order dispatches `livetv:sort-submit`
// { sort } (which also persists the selection, so reopening
// the browser keeps the order picked) and closes. Closing
// without a selection (B / Escape / Cancel / scrim) dispatches
// `livetv:close-overlay` { overlay: "sort", reason } and
// changes nothing.
//
// Controller: D-pad Up/Down moves between the four orders, A /
// Enter selects, B closes without changing. The current order
// is pre-selected and focused on open. Physical keyboard:
// arrows + Enter, Escape closes. Mouse: click an order, or
// Cancel / the scrim to close unchanged.
//
// Mount contract: mount ONCE per Live TV page (integration).
// The component wires itself on load; a second instance on the
// same page is ignored (the first [data-livetv-sort-overlay]
// wins). Requires the Live TV nav singleton (livetvNav) only —
// no shell changes.
import "@/styles/livetv-nav-chrome.css";
import { LIVETV_SORT_OPTIONS } from "@/scripts/lib/livetv-search-sort.ts";
---

<div
  class="lv2-overlay lv2-sort"
  data-livetv-sort-overlay
  role="dialog"
  aria-modal="true"
  aria-labelledby="lv2-sort-title"
  hidden
>
  <div class="lv2-overlay__scrim" data-livetv-sort-scrim></div>
  <div class="lv2-overlay__panel lv2-sort__panel">
    <div class="lv2-sort__head">
      <h2 class="lv2-sort__title" id="lv2-sort-title">Sort channels</h2>
      <p class="lv2-sort__note">Choose how channels are ordered.</p>
    </div>

    <div
      class="lv2-sort__options"
      data-livetv-sort-options
      role="radiogroup"
      aria-label="Sort order"
    >
      {
        LIVETV_SORT_OPTIONS.map((option) => (
          <button
            type="button"
            class="lv2-sort__option"
            data-livetv-sort-option={option.value}
            role="radio"
            aria-checked="false"
          >
            <span class="lv2-sort__option-label">{option.label}</span>
            <span class="lv2-sort__option-check" aria-hidden="true">✓</span>
          </button>
        ))
      }
    </div>

    <div class="lv2-sort__actions">
      <button
        type="button"
        class="lv2-sort__action"
        data-livetv-sort-cancel
      >
        Cancel
      </button>
    </div>
  </div>
</div>

<script>
  import {
    livetvNav,
    installTopLayerBackGuard,
  } from "@/scripts/lib/livetv-nav.ts";
  import {
    LIVETV_OPEN_SORT_EVENT,
    LIVETV_DEFAULT_SORT,
    dispatchLivetvCloseOverlay,
    dispatchLivetvSortSubmit,
    parseOpenSortDetail,
    readPersistedLivetvSort,
    type LivetvSortValue,
  } from "@/scripts/lib/livetv-search-sort.ts";

  const root = document.querySelector<HTMLElement>("[data-livetv-sort-overlay]");
  if (root && !root.dataset.wired) {
    root.dataset.wired = "1";
    const optionButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-livetv-sort-option]"),
    );
    const scrim = root.querySelector<HTMLElement>("[data-livetv-sort-scrim]");
    const cancelButton = root.querySelector<HTMLButtonElement>("[data-livetv-sort-cancel]");

    let isOpen = false;
    let selected: LivetvSortValue = LIVETV_DEFAULT_SORT;
    let closeReason: "back" | "cancel" = "back";
    let submitted = false;

    function syncOptions(): void {
      for (const button of optionButtons) {
        const value = button.dataset.livetvSortOption as LivetvSortValue;
        button.setAttribute("aria-checked", value === selected ? "true" : "false");
      }
    }

    function hide(): void {
      root.hidden = true;
      isOpen = false;
    }

    function onNavExit(): void {
      // Runs inside pop()/back(): hide, then report the close.
      // A selection already dispatched its own event and must
      // not also dispatch close-overlay.
      const wasSubmitted = submitted;
      hide();
      if (!wasSubmitted) {
        dispatchLivetvCloseOverlay(window, { overlay: "sort", reason: closeReason });
      }
    }

    function dismiss(): void {
      if (livetvNav.isTop("sort")) {
        livetvNav.pop();
      } else {
        // Invariant: sort is always the top layer while open.
        // If something else got above it, hide without touching
        // the stack rather than popping the wrong layer.
        hide();
      }
    }

    function open(detail: unknown): void {
      const parsed = parseOpenSortDetail(detail);
      // The open event names the current sort when the browser
      // knows it; otherwise the persisted selection wins over
      // the default, so the overlay always shows the order the
      // browser is actually using.
      selected =
        detail != null &&
        typeof detail === "object" &&
        ((detail as Record<string, unknown>)["sort"] != null ||
          (detail as Record<string, unknown>)["currentSort"] != null)
          ? parsed.sort
          : readPersistedLivetvSort();
      syncOptions();
      closeReason = "back";
      submitted = false;
      root.hidden = false;
      isOpen = true;
      livetvNav.push({
        id: "sort",
        onExit: () => onNavExit(),
      });
      requestAnimationFrame(() => {
        const current = optionButtons.find(
          (button) => button.dataset.livetvSortOption === selected,
        );
        (current ?? optionButtons[0])?.focus({ preventScroll: true });
      });
    }

    function choose(value: LivetvSortValue): void {
      selected = value;
      syncOptions();
      // Persists the selection as well as dispatching it.
      dispatchLivetvSortSubmit(window, { sort: value });
      submitted = true;
      dismiss();
    }

    function cancel(reason: "back" | "cancel"): void {
      closeReason = reason;
      dismiss();
    }

    window.addEventListener(LIVETV_OPEN_SORT_EVENT, (event) => {
      open((event as CustomEvent).detail);
    });

    // B from the gamepad layer, routed through the nav stack:
    // consumed here only while sort is the top layer, and
    // stopped so no hidden layer pops a second layer.
    installTopLayerBackGuard(livetvNav, "sort", window);

    root.addEventListener("keydown", (event) => {
      if (!isOpen) return;
      const target = event.target as HTMLElement | null;
      if (event.key === "Escape") {
        event.preventDefault();
        event.stopPropagation();
        livetvNav.back();
        return;
      }
      if (
        (event.key === "ArrowDown" || event.key === "ArrowUp") &&
        target?.closest?.("[data-livetv-sort-options]")
      ) {
        const current = optionButtons.indexOf(target as HTMLButtonElement);
        if (current >= 0) {
          // stopPropagation is load-bearing: SpatialNavigation
          // (the global arrow-key engine) listens on window and
          // ignores defaultPrevented — without it, one ArrowDown
          // would move focus twice (here AND spatially).
          event.preventDefault();
          event.stopPropagation();
          const delta = event.key === "ArrowDown" ? 1 : -1;
          const next =
            optionButtons[
              (current + delta + optionButtons.length) % optionButtons.length
            ];
          next?.focus({ preventScroll: true });
        }
        return;
      }
      // Enter/Space on an option fires click natively; the click
      // handler below does the choosing.
    });

    for (const button of optionButtons) {
      button.addEventListener("click", () => {
        choose(button.dataset.livetvSortOption as LivetvSortValue);
      });
    }
    cancelButton?.addEventListener("click", () => cancel("cancel"));
    scrim?.addEventListener("click", () => cancel("cancel"));
  }
</script>

<style>
  .lv2-sort__panel {
    width: min(40rem, 100%);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .lv2-sort__head {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .lv2-sort__title {
    margin: 0;
    font-family: var(--rs-font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--rs-text);
  }
  .lv2-sort__note {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--rs-text-2);
  }
  .lv2-sort__options {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .lv2-sort__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 4rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.5rem;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
  }
  .lv2-sort__option[aria-checked="true"] {
    border-color: var(--rs-accent);
    background: var(--rs-surface-2);
    box-shadow: inset 0 0 0 1px var(--rs-accent);
  }
  .lv2-sort__option-check {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--rs-focus);
    visibility: hidden;
  }
  .lv2-sort__option[aria-checked="true"] .lv2-sort__option-check {
    visibility: visible;
  }
  .lv2-sort__option:focus-visible {
    outline: none;
    border-color: var(--rs-focus);
    box-shadow:
      0 0 0 3px var(--rs-focus),
      0 0 1.5rem 0.25rem var(--rs-focus-glow);
  }
  .lv2-sort__actions {
    display: flex;
    gap: 0.75rem;
  }
  .lv2-sort__action {
    min-height: 3.75rem;
    padding: 0.625rem 1.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.375rem;
    font-weight: 700;
    cursor: pointer;
  }
  .lv2-sort__action:focus-visible {
    outline: none;
    border-color: var(--rs-focus);
    box-shadow:
      0 0 0 3px var(--rs-focus),
      0 0 1.5rem 0.25rem var(--rs-focus-glow);
  }
  @media (min-width: 2560px) {
    .lv2-sort__title {
      font-size: 2.5rem;
    }
    .lv2-sort__option {
      font-size: 1.75rem;
    }
  }
</style>
