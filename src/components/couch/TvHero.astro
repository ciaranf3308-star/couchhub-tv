---
// TvHero — cinematic hero (W3 production pass).
// Props: title, meta?, description?, backdrop?, backdropAlt?,
// eyebrow?, badge? (short label such as "New" or "Live" — one accent,
// never a competing colour), primaryAction? { label, href },
// secondaryAction? { label, href }.
// Title is 48–64px at 1920x1080 (see couch.css .rs-hero-title).
// The hero is 40–45% of the initial viewport; the backdrop dominates
// the right side under the burgundy scrim (couch.css), text stays
// left-aligned and readable. No autoplaying video, ever.
import TvImage from "./TvImage.astro";

interface HeroAction {
  label: string;
  href: string;
}
interface Props {
  title: string;
  meta?: string;
  description?: string;
  backdrop?: string;
  backdropAlt?: string;
  eyebrow?: string;
  badge?: string;
  primaryAction?: HeroAction;
  secondaryAction?: HeroAction;
}
const {
  title,
  meta,
  description,
  backdrop,
  backdropAlt,
  eyebrow,
  badge,
  primaryAction,
  secondaryAction,
} = Astro.props;
---

<section class="rs-hero" data-nylah-hero aria-label={title}>
  <div class="rs-hero__backdrop" aria-hidden="true">
    <TvImage
      src={backdrop}
      alt={backdropAlt ?? ""}
      kind="backdrop"
      title={title}
      eager
    />
  </div>
  <div class="rs-hero__scrim" aria-hidden="true"></div>
  <div class="rs-hero__content">
    {badge && <span class="rs-hero__badge">{badge}</span>}
    {eyebrow && <span class="rs-hero__eyebrow">{eyebrow}</span>}
    <h1 class="rs-hero-title">{title}</h1>
    {meta && <p class="rs-hero__meta">{meta}</p>}
    {description && <p class="rs-hero__description">{description}</p>}
    {
      (primaryAction || secondaryAction) && (
        <div class="rs-hero__actions">
          {primaryAction && (
            <a class="rs-hero__action" data-nylah-item href={primaryAction.href}>
              ▶ {primaryAction.label}
            </a>
          )}
          {secondaryAction && (
            <a
              class="rs-hero__action rs-hero__action--secondary"
              data-nylah-item
              href={secondaryAction.href}
            >
              {secondaryAction.label}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  /* Production pass — hero presence: 40–45% of the initial viewport.
     Scoped to TvHero; the shared hero tokens stay in couch.css (W1). */
  .rs-hero {
    min-height: clamp(24rem, 42vh, 34rem);
  }
  /* Badge: same single accent as the card badge, no new colour. */
  .rs-hero__badge {
    align-self: flex-start;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--rs-accent);
    color: var(--rs-text);
  }
</style>
