---
// TvButtonHints — the ONE shared Xbox button legend for Couch screens.
//
// Bottom-anchored, subtle, burgundy-on-dark, Manrope. One component,
// many configs: the per-screen configs live in
// src/scripts/lib/couch-button-hints.ts (audited against gamepad.ts +
// the per-screen handlers — a hint appears ONLY where its handler
// really does something on that screen).
//
// Context switching is client-side and needs no per-screen wiring:
// the layout passes `view` (main[data-couch-view]); Live TV modes
// come from html[data-livetv-mode]; a focused text field switches to
// the minimal editing legend (only B + View+Menu work while typing,
// per gamepad.ts) and focus on an on-screen keyboard key switches to
// the OSK legend (A types, B closes the keyboard, the ⌫ key deletes,
// the Clear key clears — B never deletes, see couch-keyboard.ts).
// Controller 2.0 (§42): a surface that owns input claims the legend
// via setControllerHints() and its config wins over the view-derived
// one until it clears (null) — hints always name the actual owner.
// Two exceptions (0.11.24, GAP 6): a focused text field always wins
// with the minimal editing legend (only B + View+Menu work while
// typing), and a modal hides the legend unless the modal itself
// claimed it after opening (a page-level claim must not keep stale
// hints up over a dialog).
// The legend hides while a modal dialog owns input,
// and in fullscreen playback while the OSD or any playback overlay
// (options / Quick Surf / channel browser / error) is visible — those
// surfaces already name their own keys (OSD shortcuts line, overlay
// buttons), so the legend would only duplicate them over the video.
// While Controller Cursor Mode is active (0.11.10 W6,
// html[data-cursor-mode="active"]) the legend shows the cursor hint
// set (CURSOR_MODE_HINTS) instead of the view's config.
// html[data-cursor-scroll] (0.11.14 W2, change-only) is observed
// too, so scroll-availability flips re-render the legend.
// View+Menu held 2 s = return home is global and is never hidden
// with the legend: the hold is owned by gamepad.ts, not by this bar.
import {
  hintsForView,
  hintListHtml,
  type HintConfig,
} from "@/scripts/lib/couch-button-hints.ts";

interface Props {
  /** Couch view id (CouchLayout `view` prop / main[data-couch-view]). */
  view?: string;
}
const { view = "home" } = Astro.props;
const initial: HintConfig = hintsForView(view);
---

<nav
  class="rs-button-hints"
  data-button-hints
  data-view={view}
  data-config={initial.id}
  aria-label="Controller buttons"
>
  <ul
    class="rs-button-hints__list"
    data-button-hints-list
    data-config={initial.id}
    set:html={hintListHtml(initial)}
  >
  </ul>
</nav>

<script>
  import {
    CONTROLLER_HINTS_CHANGE_EVENT,
    EDITING_HINTS,
    getControllerHints,
    hintsForOsk,
    hintsForView,
    hintListHtml,
  } from "@/scripts/lib/couch-button-hints.ts";
  // 0.11.10 (W6): while Cursor Mode is active (cursor-mode.ts sets
  // html[data-cursor-mode="active"]) the legend shows the cursor
  // hint set instead of the view's — the attribute is the signal,
  // so this render() stays the single writer of the legend and no
  // other module fights it. W1's setControllerHints (Contract C)
  // may replace this branch at integration; CURSOR_MODE_HINTS is
  // the config it should show.
  import { CURSOR_MODE_HINTS } from "@/scripts/lib/cursor-mode.ts";

  const nav = document.querySelector<HTMLElement>("[data-button-hints]");
  const list = nav?.querySelector<HTMLElement>("[data-button-hints-list]");
  if (nav && list) {
    const view = nav.dataset.view ?? "home";
    // Last painted item HTML. The repaint guard compares rendered
    // content, NOT the config id: view overrides often reuse their
    // view config's id with different items (Favourites, Followed,
    // Settings, detail pages), and the old id-only guard left those
    // overrides unpainted forever (0.11.14 W3, §8).
    let lastHtml = "";

    // Selectors whose visibility means "an overlay owns the buttons":
    // OSD + options + Quick Surf + channel browser + error, all
    // driven by data-hidden + the hidden attribute.
    const OVERLAY_SELECTORS =
      "[data-livetv-osd], [data-livetv-options], [data-livetv-quicksurf], [data-livetv-play-browser], [data-livetv-error]";

    // Dialog ownership vs page override (0.11.24, GAP 6): a page
    // (Settings) claims the legend once at load, and that claim must
    // NOT keep the pill visible over a modal — the legend hides while
    // a modal owns input, unless the modal (or its owner) claims the
    // legend for itself after opening. Track the override object
    // that was current before the dialog opened; a different object
    // while open means the dialog claimed it.
    let overrideBeforeDialog: HintConfig | null = null;
    let dialogWasOpen = false;

    function isEditingTarget(target: EventTarget | null): boolean {
      const el = target as HTMLElement | null;
      if (!el || typeof el.tagName !== "string") return false;
      const tag = el.tagName.toLowerCase();
      if (tag === "input" || tag === "textarea" || tag === "select") return true;
      return el.isContentEditable === true;
    }

    function overlayVisible(): boolean {
      const overlays = document.querySelectorAll<HTMLElement>(OVERLAY_SELECTORS);
      for (const el of overlays) {
        if (el.dataset.hidden === "false" && !el.hidden) return true;
      }
      return false;
    }

    function dialogOpen(): boolean {
      if (document.querySelector("dialog[open]")) return true;
      try {
        return !!document.querySelector("[popover]:popover-open");
      } catch {
        return false;
      }
    }

    function render(): void {
      const editing = isEditingTarget(document.activeElement);
      const osk =
        !editing &&
        !!(document.activeElement as HTMLElement | null)?.closest?.("[data-osk]");
      const mode = document.documentElement.dataset.livetvMode ?? null;
      // 0.9.0 (W5): the shell mirrors the guide sub-mode to
      // html[data-livetv-guide-mode] when a `livetv:mode` detail
      // carries it, so the legend shows the per-sub-mode rows
      // (day nav in By Channel, time nav in grid). Unset → the
      // base guide config.
      const guideMode = document.documentElement.dataset.livetvGuideMode ?? null;
      // Controller 2.0 (§42): an owner-claimed config wins over the
      // view-derived one — hints reflect the actual current input
      // owner (drawer, overlay, keyboard, playback mode). Owners
      // route every update through setControllerHints and clear on
      // close; with no claim, the audited view config applies.
      // Cursor Mode (W6) wins over both while active — the
      // pointer's legend, not the screen's — via the
      // html[data-cursor-mode] signal cursor-mode.ts owns.
      // Editing / OSK win over an owner claim (0.11.24, GAP 6):
      // while a text field owns the controller only B + View+Menu
      // work, so the minimal editing legend is the truth even on a
      // page that claimed the legend (Settings kept showing "Y
      // Settings search" while typing, where Y does nothing).
      const override = getControllerHints();
      const cursorActive =
        document.documentElement.dataset.cursorMode === "active";
      const config = cursorActive
        ? CURSOR_MODE_HINTS
        : editing
          ? EDITING_HINTS
          : osk
            ? hintsForOsk(view)
            : (override ?? hintsForView(view, { livetvMode: mode, guideMode }));
      // Hide while a dialog owns input; in Live TV playback hide
      // while the OSD / an overlay is up (it names its own keys).
      // A page-level owner claim does NOT keep the pill up over a
      // dialog — only a claim made by the dialog itself (a different
      // override object after it opened) does.
      const dialogIsOpen = dialogOpen();
      if (dialogIsOpen && !dialogWasOpen) overrideBeforeDialog = override;
      if (!dialogIsOpen) overrideBeforeDialog = null;
      dialogWasOpen = dialogIsOpen;
      const dialogClaimedHints = dialogIsOpen && override !== overrideBeforeDialog;
      const hidden =
        !cursorActive &&
        ((dialogIsOpen && !dialogClaimedHints) ||
          (!override &&
            view === "livetv" &&
            mode === "playback" &&
            overlayVisible()));
      nav.toggleAttribute("hidden", hidden);
      nav.dataset.config = config.id;
      const html = hintListHtml(config);
      if (html !== lastHtml) {
        list.innerHTML = html;
        lastHtml = html;
        list.dataset.config = config.id;
      }
    }

    const modeObserver = new MutationObserver(render);
    modeObserver.observe(document.documentElement, {
      attributes: true,
      // 0.11.10 (W6): data-cursor-mode joins the filter so Cursor
      // Mode activation/exit re-renders the legend immediately.
      // 0.11.14 (W2/W3 seam): data-cursor-scroll joins it too —
      // cursor-mode.ts writes it change-only when scroll
      // availability under the pointer flips, so the legend
      // re-renders on the flip (the cursor config itself is
      // static; the stick rows live in the on-screen pill).
      attributeFilter: ["data-livetv-mode", "data-livetv-guide-mode", "data-cursor-mode", "data-cursor-scroll"],
    });
    const domObserver = new MutationObserver(render);
    domObserver.observe(document.body, {
      attributes: true,
      attributeFilter: ["data-hidden", "hidden", "open"],
      childList: true,
      subtree: true,
    });
    document.addEventListener("focusin", render);
    document.addEventListener("focusout", render);
    window.addEventListener(CONTROLLER_HINTS_CHANGE_EVENT, render);

    // ── Settings-only idle auto-hide (0.11.24 polish, GAP 3) ──
    // Why this exists: the pill is position:fixed, so ANY content
    // scrolled to the viewport bottom sits under it at a mid-scroll
    // rest position — measured on 0.11.23 (Help card, TVDB helper,
    // Continue-watching helper, Reset button all covered in the
    // verifier shots). The footer spacer + .rs-main padding only
    // clear the page END (139.8px @1672px, 160.3px @1920px vs a
    // ~40–45px pill extent — already ample), and scroll-padding
    // only protects anchor/focus scrolling. A fixed overlay can
    // never be "never covering" while it is painted, so on Settings
    // the pill stops being painted at rest: it hides the moment the
    // user scrolls to read (wheel / scroll) and 4 s after the last
    // input, and reappears on the next keydown (physical keys AND
    // the gamepad's synthetic KeyboardEvents from gamepad.ts),
    // pointer press, or focus move. While it is visible,
    // scroll-padding-bottom (global.css) keeps the focused element
    // above it. Scoped to Settings by the view prop + .settings-page
    // presence; every other page keeps the always-on legend, and
    // Cursor Mode keeps it too (a visible pointer means the user is
    // steering, not reading).
    const isSettingsHints =
      view === "settings" || !!document.querySelector(".settings-page");
    const PILL_IDLE_HIDE_MS = 4000;
    const PILL_FOCUS_SCROLL_WINDOW_MS = 600;
    let pillIdleHidden = false;
    let pillIdleTimer = 0;
    let pillLastActivityAt = 0;
    function setPillIdleHidden(hidden: boolean): void {
      // Cursor Mode steers a visible pointer: never idle-hide under it.
      if (hidden && document.documentElement.dataset.cursorMode === "active") return;
      pillIdleHidden = hidden;
      nav.classList.toggle("rs-button-hints--idle-hidden", hidden);
    }
    function armPillIdleTimer(): void {
      window.clearTimeout(pillIdleTimer);
      pillIdleTimer = window.setTimeout(
        () => setPillIdleHidden(true),
        PILL_IDLE_HIDE_MS,
      );
    }
    function notePillActivity(): void {
      pillLastActivityAt = Date.now();
      if (pillIdleHidden) setPillIdleHidden(false);
      armPillIdleTimer();
    }
    if (isSettingsHints) {
      window.addEventListener("keydown", notePillActivity);
      window.addEventListener("pointerdown", notePillActivity);
      document.addEventListener("focusin", notePillActivity);
      // Wheel = the user is scrolling to read: hide at once, not
      // after the idle timeout — otherwise the pill sits over
      // content at the new rest position until the timer fires.
      window.addEventListener("wheel", () => setPillIdleHidden(true), {
        passive: true,
      });
      window.addEventListener(
        "scroll",
        () => {
          // A scroll right after a key/pointer/focus move is the
          // focus walk scrolling its new target into view — leave
          // the pill up (scroll-padding-bottom keeps the target
          // clear of it). Any other scroll (scrollbar drag, touch
          // scroll, anchor jump) hides the pill so the rest
          // position is uncovered.
          if (Date.now() - pillLastActivityAt < PILL_FOCUS_SCROLL_WINDOW_MS) {
            armPillIdleTimer();
            return;
          }
          setPillIdleHidden(true);
        },
        { passive: true, capture: true },
      );
      armPillIdleTimer();
    }

    render();
  }
</script>

<style is:global>
  /* is:global is required, not a shortcut: the legend items are
     injected via set:html / innerHTML (server + client re-render),
     so they never carry Astro's scoped-style CID attribute and a
     scoped block would leave them unstyled. Selectors are rooted
     at html[data-couch] so nothing leaks onto non-Couch pages.
     Fixed bottom-anchored pill bar. pointer-events:none so it can
     never swallow a click meant for the page; the bar is display
     only. The footer spacer + .rs-main padding clear it at the page
     END only — at any mid-scroll rest position the pill still sits
     over whatever content is at the viewport bottom, so on Settings
     pages the script below auto-hides it at rest (0.11.24, GAP 3)
     and scroll-padding-bottom (global.css) keeps focus/anchor
     scrolling clear of it while it is visible. */
  html[data-couch] .rs-button-hints {
    position: fixed;
    left: 50%;
    bottom: 0.75rem;
    transform: translateX(-50%);
    z-index: 60;
    max-width: calc(100vw - 2rem);
    pointer-events: none;
    /* Settings polish (0.11.24, GAP 3): the idle fade below needs a
       transition; visibility flips with opacity so the hidden pill
       never intercepts hit-testing (it has pointer-events:none
       anyway) and never paints over content at rest. */
    transition:
      opacity 250ms ease,
      visibility 250ms ease;
  }
  html[data-couch] .rs-button-hints[hidden] {
    display: none;
  }
  /* Settings-only idle hide (GAP 3): on Settings pages the pill
     auto-hides at rest so a mid-scroll rest position never leaves
     content under it — the class is only ever added by the
     Settings-scoped script below, so every other page keeps the
     always-on legend. visibility:hidden (not display:none) keeps
     the fade smooth and the layout untouched (fixed element). */
  html[data-couch] .rs-button-hints--idle-hidden {
    opacity: 0;
    visibility: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    html[data-couch] .rs-button-hints {
      transition: none;
    }
  }
  html[data-couch] .rs-button-hints__list {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    margin: 0;
    padding: 0.45rem 1rem;
    list-style: none;
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    font-family: var(--rs-font-body);
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--rs-text-2);
    background: color-mix(in srgb, var(--rs-bg) 74%, transparent);
    border: 1px solid var(--rs-line-soft);
    border-radius: 999px;
    box-shadow: var(--rs-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  html[data-couch] .rs-button-hints__list::-webkit-scrollbar {
    display: none;
  }
  html[data-couch] .rs-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  html[data-couch] .rs-hint__label {
    font-weight: 600;
    color: var(--rs-text);
    opacity: 0.92;
  }
  html[data-couch] .rs-hint__when {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--rs-text-2);
  }
  html[data-couch] .rs-hint-glyphs {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }
  html[data-couch] .rs-hint-plus {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--rs-text-2);
  }
  html[data-couch] .rs-hint-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: 1.05rem;
    min-width: 1.05rem;
    font-size: 0.6875rem;
    font-weight: 800;
    line-height: 1;
    color: #fff;
  }
  /* Xbox face buttons — authentic colours, small and flat. */
  html[data-couch] .rs-hint-glyph--a {
    border-radius: 50%;
    background: #107c10;
  }
  html[data-couch] .rs-hint-glyph--b {
    border-radius: 50%;
    background: #e81123;
  }
  html[data-couch] .rs-hint-glyph--x {
    border-radius: 50%;
    background: #0078d7;
  }
  html[data-couch] .rs-hint-glyph--y {
    border-radius: 50%;
    background: #f2c200;
    color: #201600;
  }
  /* Shoulders / Menu / arrows — burgundy surface pills. */
  html[data-couch] .rs-hint-glyph--shoulder {
    padding: 0 0.32rem;
    border-radius: 0.3rem;
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    color: var(--rs-text);
    background: var(--rs-surface);
    border: 1px solid var(--rs-line);
  }
  /* D-pad — CSS plus on a burgundy tile. */
  html[data-couch] .rs-hint-glyph--dpad {
    position: relative;
    border-radius: 0.25rem;
    background: var(--rs-surface);
    border: 1px solid var(--rs-line);
  }
  html[data-couch] .rs-hint-glyph--dpad::before,
  html[data-couch] .rs-hint-glyph--dpad::after {
    content: "";
    position: absolute;
    background: var(--rs-text);
    border-radius: 1px;
  }
  html[data-couch] .rs-hint-glyph--dpad::before {
    left: 50%;
    top: 18%;
    width: 2px;
    height: 64%;
    transform: translateX(-50%);
  }
  html[data-couch] .rs-hint-glyph--dpad::after {
    top: 50%;
    left: 18%;
    height: 2px;
    width: 64%;
    transform: translateY(-50%);
  }
</style>
