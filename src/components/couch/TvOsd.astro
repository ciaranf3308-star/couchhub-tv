---
// TvOsd — Live TV lower-third OSD (0.11.0 W5 restyle). LIVE TV ONLY:
// VOD (movies / series) uses TvVodOsd instead — the two overlays
// are different by design (0.11.2 W3), and sharing this one put a
// LIVE badge + dead Channels/Guide buttons over films and episodes
// while the VOD controls were silently dropped (no slots).
//
// ONE restrained floating surface over fullscreen playback: a single
// rounded translucent panel (soft gradient + blur), never nested
// cards, never a solid slab. It covers only the bottom of the video.
// Reads over bright AND dark video via the gradient scrim. It never
// triggers a stream reconnect: opening or closing it touches no
// player state.
//
// Layout (mockups): logo + channel (number, name, LIVE) | current
// programme (title, time range, progress) | Up Next (title + times),
// then ONE quiet row of exactly seven icon actions — Channels,
// Guide, Info, Favourite, Subtitles, Audio, Settings (the mockup's
// set, in the mockup's order; see OSD_ACTION_IDS in
// livetv-playback.ts). Transport (Pause / Mute / Previous), Restart
// (catch-up) and Back live in the Options overlay (Menu key, or the
// Settings icon) — one press away, never a text-action jungle under
// the programme. The 0.9.0 row had eleven text actions; this is the
// trim the 0.11.0 brief requires.
//
// Transport buttons do NOT reimplement the player: each dispatches
// the synthetic keydown stream.ts already handles (see
// couch-livetv-epg.ts OSD action table). Info / Restart dispatch
// `livetv:programme` (stream.ts resolves catch-up honestly —
// nothing plays where catch-up is not supported). Subtitles / Audio
// click the player's OWN control-bar menu buttons (video.js
// audioTrackButton / subsCapsButton via findPlayerMenuButton) — the
// OSD never reimplements track selection; where the mount has no
// such button it reveals the player control bar instead. Favourite
// goes to the shell (livetv:osd-action, which owns the playlist);
// the Favourite icon itself shows the state (filled star +
// aria-pressed). Back dispatches livetv:back with context playback
// — the shell resolves the three-step B sequence.
//
// Props: channel?, nowTitle?, nowStartMs?, nowStopMs?, progress?,
// nextTitle?, nextStartMs?, nextStopMs?, favourite?, autoHideMs?
// (default 5000 — see OSD_AUTO_HIDE_MS in livetv-playback.ts). The
// shell updates the text content live via the shared TvProgrammeRow
// hooks ([data-programme-*]); these props are the first paint only.
// The programme zone (Now title/times/progress + Up Next) IS a
// TvProgrammeRow without its channel column — the OSD already shows
// the channel beside it — so the Now/Next typography, spacing and
// progress treatment are identical to the Guide's rows.
import TvImage from "./TvImage.astro";
import TvProgrammeRow from "./TvProgrammeRow.astro";

interface Props {
  channel?: {
    id?: string | number;
    name?: string;
    displayName?: string;
    logo?: string | null;
    chno?: number | null;
  };
  nowTitle?: string;
  nowStartMs?: number;
  nowStopMs?: number;
  progress?: number;
  nextTitle?: string;
  nextStartMs?: number;
  nextStopMs?: number;
  favourite?: boolean;
  autoHideMs?: number;
}
const {
  channel,
  nowTitle,
  nowStartMs,
  nowStopMs,
  progress,
  nextTitle,
  nextStartMs,
  nextStopMs,
  favourite = false,
  autoHideMs = 5000,
} = Astro.props;
const label = channel ? channel.displayName || channel.name || "" : "";
// 0.11.0 W5 — the seven mockup actions as icon + label buttons.
// One shared SVG idiom (24px, currentColor stroke); the labels are
// visible text, never title-only tooltips, so the row reads on a
// 10-foot screen without hovering.
const actions = [
  {
    id: "browser",
    label: "Channels",
    focusKey: "livetv-osd-channels",
    icon: '<rect x="2.5" y="7" width="19" height="13" rx="2.5"/><path d="M8.5 3.5 12 7l3.5-3.5"/>',
  },
  {
    id: "guide",
    label: "Guide",
    focusKey: "livetv-osd-guide",
    icon: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6h.01M4 12h.01M4 18h.01"/>',
  },
  {
    id: "info",
    label: "Info",
    focusKey: "livetv-osd-info",
    icon: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 7.5h.01"/>',
  },
  {
    id: "favourite",
    label: "Favourite",
    focusKey: "livetv-osd-favourite",
    icon: '<path d="M12 3.6 14.6 9l5.9.7-4.4 4 1.2 5.8L12 16.7l-5.3 2.8 1.2-5.8-4.4-4 5.9-.7z"/>',
  },
  {
    id: "subtitles",
    label: "Subtitles",
    focusKey: "livetv-osd-subtitles",
    icon: '<rect x="2.5" y="5.5" width="19" height="13" rx="3"/><path d="M10.5 10.2c-.7-.6-1.7-.6-2.4 0-.7.7-.7 2.9 0 3.6.7.6 1.7.6 2.4 0M17.5 10.2c-.7-.6-1.7-.6-2.4 0-.7.7-.7 2.9 0 3.6.7.6 1.7.6 2.4 0"/>',
  },
  {
    id: "audio",
    label: "Audio",
    focusKey: "livetv-osd-audio",
    icon: '<path d="M4.5 14v-2.5a7.5 7.5 0 0 1 15 0V14"/><rect x="3" y="13.5" width="4" height="7" rx="1.8"/><rect x="17" y="13.5" width="4" height="7" rx="1.8"/>',
  },
  {
    id: "settings",
    label: "Settings",
    focusKey: "livetv-osd-settings",
    icon: '<circle cx="12" cy="12" r="3.2"/><path d="M12 2.8v2.6M12 18.6v2.6M2.8 12h2.6M18.6 12h2.6M5.2 5.2l1.8 1.8M17 17l1.8 1.8M18.8 5.2 17 7M7 17l-1.8 1.8"/>',
  },
] as const;
---

<div
  class="rs-livetv-play-osd"
  data-couch-osd
  data-livetv-osd
  data-autohide-ms={autoHideMs}
  data-osd-channel-id={channel?.id != null ? String(channel.id) : ""}
  data-osd-now-start={nowStartMs != null ? String(nowStartMs) : ""}
  data-hidden="true"
  role="status"
  aria-label="Now playing"
>
  <div class="rs-livetv-play-osd__row">
    <span class="rs-livetv-play-osd__logo" data-osd-logo>
      {
        channel?.logo ? (
          <TvImage src={channel.logo} alt="" kind="logo" title={label} />
        ) : (
          <span class="rs-livetv-play-osd__initial" aria-hidden="true">
            {label.slice(0, 1)}
          </span>
        )
      }
    </span>
    <span class="rs-livetv-play-osd__channel-block">
      <span class="rs-livetv-play-osd__channel">
        <span data-osd-chno>{channel?.chno != null ? channel.chno : ""}</span>
        <span data-osd-channel-name>{label}</span>
        <span class="rs-livetv-play-osd__live" data-osd-live>LIVE</span>
      </span>
    </span>
    <TvProgrammeRow
      showChannel={false}
      nowTitle={nowTitle}
      nowStartMs={nowStartMs}
      nowStopMs={nowStopMs}
      progress={progress}
      nextTitle={nextTitle}
      nextStartMs={nextStartMs}
      nextStopMs={nextStopMs}
      nextLabel="Up Next"
    />
  </div>
  <div class="rs-livetv-play-osd__controls" data-osd-controls>
    {
      actions.map((action) => (
        <button
          type="button"
          class="rs-livetv-play-osd__btn rs-livetv-play-osd__btn--icon"
          data-osd-action={action.id}
          data-focus-key={action.focusKey}
          {...(action.id === "favourite"
            ? { "data-osd-fav-btn": "", "aria-pressed": favourite ? "true" : "false" }
            : {})}
        >
          <svg
            class="rs-livetv-play-osd__icon"
            viewBox="0 0 24 24"
            width="28"
            height="28"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={action.icon}
          />
          <span class="rs-livetv-play-osd__btn-label">{action.label}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  // TvOsd auto-hide + action wiring (0.11.0 W5). Timing lives in
  // livetv-playback.ts `createOsdAutoHide` (vitest fake timers assert
  // it); this script owns only the DOM rules: never hide while focus
  // is inside the OSD, show on `couch-osd:show` / `livetv:overlay`
  // "osd", and the action wiring below. Showing/hiding never touches
  // the player — no reconnect, no retune.
  import {
    createOsdAutoHide,
    findPlayerMenuButton,
  } from "@/scripts/lib/livetv-playback";
  // INTEGRATION: mode requests go through the shared helper.
  import { requestLivetvMode } from "@/scripts/lib/livetv-data";

  const osds = Array.from(document.querySelectorAll("[data-livetv-osd]"));
  for (const osd of osds) {
    const el = osd;
    if (el.dataset.osdArmed) continue;
    el.dataset.osdArmed = "1";
    const delay = Number(el.getAttribute("data-autohide-ms")) || 5000;
    const autoHide = createOsdAutoHide(() => {
      // Focus inside the OSD cancels the hide so keyboard/controller
      // users are never locked out of controls they are tabbing
      // through; hiding resumes once focus leaves.
      if (el.contains(document.activeElement)) {
        autoHide.show();
        return;
      }
      el.setAttribute("data-hidden", "true");
    }, delay);
    const show = () => {
      el.setAttribute("data-hidden", "false");
      autoHide.show();
    };
    const onActivity = () => show();
    for (const evt of ["pointermove", "pointerdown", "keydown", "focusin"]) {
      el.addEventListener(evt, onActivity, { passive: true });
    }
    el.addEventListener("focusout", () => {
      autoHide.show();
    });
    window.addEventListener("couch-osd:show", onActivity);
    window.addEventListener("livetv:overlay", (ev) => {
      const overlay = (ev as CustomEvent).detail?.overlay;
      if (overlay === "osd") show();
      // INTEGRATION 0.9.0 — Quick Surf docks over the OSD's right
      // side (mockup 2 shows no OSD while surfing): hide the OSD
      // while the surf panel is open. The OSD returns on the next
      // activity / tune / pointer move once surf closes.
      else if (overlay === "quicksurf") el.setAttribute("data-hidden", "true");
    });

    const programmeDetail = () => {
      const channelId = el.getAttribute("data-osd-channel-id") || "";
      const startMs = Number(el.getAttribute("data-osd-now-start"));
      if (!channelId || !Number.isFinite(startMs)) return null;
      return { channelId, startMs };
    };

    const openPlayerMenu = (kind: "audio" | "subtitles") => {
      // The player's own menu button: the menu that opens is the
      // engine's, not a reimplementation. Where the mount has no
      // such button, reveal the player control bar instead so the
      // user can still reach the tracks from there.
      const button = findPlayerMenuButton(kind);
      if (button) {
        button.click();
        return;
      }
      const wrap = document.querySelector("#player-wrap");
      wrap?.dispatchEvent(new PointerEvent("pointermove", { bubbles: true }));
      show();
    };

    // OSD-owned actions dispatch window events the shell / engine
    // consume (guide / channels / home / info / settings /
    // favourite). Transport (Pause / Mute / Previous) and Restart
    // live in the Options overlay, not on this row.
    el.addEventListener("click", (ev) => {
      const btn = (ev.target as HTMLElement | null)?.closest?.(
        "[data-osd-action]",
      ) as HTMLElement | null;
      if (!btn || !el.contains(btn)) return;
      const action = btn.getAttribute("data-osd-action");
      if (action === "guide") {
        requestLivetvMode("guide");
      } else if (action === "browser") {
        window.dispatchEvent(
          new CustomEvent("livetv:overlay", { detail: { overlay: "browser" } }),
        );
      } else if (action === "home") {
        requestLivetvMode("landing");
      } else if (action === "info") {
        // Info opens programme detail through the engine's
        // `livetv:programme` path, which resolves catch-up honestly
        // (and toasts instead of playing where it is not supported).
        const detail = programmeDetail();
        if (detail) {
          window.dispatchEvent(new CustomEvent("livetv:programme", { detail }));
        }
      } else if (action === "favourite") {
        window.dispatchEvent(
          new CustomEvent("livetv:osd-action", {
            detail: { action: "favourite", channelId: el.getAttribute("data-osd-channel-id") || "" },
          }),
        );
      } else if (action === "subtitles") {
        openPlayerMenu("subtitles");
      } else if (action === "audio") {
        openPlayerMenu("audio");
      } else if (action === "settings") {
        window.dispatchEvent(
          new CustomEvent("livetv:overlay", { detail: { overlay: "options" } }),
        );
      }
      show();
    });
    // Start hidden: the shell reveals the OSD on tune / activity.
    el.setAttribute("data-hidden", "true");
  }
</script>
