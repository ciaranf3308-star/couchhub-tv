---
// TvGuideView — the dedicated FULLSCREEN programme Guide (W4, 0.9.0).
//
// Four modes, one screen (default On Now — the timeline grid is
// demoted to the secondary "Full Guide" tab, never the default):
//
//   On Now     — mockup 3's composition: featured programme on
//                the left (art + title + times + synopsis, following
//                the focused row) and a compact channel Now/Next
//                list on the right. Polished TV listings, not a
//                data table and never stacked full-width rows.
//   Tonight    — RTÉ Guide-style evening (17:00–23:00 local):
//                art-led featured programme + gated sections, all
//                from real EPG metadata (see livetv-tonight.ts).
//                Featured art comes only from W2's enrichment API
//                (enrichProgramme, featured programmes only) —
//                never invented; without it the featured slot is a
//                channel-branded gradient, never a giant initial.
//   By Channel — one channel's schedule as a simple chronological
//                sequence; LB/RB moves days (-7..+14).
//   Full Guide — the 0.8.0 timeline grid, unchanged engine, kept
//                only as the secondary tab. 0.11.0 W6 fixed its
//                rendering: the grid's rows/cells/ticks are injected
//                by the client script, so their rules are :global
//                in the <style> below — scoped selectors never
//                matched them and the tab rendered empty.
//
// Mounts into `#livetv-mode-guide` on livetv.astro (this component's
// root carries `data-livetv-guide-root`, NOT the mount id, so there
// is exactly one `#livetv-mode-guide` in the DOM).
//
// Data: cached channels (`readCachedLiveChannels`) + cached EPG
// (`getProgrammesSync`) — the EPG engine is reused, never rewritten.
// All Guide logic is pure and testable over programme arrays
// (livetv-guide.ts / livetv-tonight.ts); the component only hands
// real data in. The short-EPG cache is in-memory and not seedable,
// so headless renders show the honest empty state, never fake rows.
//
// Rows are built inline by `programmeRowHtml` ({ programme,
// channel, variant: "now" | "tonight" | "channel" }, plus the next
// programme for On Now). INTEGRATION NOTE: the shared
// TvProgrammeRow Astro component cannot be swapped in here —
// Guide rows are client-side HTML strings (innerHTML), and an
// Astro component cannot render inside a <script> string builder.
// The inline builder instead carries the same visual contract
// (logo tile + title + time + progress + next line, same hooks
// shape) and the Guide-specific data the shared row does not
// model (programme desc, honestly-gated catch-up badge, LIVE
// state, data-focus-key). Catch-up stays gated by
// guideCellViewModel, never invented.
//
// Actions dispatch the shared Live TV events — the Guide never
// plays anything itself:
//   livetv:tune {channelId} + requestLivetvMode("playback") — watch live
//   livetv:programme {channelId, startMs} — catch-up replay / restart.
//     startMs is the DISPLAY time, matching TvQuickSurf's dispatch;
//     whoever plays it converts with displayedToUtcMs, as epg.ts does.
//   requestLivetvMode(returnTo) — leaving the Guide
//   (returnTo = the mode the Guide was entered from, recorded in
//   shared state as guideReturnTo; "landing" default)
// Mode switching: `livetv:mode` {mode:"guide", guideMode} —
// guideMode lives in the SHARED state (livetv-state.ts); this
// component keeps a local working copy that is seeded from
// liveState on entry and written back on every tab change.
// B: the Guide listens for the `livetv:back` window event (W5's
// contract) and the guide "back" key action — detail open closes
// first, otherwise the Guide exits to its entry mode.
// While active the Guide sets html[data-livetv-mode="guide"] (the
// same marker pattern TvPlaybackShell uses for "playback") so
// gamepad.ts routes X / Y / LB / RB / Menu to the Guide.
// Catch-up is offered ONLY where `catchupActionForProgramme` says so.
import TvProgrammeMeta from "./TvProgrammeMeta.astro";

interface Props {
  /** Active playlist id; resolved via getActiveEntry() when omitted. */
  playlistId?: string;
}
const { playlistId = "" } = Astro.props;
const nowMs = Date.now();
---

<section
  class="rs-livetv-guide"
  data-livetv-guide-root
  data-playlist-id={playlistId}
  aria-label="Programme guide"
  hidden
>
  <!-- Tab row: the four Guide modes + search. Left/Right on the
       tabs switches mode; the category filter serves On Now and
       By Channel. -->
  <div class="rs-guide-tabs" role="tablist" aria-label="Guide views">
    <button
      type="button"
      class="rs-livetv-guide__toolbtn"
      data-guide-back
      aria-label="Back from guide"
    >
      ← Back
    </button>
    <button
      type="button"
      role="tab"
      class="rs-guide-tab rs-guide-tab--active"
      data-guide-tab="now"
      aria-selected="true"
    >
      On Now
    </button>
    <button
      type="button"
      role="tab"
      class="rs-guide-tab"
      data-guide-tab="tonight"
      aria-selected="false"
      tabindex="-1"
    >
      Tonight
    </button>
    <button
      type="button"
      role="tab"
      class="rs-guide-tab"
      data-guide-tab="channel"
      aria-selected="false"
      tabindex="-1"
    >
      By Channel
    </button>
    <button
      type="button"
      role="tab"
      class="rs-guide-tab"
      data-guide-tab="grid"
      aria-selected="false"
      tabindex="-1"
    >
      Full Guide
    </button>
    <label class="rs-guide-searchlabel">
      <span class="rs-guide-searchlabel-text">Search</span>
      <input
        type="search"
        class="rs-guide-search"
        data-guide-search
        placeholder="Search programmes…"
        aria-label="Search programmes"
      />
    </label>
    <label class="rs-livetv-guide__catlabel">
      <span class="rs-livetv-guide__catlabel-text">Category</span>
      <select
        class="rs-livetv-guide__select"
        data-guide-category
        aria-label="Channel category"
      >
        <option value="__all__">All categories</option>
      </select>
    </label>
  </div>

  <!-- MODE A — On Now (default): mockup 3's Guide composition —
       featured programme on the left (photo + title + times +
       synopsis), channel Now/Next list on the right. Never a
       stacked full-width list. -->
  <div
    class="rs-guide-panel rs-guide-panel--now"
    data-guide-panel="now"
    role="tabpanel"
    aria-label="On now"
  >
    <div class="rs-guide-now">
      <div class="rs-guide-now-featured" data-guide-now-featured hidden></div>
      <div class="rs-guide-now-listwrap">
        <div class="rs-guide-now-head" aria-hidden="true">
          <span class="rs-guide-now-head__channel">Channel</span>
          <span class="rs-guide-now-head__now">Now</span>
          <span class="rs-guide-now-head__next">Next</span>
        </div>
        <div class="rs-guide-list rs-guide-now-list" data-guide-now-list></div>
        <p class="rs-guide-panel-empty" data-guide-now-empty hidden>
          Nothing on now — the guide hasn't loaded yet. Open Live TV first
          so the channel list and programme data load.
        </p>
      </div>
    </div>
  </div>

  <!-- MODE B — Tonight: featured programme + gated sections. -->
  <div
    class="rs-guide-panel"
    data-guide-panel="tonight"
    role="tabpanel"
    aria-label="Tonight"
    hidden
  >
    <div class="rs-guide-tonight-featured" data-guide-tonight-featured hidden></div>
    <div class="rs-guide-tonight-sections" data-guide-tonight-sections></div>
    <p class="rs-guide-panel-empty" data-guide-tonight-empty hidden>
      No evening listings yet — the guide hasn't loaded, or tonight's
      programmes have finished.
    </p>
  </div>

  <!-- MODE C — By Channel: channel picker + chronological schedule. -->
  <div
    class="rs-guide-panel rs-guide-panel--channel"
    data-guide-panel="channel"
    role="tabpanel"
    aria-label="By channel"
    hidden
  >
    <div class="rs-guide-channel-picker" data-guide-channel-picker>
      <div class="rs-guide-channel-list" data-guide-channel-list></div>
    </div>
    <div class="rs-guide-channel-schedule">
      <div class="rs-guide-channel-daynav">
        <button
          type="button"
          class="rs-livetv-guide__toolbtn rs-livetv-guide__toolbtn--square"
          data-guide-channel-prev-day
          aria-label="Previous day"
        >
          ‹
        </button>
        <span
          class="rs-livetv-guide__daylabel"
          data-guide-channel-day-label
          aria-live="polite"
        >
          Today
        </span>
        <button
          type="button"
          class="rs-livetv-guide__toolbtn rs-livetv-guide__toolbtn--square"
          data-guide-channel-next-day
          aria-label="Next day"
        >
          ›
        </button>
        <span class="rs-guide-channel-dayhint" data-guide-channel-dayhint>
          LB / RB changes day
        </span>
      </div>
      <div class="rs-guide-list" data-guide-channel-schedule></div>
      <p class="rs-guide-panel-empty" data-guide-channel-empty hidden>
        No programmes listed for this channel on this day.
      </p>
    </div>
  </div>

  <!-- MODE D — Full Guide (secondary): the 0.8.0 timeline grid,
       engine unchanged. Grid-only toolbar: day nav + Jump to Now. -->
  <div
    class="rs-guide-panel"
    data-guide-panel="grid"
    role="tabpanel"
    aria-label="Full guide"
    hidden
  >
    <div class="rs-livetv-guide__toolbar" role="toolbar" aria-label="Guide controls">
      <button
        type="button"
        class="rs-livetv-guide__toolbtn rs-livetv-guide__toolbtn--square"
        data-guide-prev-day
        aria-label="Previous day"
      >
        ‹
      </button>
      <span
        class="rs-livetv-guide__daylabel"
        data-guide-day-label
        aria-live="polite"
      >
        Today
      </span>
      <button
        type="button"
        class="rs-livetv-guide__toolbtn rs-livetv-guide__toolbtn--square"
        data-guide-next-day
        aria-label="Next day"
      >
        ›
      </button>
      <button
        type="button"
        class="rs-livetv-guide__toolbtn"
        data-guide-now
      >
        Now
      </button>
      <span class="rs-livetv-guide__hint" data-guide-hint>
        LB / RB shifts time · N jumps to now
      </span>
    </div>

    <div
      class="rs-livetv-guide__scroll"
      data-guide-scroll
      tabindex="-1"
    >
      <div class="rs-livetv-guide__track" data-guide-track>
        <div class="rs-livetv-guide__head">
          <div class="rs-livetv-guide__corner" aria-hidden="true"></div>
          <div
            class="rs-livetv-guide__timehead"
            data-guide-timehead
            aria-hidden="true"
          ></div>
        </div>
        <div class="rs-livetv-guide__body" data-guide-body></div>
        <div
          class="rs-livetv-guide__nowline"
          data-guide-nowline
          aria-hidden="true"
          hidden
        ></div>
      </div>
    </div>
  </div>

  <!-- Contextual detail for the selected programme. The meta block
       starts hidden (no fake times) and is filled by the script. -->
  <div class="rs-livetv-guide__detail" data-guide-detail>
    <p class="rs-livetv-guide__detail-empty" data-guide-detail-empty>
      Select a programme to see details.
    </p>
    <div
      class="rs-livetv-guide__detail-meta"
      data-guide-detail-meta
      hidden
    >
      <TvProgrammeMeta
        title="Select a programme"
        startMs={nowMs}
        stopMs={nowMs + 3600000}
        desc="Choose a programme to see details."
        catchup
      />
    </div>
    <div class="rs-livetv-guide__actions" data-guide-actions>
      <button
        type="button"
        class="rs-livetv-guide__action"
        data-guide-action-watch
        hidden
      >
        Watch live
      </button>
      <button
        type="button"
        class="rs-livetv-guide__action rs-livetv-guide__action--catchup"
        data-guide-action-catchup
        hidden
      >
        Replay
      </button>
    </div>
  </div>

  <div
    class="rs-livetv-guide__empty"
    data-guide-empty
    role="status"
    hidden
  >
    <p data-guide-empty-text>Loading the programme guide…</p>
  </div>
</section>

<style>
  .rs-livetv-guide {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
    min-height: 0;
    color: var(--rs-text);
  }
  .rs-livetv-guide[hidden] {
    display: none;
  }
  .rs-livetv-guide__toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }
  .rs-livetv-guide__toolbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.5rem 0.9rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.15rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .rs-livetv-guide__toolbtn:hover {
    background: var(--rs-surface-2);
  }
  .rs-livetv-guide__toolbtn--square {
    padding-inline: 0.7rem;
  }
  .rs-livetv-guide__toolbtn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .rs-livetv-guide__catlabel {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .rs-livetv-guide__catlabel-text {
    color: var(--rs-text-2);
    font-size: 1.15rem;
    flex-shrink: 0;
  }
  .rs-livetv-guide__select {
    min-height: 3rem;
    max-width: 20rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.15rem;
  }
  .rs-livetv-guide__daylabel {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--rs-text-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    padding-inline: 0.25rem;
  }
  .rs-livetv-guide__hint {
    margin-left: auto;
    font-size: 1rem;
    color: var(--rs-text-2);
  }
  .rs-livetv-guide__scroll {
    flex: 1;
    min-height: 0;
    overflow: auto;
    border: 1px solid var(--rs-line);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, var(--rs-surface) 0%, var(--rs-bg) 18rem);
    box-shadow: var(--rs-shadow);
  }
  .rs-livetv-guide__track {
    position: relative;
    min-width: max-content;
  }
  .rs-livetv-guide__head {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--rs-line);
    background: var(--rs-surface);
  }
  .rs-livetv-guide__corner {
    position: sticky;
    left: 0;
    z-index: 31;
    flex-shrink: 0;
    width: 240px;
    height: 40px;
    background: var(--rs-surface);
    border-right: 1px solid var(--rs-line);
  }
  .rs-livetv-guide__timehead {
    position: relative;
    flex-shrink: 0;
    height: 40px;
  }
  /* Grid rules below are :global — the grid's rows, cells and
     ticks are injected by the client script (innerHTML), so they
     never carry Astro's scope attribute and scoped selectors
     would never match them (0.11.0 W6: the Full Guide tab rendered
     completely empty — cells in the DOM, no styles applied —
     because of exactly that; the 0.9.0/0.10.0 passes never
     screenshotted the grid, so it went unnoticed). Static grid
     chrome (toolbar, scroll, track, head, body, nowline) stays
     scoped. */
  :global(.rs-livetv-guide__tick) {
    position: absolute;
    top: 0;
    bottom: 0;
    padding: 0.5rem 0 0 0.5rem;
    border-left: 1px solid var(--rs-line);
    font-size: 1.1rem;
    color: var(--rs-text-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .rs-livetv-guide__body {
    position: relative;
  }
  :global(.rs-livetv-guide__row) {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--rs-line);
    content-visibility: auto;
    contain-intrinsic-size: auto 4.75rem;
  }
  :global(.rs-livetv-guide__channel) {
    position: sticky;
    left: 0;
    z-index: 10;
    flex-shrink: 0;
    width: 240px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--rs-bg-2);
    border-right: 1px solid var(--rs-line);
    min-width: 0;
  }
  :global(.rs-livetv-guide__channel--focused) {
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--rs-accent) 14%, transparent),
      var(--rs-bg-2)
    );
    box-shadow: inset 3px 0 0 var(--rs-accent);
  }
  :global(.rs-livetv-guide__logo) {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 0.5rem;
    background: var(--rs-surface-2);
  }
  :global(.rs-livetv-guide__logo--fallback) {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--rs-text);
  }
  :global(.rs-livetv-guide__channel-name) {
    flex: 1;
    min-width: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--rs-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.rs-livetv-guide__catchup-dot) {
    flex-shrink: 0;
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--rs-accent) 25%, transparent);
    color: var(--rs-focus);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rs-accent) 50%, transparent);
  }
  :global(.rs-livetv-guide__cells) {
    position: relative;
    flex-shrink: 0;
  }
  :global(.rs-livetv-guide__cell) {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    min-width: 2px;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--rs-line);
    border-radius: 0.6rem;
    background: var(--rs-surface);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.1rem;
    line-height: 1.25;
    text-align: left;
    overflow: hidden;
    cursor: pointer;
  }
  :global(.rs-livetv-guide__cell-title) {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.rs-livetv-guide__cell-time) {
    display: block;
    font-size: 0.95rem;
    color: var(--rs-text-2);
    font-variant-numeric: tabular-nums;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.rs-livetv-guide__cell--now) {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--rs-accent) 26%, transparent),
      color-mix(in srgb, var(--rs-focus) 12%, transparent)
    );
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--rs-accent) 45%, transparent),
      0 0 1.125rem 0.125rem color-mix(in srgb, var(--rs-accent) 22%, transparent);
  }
  :global(.rs-livetv-guide__cell--past) {
    opacity: 0.62;
  }
  :global(.rs-livetv-guide__cell--catchup)::after {
    content: "↺";
    position: absolute;
    top: 0.2rem;
    right: 0.45rem;
    font-size: 1rem;
    color: var(--rs-focus);
  }
  :global(.rs-livetv-guide__cell):focus-visible {
    z-index: 5;
    outline: none;
    box-shadow:
      0 0 0 2px var(--rs-focus),
      0 0 2rem 0.25rem var(--rs-focus-glow);
  }
  :global(.rs-livetv-guide__cell--selected) {
    box-shadow: 0 0 0 2px var(--rs-focus);
  }
  .rs-livetv-guide__nowline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    z-index: 20;
    background: var(--rs-accent);
    box-shadow: 0 0 0.75rem 1px color-mix(in srgb, var(--rs-accent) 60%, transparent);
    pointer-events: none;
  }
  .rs-livetv-guide__detail {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid var(--rs-line);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, var(--rs-surface), var(--rs-bg-2));
    box-shadow: var(--rs-shadow);
    padding: 1rem 1.5rem;
    min-height: 5.5rem;
  }
  .rs-livetv-guide__detail-empty {
    font-size: 1.2rem;
    color: var(--rs-text-2);
  }
  .rs-livetv-guide__detail-meta {
    flex: 1;
    min-width: 0;
  }
  .rs-livetv-guide__actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }
  .rs-livetv-guide__action {
    min-height: 3.25rem;
    padding: 0.6rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-accent);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .rs-livetv-guide__action--catchup {
    background: color-mix(in srgb, var(--rs-accent) 25%, transparent);
    color: var(--rs-focus);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--rs-accent) 50%, transparent);
  }
  .rs-livetv-guide__empty {
    border: 1px solid var(--rs-line);
    border-radius: 1.25rem;
    background: linear-gradient(180deg, var(--rs-surface), var(--rs-bg-2));
    box-shadow: var(--rs-shadow);
    padding: 1.5rem 2rem;
    font-size: 1.375rem;
    color: var(--rs-text-2);
  }
  .rs-livetv-guide__empty[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rs-livetv-guide__cell):focus-visible,
    .rs-livetv-guide__nowline {
      box-shadow: none;
    }
    :global(.rs-livetv-guide__cell):focus-visible {
      box-shadow: 0 0 0 2px var(--rs-focus);
    }
  }
</style>
<script>
  import {
    enterGuide,
    exitGuide,
    guideProgrammeKey,
    persistLivetvState,
    restoreLivetvState,
    setGuideMode as setSharedGuideMode,
    startOfLocalDayMs,
  } from "@/scripts/lib/livetv-state.ts";
  import { requestLivetvMode } from "@/scripts/lib/livetv-data.ts";
  import { livetvKeyActionForKey } from "@/scripts/lib/livetv-keys.ts";
  import {
    GUIDE_DAY_MS,
    GUIDE_MAX_FUTURE_DAYS,
    GUIDE_MAX_PAST_DAYS,
    DEFAULT_GUIDE_MODE,
    availableGuideDays,
    clampGuideDayOffset,
    filterGuideRows,
    guideCellViewModel,
    guideDayForOffset,
    guideReturnMode,
    jumpToNowWindow,
    normaliseCategoryLabel,
    nowNextRows,
    parseGuideMode,
    pickNowFeatured,
    programmesForGuideDay,
    sanitiseGuideProgrammes,
    stableGuideSelection,
  } from "@/scripts/lib/livetv-guide.ts";
  import {
    buildTonightSections,
    chronologicalTonight,
    eveningWindowMs,
    pickTonightFeatured,
  } from "@/scripts/lib/livetv-tonight.ts";
  import {
    catchupBadgeLabel,
    epgCellGeometry,
    epgRowWindow,
    epgTimeRangeLabel,
    epgTimeWindow,
    programmeProgress,
    programmeState,
  } from "@/scripts/lib/couch-livetv-epg.ts";
  import {
    getProgrammesSync,
    resolveTvgId,
    shiftChannelProgrammes,
    EPG_LOADED_EVENT,
  } from "@/scripts/lib/epg-data.js";
  import { readCachedLiveChannels } from "@/scripts/lib/live-catalog.ts";
  import { getActiveEntry } from "@/scripts/lib/creds.js";
  import {
    CACHE_REVALIDATED_EVENT,
    hydrate as hydrateCache,
  } from "@/scripts/lib/cache.js";
  import {
    getChannelEpgOverride,
    getFavorites,
    getRecents,
  } from "@/scripts/lib/preferences.js";

  const PX_PER_HOUR = 200;
  const ROW_HEIGHT_PX = 76;
  const CHANNEL_COL_PX = 240;
  const HOUR_MS = 3600000;

  const root = document.querySelector("[data-livetv-guide-root]");
  if (root instanceof HTMLElement) {
    const scrollEl = root.querySelector("[data-guide-scroll]");
    const trackEl = root.querySelector("[data-guide-track]");
    const timeheadEl = root.querySelector("[data-guide-timehead]");
    const bodyEl = root.querySelector("[data-guide-body]");
    const nowlineEl = root.querySelector("[data-guide-nowline]");
    const dayLabelEl = root.querySelector("[data-guide-day-label]");
    const categoryEl = root.querySelector("[data-guide-category]");
    const searchEl = root.querySelector("[data-guide-search]");
    const emptyEl = root.querySelector("[data-guide-empty]");
    const emptyTextEl = root.querySelector("[data-guide-empty-text]");
    const detailEmptyEl = root.querySelector("[data-guide-detail-empty]");
    const detailMetaEl = root.querySelector("[data-guide-detail-meta]");
    const watchBtn = root.querySelector("[data-guide-action-watch]");
    const catchupBtn = root.querySelector("[data-guide-action-catchup]");
    const prevDayBtn = root.querySelector("[data-guide-prev-day]");
    const nextDayBtn = root.querySelector("[data-guide-next-day]");
    const tabEls = [...root.querySelectorAll("[data-guide-tab]")];
    const panelEls = [...root.querySelectorAll("[data-guide-panel]")];
    const nowListEl = root.querySelector("[data-guide-now-list]");
    const nowEmptyEl = root.querySelector("[data-guide-now-empty]");
    const nowFeaturedEl = root.querySelector("[data-guide-now-featured]");
    const tonightFeaturedEl = root.querySelector("[data-guide-tonight-featured]");
    const tonightSectionsEl = root.querySelector("[data-guide-tonight-sections]");
    const tonightEmptyEl = root.querySelector("[data-guide-tonight-empty]");
    const channelListEl = root.querySelector("[data-guide-channel-list]");
    const channelScheduleEl = root.querySelector("[data-guide-channel-schedule]");
    const channelEmptyEl = root.querySelector("[data-guide-channel-empty]");
    const channelDayLabelEl = root.querySelector("[data-guide-channel-day-label]");
    const channelPrevDayBtn = root.querySelector("[data-guide-channel-prev-day]");
    const channelNextDayBtn = root.querySelector("[data-guide-channel-next-day]");

    let liveState = restoreLivetvState();
    let enteredFrom = "home";
    let active = false;
    let playlistId = root.dataset.playlistId || "";
    /** Local working copy of the SHARED guideMode (livetv-state).
     *  Seeded from liveState on entry; every change below writes
     *  back through setSharedGuideMode + persist. Default "now". */
    let guideMode = DEFAULT_GUIDE_MODE;
    /** @type {Array<any>} */
    let allChannels = [];
    /** @type {Map<string, any>} channel id (string) -> channel */
    let channelsById = new Map();
    /** @type {Map<string, Array<any>>} channel id -> ALL sanitised programmes (all days) */
    let programmesByChannel = new Map();
    /** @type {Map<string, Array<any>>} channel id -> sanitised day programmes (grid) */
    let dayProgrammes = new Map();
    /** @type {Array<any>} channels in the selected category, in source order */
    let visibleChannels = [];
    /** @type {Array<number>} available day starts */
    let days = [];
    let category = "__all__";
    let searchQuery = "";
    let viewStartMs = jumpToNowWindow(Date.now()).viewStartMs;
    let selectedKey = liveState.guideProgrammeKey;
    /** @type {{ channel: any, programme: any } | null} */
    let selected = null;
    /** Detail panel counts as "open" once a programme is selected
     *  in a list mode; B closes it before leaving the Guide. */
    let detailOpen = false;
    /** By Channel: day offset from today, clamped [-7, +14]. */
    let channelDayOffset = 0;
    /** By Channel: selected channel id (string) or null. */
    let selectedChannelId = null;
    let renderQueued = false;
    /** Featured programme keys per slot (On Now / Tonight) — the
     *  programme the featured art belongs to. */
    let nowFeaturedKey = null;
    let tonightFeaturedKey = null;
    /** Enriched art URLs by programme key (backdrop/still only). */
    const featuredArtCache = new Map();
    let featuredArtTimer = null;

    // ── Featured programme art (Live TV 0.11.0, W6) ─────────────
    // W2's enrichment module (src/scripts/lib/livetv-enrichment.ts)
    // is loaded through import.meta.glob, so the Guide builds and
    // runs with its branded placeholder while the module is not in
    // the tree yet, and picks it up the moment it lands — no static
    // import of a file another worker owns. Only the featured
    // programme is ever enriched (never a list, never on scroll);
    // a 350ms settle delay keeps arrowing through rows from firing
    // a lookup per row. Art is used only when the module returns a
    // non-placeholder source at confidence >= 0.6; anything else
    // keeps the channel-branded placeholder (logo on a burgundy
    // gradient, never a giant initial letter).
    const ENRICHMENT_GLOB_KEY = "/src/scripts/lib/livetv-enrichment.ts";
    const FEATURED_ART_CONFIDENCE_MIN = 0.6;
    /** undefined = unresolved, null = module absent. */
    let enrichmentLoader = undefined;
    function getEnrichmentLoader() {
      if (enrichmentLoader !== undefined) return enrichmentLoader;
      try {
        // Absolute-from-root pattern: a relative glob does not
        // resolve inside an Astro component <script> (the compiled
        // script's location is not the .astro file's), so the map
        // came back empty. The leading-/ form is project-root
        // relative and matches the module when W2 lands it.
        const loaders = import.meta.glob("/src/scripts/lib/livetv-enrichment.ts");
        // Look the loader up by value, not by key: the bundler
        // normalises the glob key and the literal key above does
        // not always match it.
        const load = loaders[ENRICHMENT_GLOB_KEY] ?? Object.values(loaders)[0];
        enrichmentLoader = typeof load === "function" ? load : null;
      } catch {
        enrichmentLoader = null;
      }
      return enrichmentLoader;
    }
    /** A usable wide-art URL from an enrichment result, or null. */
    function usableArtUrl(art) {
      if (!art || art.source === "placeholder") return null;
      if (
        typeof art.confidence !== "number" ||
        art.confidence < FEATURED_ART_CONFIDENCE_MIN
      ) {
        return null;
      }
      return art.backdropUrl || art.stillUrl || null;
    }
    /** The art slot's content: enriched photo when cached, else the
     *  channel-branded placeholder (logo, or the channel name). */
    function featuredArtHtml(programme, channel) {
      const key = guideProgrammeKey(String(channel.id), programme.startMs);
      const cached = featuredArtCache.get(key);
      if (cached) {
        return `<img class="rs-guide-featured__art-img" src="${escapeAttr(cached)}" alt="" loading="lazy" />`;
      }
      const logo = channel.logo ? String(channel.logo) : "";
      const name = escapeHtml(channel.displayName || channel.name || "");
      if (logo) {
        return `<img class="rs-guide-featured__art-logo" src="${escapeAttr(logo)}" alt="" loading="lazy" />`;
      }
      return `<span class="rs-guide-featured__art-name">${name}</span>`;
    }
    function scheduleFeaturedArt(slot, programme, channel) {
      if (!programme || !channel) return;
      const key = guideProgrammeKey(String(channel.id), programme.startMs);
      if (featuredArtCache.has(key)) return;
      if (featuredArtTimer !== null) clearTimeout(featuredArtTimer);
      featuredArtTimer = setTimeout(() => {
        featuredArtTimer = null;
        void paintFeaturedArt(slot, programme, channel);
      }, 350);
    }
    async function paintFeaturedArt(slot, programme, channel) {
      const key = guideProgrammeKey(String(channel.id), programme.startMs);
      const currentKey = slot === "now" ? nowFeaturedKey : tonightFeaturedKey;
      if (currentKey !== key) return;
      const loader = getEnrichmentLoader();
      if (!loader) return;
      try {
        const mod = await loader();
        if (typeof mod.getProgrammeArtworkSync === "function") {
          const url = usableArtUrl(mod.getProgrammeArtworkSync(programme.title));
          if (url) return finishFeaturedArt(slot, key, url);
        }
        if (typeof mod.enrichProgramme !== "function") return;
        const art = await mod.enrichProgramme({
          title: programme.title,
          channelName: channel.displayName || channel.name || "",
          startMs: programme.startMs,
          endMs: programme.stopMs,
        });
        const url = usableArtUrl(art);
        if (!url) return;
        finishFeaturedArt(slot, key, url);
      } catch {
        // Enrichment is best-effort; the placeholder stays.
      }
    }
    function finishFeaturedArt(slot, key, url) {
      const currentKey = slot === "now" ? nowFeaturedKey : tonightFeaturedKey;
      if (currentKey !== key) return;
      featuredArtCache.set(key, url);
      const container = slot === "now" ? nowFeaturedEl : tonightFeaturedEl;
      const artEl = container?.querySelector("[data-guide-featured-art]");
      if (artEl instanceof HTMLElement) {
        artEl.innerHTML = `<img class="rs-guide-featured__art-img" src="${escapeAttr(url)}" alt="" loading="lazy" />`;
      }
    }

    const dayWidthPx = () => (GUIDE_DAY_MS / HOUR_MS) * PX_PER_HOUR;
    const dayStartMs = () => startOfLocalDayMs(liveState.guideDateMs);

    function dispatch(name, detail) {
      window.dispatchEvent(new CustomEvent(name, { detail }));
    }

    function showEmpty(text) {
      if (emptyTextEl) emptyTextEl.textContent = text;
      if (emptyEl) emptyEl.hidden = false;
    }
    function hideEmpty() {
      if (emptyEl) emptyEl.hidden = true;
    }

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
    }
    function escapeAttr(value) {
      return escapeHtml(value).replace(/"/g, "&quot;");
    }

    async function resolvePlaylist() {
      if (playlistId) return playlistId;
      try {
        const entry = await getActiveEntry();
        if (entry && entry._id) playlistId = String(entry._id);
      } catch {
        playlistId = "";
      }
      return playlistId;
    }

    function loadChannels() {
      allChannels = playlistId ? readCachedLiveChannels(playlistId) : [];
      channelsById = new Map(
        allChannels.map((channel) => [String(channel.id), channel]),
      );
    }

    /** Favourite / recently-watched ids for Tonight highlights. */
    function favouriteIds() {
      try {
        return getFavorites(playlistId, "live");
      } catch {
        return new Set();
      }
    }
    function watchedIds() {
      try {
        return new Set(getRecents(playlistId, "live").map((r) => r.id));
      } catch {
        return new Set();
      }
    }

    /** The Tonight identity for a raw cached channel. */
    function tonightChannelFor(channel) {
      const favs = favouriteIds();
      const watched = watchedIds();
      return {
        id: String(channel.id),
        displayName: channel.displayName || channel.name || "",
        logo: channel.logo ? String(channel.logo) : null,
        categoryLabel: normaliseCategoryLabel(channel.category || ""),
        favourite: favs.has(channel.id),
        watched: watched.has(channel.id),
      };
    }

    /** All sanitised programmes per channel (every day the EPG covers). */
    function loadAllProgrammes() {
      programmesByChannel = new Map();
      const state = playlistId ? getProgrammesSync(playlistId) : null;
      const programmes = state && state.programmes instanceof Map ? state.programmes : null;
      const channelNames = state && state.channelNames instanceof Map ? state.channelNames : null;
      if (!programmes) return;
      const overrides = {};
      for (const channel of allChannels) {
        try {
          const override = getChannelEpgOverride(playlistId, channel.id);
          if (override) overrides[String(channel.id)] = override;
        } catch {
          // No override for this channel; resolution falls through.
        }
      }
      for (const channel of allChannels) {
        const tvgId = resolveTvgId(channel, overrides, programmes, channelNames);
        if (!tvgId) continue;
        const raw = programmes.get(String(tvgId).toLowerCase());
        if (!raw) continue;
        const shifted = shiftChannelProgrammes(raw, channel.tvgShift);
        programmesByChannel.set(
          String(channel.id),
          sanitiseGuideProgrammes(String(channel.id), shifted),
        );
      }
    }

    function loadProgrammesForDay() {
      dayProgrammes = new Map();
      for (const [channelId, list] of programmesByChannel) {
        dayProgrammes.set(channelId, programmesForGuideDay(list, dayStartMs()));
      }
    }

    function rebuildDays() {
      days = availableGuideDays(programmesByChannel);
    }

    function categories() {
      const seen = new Map();
      for (const channel of allChannels) {
        const raw = (channel.category || "").toString();
        if (!raw.trim()) continue;
        if (!seen.has(raw)) seen.set(raw, normaliseCategoryLabel(raw));
      }
      return [...seen.entries()].map(([value, label]) => ({ value, label }));
    }

    function applyCategoryFilter() {
      if (category === "__all__") return allChannels;
      if (category === "__favorites__") {
        let favs = new Set();
        try {
          favs = getFavorites(playlistId, "live");
        } catch {
          favs = new Set();
        }
        return allChannels.filter((channel) => favs.has(channel.id));
      }
      if (category === "__recents__") {
        let recents = [];
        try {
          recents = getRecents(playlistId, "live");
        } catch {
          recents = [];
        }
        const byId = new Map(allChannels.map((channel) => [channel.id, channel]));
        const out = [];
        for (const recent of recents) {
          const channel = byId.get(recent.id);
          if (channel) out.push(channel);
        }
        return out;
      }
      return allChannels.filter((channel) => (channel.category || "") === category);
    }

    function rebuildCategoryOptions() {
      if (!(categoryEl instanceof HTMLSelectElement)) return;
      const current = categoryEl.value || category;
      categoryEl.innerHTML = "";
      const add = (value, label) => {
        const option = document.createElement("option");
        option.value = value;
        option.textContent = label;
        categoryEl.appendChild(option);
      };
      add("__all__", "All categories");
      add("__favorites__", "Favourites");
      add("__recents__", "Recently watched");
      for (const { value, label } of categories()) add(value, label);
      categoryEl.value = [...categoryEl.options].some((o) => o.value === current)
        ? current
        : "__all__";
      category = categoryEl.value;
    }

    function formatDayLabel(dayMs) {
      const today = startOfLocalDayMs(Date.now());
      if (dayMs === today) return "Today";
      if (dayMs === today + GUIDE_DAY_MS) return "Tomorrow";
      if (dayMs === today - GUIDE_DAY_MS) return "Yesterday";
      return new Date(dayMs).toLocaleDateString(undefined, {
        weekday: "short",
        day: "numeric",
        month: "short",
      });
    }

    // ── Programme rows (shared TvProgrammeRow visual contract) ───
    // { programme, channel, variant: "now" | "tonight" | "channel" }
    // Rendered inline as HTML strings (innerHTML) — the shared
    // TvProgrammeRow Astro component cannot render inside a client
    // <script> string builder, so this builder mirrors its visual
    // contract (logo tile + title + time + progress + next line)
    // and adds the Guide-only data (desc, catch-up badge, LIVE).
    function programmeRowHtml({ programme, channel, variant, next = null }) {
      const key = guideProgrammeKey(String(channel.id), programme.startMs);
      const timeLabel = epgTimeRangeLabel(programme.startMs, programme.stopMs);
      const logo = channel.logo ? String(channel.logo) : "";
      const initial = (channel.displayName || channel.name || "?").trim().charAt(0).toUpperCase();
      const name = escapeHtml(channel.displayName || channel.name || "");
      const title = escapeHtml(programme.title);
      const desc = programme.desc ? escapeHtml(programme.desc) : "";
      const nowMs = Date.now();
      const state = programmeState(programme.startMs, programme.stopMs, nowMs);
      const progress = programmeProgress(programme.startMs, programme.stopMs, nowMs);
      const vm = guideCellViewModel(programme, channel, nowMs);
      const badge = vm.badge ? `<span class="rs-guide-row__badge">${vm.badge}</span>` : "";
      const progressBar =
        variant === "now" && state === "now"
          ? `<span class="rs-guide-row__progress" aria-hidden="true"><span style="width:${Math.round(progress * 100)}%"></span></span>`
          : "";
      const nextLine = variant === "now" ? nowNextLineHtml(next) : "";
      return (
        `<button type="button" class="rs-guide-row rs-guide-row--${variant}" data-guide-row ` +
        `data-focus-key="guide:programme:${key}" data-channel-id="${escapeAttr(String(channel.id))}" ` +
        `data-start-ms="${programme.startMs}" data-variant="${variant}" ` +
        `aria-label="${escapeAttr(programme.title)}, ${escapeAttr(timeLabel)}">` +
        (logo
          ? `<img class="rs-guide-row__logo" src="${escapeAttr(logo)}" alt="" loading="lazy" />`
          : `<span class="rs-guide-row__logo rs-guide-row__logo--fallback" aria-hidden="true">${escapeHtml(initial)}</span>`) +
        `<span class="rs-guide-row__main">` +
        `<span class="rs-guide-row__topline"><span class="rs-guide-row__channel">${name}</span>` +
        `<span class="rs-guide-row__time">${timeLabel}</span>${badge}</span>` +
        `<span class="rs-guide-row__title">${title}${state === "now" ? ` <span class="rs-guide-row__live">LIVE</span>` : ""}</span>` +
        (desc ? `<span class="rs-guide-row__desc">${desc}</span>` : "") +
        progressBar +
        nextLine +
        `</span></button>`
      );
    }

    /** Next-programme line for an On Now row (the "next" half). */
    function nowNextLineHtml(next) {
      if (!next) return "";
      const label = epgTimeRangeLabel(next.startMs, next.stopMs);
      return `<span class="rs-guide-row__next">Next: ${escapeHtml(next.title)} · ${label}</span>`;
    }

    /** Flat, searchable row records for the active list mode. */
    function searchableRows(rows) {
      return rows.map((row) => ({
        ...row,
        channelName: row.channel.displayName || row.channel.name || "",
        programmeTitle: row.programme.title,
        programmeDesc: row.programme.desc || "",
      }));
    }

    // ── Mode renderers ────────────────────────────────────────────

    function renderActivePanel() {
      if (guideMode === "now") renderNow();
      else if (guideMode === "tonight") renderTonight();
      else if (guideMode === "channel") renderChannel();
      else if (guideMode === "grid") {
        renderTimeHeader();
        updateDayControls();
        renderRows();
      }
    }

    /** On Now rows for the current category/search filter. */
    function currentNowEntries() {
      const nowMs = Date.now();
      const visibleIds = new Set(visibleChannels.map((c) => String(c.id)));
      const filtered = new Map(
        [...programmesByChannel].filter(([id]) => visibleIds.has(id)),
      );
      let entries = nowNextRows(filtered, nowMs)
        .map((row) => ({
          row,
          channel: channelsById.get(row.channelId),
        }))
        .filter((entry) => entry.channel);
      if (searchQuery.trim()) {
        const needle = searchQuery.trim().toLowerCase();
        entries = entries.filter(({ row, channel }) =>
          `${channel.displayName || channel.name || ""} ${row.current.title} ${row.current.desc ?? ""} ${row.next?.title ?? ""}`
            .toLowerCase()
            .includes(needle),
        );
      }
      return entries;
    }

    /** One Now/Next list row: channel | now (title, times,
     *  progress) | next (title, times). The synopsis lives in the
     *  featured panel, not repeated down the list. */
    function nowNextRowHtml({ row, channel }) {
      const key = guideProgrammeKey(String(channel.id), row.current.startMs);
      const logo = channel.logo ? String(channel.logo) : "";
      const initial = (channel.displayName || channel.name || "?").trim().charAt(0).toUpperCase();
      const nowLabel = epgTimeRangeLabel(row.current.startMs, row.current.stopMs);
      const nextLabel = row.next
        ? epgTimeRangeLabel(row.next.startMs, row.next.stopMs)
        : "";
      const progress = Math.round(row.progress * 100);
      return (
        `<button type="button" class="rs-guide-row rs-guide-row--nownav" data-guide-row ` +
        `data-focus-key="guide:programme:${key}" data-channel-id="${escapeAttr(String(channel.id))}" ` +
        `data-start-ms="${row.current.startMs}" data-variant="now" ` +
        `aria-label="${escapeAttr(row.current.title)}, ${escapeAttr(nowLabel)}">` +
        `<span class="rs-guide-nownav__channel">` +
        (logo
          ? `<img class="rs-guide-nownav__logo" src="${escapeAttr(logo)}" alt="" loading="lazy" />`
          : `<span class="rs-guide-nownav__logo rs-guide-nownav__logo--fallback" aria-hidden="true">${escapeHtml(initial)}</span>`) +
        `<span class="rs-guide-nownav__name">${escapeHtml(channel.displayName || channel.name || "")}</span>` +
        `</span>` +
        `<span class="rs-guide-nownav__now">` +
        `<span class="rs-guide-nownav__title">${escapeHtml(row.current.title)} <span class="rs-guide-row__live">LIVE</span></span>` +
        `<span class="rs-guide-nownav__time">${nowLabel}</span>` +
        `<span class="rs-guide-row__progress" aria-hidden="true"><span style="width:${progress}%"></span></span>` +
        `</span>` +
        `<span class="rs-guide-nownav__next">` +
        (row.next
          ? `<span class="rs-guide-nownav__title rs-guide-nownav__title--next">${escapeHtml(row.next.title)}</span>` +
            `<span class="rs-guide-nownav__time">${nextLabel}</span>`
          : `<span class="rs-guide-nownav__title rs-guide-nownav__title--next">—</span>`) +
        `</span></button>`
      );
    }

    /** The On Now featured panel: art + channel + title + times +
     *  progress + synopsis + next up. Follows the focused row. */
    function renderNowFeatured(entry) {
      if (!(nowFeaturedEl instanceof HTMLElement)) return;
      if (!entry) {
        nowFeaturedEl.hidden = true;
        nowFeaturedKey = null;
        return;
      }
      const { row, channel } = entry;
      const programme = row.current;
      nowFeaturedKey = guideProgrammeKey(String(channel.id), programme.startMs);
      const timeLabel = epgTimeRangeLabel(programme.startMs, programme.stopMs);
      const progress = Math.round(row.progress * 100);
      const nextLine = row.next
        ? `Next: ${escapeHtml(row.next.title)} · ${epgTimeRangeLabel(row.next.startMs, row.next.stopMs)}`
        : "";
      nowFeaturedEl.innerHTML =
        `<button type="button" class="rs-guide-featured rs-guide-featured--now" data-guide-row ` +
        `data-focus-key="guide:programme:${nowFeaturedKey}" ` +
        `data-channel-id="${escapeAttr(String(channel.id))}" data-start-ms="${programme.startMs}" data-variant="now">` +
        `<span class="rs-guide-featured__art" data-guide-featured-art>${featuredArtHtml(programme, channel)}</span>` +
        `<span class="rs-guide-featured__main">` +
        `<span class="rs-guide-featured__eyebrow">On Now · ${escapeHtml(channel.displayName || channel.name || "")}</span>` +
        `<span class="rs-guide-featured__title">${escapeHtml(programme.title)}</span>` +
        `<span class="rs-guide-featured__time">${timeLabel}</span>` +
        `<span class="rs-guide-featured__progress" aria-hidden="true"><span style="width:${progress}%"></span></span>` +
        (programme.desc
          ? `<span class="rs-guide-featured__desc">${escapeHtml(programme.desc)}</span>`
          : "") +
        (nextLine ? `<span class="rs-guide-featured__next">${nextLine}</span>` : "") +
        `</span></button>`;
      nowFeaturedEl.hidden = false;
      scheduleFeaturedArt("now", programme, channel);
    }

    /** Re-render only the featured panel when focus moves to
     *  another Now row (the list itself is untouched, so focus
     *  stays where the user put it). */
    function refreshNowFeaturedFromSelection() {
      if (!(nowFeaturedEl instanceof HTMLElement)) return;
      const entries = currentNowEntries();
      const featured = pickNowFeatured(
        entries.map((entry) => entry.row),
        selectedKey,
      );
      if (!featured) return;
      if (
        guideProgrammeKey(featured.channelId, featured.current.startMs) ===
        nowFeaturedKey
      ) {
        return;
      }
      const entry = entries.find((candidate) => candidate.row === featured);
      if (entry) renderNowFeatured(entry);
    }

    /** MODE A — On Now: featured programme (left) + Now/Next
     *  list (right), the mockup's composition. */
    function renderNow() {
      if (!(nowListEl instanceof HTMLElement)) return;
      const entries = currentNowEntries();
      const featured = pickNowFeatured(
        entries.map((entry) => entry.row),
        selectedKey,
      );
      renderNowFeatured(
        featured ? entries.find((entry) => entry.row === featured) || null : null,
      );
      nowListEl.innerHTML = entries.map((entry) => nowNextRowHtml(entry)).join("");
      if (nowEmptyEl) nowEmptyEl.hidden = entries.length > 0;
    }

    /** MODE B — Tonight: featured + gated sections, or the plain
     *  chronological fallback when no section has a signal. */
    function renderTonight() {
      if (!(tonightSectionsEl instanceof HTMLElement)) return;
      const nowMs = Date.now();
      let items = [];
      for (const channel of allChannels) {
        const list = programmesByChannel.get(String(channel.id)) || [];
        if (list.length === 0) continue;
        const tonightChannel = tonightChannelFor(channel);
        for (const programme of list) {
          items.push({ programme, channel: tonightChannel });
        }
      }
      if (searchQuery.trim()) {
        const needle = searchQuery.trim().toLowerCase();
        items = items.filter((item) =>
          `${item.channel.displayName} ${item.programme.title} ${item.programme.desc ?? ""}`
            .toLowerCase()
            .includes(needle),
        );
      }
      const built = buildTonightSections(items, nowMs);
      const evening = chronologicalTonight(items, nowMs);
      if (evening.length === 0) {
        if (tonightFeaturedEl) tonightFeaturedEl.hidden = true;
        tonightSectionsEl.innerHTML = "";
        if (tonightEmptyEl) tonightEmptyEl.hidden = false;
        return;
      }
      if (tonightEmptyEl) tonightEmptyEl.hidden = true;
      // Featured: the strongest highlight (a premiere first),
      // else the first programme starting soon, else the first
      // evening programme (pickTonightFeatured, tested). Art comes
      // only from the enrichment API — never invented; without it
      // the slot is the channel-branded placeholder.
      const featured = pickTonightFeatured(built, evening);
      if (tonightFeaturedEl && featured) {
        const timeLabel = epgTimeRangeLabel(featured.programme.startMs, featured.programme.stopMs);
        const featuredChannel = channelsById.get(featured.channel.id) || featured.channel;
        tonightFeaturedKey = guideProgrammeKey(
          featured.channel.id,
          featured.programme.startMs,
        );
        tonightFeaturedEl.innerHTML =
          `<button type="button" class="rs-guide-featured rs-guide-featured--art" data-guide-row ` +
          `data-focus-key="guide:programme:${tonightFeaturedKey}" ` +
          `data-channel-id="${escapeAttr(featured.channel.id)}" data-start-ms="${featured.programme.startMs}" data-variant="tonight">` +
          `<span class="rs-guide-featured__art" data-guide-featured-art>${featuredArtHtml(featured.programme, featuredChannel)}</span>` +
          `<span class="rs-guide-featured__main">` +
          `<span class="rs-guide-featured__eyebrow">Tonight · ${escapeHtml(featured.channel.displayName)}</span>` +
          `<span class="rs-guide-featured__title">${escapeHtml(featured.programme.title)}</span>` +
          `<span class="rs-guide-featured__time">${timeLabel}</span>` +
          (featured.programme.desc
            ? `<span class="rs-guide-featured__desc">${escapeHtml(featured.programme.desc)}</span>`
            : "") +
          `</span></button>`;
        tonightFeaturedEl.hidden = false;
        scheduleFeaturedArt("tonight", featured.programme, featuredChannel);
      } else if (tonightFeaturedEl) {
        tonightFeaturedEl.hidden = true;
        tonightFeaturedKey = null;
      }
      let html = "";
      if (built.hasEditorialSignal) {
        for (const section of built.sections) {
          html += `<section class="rs-guide-tonight-section" aria-label="${escapeAttr(section.title)}">` +
            `<h2 class="rs-guide-tonight-section__title">${escapeHtml(section.title)}</h2>` +
            section.items
              .map((item) => {
                const channel = channelsById.get(item.channel.id);
                if (!channel) return "";
                return programmeRowHtml({
                  programme: item.programme,
                  channel,
                  variant: "tonight",
                });
              })
              .join("") +
            `</section>`;
        }
      } else {
        // Poor metadata: one plain chronological evening list.
        const { windowStartMs } = eveningWindowMs(nowMs);
        const dateLabel = new Date(windowStartMs).toLocaleDateString(undefined, {
          weekday: "long",
          day: "numeric",
          month: "long",
        });
        html += `<section class="rs-guide-tonight-section" aria-label="Tonight">` +
          `<h2 class="rs-guide-tonight-section__title">Tonight · ${escapeHtml(dateLabel)}</h2>` +
          evening
            .map((item) => {
              const channel = channelsById.get(item.channel.id);
              if (!channel) return "";
              return programmeRowHtml({
                programme: item.programme,
                channel,
                variant: "tonight",
              });
            })
            .join("") +
          `</section>`;
      }
      tonightSectionsEl.innerHTML = html;
    }

    /** MODE C — By Channel: picker + one channel's day, chronological. */
    function renderChannel() {
      renderChannelList();
      renderChannelSchedule();
    }

    function renderChannelList() {
      if (!(channelListEl instanceof HTMLElement)) return;
      if (!selectedChannelId || !channelsById.has(selectedChannelId)) {
        selectedChannelId =
          (liveState.guideChannelId && channelsById.has(liveState.guideChannelId)
            ? liveState.guideChannelId
            : null) ||
          (visibleChannels[0] ? String(visibleChannels[0].id) : null);
      }
      const nowMs = Date.now();
      channelListEl.innerHTML = visibleChannels
        .map((channel) => {
          const id = String(channel.id);
          const logo = channel.logo ? String(channel.logo) : "";
          const initial = (channel.displayName || channel.name || "?").trim().charAt(0).toUpperCase();
          const isSelected = id === selectedChannelId;
          const onNow = (programmesByChannel.get(id) || []).find(
            (p) => programmeState(p.startMs, p.stopMs, nowMs) === "now",
          );
          return (
            `<button type="button" class="rs-guide-channel-pick${isSelected ? " rs-guide-channel-pick--selected" : ""}" ` +
            `data-guide-channel-pick="${escapeAttr(id)}" data-focus-key="guide:channel:${escapeAttr(id)}" ` +
            `aria-current="${isSelected ? "true" : "false"}">` +
            (logo
              ? `<img class="rs-guide-channel-pick__logo" src="${escapeAttr(logo)}" alt="" loading="lazy" />`
              : `<span class="rs-guide-channel-pick__logo rs-guide-channel-pick__logo--fallback" aria-hidden="true">${escapeHtml(initial)}</span>`) +
            `<span class="rs-guide-channel-pick__text">` +
            `<span class="rs-guide-channel-pick__name">${escapeHtml(channel.displayName || channel.name || "")}</span>` +
            (onNow
              ? `<span class="rs-guide-channel-pick__now">${escapeHtml(onNow.title)}</span>`
              : "") +
            `</span></button>`
          );
        })
        .join("");
    }

    /** One By Channel schedule row: time-led, no repeated logo or
     *  channel name — the channel is already picked on the left.
     *  The programme on now carries its progress + LIVE mark;
     *  catch-up appears only where the engine confirms it. */
    function channelScheduleRowHtml({ programme, channel }) {
      const key = guideProgrammeKey(String(channel.id), programme.startMs);
      const timeLabel = epgTimeRangeLabel(programme.startMs, programme.stopMs);
      const startLabel = new Date(programme.startMs).toLocaleTimeString(undefined, {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      });
      const endLabel = new Date(programme.stopMs).toLocaleTimeString(undefined, {
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      });
      const nowMs = Date.now();
      const state = programmeState(programme.startMs, programme.stopMs, nowMs);
      const progress = programmeProgress(programme.startMs, programme.stopMs, nowMs);
      const vm = guideCellViewModel(programme, channel, nowMs);
      const badge = vm.badge
        ? `<span class="rs-guide-row__badge">${vm.badge}</span>`
        : "";
      return (
        `<button type="button" class="rs-guide-row rs-guide-row--channel" data-guide-row ` +
        `data-focus-key="guide:programme:${key}" data-channel-id="${escapeAttr(String(channel.id))}" ` +
        `data-start-ms="${programme.startMs}" data-variant="channel" ` +
        `aria-label="${escapeAttr(programme.title)}, ${escapeAttr(timeLabel)}">` +
        `<span class="rs-guide-channelrow__time">${startLabel}<span class="rs-guide-channelrow__end">– ${endLabel}</span></span>` +
        `<span class="rs-guide-row__main">` +
        `<span class="rs-guide-row__title">${escapeHtml(programme.title)}${state === "now" ? ` <span class="rs-guide-row__live">LIVE</span>` : ""}${badge}</span>` +
        (programme.desc
          ? `<span class="rs-guide-row__desc">${escapeHtml(programme.desc)}</span>`
          : "") +
        (state === "now"
          ? `<span class="rs-guide-row__progress" aria-hidden="true"><span style="width:${Math.round(progress * 100)}%"></span></span>`
          : "") +
        `</span></button>`
      );
    }

    function renderChannelSchedule() {
      if (!(channelScheduleEl instanceof HTMLElement)) return;
      const dayMs = guideDayForOffset(channelDayOffset);
      if (channelDayLabelEl) channelDayLabelEl.textContent = formatDayLabel(dayMs);
      if (channelPrevDayBtn instanceof HTMLButtonElement) {
        channelPrevDayBtn.disabled = channelDayOffset <= GUIDE_MAX_PAST_DAYS * -1;
      }
      if (channelNextDayBtn instanceof HTMLButtonElement) {
        channelNextDayBtn.disabled = channelDayOffset >= GUIDE_MAX_FUTURE_DAYS;
      }
      const channel = selectedChannelId ? channelsById.get(selectedChannelId) : null;
      let rows = [];
      if (channel) {
        const list = programmesByChannel.get(String(channel.id)) || [];
        rows = programmesForGuideDay(list, dayMs).map((programme) => ({
          programme,
          channel,
        }));
        rows = filterGuideRows(searchableRows(rows), searchQuery);
      }
      channelScheduleEl.innerHTML = rows
        .map((row) => channelScheduleRowHtml(row))
        .join("");
      if (channelEmptyEl) channelEmptyEl.hidden = rows.length > 0;
    }

    function stepChannelDay(delta) {
      channelDayOffset = clampGuideDayOffset(channelDayOffset + delta);
      renderChannelSchedule();
    }

    // ── Mode switching ────────────────────────────────────────────

    function setGuideMode(mode, { focusTab = false } = {}) {
      const next = parseGuideMode(mode, guideMode);
      guideMode = next;
      // Write back to shared state so re-entry restores the tab.
      liveState = setSharedGuideMode(liveState, next);
      persistLivetvState(liveState);
      // Mirror to html so the button-hints legend picks the
      // sub-mode config (the shell only mirrors livetv:mode events,
      // which never fire on a ?mode=guide deep link).
      document.documentElement.dataset.livetvGuideMode = next;
      for (const tab of tabEls) {
        const isActive = tab.dataset.guideTab === next;
        tab.classList.toggle("rs-guide-tab--active", isActive);
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.tabIndex = isActive ? 0 : -1;
      }
      for (const panel of panelEls) {
        panel.hidden = panel.dataset.guidePanel !== next;
      }
      renderActivePanel();
      if (focusTab) {
        const tab = tabEls.find((t) => t.dataset.guideTab === next);
        if (tab instanceof HTMLElement) tab.focus({ preventScroll: true });
      }
    }

    function stepGuideMode(delta) {
      const order = ["now", "tonight", "channel", "grid"];
      const idx = order.indexOf(guideMode);
      const next = order[(idx + delta + order.length) % order.length];
      setGuideMode(next, { focusTab: true });
    }

    // ── Full Guide grid engine (0.8.0, unchanged) ─────────────────
    // Only rendered while the grid tab is active; the grid is the
    // secondary tab, never the default.

    function renderTimeHeader() {
      if (!(timeheadEl instanceof HTMLElement)) return;
      const start = dayStartMs();
      timeheadEl.style.width = `${dayWidthPx()}px`;
      let html = "";
      for (let hour = 0; hour < 24; hour++) {
        const tickMs = start + hour * HOUR_MS;
        const label = new Date(tickMs).toLocaleTimeString(undefined, {
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        });
        html += `<span class="rs-livetv-guide__tick" style="left:${hour * PX_PER_HOUR}px">${label}</span>`;
      }
      timeheadEl.innerHTML = html;
    }

    function channelHasCatchup(channel) {
      if (!channel) return false;
      return Boolean(
        Number(channel.tvArchive) === 1 || channel.catchup || channel.catchupSource,
      );
    }

    function programmeAt(channelId, startMs) {
      const list = dayProgrammes.get(String(channelId)) || [];
      return list.find((p) => p.startMs === startMs) || null;
    }

    /** Find a programme anywhere in the loaded EPG (all days). */
    function findProgramme(channelId, startMs) {
      const list = programmesByChannel.get(String(channelId)) || [];
      return list.find((p) => p.startMs === startMs) || null;
    }

    function renderRows() {
      if (!(bodyEl instanceof HTMLElement) || !(scrollEl instanceof HTMLElement)) return;
      const viewportHeight = scrollEl.clientHeight || 600;
      const viewportWidth = scrollEl.clientWidth || 1200;
      const scrollTop = scrollEl.scrollTop;
      const scrollLeft = scrollEl.scrollLeft;
      const viewStart = dayStartMs() + (scrollLeft / PX_PER_HOUR) * HOUR_MS;
      const viewEnd = dayStartMs() + ((scrollLeft + viewportWidth) / PX_PER_HOUR) * HOUR_MS;
      const windowRows = epgRowWindow({
        totalRows: visibleChannels.length,
        rowHeightPx: ROW_HEIGHT_PX,
        scrollTopPx: scrollTop,
        viewportHeightPx: viewportHeight,
      });
      bodyEl.style.height = `${visibleChannels.length * ROW_HEIGHT_PX}px`;
      let html = "";
      for (let row = windowRows.startRow; row <= windowRows.endRow; row++) {
        const channel = visibleChannels[row];
        if (!channel) continue;
        const channelId = String(channel.id);
        const list = dayProgrammes.get(channelId) || [];
        const timeWindow = epgTimeWindow({
          programmes: list,
          viewStartMs: viewStart,
          viewEndMs: viewEnd,
        });
        const nowMs = Date.now();
        let cells = "";
        for (let i = timeWindow.startIndex; i < timeWindow.endIndex; i++) {
          const programme = list[i];
          if (!programme) continue;
          const geom = epgCellGeometry({
            startMs: programme.startMs,
            stopMs: programme.stopMs,
            viewStartMs: dayStartMs(),
            pxPerHour: PX_PER_HOUR,
            trackWidthPx: dayWidthPx(),
          });
          const vm = guideCellViewModel(programme, channel, nowMs);
          const key = vm.key;
          const timeLabel = epgTimeRangeLabel(programme.startMs, programme.stopMs);
          const classes = [
            "rs-livetv-guide__cell",
            vm.state === "now" ? "rs-livetv-guide__cell--now" : "",
            vm.state === "past" ? "rs-livetv-guide__cell--past" : "",
            vm.canCatchup ? "rs-livetv-guide__cell--catchup" : "",
            key === selectedKey ? "rs-livetv-guide__cell--selected" : "",
          ]
            .filter(Boolean)
            .join(" ");
          const title = programme.title.replace(/"/g, "&quot;");
          cells +=
            `<button type="button" class="${classes}" data-guide-cell ` +
            `data-focus-key="guide:programme:${key}" data-channel-id="${channelId}" ` +
            `data-start-ms="${programme.startMs}" data-state="${vm.state}" ` +
            `data-catchup="${vm.catchupAction}" title="${title}" ` +
            `style="left:${geom.leftPx}px;width:${geom.widthPx}px" aria-label="${title}, ${timeLabel}">` +
            `<span class="rs-livetv-guide__cell-title">${escapeHtml(programme.title)}</span>` +
            `<span class="rs-livetv-guide__cell-time">${timeLabel}</span>` +
            `</button>`;
        }
        const logo = channel.logo ? String(channel.logo) : "";
        const initial = (channel.name || "?").trim().charAt(0).toUpperCase();
        const channelCell =
          `<div class="rs-livetv-guide__channel" data-guide-channel="${channelId}">` +
          (logo
            ? `<img class="rs-livetv-guide__logo" src="${escapeAttr(logo)}" alt="" loading="lazy" />`
            : `<span class="rs-livetv-guide__logo rs-livetv-guide__logo--fallback" aria-hidden="true">${escapeHtml(initial)}</span>`) +
          `<span class="rs-livetv-guide__channel-name">${escapeHtml(channel.displayName || channel.name || "")}</span>` +
          (channelHasCatchup(channel)
            ? `<span class="rs-livetv-guide__catchup-dot">Catch-up</span>`
            : "") +
          `</div>`;
        html +=
          `<div class="rs-livetv-guide__row" style="top:${row * ROW_HEIGHT_PX}px;height:${ROW_HEIGHT_PX}px">` +
          channelCell +
          `<div class="rs-livetv-guide__cells" style="width:${dayWidthPx()}px">${cells}</div>` +
          `</div>`;
      }
      bodyEl.innerHTML = html;
      if (nowlineEl instanceof HTMLElement) {
        const now = Date.now();
        const day = dayStartMs();
        if (now >= day && now < day + GUIDE_DAY_MS) {
          const x = CHANNEL_COL_PX + ((now - day) / HOUR_MS) * PX_PER_HOUR;
          nowlineEl.style.left = `${x}px`;
          nowlineEl.hidden = false;
        } else {
          nowlineEl.hidden = true;
        }
      }
      const focused = bodyEl.querySelector(".rs-livetv-guide__cell:focus-visible");
      if (focused) markFocusedRow(focused);
    }

    function markFocusedRow(cell) {
      const row = cell.closest(".rs-livetv-guide__row");
      if (!row) return;
      bodyEl
        .querySelectorAll(".rs-livetv-guide__channel--focused")
        .forEach((el) => el.classList.remove("rs-livetv-guide__channel--focused"));
      const channelCell = row.querySelector(".rs-livetv-guide__channel");
      if (channelCell) channelCell.classList.add("rs-livetv-guide__channel--focused");
    }

    function queueRender() {
      if (renderQueued) return;
      renderQueued = true;
      requestAnimationFrame(() => {
        renderQueued = false;
        if (guideMode === "grid") renderRows();
      });
    }

    function updateDayControls() {
      if (dayLabelEl) dayLabelEl.textContent = formatDayLabel(dayStartMs());
      const idx = days.indexOf(dayStartMs());
      if (prevDayBtn instanceof HTMLButtonElement) {
        prevDayBtn.disabled = idx <= 0;
      }
      if (nextDayBtn instanceof HTMLButtonElement) {
        nextDayBtn.disabled = idx === -1 || idx >= days.length - 1;
      }
    }

    // ── Selection + detail (shared across modes) ──────────────────

    function selectProgramme(channelId, startMs, { focus = false, openDetail = true } = {}) {
      const programme = findProgramme(channelId, startMs);
      const channel = channelsById.get(String(channelId)) || null;
      if (!programme || !channel) {
        selected = null;
        return;
      }
      selected = { channel, programme };
      selectedKey = guideProgrammeKey(String(channelId), startMs);
      liveState = {
        ...liveState,
        guideChannelId: String(channelId),
        guideProgrammeKey: selectedKey,
      };
      detailOpen = openDetail;
      updateDetail();
      if (guideMode === "grid") {
        bodyEl
          .querySelectorAll(".rs-livetv-guide__cell--selected")
          .forEach((el) => el.classList.remove("rs-livetv-guide__cell--selected"));
        const cell = bodyEl.querySelector(
          `[data-guide-cell][data-channel-id="${CSS.escape(String(channelId))}"][data-start-ms="${startMs}"]`,
        );
        if (cell) {
          cell.classList.add("rs-livetv-guide__cell--selected");
          markFocusedRow(cell);
          if (focus) cell.focus({ preventScroll: true });
        }
      } else if (focus) {
        const row = root.querySelector(
          `[data-guide-row][data-channel-id="${CSS.escape(String(channelId))}"][data-start-ms="${startMs}"]`,
        );
        if (row instanceof HTMLElement) row.focus({ preventScroll: true });
      }
    }

    function closeDetail() {
      selected = null;
      detailOpen = false;
      updateDetail();
    }

    function updateDetail() {
      if (!selected || !detailOpen) {
        if (detailEmptyEl) detailEmptyEl.hidden = false;
        if (detailMetaEl) detailMetaEl.hidden = true;
        if (watchBtn instanceof HTMLElement) watchBtn.hidden = true;
        if (catchupBtn instanceof HTMLElement) catchupBtn.hidden = true;
        return;
      }
      const { channel, programme } = selected;
      const nowMs = Date.now();
      const vm = guideCellViewModel(programme, channel, nowMs);
      if (detailEmptyEl) detailEmptyEl.hidden = true;
      if (detailMetaEl) detailMetaEl.hidden = false;
      const meta = root.querySelector("[data-programme-meta]");
      if (meta) {
        const titleEl = meta.querySelector(".rs-livetv-programme-meta__title");
        if (titleEl) {
          titleEl.textContent = "";
          if (vm.state === "now") {
            const live = document.createElement("span");
            live.className = "rs-livetv-programme-meta__live";
            live.textContent = "LIVE";
            titleEl.appendChild(live);
            titleEl.appendChild(document.createTextNode(" "));
          }
          titleEl.appendChild(document.createTextNode(programme.title));
        }
        const timeEl = meta.querySelector(".rs-livetv-programme-meta__time");
        if (timeEl) {
          timeEl.textContent = epgTimeRangeLabel(programme.startMs, programme.stopMs);
        }
        const descEl = meta.querySelector(".rs-livetv-programme-meta__desc");
        if (descEl) {
          const desc = programme.desc || "";
          descEl.textContent = desc;
          descEl.hidden = desc.length === 0;
        }
        const catchupEl = meta.querySelector(".rs-livetv-programme-meta__catchup");
        if (catchupEl) {
          const label = catchupBadgeLabel(vm.catchupAction);
          catchupEl.textContent =
            vm.catchupAction === "watch-from-start"
              ? "Restart from start available"
              : "Catch-up available";
          catchupEl.hidden = label === null;
        }
        const progressEl = meta.querySelector(".rs-livetv-programme-meta__progress > span");
        if (progressEl instanceof HTMLElement) {
          progressEl.style.width = `${Math.round(programmeProgress(programme.startMs, programme.stopMs, nowMs) * 100)}%`;
        }
      }
      if (watchBtn instanceof HTMLElement) {
        watchBtn.hidden = !vm.watchLive;
      }
      if (catchupBtn instanceof HTMLElement) {
        catchupBtn.hidden = !vm.canCatchup;
        catchupBtn.textContent =
          vm.catchupAction === "replay" ? "Replay" : "Restart from start";
      }
    }

    function activateSelected() {
      if (!selected) return;
      const { channel, programme } = selected;
      const vm = guideCellViewModel(programme, channel, Date.now());
      const channelId = String(channel.id);
      if (vm.state === "now" && vm.catchupAction !== "watch-from-start") {
        tuneToChannel(channelId);
        return;
      }
      if (vm.canCatchup) {
        // Display time, matching TvQuickSurf's livetv:programme
        // dispatch; the player converts with displayedToUtcMs.
        dispatch("livetv:programme", { channelId, startMs: programme.startMs });
        return;
      }
      if (vm.state === "now") tuneToChannel(channelId);
    }

    function tuneToChannel(channelId) {
      dispatch("livetv:tune", { channelId });
      requestLivetvMode("playback");
    }

    function goToDay(dayMs, { jumpNow = false } = {}) {
      liveState = { ...liveState, guideDateMs: startOfLocalDayMs(dayMs) };
      persistLivetvState(liveState);
      loadProgrammesForDay();
      renderTimeHeader();
      updateDayControls();
      if (jumpNow) {
        const { viewStartMs: start } = jumpToNowWindow(Date.now());
        viewStartMs = start;
      }
      const all = [...dayProgrammes.values()].flat();
      selectedKey = stableGuideSelection(selectedKey, all, Date.now());
      renderRows();
      scrollToViewStart();
      restoreSelectionFocus();
    }

    function scrollToViewStart() {
      if (!(scrollEl instanceof HTMLElement)) return;
      const day = dayStartMs();
      scrollEl.scrollLeft = Math.max(
        0,
        ((viewStartMs - day) / HOUR_MS) * PX_PER_HOUR,
      );
    }

    function restoreSelectionFocus() {
      if (!selectedKey || guideMode !== "grid") return;
      const [channelId, startRaw] = selectedKey.split("@");
      const startMs = Number(startRaw);
      if (!channelId || !Number.isFinite(startMs)) return;
      selectProgramme(channelId, startMs, { focus: true });
      const cell = bodyEl.querySelector(
        `[data-guide-cell][data-channel-id="${CSS.escape(channelId)}"][data-start-ms="${startMs}"]`,
      );
      if (cell instanceof HTMLElement) {
        cell.scrollIntoView({ block: "nearest", inline: "nearest" });
      }
    }

    function jumpToNow() {
      const today = startOfLocalDayMs(Date.now());
      if (dayStartMs() !== today) {
        goToDay(today, { jumpNow: true });
        return;
      }
      const { viewStartMs: start } = jumpToNowWindow(Date.now());
      viewStartMs = start;
      scrollToViewStart();
      queueRender();
      const list = dayProgrammes.get(String(liveState.guideChannelId || "")) || [];
      const current = list.find(
        (p) => programmeState(p.startMs, p.stopMs, Date.now()) === "now",
      );
      if (current) selectProgramme(current.channelId, current.startMs, { focus: true });
    }

    function shiftTime(deltaHours) {
      const day = dayStartMs();
      const next = viewStartMs + deltaHours * HOUR_MS;
      const min = day;
      const max = day + GUIDE_DAY_MS - 6 * HOUR_MS;
      viewStartMs = Math.max(min, Math.min(max, next));
      scrollToViewStart();
      queueRender();
    }

    function moveFocus(direction) {
      const activeEl = document.activeElement;
      if (!(activeEl instanceof HTMLElement)) return false;
      const cell = activeEl.closest("[data-guide-cell]");
      if (!cell) return false;
      const channelId = cell.dataset.channelId || "";
      const startMs = Number(cell.dataset.startMs);
      const rowIndex = visibleChannels.findIndex(
        (c) => String(c.id) === String(channelId),
      );
      if (rowIndex === -1) return false;
      const list = dayProgrammes.get(String(channelId)) || [];
      const idx = list.findIndex((p) => p.startMs === startMs);
      let target = null;
      if (direction === "move-left" && idx > 0) {
        target = { channelId, startMs: list[idx - 1].startMs };
      } else if (direction === "move-right" && idx >= 0 && idx < list.length - 1) {
        target = { channelId, startMs: list[idx + 1].startMs };
      } else if (direction === "move-up" || direction === "move-down") {
        const nextRow = direction === "move-up" ? rowIndex - 1 : rowIndex + 1;
        const nextChannel = visibleChannels[nextRow];
        if (!nextChannel) return false;
        const nextList = dayProgrammes.get(String(nextChannel.id)) || [];
        const sameTime =
          nextList.find((p) => p.startMs <= startMs && p.stopMs > startMs) ||
          nextList.find((p) => p.startMs >= startMs) ||
          nextList[nextList.length - 1];
        if (sameTime) {
          target = { channelId: String(nextChannel.id), startMs: sameTime.startMs };
        }
      }
      if (!target) return false;
      const targetRow = visibleChannels.findIndex(
        (c) => String(c.id) === String(target.channelId),
      );
      if (scrollEl instanceof HTMLElement) {
        const top = targetRow * ROW_HEIGHT_PX;
        if (top < scrollEl.scrollTop || top + ROW_HEIGHT_PX > scrollEl.scrollTop + scrollEl.clientHeight) {
          scrollEl.scrollTop = Math.max(0, top - ROW_HEIGHT_PX);
        }
      }
      renderRows();
      const el = bodyEl.querySelector(
        `[data-guide-cell][data-channel-id="${CSS.escape(target.channelId)}"][data-start-ms="${target.startMs}"]`,
      );
      if (el instanceof HTMLElement) {
        el.focus({ preventScroll: true });
        el.scrollIntoView({ block: "nearest", inline: "nearest" });
        return true;
      }
      return false;
    }

    /** Up/Down through the rows of the active list panel. */
    function moveRowFocus(direction) {
      const activeEl = document.activeElement;
      if (!(activeEl instanceof HTMLElement)) return false;
      const row = activeEl.closest("[data-guide-row]");
      if (!row) return false;
      const list = row.closest(".rs-guide-list, .rs-guide-tonight-sections, .rs-guide-tonight-featured");
      const scope = list || root;
      const rows = [...scope.querySelectorAll("[data-guide-row]")];
      const idx = rows.indexOf(row);
      const target = direction === "move-up" ? rows[idx - 1] : rows[idx + 1];
      if (target instanceof HTMLElement) {
        target.focus({ preventScroll: true });
        target.scrollIntoView({ block: "nearest" });
        return true;
      }
      return false;
    }

    // ── B behaviour ───────────────────────────────────────────────
    // Detail open closes first; otherwise exit to the entry mode.
    function handleBack() {
      if (detailOpen) {
        closeDetail();
        return;
      }
      leaveGuide();
    }

    function leaveGuide() {
      const returnTo = guideReturnMode(enteredFrom);
      liveState = exitGuide(liveState, returnTo);
      persistLivetvState(liveState);
      active = false;
      root.hidden = true;
      // 0.11.0 integration (R9): the shell (livetv.astro setMode)
      // is the single writer of html[data-livetv-mode]; the Guide
      // used to delete it here, but requestLivetvMode below makes
      // the shell write the return mode synchronously.
      requestLivetvMode(returnTo);
      const key = liveState.returnFocusKey;
      if (key) {
        const target = document.querySelector(
          `[data-focus-key="${CSS.escape(key)}"]`,
        );
        if (target instanceof HTMLElement) {
          target.focus({ preventScroll: true });
          return;
        }
      }
      const fallback = document.querySelector(
        '[data-couch-nav] [data-nylah-item]',
      );
      if (fallback instanceof HTMLElement) fallback.focus({ preventScroll: true });
    }

    // ── Cold-load catalog race (INTEGRATION 0.9.0) ───────────────
    // The Guide's script runs before the engine (stream.ts) has
    // fetched the channel list, so activate's first loadChannels()
    // can legitimately find nothing — and nothing retried it, so a
    // cold ?mode=guide load (and the /epg redirect) stayed empty
    // forever even after the catalog landed. finishActivation()
    // is the single post-catalog step; maybeFinishActivation()
    // runs it the moment channels appear (catalog event, EPG
    // load, or a bounded retry timer), and the tab switch no
    // longer waits for data (see activate).
    let activationFinished = false;
    let catalogRetryTimer = null;

    function finishActivation() {
      if (activationFinished) return;
      activationFinished = true;
      if (catalogRetryTimer !== null) {
        clearTimeout(catalogRetryTimer);
        catalogRetryTimer = null;
      }
      hideEmpty();
      rebuildCategoryOptions();
      loadAllProgrammes();
      rebuildDays();
      loadProgrammesForDay();
      visibleChannels = applyCategoryFilter();
      setGuideMode(guideMode);
      if (guideMode === "grid") {
        renderTimeHeader();
        updateDayControls();
        const all = [...dayProgrammes.values()].flat();
        selectedKey =
          stableGuideSelection(
            liveState.guideProgrammeKey || selectedKey,
            all,
            Date.now(),
          ) || selectedKey;
        if (selectedKey) {
          const [channelId, startRaw] = selectedKey.split("@");
          selectProgramme(channelId, Number(startRaw), { openDetail: false });
        }
        renderRows();
        scrollToViewStart();
        restoreSelectionFocus();
      }
    }

    function maybeFinishActivation() {
      if (!active || activationFinished) return;
      loadChannels();
      if (allChannels.length === 0) return;
      finishActivation();
    }

    function scheduleCatalogRetry(attemptsLeft) {
      if (!active || activationFinished || attemptsLeft <= 0) return;
      if (catalogRetryTimer !== null) return;
      catalogRetryTimer = setTimeout(() => {
        catalogRetryTimer = null;
        if (!active || activationFinished) return;
        loadChannels();
        if (allChannels.length === 0) {
          scheduleCatalogRetry(attemptsLeft - 1);
          return;
        }
        finishActivation();
      }, 1000);
    }

    async function activate(requestedMode) {
      if (active) {
        // Already open: a mode request just switches tabs.
        if (requestedMode !== undefined) setGuideMode(requestedMode);
        return;
      }
      const persisted = restoreLivetvState();
      enteredFrom = persisted.mode === "playback" ? "playback" : "home";
      const invokerKey =
        document.activeElement instanceof HTMLElement
          ? document.activeElement.getAttribute("data-focus-key")
          : null;
      // Seed shared guideMode from the request (or the persisted
      // tab) and record where to return to — both live in shared
      // state from here on; the local copy follows liveState. The
      // return mode goes through enterGuide's guideReturnTo param
      // (0.11.0 integration: the post-enterGuide spread that used
      // to set it here is gone — enterGuide is the single writer).
      liveState = enterGuide(
        persisted,
        invokerKey,
        requestedMode !== undefined
          ? parseGuideMode(requestedMode, persisted.guideMode)
          : undefined,
        enteredFrom === "playback" ? "playback" : "landing",
      );
      guideMode = liveState.guideMode;
      persistLivetvState(liveState);
      active = true;
      activationFinished = false;
      root.hidden = false;
      // 0.11.0 integration (R9): html[data-livetv-mode] is written
      // only by the shell (livetv.astro setMode) — on the same
      // livetv:mode event that triggers this activation, and on
      // load by the shell init for ?mode=guide deep links. The
      // Guide no longer writes it behind the shell's back.
      // The tab follows the request NOW, not after data loads: the
      // old code switched tabs only at the end of activate, so a
      // ?guideMode=tonight deep link stayed on On Now whenever the
      // catalog had not landed yet.
      setGuideMode(guideMode);
      await resolvePlaylist();
      if (!playlistId) {
        showEmpty("No playlist selected — open Live TV first to pick a playlist.");
        return;
      }
      try {
        // Hydrate BOTH kinds: a playlist only ever hits one, and
        // "live" alone misses a warm M3U cache after a reload.
        await Promise.allSettled([
          hydrateCache(playlistId, "live"),
          hydrateCache(playlistId, "m3u"),
        ]);
      } catch {
        // Cache hydration is best-effort; cached rows may already exist.
      }
      loadChannels();
      if (allChannels.length === 0) {
        showEmpty("No channels cached yet — open Live TV first so the channel list loads.");
        // The engine fetches the catalog in parallel; finish the
        // moment it lands instead of staying empty (catalog event,
        // EPG load, or the bounded retry below).
        scheduleCatalogRetry(10);
        return;
      }
      finishActivation();
    }

    function deactivate() {
      if (!active) return;
      active = false;
      activationFinished = false;
      if (catalogRetryTimer !== null) {
        clearTimeout(catalogRetryTimer);
        catalogRetryTimer = null;
      }
      root.hidden = true;
      // 0.11.0 integration (R9): the shell owns
      // html[data-livetv-mode] — this used to delete it, but the
      // shell's setMode on the same livetv:mode event writes the
      // new mode, so there is nothing for the Guide to clean up.
    }

    // ── Events ────────────────────────────────────────────────
    root.addEventListener("focusin", (event) => {
      const cell = event.target.closest("[data-guide-cell]");
      if (cell instanceof HTMLElement) {
        selectProgramme(cell.dataset.channelId || "", Number(cell.dataset.startMs), { openDetail: false });
        return;
      }
      const row = event.target.closest("[data-guide-row]");
      if (row instanceof HTMLElement) {
        selectProgramme(row.dataset.channelId || "", Number(row.dataset.startMs), { openDetail: false });
        // On Now: the featured panel follows the focused row (the
        // featured button itself is excluded — it already shows
        // this programme, and re-rendering it would steal focus).
        if (
          guideMode === "now" &&
          row.dataset.variant === "now" &&
          !row.closest("[data-guide-now-featured]")
        ) {
          refreshNowFeaturedFromSelection();
        }
      }
    });
    root.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const tab = target.closest("[data-guide-tab]");
      if (tab instanceof HTMLElement) {
        setGuideMode(tab.dataset.guideTab, { focusTab: true });
        return;
      }
      const pick = target.closest("[data-guide-channel-pick]");
      if (pick instanceof HTMLElement) {
        selectedChannelId = pick.dataset.guideChannelPick || null;
        renderChannel();
        const first = channelScheduleEl?.querySelector("[data-guide-row]");
        if (first instanceof HTMLElement) first.focus({ preventScroll: true });
        return;
      }
      const row = target.closest("[data-guide-row]");
      if (row instanceof HTMLElement) {
        selectProgramme(row.dataset.channelId || "", Number(row.dataset.startMs));
        return;
      }
      const cell = target.closest("[data-guide-cell]");
      if (cell instanceof HTMLElement) {
        selectProgramme(cell.dataset.channelId || "", Number(cell.dataset.startMs));
        activateSelected();
        return;
      }
      if (target.closest("[data-guide-back]")) {
        handleBack();
        return;
      }
      if (target.closest("[data-guide-now]")) {
        jumpToNow();
        return;
      }
      if (target.closest("[data-guide-prev-day]")) {
        const idx = days.indexOf(dayStartMs());
        if (idx > 0) goToDay(days[idx - 1]);
        return;
      }
      if (target.closest("[data-guide-next-day]")) {
        const idx = days.indexOf(dayStartMs());
        if (idx >= 0 && idx < days.length - 1) goToDay(days[idx + 1]);
        return;
      }
      if (target.closest("[data-guide-channel-prev-day]")) {
        stepChannelDay(-1);
        return;
      }
      if (target.closest("[data-guide-channel-next-day]")) {
        stepChannelDay(1);
        return;
      }
      if (target.closest("[data-guide-action-watch]") && selected) {
        tuneToChannel(String(selected.channel.id));
        return;
      }
      if (target.closest("[data-guide-action-catchup]") && selected) {
        dispatch("livetv:programme", {
          channelId: String(selected.channel.id),
          startMs: selected.programme.startMs,
        });
      }
    });
    if (categoryEl instanceof HTMLSelectElement) {
      categoryEl.addEventListener("change", () => {
        category = categoryEl.value;
        visibleChannels = applyCategoryFilter();
        if (scrollEl instanceof HTMLElement) scrollEl.scrollTop = 0;
        loadProgrammesForDay();
        renderActivePanel();
      });
    }
    if (searchEl instanceof HTMLInputElement) {
      searchEl.addEventListener("input", () => {
        searchQuery = searchEl.value || "";
        renderActivePanel();
      });
    }
    if (scrollEl instanceof HTMLElement) {
      scrollEl.addEventListener("scroll", queueRender, { passive: true });
    }
    root.addEventListener("keydown", (event) => {
      const target = event.target;
      // Typing in search / the category select owns its own keys.
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLSelectElement
      ) {
        return;
      }
      const action = livetvKeyActionForKey("guide", event.key);
      if (action === "back") {
        event.preventDefault();
        handleBack();
        return;
      }
      if (!action) {
        // D-pad Up/Down/Left/Right arrive as plain arrows here.
        const row = document.activeElement?.closest?.("[data-guide-row]");
        const tab = document.activeElement?.closest?.("[data-guide-tab]");
        const featured = document.activeElement?.closest?.(
          "[data-guide-now-featured], [data-guide-tonight-featured]",
        );
        if (event.key === "ArrowUp" || event.key === "ArrowDown") {
          if (featured) {
            // From a featured panel: Down enters the list, Up
            // returns to the mode tabs.
            event.preventDefault();
            if (event.key === "ArrowDown") {
              const first = root.querySelector(
                guideMode === "now"
                  ? "[data-guide-now-list] [data-guide-row]"
                  : "[data-guide-tonight-sections] [data-guide-row]",
              );
              if (first instanceof HTMLElement) first.focus({ preventScroll: true });
            } else {
              const activeTab = tabEls.find((t) => t.dataset.guideTab === guideMode);
              if (activeTab instanceof HTMLElement) activeTab.focus({ preventScroll: true });
            }
            return;
          }
          if (row) {
            event.preventDefault();
            moveRowFocus(event.key === "ArrowUp" ? "move-up" : "move-down");
          }
          return;
        }
        if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
          if (tab) {
            event.preventDefault();
            stepGuideMode(event.key === "ArrowLeft" ? -1 : 1);
          } else if (featured && guideMode === "now" && event.key === "ArrowRight") {
            // From the On Now featured panel: Right enters the list.
            event.preventDefault();
            const first = root.querySelector("[data-guide-now-list] [data-guide-row]");
            if (first instanceof HTMLElement) first.focus({ preventScroll: true });
          } else if (row && guideMode === "now" && event.key === "ArrowLeft") {
            // From an On Now row: Left enters the featured panel.
            event.preventDefault();
            const featuredBtn = nowFeaturedEl?.querySelector("[data-guide-row]");
            if (featuredBtn instanceof HTMLElement) featuredBtn.focus({ preventScroll: true });
          } else if (row && guideMode === "channel") {
            // Left/Right moves between the channel picker and the schedule.
            if (event.key === "ArrowLeft" && row) {
              event.preventDefault();
              const firstPick = channelListEl?.querySelector("[data-guide-channel-pick]");
              if (firstPick instanceof HTMLElement) firstPick.focus({ preventScroll: true });
            }
          }
          return;
        }
        return;
      }
      if (action === "jump-to-now") {
        event.preventDefault();
        if (guideMode === "channel") {
          channelDayOffset = 0;
          renderChannelSchedule();
        } else {
          jumpToNow();
        }
        return;
      }
      if (action === "time-prev") {
        event.preventDefault();
        if (guideMode === "channel") stepChannelDay(-1);
        else if (guideMode === "grid") shiftTime(-6);
        return;
      }
      if (action === "time-next") {
        event.preventDefault();
        if (guideMode === "channel") stepChannelDay(1);
        else if (guideMode === "grid") shiftTime(6);
        return;
      }
      if (action === "guide-actions") {
        event.preventDefault();
        if (categoryEl instanceof HTMLElement) categoryEl.focus();
        return;
      }
      if (action.startsWith("move-")) {
        const cell = document.activeElement?.closest?.("[data-guide-cell]");
        if (cell) {
          event.preventDefault();
          moveFocus(action);
          return;
        }
        if (action === "move-up" || action === "move-down") {
          event.preventDefault();
          moveRowFocus(action);
        }
      }
      // "select" falls through to the native button click (Enter/Space).
    });
    window.addEventListener("livetv:mode", (event) => {
      const mode = event.detail?.mode;
      if (mode === "guide") {
        void activate(event.detail?.guideMode);
      } else if (mode === "home" || mode === "landing" || mode === "playback") {
        // INTEGRATION 0.11.0 — "landing" is the 0.11.0 name for
        // the 0.9.0 "home" mode (setMode maps home→landing before
        // dispatching, so the "home" branch is dead): without it,
        // leaving the Guide for the landing via the top nav left
        // `active` true, and re-entering the Guide early-returned
        // from activate() without capturing the invoker's focus
        // key — B then restored focus to a stale key (or the
        // nav fallback) instead of the invoker.
        deactivate();
      }
    });
    // B behaviour (W5 contract): the gamepad layer dispatches this
    // window event; the Guide closes its detail first, then exits.
    window.addEventListener("livetv:back", () => {
      if (!active) return;
      handleBack();
    });
    // The catalog can land after activation (cold ?mode=guide):
    // a cache write, or the EPG arriving, re-checks the channel
    // list and finishes activation the moment it appears.
    document.addEventListener(CACHE_REVALIDATED_EVENT, (event) => {
      if (!active || activationFinished) return;
      const detail = event.detail ?? {};
      if (detail.entryId && detail.entryId !== playlistId) return;
      if (detail.kind && detail.kind !== "live" && detail.kind !== "m3u") return;
      maybeFinishActivation();
    });
    document.addEventListener(EPG_LOADED_EVENT, () => {
      if (!active) return;
      const previous = selectedKey;
      loadChannels();
      maybeFinishActivation();
      loadAllProgrammes();
      rebuildDays();
      loadProgrammesForDay();
      visibleChannels = applyCategoryFilter();
      const all = [...dayProgrammes.values()].flat();
      selectedKey = stableGuideSelection(previous, all, Date.now());
      renderActivePanel();
      if (guideMode === "grid" && selectedKey) {
        const [channelId, startRaw] = selectedKey.split("@");
        selectProgramme(channelId, Number(startRaw), { openDetail: false });
      }
    });

    // Deep link / reload: ?mode=guide or a persisted guide mode.
    const params = new URLSearchParams(window.location.search);
    if (params.get("mode") === "guide" || restoreLivetvState().mode === "guide") {
      void activate(parseGuideMode(params.get("guideMode"), DEFAULT_GUIDE_MODE));
    } else {
      // Pre-warm the guide data so first activation is instant.
      void resolvePlaylist().then(() => {
        if (!playlistId) return;
        loadChannels();
      });
    }
  }
</script>
