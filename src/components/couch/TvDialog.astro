---
// TvDialog — overlay dialog built on dialog-spatial-nav.ts.
// Props: id (required, unique per page), title.
// Behaviour: traps spatial nav while open (attachDialogSpatialNav),
// closes on B/Escape (native <dialog> cancel), returns focus to the
// invoker (openCouchDialog/closeCouchDialog in couch-focus.ts), and
// NEVER requires a mouse to close — the Close button is a normal
// focusable and B/Escape always work.
// Open from anywhere: <button data-couch-dialog-open="<id>"> or
// openCouchDialog("<id>", invokerEl). Close: [data-couch-dialog-close]
// or closeCouchDialog("<id>").
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<dialog
  id={id}
  class="rs-dialog"
  data-nylah-dialog
  aria-labelledby={`${id}-title`}
>
  <div class="rs-dialog__inner">
    <div class="rs-dialog__head">
      <h2 class="rs-dialog__title" id={`${id}-title`}>{title}</h2>
      <button type="button" class="rs-dialog__close" data-couch-dialog-close>
        Close
      </button>
    </div>
    <div class="rs-dialog__body">
      <slot />
    </div>
  </div>
</dialog>

<script>
  // Astro inlines a define:vars script verbatim, so the bare imports
  // this dialog used to carry threw "Cannot use import statement
  // outside a module" in the browser and the dialog nav never attached
  // (W8) — not even the Search-button trigger wiring. A plain <script>
  // is bundled as a module, so imports resolve; it cannot receive the
  // dialog id via define:vars, so it wires every dialog on the page
  // instead, guarded so a second script instance (or a second TvDialog)
  // never double-attaches (double attach would register two
  // spatial-nav sections under one id and fight over focus).
  import { attachDialogSpatialNav } from "@/scripts/lib/dialog-spatial-nav.ts";
  import {
    openCouchDialog,
    closeCouchDialog,
  } from "@/scripts/lib/couch-focus.ts";
  import {
    registerBackLayer,
    BACK_PRIORITY,
  } from "@/scripts/lib/back-handler.ts";

  document.querySelectorAll("dialog[data-nylah-dialog]").forEach((dlg) => {
    if (!(dlg instanceof HTMLDialogElement) || !dlg.id) return;
    if (dlg.dataset.dialogWired) return;
    dlg.dataset.dialogWired = "1";
    const dialogId = dlg.id;
    attachDialogSpatialNav(dlg);
    // Back layer for the coordinator: while this dialog is open
    // it owns B (close + invoker restore via closeCouchDialog).
    // The coordinator runs this layer before its own
    // close-topmost-chrome fallback, so it never double-closes.
    registerBackLayer({
      id: `tv-dialog:${dialogId}`,
      priority: BACK_PRIORITY.MODAL,
      isActive: () => dlg.open,
      handle: () => closeCouchDialog(dialogId),
    });
    // Native close (B/Escape) still needs focus returned to the
    // invoker — the dialog's own close event is the hook. The
    // invoker map is populated by openCouchDialog; a dialog opened
    // any other way simply restores nothing.
    dlg.addEventListener("close", () => {
      closeCouchDialog(dialogId);
    });
    dlg
      .querySelectorAll("[data-couch-dialog-close]")
      .forEach((btn) =>
        btn.addEventListener("click", () => closeCouchDialog(dialogId)),
      );
    document
      .querySelectorAll(`[data-couch-dialog-open="${dialogId}"]`)
      .forEach((trigger) => {
        if (!(trigger instanceof HTMLElement)) return;
        if (trigger.dataset.dialogTriggerWired) return;
        trigger.dataset.dialogTriggerWired = "1";
        trigger.addEventListener("click", (event) =>
          openCouchDialog(
            dialogId,
            event.currentTarget instanceof HTMLElement
              ? event.currentTarget
              : null,
          ),
        );
      });
  });
</script>
