---
// TvChannelList — Live TV channel browser (W3).
//
// The virtual list itself is painted by stream.ts into #list /
// #spacer / #viewport — those ids are stream.ts's, keep them exact.
// This component provides that shell (couch-sized, RedSilk surfaces)
// plus the client fill for the Favourites / Recently watched quick
// rails. The rail *sections* live on the page (TvRail shells placed
// full-width below the player grid in livetv.astro); this script
// finds them by rail id and fills them from the same preferences
// store stream.ts uses (getFavorites / getRecents / getFavoriteMeta),
// so they never show invented channels: an empty collection hides
// its rail entirely. Rail cards link to /livetv?channel=<id> — the
// auto-play path stream.ts already mounts on load — so picking a
// favourite tunes straight to it without leaving the screen.
---

<div class="rs-channellist" data-couch-channel-list>
  <div
    id="list"
    class="relative flex-1 min-h-0 overflow-auto pr-1 custom-scroll"
    role="listbox"
    aria-label="Channels"
  >
    <div id="spacer"></div>
    <div id="viewport" class="absolute inset-x-0 top-0"></div>
  </div>

  <div
    id="list-status"
    class="rs-channellist__status px-2.5 text-sm shrink-0"
    aria-live="polite"
  >
    No playlist selected.
  </div>
</div>

<script>
  import {
    ensureLoaded,
    getFavorites,
    getFavoriteMeta,
    getRecents,
  } from "@/scripts/lib/preferences.js";
  import {
    armTvImageFallbacks,
    fallbackMarkFor,
    isUsableImageSrc,
  } from "@/scripts/lib/couch-image.ts";

  // Rail sections live on the page (TvRail shells in livetv.astro);
  // the fill below appends real channel cards into them by rail id.
  // The same data also fills the OSD quick-channel dialog
  // ([data-couch-quick-list] mounts in livetv.astro) as compact rows.
  const FAVOURITES_RAIL_ID = "livetv-favourites";
  const RECENTS_RAIL_ID = "livetv-recents";
  const MAX_FAVOURITES = 12;
  const MAX_RECENTS = 10;

  function activePlaylistId() {
    try {
      const raw = localStorage.getItem("xt_playlists") || "";
      if (!raw) return "";
      const parsed = JSON.parse(raw);
      const entries = Array.isArray(parsed?.entries) ? parsed.entries : [];
      const selected = entries.find((e) => e && e._id === parsed?.selectedId);
      return selected ? String(selected._id) : "";
    } catch {
      return "";
    }
  }

  function channelCard(channel, metaLabel) {
    const link = document.createElement("a");
    link.className = "rs-card rs-card--channel";
    link.setAttribute("data-nylah-item", "");
    link.setAttribute("data-couch-key", `live-${channel.id}`);
    link.href = `/livetv?channel=${encodeURIComponent(String(channel.id))}`;
    link.setAttribute("aria-label", channel.name || `Channel ${channel.id}`);

    const media = document.createElement("span");
    media.className = "rs-card__media";
    const image = document.createElement("span");
    image.className = "rs-image rs-image--logo";
    image.setAttribute("data-tv-image", "");
    image.setAttribute("data-kind", "logo");
    const usable = isUsableImageSrc(channel.logo);
    if (!usable) image.classList.add("is-fallback");
    if (usable) {
      const img = document.createElement("img");
      img.src = channel.logo;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.setAttribute("data-tv-image-img", "");
      image.appendChild(img);
    }
    const fallback = document.createElement("span");
    fallback.className = "rs-image__fallback";
    fallback.setAttribute("aria-hidden", "true");
    const mark = document.createElement("span");
    mark.className = "rs-image__fallback-mark";
    mark.textContent = fallbackMarkFor("logo", channel.name);
    // No fallback-title here: the card body already shows the channel
    // name, and the title text inside the small logo box overflows
    // onto it. The logo box carries the "N" mark only.
    fallback.append(mark);
    image.appendChild(fallback);
    media.appendChild(image);

    const body = document.createElement("span");
    body.className = "rs-card__body";
    const title = document.createElement("span");
    title.className = "rs-card__title";
    title.textContent = channel.name || `Channel ${channel.id}`;
    body.appendChild(title);
    if (metaLabel) {
      const meta = document.createElement("span");
      meta.className = "rs-card__meta";
      meta.textContent = metaLabel;
      body.appendChild(meta);
    }
    link.append(media, body);
    return link;
  }

  function fillRail(railId, channels, metaLabel) {
    const section = document.querySelector(
      `[data-nylah-rail="${railId}"]`,
    );
    if (!section) return;
    const row = section.querySelector(".rs-rail__row");
    if (!row) return;
    row.replaceChildren();
    if (!channels.length) {
      section.setAttribute("hidden", "");
      return;
    }
    section.removeAttribute("hidden");
    for (const channel of channels) {
      row.appendChild(channelCard(channel, metaLabel));
    }
    window.SpatialNavigation?.makeFocusable?.();
  }

  function quickRow(channel) {
    const link = document.createElement("a");
    link.className = "rs-quicklist__row";
    link.setAttribute("data-nylah-item", "");
    link.href = `/livetv?channel=${encodeURIComponent(String(channel.id))}`;
    const image = document.createElement("span");
    image.className = "rs-image rs-image--logo rs-quicklist__logo";
    image.setAttribute("data-tv-image", "");
    image.setAttribute("data-kind", "logo");
    const usable = isUsableImageSrc(channel.logo);
    if (!usable) image.classList.add("is-fallback");
    if (usable) {
      const img = document.createElement("img");
      img.src = channel.logo;
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.setAttribute("data-tv-image-img", "");
      image.appendChild(img);
    }
    const fallback = document.createElement("span");
    fallback.className = "rs-image__fallback";
    fallback.setAttribute("aria-hidden", "true");
    const mark = document.createElement("span");
    mark.className = "rs-image__fallback-mark";
    mark.textContent = fallbackMarkFor("logo", channel.name);
    fallback.appendChild(mark);
    image.appendChild(fallback);
    const name = document.createElement("span");
    name.className = "rs-quicklist__name";
    name.textContent = channel.name || `Channel ${channel.id}`;
    const hint = document.createElement("span");
    hint.className = "rs-quicklist__hint";
    hint.textContent = "Play";
    link.append(image, name, hint);
    return link;
  }

  function fillQuickList(kind, channels) {
    const mount = document.querySelector(
      `[data-couch-quick-list="${kind}"]`,
    );
    if (!mount) return;
    mount.replaceChildren();
    if (!channels.length) {
      const empty = document.createElement("p");
      empty.className = "rs-quicklist__empty";
      empty.textContent =
        kind === "favourites"
          ? "No favourite channels yet — star a channel in the list to pin it here."
          : "Nothing watched yet — channels you watch will appear here.";
      mount.appendChild(empty);
      return;
    }
    for (const channel of channels) {
      mount.appendChild(quickRow(channel));
    }
    window.SpatialNavigation?.makeFocusable?.();
  }

  async function refreshRails() {
    armTvImageFallbacks(document);
    const playlistId = activePlaylistId();
    if (!playlistId) {
      fillRail(FAVOURITES_RAIL_ID, [], null);
      fillRail(RECENTS_RAIL_ID, [], null);
      fillQuickList("favourites", []);
      fillQuickList("recents", []);
      return;
    }
    try {
      await ensureLoaded();
    } catch {
      // Preferences unreadable: rails stay hidden rather than
      // showing stale or invented entries.
      fillRail(FAVOURITES_RAIL_ID, [], null);
      fillRail(RECENTS_RAIL_ID, [], null);
      fillQuickList("favourites", []);
      fillQuickList("recents", []);
      return;
    }
    const favouriteIds = Array.from(getFavorites(playlistId, "live") ?? []);
    const favourites = favouriteIds
      .slice(0, MAX_FAVOURITES)
      .map((id) => {
        const meta = getFavoriteMeta(playlistId, "live", id) || {};
        return { id, name: meta.name || "", logo: meta.logo || null };
      })
      .filter((channel) => channel.name);
    fillRail(FAVOURITES_RAIL_ID, favourites, null);
    fillQuickList("favourites", favourites);

    const recents = (getRecents(playlistId, "live") ?? [])
      .slice(0, MAX_RECENTS)
      .map((entry) => ({ id: entry.id, name: entry.name || "", logo: entry.logo || null }))
      .filter((channel) => channel.name);
    fillRail(RECENTS_RAIL_ID, recents, null);
    fillQuickList("recents", recents);
  }

  refreshRails();
  document.addEventListener("xt:favorites-changed", () => refreshRails());
  document.addEventListener("xt:recents-changed", () => refreshRails());
  document.addEventListener("xt:active-changed", () => refreshRails());
</script>

<style>
  /* The list shell: full-height virtual list inside the browser
     column. Rows are painted by stream.ts; the couch sizing for
     them (bigger fitted logos, legible type) lives in the page
     stylesheet, where the :global() hooks for runtime DOM belong. */
  .rs-channellist {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    min-height: 0;
  }
  .rs-channellist__status {
    color: var(--rs-text-2);
    font-size: 1.125rem;
  }
  /* Rail-card logo frame: the .rs-image span has no in-flow content
     when a channel has no logo (no <img>), so without an explicit
     size it collapses to 0×0 and its absolute fallback ("N" mark)
     spills out over the card title. Block + full width gives the
     16/9 logo frame from couch.css a real box; the mark centres
     inside it and the title flows below. */
  :global(.rs-card--channel .rs-card__media .rs-image--logo) {
    display: block;
    width: 100%;
  }
  /* Quick-list rows (OSD "Channels" dialog). The dialog lives on the
     page, so these rules are :global() — same rs classes as the rail
     cards, in a compact list form. */
  :global(.rs-quicklist__row) {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid transparent;
    color: var(--rs-text);
  }
  :global(.rs-quicklist__row:hover) {
    background: var(--rs-surface);
  }
  :global(.rs-quicklist__row:focus-visible) {
    outline: none;
    border-color: var(--rs-focus);
    box-shadow:
      0 0 0 2px var(--rs-focus),
      0 0 1.5rem 0.25rem var(--rs-focus-glow);
    background: var(--rs-surface);
  }
  :global(.rs-quicklist__logo) {
    width: 4.5rem;
    height: 2.75rem;
    aspect-ratio: auto;
  }
  :global(.rs-quicklist__name) {
    flex: 1;
    min-width: 0;
    font-size: 1.375rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.rs-quicklist__hint) {
    font-size: 1.125rem;
    color: var(--rs-focus);
    flex-shrink: 0;
  }
  :global(.rs-quicklist__empty) {
    font-size: 1.25rem;
    color: var(--rs-text-2);
    margin: 0;
    padding: 0.75rem;
  }
</style>
