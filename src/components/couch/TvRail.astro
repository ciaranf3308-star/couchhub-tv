---
// TvRail — horizontal rail, registered as a gamepad section.
// Props: id (rail id for data-nylah-rail + focus memory), title,
// href? ("See all" link — a plain link, deliberately NOT a rail item
// so D-pad left/right stays on the cards), density? ("default" |
// "large" — sizing ONLY: "large" renders roughly 5–6 substantial
// cards per visible rail at 1080p via .rs-rail--large in couch.css;
// default is the current sizing, unchanged. Home rails use "large";
// every other screen keeps the default. Behaviour — slots, focus
// memory, gamepad section registration — is identical either way),
// variant? (H04 rail visual variation — ONE of "film" | "series" |
// "documentary" | "followed" | "live"; renders
// .rs-rail--variant-<name> in couch.css. Subtle differences only:
// card treatment, spacing, typography — no heavy panels, no nested
// containers. Omit for the neutral default rail), sparse? (H06 —
// set when W1's minimum-population rule marks this rail sparse:
// renders .rs-rail--sparse, which restyles a thin collection
// instead of stretching it — default-density cards, quieter title,
// no giant-card treatment even on a "large" rail. Hiding or
// consolidating the rail entirely is W1's render decision; this is
// the presentation for a sparse rail that still renders), count?
// (item population, rendered as data-rail-count for CSS/JS hooks).
// Children are the rail's cards (TvCard, each data-nylah-item).
export type TvRailDensity = "default" | "large";
export type TvRailVariant = "film" | "series" | "documentary" | "followed" | "live";

interface Props {
  id: string;
  title: string;
  href?: string;
  density?: TvRailDensity;
  variant?: TvRailVariant;
  sparse?: boolean;
  count?: number;
}
const { id, title, href, density = "default", variant, sparse = false, count } = Astro.props;
const classes = [
  "rs-rail",
  density === "large" ? "rs-rail--large" : "",
  variant ? `rs-rail--variant-${variant}` : "",
  sparse ? "rs-rail--sparse" : "",
]
  .filter(Boolean)
  .join(" ");
---

<section
  class={classes}
  data-nylah-rail={id}
  data-rail-variant={variant}
  data-rail-count={count}
  aria-label={title}
>
  <div class="rs-rail__head">
    <h2 class="rs-section-title">{title}</h2>
    {href && <a class="rs-rail__more" href={href}>See all ›</a>}
  </div>
  <div class="rs-rail__row">
    <slot />
  </div>
</section>
