---
// TvLiveHero — Now Watching / Continue Live hero (0.11.0, W3).
//
// The full-width cinematic hero band. Renders the skeleton with
// [data-hero-*] mounts; src/scripts/lib/livetv-landing.ts fills it
// (fillLandingHero) from the cached home data. No props: the hero
// channel + programme come from loadLivetvHomeData at runtime, so a
// server-rendered hero would be stale by construction.
//
// Programme-led, not gradient-led (0.9.0's "EPG carries no
// artwork" reasoning is superseded by the 0.11.0 enrichment
// layer): the art layer ([data-hero-art]) starts as the branded
// TvProgrammeArt placeholder and is upgraded in place to real
// programme artwork by fillLandingHero via enrichProgramme — the
// artwork forms the right-hand composition of the band, with
// gradient fades preserving readability of the text on the left.
// When no artwork is available the branded fallback stands — a
// composed burgundy treatment with the channel logo, never a giant
// empty rectangle, never unrelated artwork. Do NOT display artwork
// matched to a different programme.
//
// Artwork honesty: programme title / times / progress / synopsis
// are real EPG only (synopsis falls back to the enrichment
// synopsis for the same title, never invented). No stream is
// started to populate the hero: Watch Live tunes explicitly
// (dispatchLivetvTune); opening the landing never auto-starts a
// stream.
//
// Mount contract (unchanged from 0.9.0 so livetv.astro wiring
// survives): [data-hero-eyebrow], [data-hero-logo],
// [data-hero-title] (channel name), [data-hero-programme-title],
// [data-hero-programme-time], [data-hero-progress-wrap] /
// [data-hero-progress-fill], [data-hero-next], [data-hero-watch],
// [data-hero-guide]. Added in 0.11.0: [data-hero-art] (artwork
// layer) and [data-hero-description] (programme synopsis).
import TvProgrammeArt from "@/components/couch/TvProgrammeArt.astro";
---

<section
	class="rs-livetv-landing-hero"
	data-livetv-hero
	data-nylah-rail="livetv-landing-hero"
	aria-label="Now watching"
	hidden>
	<div class="rs-livetv-landing-hero__art" data-hero-art aria-hidden="true">
		<TvProgrammeArt title="" variant="hero" />
	</div>
	<div class="rs-livetv-landing-hero__body">
		<p class="rs-livetv-landing-hero__eyebrow" data-hero-eyebrow>Now Watching</p>
		<div class="rs-livetv-landing-hero__channel">
			<div class="rs-livetv-landing-hero__logo" data-hero-logo></div>
			<h2 class="rs-livetv-landing-hero__title" data-hero-title></h2>
		</div>
		<p class="rs-livetv-landing-hero__programme" data-hero-programme-title></p>
		<p class="rs-livetv-landing-hero__time" data-hero-programme-time></p>
		<div
			class="rs-livetv-landing-hero__progress"
			data-hero-progress-wrap
			role="progressbar"
			aria-label="Programme progress"
			hidden>
			<div class="rs-livetv-landing-hero__progress-fill" data-hero-progress-fill style="width: 0%"></div>
		</div>
		<p class="rs-livetv-landing-hero__description" data-hero-description hidden></p>
		<p class="rs-livetv-landing-hero__next" data-hero-next hidden></p>
		<div class="rs-livetv-landing-hero__actions">
			<button
				type="button"
				class="rs-livetv-landing-hero__action rs-livetv-landing-hero__action--primary"
				data-hero-watch
				data-nylah-item
				data-couch-key="landing-hero-watch"
				data-focus-key="landing-hero-watch">
				Watch Live
			</button>
			<button
				type="button"
				class="rs-livetv-landing-hero__action rs-livetv-landing-hero__action--secondary"
				data-hero-guide
				data-nylah-item
				data-couch-key="landing-hero-guide"
				data-focus-key="landing-hero-guide">
				Open Guide
			</button>
		</div>
	</div>
</section>
