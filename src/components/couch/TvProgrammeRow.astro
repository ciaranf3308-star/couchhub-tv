// TvProgrammeRow — ONE shared presentational programme row (W5, 0.9.0).
//
// Used by W4 (Guide On Now / Tonight / By Channel). Presentational
// only: no fetching, no tuning — the caller owns selection and
// actions. Times, title, channel identity, synopsis, progress and a
// catch-up badge. The badge comes only from
// catchupActionForProgramme — a programme on a channel without
// catch-up never shows one. Rows are separated by subtle dividers,
// never borders-in-borders; imagery is bounded.
import TvImage from "./TvImage.astro";
import { formatTimeRange } from "@/scripts/lib/now-next.ts";
import {
  catchupActionForProgramme,
  catchupBadgeLabel,
  programmeProgress,
} from "@/scripts/lib/couch-livetv-epg.ts";
import type { LivetvChannel } from "@/scripts/lib/livetv-data.ts";
import type { Programme } from "@/scripts/lib/now-next.ts";

interface Props {
  programme: Programme;
  channel: LivetvChannel;
  variant: "now" | "tonight" | "channel";
}
const { programme, channel, variant } = Astro.props;
const name = channel.displayName || channel.name;
const nowMs = Date.now();
const progress = programmeProgress(programme.start, programme.stop, nowMs);
// LivetvChannel carries the catch-up flag but not the raw provider
// fields catchupActionForProgramme reads — pass the flag through
// the shape it understands (tvArchive 1 = catch-up offered).
// The programme's raw XMLTV start (never tvg-shifted) gates the
// archive window, exactly as the Guide does.
const catchupAction = catchupActionForProgramme({
  channel: { tvArchive: channel.catchup ? 1 : 0 },
  startMs: programme.rawStart ?? programme.start,
  stopMs: programme.rawStop ?? programme.stop,
  nowMs,
});
const badge = catchupBadgeLabel(catchupAction);
const isLive = programme.start <= nowMs && nowMs < programme.stop;
---

<div
  class={`rs-tv-programme-row rs-tv-programme-row--${variant}`}
  data-tv-programme-row
  data-variant={variant}
  data-channel-id={String(channel.id)}
  data-programme-start={String(programme.start)}
>
  <div class="rs-tv-programme-row__logo">
    <TvImage
      src={channel.logo ?? undefined}
      kind="logo"
      media="channel"
      title={name}
      alt=""
    />
  </div>
  <div class="rs-tv-programme-row__body">
    <p class="rs-tv-programme-row__head">
      <span class="rs-tv-programme-row__time">
        {formatTimeRange(programme.start, programme.stop)}
      </span>
      <span class="rs-tv-programme-row__channel">{name}</span>
      {
        isLive && (
          <span class="rs-tv-programme-row__live">Live</span>
        )
      }
      {
        badge && (
          <span class="rs-tv-programme-row__badge">{badge}</span>
        )
      }
    </p>
    <p class="rs-tv-programme-row__title">{programme.title}</p>
    {
      programme.desc && (
        <p class="rs-tv-programme-row__desc">{programme.desc}</p>
      )
    }
    {
      isLive && (
        <div
          class="rs-tv-programme-row__progress"
          role="progressbar"
          aria-valuenow={Math.round(progress * 100)}
          aria-valuemin={0}
          aria-valuemax={100}
          aria-label={`Progress of ${programme.title}`}
        >
          <div
            class="rs-tv-programme-row__progress-fill"
            style={`width: ${Math.round(progress * 100)}%`}
          />
        </div>
      )
    }
  </div>
</div>

<style>
  /* Row, not a card: no border, no background box — the divider
     below separates rows. */
  .rs-tv-programme-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.875rem 0.25rem;
    border-bottom: 1px solid var(--rs-line-soft);
  }
  .rs-tv-programme-row:last-child {
    border-bottom: none;
  }
  .rs-tv-programme-row__logo {
    flex-shrink: 0;
    width: 5.5rem;
    height: 3.25rem;
    overflow: hidden;
    border-radius: 0.5rem;
  }
  .rs-tv-programme-row__logo :global(.rs-image) {
    width: 100%;
    height: 100%;
  }
  .rs-tv-programme-row__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    flex: 1;
  }
  .rs-tv-programme-row__head {
    margin: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--rs-text-2);
  }
  .rs-tv-programme-row__time {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--rs-text);
  }
  .rs-tv-programme-row__channel {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rs-tv-programme-row__live {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rs-accent);
  }
  .rs-tv-programme-row__badge {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rs-text);
    background: color-mix(in srgb, var(--rs-accent) 22%, transparent);
    border-radius: 999px;
    padding: 0.125rem 0.5rem;
  }
  .rs-tv-programme-row__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--rs-text);
  }
  .rs-tv-programme-row__desc {
    margin: 0;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--rs-text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rs-tv-programme-row__progress {
    height: 0.25rem;
    margin-top: 0.375rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--rs-accent) 22%, transparent);
    overflow: hidden;
  }
  .rs-tv-programme-row__progress-fill {
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--rs-accent), var(--rs-focus));
  }
</style>
