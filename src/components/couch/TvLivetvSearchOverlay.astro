---
// TvLivetvSearchOverlay — Live TV 2.0 Search overlay (0.11.7, W4).
//
// A large controller-friendly search overlay. It renders hidden
// and opens ONLY on `livetv:open-search` (dispatched by W2's
// browser/drawer with the current group/subcategory context).
// On submit it dispatches `livetv:search-submit`
// { query, scope, categoryId }; on close without a submit it
// dispatches `livetv:close-overlay` { overlay: "search", reason }.
//
// Scoping (see livetv-search-sort.ts): by default a search from
// within a subcategory searches THAT subcategory; an obvious
// "All channels" scope searches everything. Changing category
// clears a category-scoped draft unless the user explicitly
// chose the global scope — Sports → Movies never intersects.
//
// Controller: the on-screen keyboard (TvKeyboard, the shared
// OSK — A types, B deletes, X clears) is the typing path; the
// scope buttons, Search / Clear / Cancel are large focusables.
// B / Escape closes the overlay (one nav layer only — the
// overlay pushes the "search" layer on livetvNav and B pops
// exactly that layer). Physical keyboard: type + Enter submits,
// Escape closes, X clears when the input is not focused.
// Mouse: click scope, Search, Clear, Cancel, or the scrim.
//
// Mount contract: mount ONCE per Live TV page (integration).
// The component wires itself on load; a second instance on the
// same page is ignored (the first [data-livetv-search-overlay]
// wins). Requires the Live TV nav singleton (livetvNav) only —
// no shell changes.
//
// Known limitation (shared with the Movies/Series search
// dialogs): TvKeyboard's value is an Astro static prop, so the
// OSK starts empty on every mount and typing on it replaces a
// prefilled query rather than appending to it. The text input
// is the source of truth for physical typing + submit.
import "@/styles/livetv-nav-chrome.css";
import TvKeyboard from "@/components/couch/TvKeyboard.svelte";
---

<div
  class="lv2-overlay lv2-search"
  data-livetv-search-overlay
  role="dialog"
  aria-modal="true"
  aria-labelledby="lv2-search-title"
  hidden
>
  <div class="lv2-overlay__scrim" data-livetv-search-scrim></div>
  <div class="lv2-overlay__panel lv2-search__panel">
    <div class="lv2-search__head">
      <h2 class="lv2-search__title" id="lv2-search-title">Search channels</h2>
      <nav
        class="lv2-breadcrumb lv2-search__context"
        data-livetv-search-context
        aria-label="Search location"
      >
      </nav>
      <p class="lv2-search__note" data-livetv-search-note></p>
    </div>

    <input
      class="lv2-search__input"
      data-livetv-search-input
      type="search"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      aria-label="Search channels"
      placeholder="Type a channel name…"
    />

    <div
      class="lv2-search__scopes"
      data-livetv-search-scopes
      role="radiogroup"
      aria-label="Search scope"
    >
      <button
        type="button"
        class="lv2-search__scope"
        data-livetv-search-scope="category"
        role="radio"
        aria-checked="false"
      >
        In this category
      </button>
      <button
        type="button"
        class="lv2-search__scope"
        data-livetv-search-scope="all"
        role="radio"
        aria-checked="true"
      >
        All channels
      </button>
    </div>

    <div class="lv2-search__osk" data-livetv-search-osk>
      <TvKeyboard client:load placeholder="Type a channel name…" />
    </div>

    <div class="lv2-search__actions">
      <button
        type="button"
        class="lv2-search__action lv2-search__action--primary"
        data-livetv-search-submit
      >
        Search
      </button>
      <button
        type="button"
        class="lv2-search__action"
        data-livetv-search-clear
      >
        Clear
      </button>
      <button
        type="button"
        class="lv2-search__action"
        data-livetv-search-cancel
      >
        Cancel
      </button>
    </div>
  </div>
</div>

<script>
  import {
    livetvNav,
    installTopLayerBackGuard,
  } from "@/scripts/lib/livetv-nav.ts";
  import {
    LIVETV_OPEN_SEARCH_EVENT,
    defaultSearchScope,
    dispatchLivetvCloseOverlay,
    dispatchLivetvSearchSubmit,
    nextSearchDraftOnContextChange,
    parseOpenSearchDetail,
    searchContextCategoryId,
    searchContextLabel,
    searchScopeButtonLabel,
    type LivetvSearchContext,
    type LivetvSearchScope,
  } from "@/scripts/lib/livetv-search-sort.ts";

  const root = document.querySelector<HTMLElement>("[data-livetv-search-overlay]");
  if (root && !root.dataset.wired) {
    root.dataset.wired = "1";
    const input = root.querySelector<HTMLInputElement>("[data-livetv-search-input]");
    const contextEl = root.querySelector<HTMLElement>("[data-livetv-search-context]");
    const noteEl = root.querySelector<HTMLElement>("[data-livetv-search-note]");
    const scopeButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-livetv-search-scope]"),
    );
    const categoryButton = scopeButtons.find(
      (button) => button.dataset.livetvSearchScope === "category",
    );
    const scrim = root.querySelector<HTMLElement>("[data-livetv-search-scrim]");
    const submitButton = root.querySelector<HTMLButtonElement>("[data-livetv-search-submit]");
    const clearButton = root.querySelector<HTMLButtonElement>("[data-livetv-search-clear]");
    const cancelButton = root.querySelector<HTMLButtonElement>("[data-livetv-search-cancel]");

    let isOpen = false;
    let context: LivetvSearchContext = {};
    let scope: LivetvSearchScope = "all";
    let closeReason: "back" | "cancel" = "back";
    let submitted = false;
    let lastDraft: {
      query: string;
      scope: LivetvSearchScope;
      context: LivetvSearchContext;
    } | null = null;

    function saveDraft(): void {
      lastDraft = {
        query: input?.value ?? "",
        scope,
        context: { ...context },
      };
    }

    function renderContext(): void {
      if (!contextEl || !noteEl) return;
      contextEl.replaceChildren();
      const groupLabel = context.groupLabel ?? context.groupId ?? null;
      const subLabel = context.subcategoryLabel ?? context.subcategoryId ?? null;
      if (groupLabel) {
        const group = document.createElement("span");
        group.className = "lv2-breadcrumb__group";
        group.textContent = groupLabel;
        contextEl.appendChild(group);
      }
      if (subLabel) {
        const sep = document.createElement("span");
        sep.className = "lv2-breadcrumb__sep";
        sep.setAttribute("aria-hidden", "true");
        sep.textContent = "›";
        const sub = document.createElement("span");
        sub.className = "lv2-breadcrumb__sub";
        sub.setAttribute("aria-current", "location");
        sub.textContent = subLabel;
        contextEl.appendChild(sep);
        contextEl.appendChild(sub);
      }
      if (!groupLabel && !subLabel) {
        const all = document.createElement("span");
        all.className = "lv2-breadcrumb__sub";
        all.setAttribute("aria-current", "location");
        all.textContent = "All channels";
        contextEl.appendChild(all);
      }
      const label = searchContextLabel(context);
      noteEl.textContent =
        scope === "all"
          ? "Searching all channels."
          : label
            ? `Searching inside ${label}. Choose All channels to search everything.`
            : "Searching inside this category. Choose All channels to search everything.";
    }

    function syncScopeUI(): void {
      const categoryId = searchContextCategoryId(context);
      const hasCategory = !!categoryId && categoryId !== "all";
      if (categoryButton) {
        categoryButton.hidden = !hasCategory;
        categoryButton.textContent = searchScopeButtonLabel("category", context);
      }
      if (!hasCategory) scope = "all";
      for (const button of scopeButtons) {
        const value = button.dataset.livetvSearchScope as LivetvSearchScope;
        button.setAttribute("aria-checked", value === scope ? "true" : "false");
      }
      renderContext();
    }

    function setScope(next: LivetvSearchScope): void {
      scope = next;
      syncScopeUI();
    }

    function hide(): void {
      root.hidden = true;
      isOpen = false;
    }

    function onNavExit(): void {
      // Runs inside pop()/back(): hide, then report the close.
      // A submit already dispatched its own event and must not
      // also dispatch close-overlay.
      const wasSubmitted = submitted;
      saveDraft();
      hide();
      if (!wasSubmitted) {
        dispatchLivetvCloseOverlay(window, { overlay: "search", reason: closeReason });
      }
    }

    function dismiss(): void {
      if (livetvNav.isTop("search")) {
        livetvNav.pop();
      } else {
        // Invariant: search is always the top layer while open.
        // If something else got above it, hide without touching
        // the stack rather than popping the wrong layer.
        hide();
      }
    }

    function open(detail: unknown): void {
      const parsed = parseOpenSearchDetail(detail);
      context = parsed.context;
      if (parsed.query) {
        // The browser holds an applied search: prefill it.
        if (input) input.value = parsed.query;
        scope = parsed.scope ?? defaultSearchScope(context);
      } else {
        // No applied search: reopen the draft, cleared when the
        // category changed (unless the draft was global).
        const draft = nextSearchDraftOnContextChange(lastDraft, context);
        if (input) input.value = draft.query;
        scope = draft.scope;
      }
      syncScopeUI();
      closeReason = "back";
      submitted = false;
      root.hidden = false;
      isOpen = true;
      livetvNav.push({
        id: "search",
        context: { ...context },
        onExit: () => onNavExit(),
      });
      requestAnimationFrame(() => {
        input?.focus({ preventScroll: true });
      });
    }

    function submit(): void {
      const query = (input?.value ?? "").trim();
      dispatchLivetvSearchSubmit(window, {
        query,
        scope,
        categoryId:
          scope === "category" ? searchContextCategoryId(context) : null,
      });
      submitted = true;
      dismiss();
    }

    function cancel(reason: "back" | "cancel"): void {
      closeReason = reason;
      dismiss();
    }

    window.addEventListener(LIVETV_OPEN_SEARCH_EVENT, (event) => {
      open((event as CustomEvent).detail);
    });

    // B from the gamepad layer, routed through the nav stack:
    // consumed here only while search is the top layer, and
    // stopped so no hidden layer pops a second layer.
    installTopLayerBackGuard(livetvNav, "search", window);

    // Category changed behind the open overlay (drawer/LB/RB):
    // re-resolve the draft — a category-scoped draft is
    // cleared, a global draft survives.
    window.addEventListener("livetv:browser-category", (event) => {
      if (!isOpen) return;
      const detail = (event as CustomEvent).detail as
        | { categoryId?: string }
        | undefined;
      if (!detail?.categoryId) return;
      const nextContext: LivetvSearchContext = { groupId: detail.categoryId };
      const draft = nextSearchDraftOnContextChange(
        { query: input?.value ?? "", scope, context },
        nextContext,
      );
      context = nextContext;
      if (input) input.value = draft.query;
      scope = draft.scope;
      syncScopeUI();
    });

    // On-screen keyboard (TvKeyboard): value + commit events.
    window.addEventListener("couch-keyboard:input", (event) => {
      if (!isOpen || !input) return;
      const value = (event as CustomEvent).detail?.value;
      if (typeof value === "string") input.value = value;
    });
    window.addEventListener("couch-keyboard:commit", (event) => {
      if (!isOpen) return;
      const value = (event as CustomEvent).detail?.value;
      if (typeof value === "string" && input) input.value = value;
      submit();
    });

    root.addEventListener("keydown", (event) => {
      if (!isOpen) return;
      const target = event.target as HTMLElement | null;
      if (event.key === "Escape") {
        // Focus inside the OSK grid never reaches here (the
        // OSK stops Escape for backspace). Anywhere else in
        // the overlay, B/Escape closes exactly this layer.
        if (target?.closest?.("[data-osk]")) return;
        event.preventDefault();
        event.stopPropagation();
        livetvNav.back();
        return;
      }
      if (event.key === "Enter" && target === input) {
        event.preventDefault();
        submit();
        return;
      }
      if (
        (event.key === "x" || event.key === "X") &&
        target !== input &&
        !event.metaKey &&
        !event.ctrlKey &&
        !event.altKey
      ) {
        // X clears the query (matches the OSK's X behaviour).
        event.preventDefault();
        if (input) {
          input.value = "";
          input.focus({ preventScroll: true });
        }
        return;
      }
      // Radio behaviour for the scope group: arrows move + select.
      if (
        (event.key === "ArrowLeft" ||
          event.key === "ArrowRight" ||
          event.key === "ArrowUp" ||
          event.key === "ArrowDown") &&
        target?.closest?.("[data-livetv-search-scopes]")
      ) {
        const visible = scopeButtons.filter((button) => !button.hidden);
        const current = visible.indexOf(target as HTMLButtonElement);
        if (current >= 0) {
          // stopPropagation is load-bearing: SpatialNavigation
          // (the global arrow-key engine) listens on window and
          // ignores defaultPrevented — without it, one arrow
          // press would move focus twice (here AND spatially).
          event.preventDefault();
          event.stopPropagation();
          const delta =
            event.key === "ArrowLeft" || event.key === "ArrowUp" ? -1 : 1;
          const next =
            visible[(current + delta + visible.length) % visible.length];
          if (next) {
            setScope(next.dataset.livetvSearchScope as LivetvSearchScope);
            next.focus({ preventScroll: true });
          }
        }
      }
    });

    for (const button of scopeButtons) {
      button.addEventListener("click", () => {
        setScope(button.dataset.livetvSearchScope as LivetvSearchScope);
      });
    }
    submitButton?.addEventListener("click", () => submit());
    clearButton?.addEventListener("click", () => {
      if (input) {
        input.value = "";
        input.focus({ preventScroll: true });
      }
    });
    cancelButton?.addEventListener("click", () => cancel("cancel"));
    scrim?.addEventListener("click", () => cancel("cancel"));
  }
</script>

<style>
  .lv2-search__panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .lv2-search__head {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .lv2-search__title {
    margin: 0;
    font-family: var(--rs-font-display);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--rs-text);
  }
  .lv2-search__note {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.4;
    color: var(--rs-text-2);
  }
  .lv2-search__input {
    width: 100%;
    min-height: 4.25rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.625rem;
    line-height: 1.3;
  }
  .lv2-search__input::placeholder {
    color: var(--rs-text-2);
    opacity: 0.75;
  }
  .lv2-search__input:focus-visible {
    outline: none;
    border-color: var(--rs-focus);
    box-shadow:
      0 0 0 3px var(--rs-focus),
      0 0 1.5rem 0.25rem var(--rs-focus-glow);
  }
  .lv2-search__scopes {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .lv2-search__scope {
    min-height: 3.75rem;
    padding: 0.625rem 1.5rem;
    border-radius: 999px;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.375rem;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }
  .lv2-search__scope[aria-checked="true"] {
    border-color: var(--rs-accent);
    background: var(--rs-surface-2);
    box-shadow: inset 0 0 0 1px var(--rs-accent);
  }
  .lv2-search__scope:focus-visible {
    outline: none;
    border-color: var(--rs-focus);
    box-shadow:
      0 0 0 3px var(--rs-focus),
      0 0 1.5rem 0.25rem var(--rs-focus-glow);
  }
  .lv2-search__osk {
    margin-top: 0.25rem;
  }
  .lv2-search__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .lv2-search__action {
    min-height: 3.75rem;
    padding: 0.625rem 1.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--rs-line);
    background: var(--rs-bg-2);
    color: var(--rs-text);
    font-family: var(--rs-font-body);
    font-size: 1.375rem;
    font-weight: 700;
    cursor: pointer;
  }
  .lv2-search__action--primary {
    border-color: var(--rs-accent);
    background: var(--rs-accent);
    color: var(--rs-text);
  }
  .lv2-search__action:focus-visible {
    outline: none;
    border-color: var(--rs-focus);
    box-shadow:
      0 0 0 3px var(--rs-focus),
      0 0 1.5rem 0.25rem var(--rs-focus-glow);
  }
  @media (min-width: 2560px) {
    .lv2-search__title {
      font-size: 2.5rem;
    }
    .lv2-search__input {
      font-size: 2rem;
    }
  }
</style>
