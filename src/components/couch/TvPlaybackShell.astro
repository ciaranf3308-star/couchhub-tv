---
// TvPlaybackShell — fullscreen Live TV playback shell (W2).
//
// Mounted by livetv.astro inside W1's `#livetv-mode-playback` mount
// point (this section carries NO id of its own — the mount div owns
// `#livetv-mode-playback`, so there is exactly one in the DOM). It
// does NOT own the video: the existing `#player` element / wrap stays owned
// by stream.ts + player-runtime.ts (mountPlayer). On mount this
// shell only *detects* whether a player session is already running
// (a <video> / video.js / artplayer node inside #player) and never
// re-initialises it — switching home ↔ playback never restarts the
// stream. Video fills the screen while this shell is active via the
// `html[data-livetv-mode="playback"] #player-wrap` rule in
// couch.css: no permanent burgundy panel, borders, or page chrome
// around it. During normal playback ALL application controls are
// hidden; mouse movement or a relevant controller button reveals
// the OSD (TvOsd, auto-hiding lower third).
//
// Events (shared contracts): listens for `livetv:tune
// {channelId}`, `livetv:mode {mode}`, `livetv:overlay {overlay}`,
// `livetv:back {context:"playback"}` (0.9.0: gamepad B — resolved
// in order dismiss Quick Surf → close overlay → return to landing,
// the same path the keyboard Escape key takes),
// `livetv:osd-action {action:"favourite"}` (OSD favourite button),
// `livetv:playback-error {streamId, kind}` (dispatched by the
// stream.ts seam). Tunes go through the engine seam only — this
// shell never builds a stream URL. Confirmed switches go through
// `switchChannel`: the prior stream is released before the
// replacement opens.
//
// Error state: on `livetv:playback-error` the shell shows a
// polished overlay (TvEmpty) with Retry / Previous channel /
// Live TV Home. A failed tune leaves the previous working stream
// playing where possible — the overlay sits over the still-playing
// video, it never blanks the player.
import TvOsd from "./TvOsd.astro";
import TvQuickSurf from "./TvQuickSurf.astro";
import TvEmpty from "./TvEmpty.astro";
import TvLogo from "./TvLogo.astro";
---

<section
  class="rs-livetv-play-shell"
  data-livetv-playback
  data-tuned-channel-id=""
  data-previous-channel-id=""
  data-player-session="unknown"
  data-hidden="true"
  hidden
  aria-label="Live TV playback"
>
  <!-- Slim playback top bar (0.11.0 W5 — mockup 2/3): the full
       top nav is hidden in playback, but the mockups keep a slim
       brand bar over the video (full lockup + "Live TV" left, live
       clock right, 24-hour "18:24 / Tue 10 Nov"). Persistent while
       playback is active; pointer-events none — chrome, not a
       control. -->
  <div class="rs-livetv-play-topbar" data-livetv-play-topbar aria-hidden="true">
    <span class="rs-livetv-play-topbar__brand">
      <TvLogo variant="lockup" size="nav" />
      <span class="rs-livetv-play-topbar__divider" aria-hidden="true"></span>
      <span class="rs-livetv-play-topbar__label">Live TV</span>
    </span>
    <span class="rs-livetv-play-topbar__clock" data-play-clock>
      <span class="rs-livetv-play-topbar__time" data-play-clock-time></span>
      <span class="rs-livetv-play-topbar__date" data-play-clock-date></span>
    </span>
  </div>
  <TvOsd />
  <TvQuickSurf />

  <!-- Options overlay (Menu). Transport lives in the engine; these
       buttons dispatch the same synthetic keys / events as the OSD.
       This is also where the OSD's trimmed actions live: Pause,
       Mute, Previous channel and Restart (catch-up, only where the
       provider honestly offers it) — reachable from the OSD's
       Settings icon as well as the Menu key, so mouse users are
       never stranded without transport. -->
  <div
    class="rs-livetv-play-options"
    data-livetv-options
    data-hidden="true"
    role="dialog"
    aria-label="Playback options"
    hidden
  >
    <div class="rs-livetv-play-options__panel">
      <h2 class="rs-livetv-play-options__title">Playback options</h2>
      <p class="rs-livetv-play-options__note">
        Live TV has no seek. Audio and subtitle tracks are chosen on
        the player control bar for the current stream.
      </p>
      <div class="rs-livetv-play-options__actions">
        <button type="button" class="rs-livetv-play-osd__btn" data-play-key=" " data-focus-key="livetv-options-pause">Pause / resume</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-key="m" data-focus-key="livetv-options-mute">Mute / unmute</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-action="previous" data-focus-key="livetv-options-previous">Previous channel</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-action="restart" data-focus-key="livetv-options-restart" data-options-restart hidden>Restart from start</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-key="f" data-focus-key="livetv-options-fullscreen">Fullscreen</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-action="guide" data-focus-key="livetv-options-guide">Full Guide (X)</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-action="browser" data-focus-key="livetv-options-browser">Channel Browser (Y)</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-action="home" data-focus-key="livetv-options-home">Live TV Home</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-play-action="close" data-focus-key="livetv-options-close">Close (B)</button>
      </div>
    </div>
  </div>

  <!-- Stream-failure overlay. Sits over the still-playing previous
       stream where one exists; never blanks the player. Recovery
       actions are kind-aware (0.11.0 W5): the legacy failure panel's
       HEVC-enable and external-player recoveries were unreachable in
       0.9.0 because the panel is suppressed while this shell is
       active — they live here now, offered only for the failure
       kinds they can actually fix. Audio has no button on purpose:
       the engine auto-attempts its one-shot audio-proxy fix before
       the panel (stream.ts fixAudioNow, no public seam), so by the
       time this overlay shows the fix has already run once; Retry
       stays the audio path. -->
  <div
    class="rs-livetv-play-error"
    data-livetv-error
    data-error-key=""
    data-hidden="true"
    role="alert"
    hidden
  >
    <div class="rs-livetv-play-error__panel">
      <TvEmpty
        title="This channel isn't playing right now"
        message="Your previous channel keeps playing underneath. Try this channel again, or go back to it."
      />
      <p class="rs-livetv-play-error__reason" data-error-reason hidden></p>
      <div class="rs-livetv-play-error__actions">
        <button type="button" class="rs-livetv-play-osd__btn" data-error-action="retry" data-focus-key="livetv-error-retry">Retry channel</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-error-action="hevc" data-focus-key="livetv-error-hevc" hidden>Enable HEVC playback</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-error-action="external" data-focus-key="livetv-error-external" hidden>Open in external player</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-error-action="previous" data-focus-key="livetv-error-previous">Previous channel</button>
        <button type="button" class="rs-livetv-play-osd__btn" data-error-action="home" data-focus-key="livetv-error-home">Live TV Home</button>
      </div>
    </div>
  </div>

  <!-- Channel Browser (W1) mounted inside playback (integration
       0.7.0). The browser instance is mounted lazily by the script
       below into [data-livetv-play-browser-mount] on first open —
       same module, same contract as Home's browser, with its own
       browserId ("playback") so category events don't cross wires.
       Watch on a row tunes via livetv:tune; highlight never tunes. -->
  <div
    class="rs-livetv-play-browser"
    data-livetv-play-browser
    data-hidden="true"
    role="dialog"
    aria-label="Channel Browser"
    hidden
  >
    <div data-livetv-play-browser-mount></div>
  </div>
</section>

<script>
  import {
    OSD_AUTO_HIDE_MS,
    errorKeyForFailureKind,
    previousChannelTarget,
    retryTarget,
    streamToKeepOnFailure,
    resolveBackStep,
    switchChannel,
    dispatchRelease,
    shouldReleaseStreamOnModeLeave,
    catchupActionForPlaybackChannel,
    toggleFavourite,
    recoveryActionsForFailureKind,
    windowPlaybackEngine,
  } from "@/scripts/lib/livetv-playback";
  import {
    loadLivetvChannels,
    loadLivetvProgrammes,
    nowNextForChannel,
    activeLivetvPlaylistId,
    requestLivetvMode,
    type LivetvChannel,
  } from "@/scripts/lib/livetv-data";
  import { programmeProgress } from "@/scripts/lib/couch-livetv-epg";
  import { getFavorites } from "@/scripts/lib/preferences.js";
  import { mountCachedChannelBrowser } from "@/scripts/lib/livetv-browser";
  // Recovery actions the legacy failure panel used to own (0.11.0
  // W5): HEVC install via the public lib, external-player launch
  // via the engine's own button (see showError). The audio fix has
  // no public seam — the engine auto-attempts it before the panel.
  import { ensureHevcDecodable, isWindowsDesktop } from "@/scripts/lib/hevc-extension.ts";
  import { hasAvailableExternalPlayer } from "@/scripts/lib/external-player-button.ts";

  const shell = document.querySelector<HTMLElement>("[data-livetv-playback]");
  if (shell && !shell.dataset.playArmed) {
    shell.dataset.playArmed = "1";
    let channels: LivetvChannel[] = [];
    let programmes: Map<string, any> = new Map();
    let playlistId = "";
    let dataLoaded = false;
    let tunedId: string | number | null = null;
    let previousId: string | number | null = null;
    let lastWorkingId: string | number | null = null;
    let failedId: string | number | null = null;
    // Start of the current programme on the tuned channel (for the
    // Options-overlay Restart action); null when unknown.
    let currentStartMs: number | null = null;
    let returnFocusKey: string | null = null;

    // Slim top-bar clock (0.11.0 W5 — mockup 2: "18:24 / Tue
    // 10 Nov", 24-hour, two lines). Device-local time; ticks every
    // 15 s, page lifetime.
    const clockTimeEl = shell.querySelector<HTMLElement>("[data-play-clock-time]");
    const clockDateEl = shell.querySelector<HTMLElement>("[data-play-clock-date]");
    const paintClock = () => {
      const now = new Date();
      if (clockTimeEl) {
        clockTimeEl.textContent = now.toLocaleTimeString("en-IE", {
          hour: "2-digit",
          minute: "2-digit",
          hourCycle: "h23",
        });
      }
      if (clockDateEl) {
        // en-IE gives "Wed, 11 Nov"; the mockup reads "Wed 11 Nov".
        clockDateEl.textContent = now
          .toLocaleDateString("en-IE", {
            weekday: "short",
            day: "numeric",
            month: "short",
          })
          .replace(",", "");
      }
    };
    paintClock();
    setInterval(paintClock, 15000);

    // Detect (never create) the player session: if stream.ts already
    // mounted a player inside #player, mode switches must not
    // restart it. This shell never calls mountPlayer.
    const detectSession = () => {
      const player = document.querySelector("#player");
      const running = !!player?.querySelector(
        "video, .video-js, .art-video-player, .artplayer, .shaka-video-container",
      );
      shell.dataset.playerSession = running ? "running" : "none";
      return running;
    };
    detectSession();

    const osd = shell.querySelector<HTMLElement>("[data-livetv-osd]");
    const optionsEl = shell.querySelector<HTMLElement>("[data-livetv-options]");
    const errorEl = shell.querySelector<HTMLElement>("[data-livetv-error]");
    const browserEl = shell.querySelector<HTMLElement>("[data-livetv-play-browser]");
    const browserMount = shell.querySelector<HTMLElement>("[data-livetv-play-browser-mount]");
    let browserHandle: { destroy: () => void } | null = null;
    let browserMounting: Promise<unknown> | null = null;

    // Channel Browser inside playback (integration 0.7.0): W1's
    // mountCachedChannelBrowser, lazily mounted on first open so a
    // session that never opens the browser pays nothing. The browser
    // answers `livetv:browser-category` for id "playback" only, so
    // Home's collection cards never retarget it.
    const openBrowser = () => {
      if (!browserEl) return;
      rememberFocus();
      browserEl.hidden = false;
      browserEl.dataset.hidden = "false";
      if (!browserHandle && !browserMounting && browserMount) {
        browserMounting = mountCachedChannelBrowser(browserMount, {
          browserId: "playback",
          onClose: () => closeBrowser(),
        }).then((handle) => {
          browserHandle = handle;
          browserMounting = null;
          if (!handle) {
            browserMount.textContent =
              "No live playlist connected — add a playlist to browse live channels.";
          }
          return handle;
        });
      }
      const search = browserEl.querySelector<HTMLElement>("[data-browser-search]");
      search?.focus?.({ preventScroll: true });
    };

    const closeBrowser = () => {
      if (!browserEl) return;
      browserEl.hidden = true;
      browserEl.dataset.hidden = "true";
      restoreFocus();
    };

    const showOsd = () => {
      window.dispatchEvent(new CustomEvent("couch-osd:show"));
    };

    const isPlaybackActive = () =>
      document.documentElement.dataset.livetvMode === "playback";

    const overlayOpen = () => {
      const qs = document.querySelector<HTMLElement>("[data-livetv-quicksurf]");
      if (qs && !qs.hidden) return "quicksurf";
      if (optionsEl && !optionsEl.hidden) return "options";
      if (browserEl && !browserEl.hidden) return "browser";
      if (errorEl && !errorEl.hidden) return "error";
      return "none";
    };

    const hideOsd = () => {
      if (!osd) return;
      osd.dataset.hidden = "true";
      osd.setAttribute("data-hidden", "true");
    };

    // ── B / back (0.9.0) ──────────────────────────────────────────
    // One B press, resolved in order (resolveBackStep): dismiss
    // Quick Surf → close the open overlay (options / browser / error
    // / visible OSD) → return to the landing screen. Both entry
    // points share this path: the gamepad `livetv:back
    // {context:"playback"}` event (W5's contract) and the keyboard
    // Escape key. A single physical press must advance exactly one
    // step even if it arrives as both (gamepad B synthesising an
    // Escape AND dispatching livetv:back): the 250 ms dedupe window
    // swallows the second signal. The error overlay counts as an
    // overlay — B never jumps to landing from under a failure state;
    // closing it reveals the OSD so the kept stream still has a way
    // out. Landing is LIVETV_LANDING_MODE ("home" — see
    // livetv-playback.ts; there is no "landing" mode in 0.9.0).
    let lastBackHandledAt = 0;
    const BACK_DEDUPE_MS = 250;

    const handleBack = () => {
      const now = Date.now();
      if (now - lastBackHandledAt < BACK_DEDUPE_MS) return;
      lastBackHandledAt = now;
      const step = resolveBackStep({
        quicksurfOpen: overlayOpen() === "quicksurf",
        overlayOpen:
          overlayOpen() === "options" ||
          overlayOpen() === "browser" ||
          overlayOpen() === "error",
        osdVisible: !!osd && osd.dataset.hidden === "false",
      });
      if (step === "dismiss-quicksurf") {
        // Quick Surf hides itself on `livetv:overlay {overlay:"none"}`
        // without retuning — B dismisses, never switches.
        window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay: "none" } }));
      } else if (step === "close-overlay") {
        const open = overlayOpen();
        if (open === "options") closeOptions();
        else if (open === "browser") closeBrowser();
        else if (open === "error") {
          hideError();
          showOsd();
        } else hideOsd();
      } else {
        requestLivetvMode("landing");
      }
    };

    const closeOptions = () => {
      if (!optionsEl) return;
      optionsEl.hidden = true;
      optionsEl.dataset.hidden = "true";
      restoreFocus();
    };

    const openOptions = () => {
      if (!optionsEl) return;
      rememberFocus();
      optionsEl.hidden = false;
      optionsEl.dataset.hidden = "false";
      window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay: "options" } }));
      const first = optionsEl.querySelector<HTMLElement>("[data-focus-key]");
      first?.focus?.({ preventScroll: true });
    };

    const rememberFocus = () => {
      const active = document.activeElement as HTMLElement | null;
      returnFocusKey = active?.dataset?.focusKey ?? null;
    };

    const restoreFocus = () => {
      if (!returnFocusKey) return;
      const el = document.querySelector<HTMLElement>(
        `[data-focus-key="${returnFocusKey}"]`,
      );
      el?.focus?.({ preventScroll: true });
      returnFocusKey = null;
    };

    const ensureData = async () => {
      if (dataLoaded) return;
      dataLoaded = true;
      try {
        playlistId = await activeLivetvPlaylistId();
        channels = await loadLivetvChannels();
        programmes = await loadLivetvProgrammes();
      } catch {
        channels = [];
        programmes = new Map();
      }
    };

    const paintOsd = () => {
      if (!osd) return;
      const channel = channels.find((c) => String(c.id) === String(tunedId)) ?? null;
      osd.setAttribute("data-osd-channel-id", channel ? String(channel.id) : "");
      const setText = (sel: string, text: string) => {
        const el = osd.querySelector<HTMLElement>(sel);
        if (el) el.textContent = text;
      };
      setText("[data-osd-channel-name]", channel ? channel.displayName || channel.name || "" : "");
      setText("[data-osd-chno]", channel?.chno != null ? String(channel.chno) : "");
      let isFav = false;
      try {
        isFav = !!playlistId && !!channel && getFavorites(playlistId, "live").has(Number(channel.id));
      } catch {}
      // 0.11.0 W5 — the favourite state lives on the OSD's Favourite
      // icon button (filled star + aria-pressed), not a heart glyph
      // in the channel line.
      const favBtn = osd.querySelector<HTMLElement>("[data-osd-fav-btn]");
      if (favBtn) {
        favBtn.setAttribute("aria-pressed", isFav ? "true" : "false");
        favBtn.classList.toggle("is-favourite", isFav);
      }
      // Restart (catch-up) lives in the Options overlay now (the
      // OSD row is the mockup's seven icons) and is offered only
      // where the provider honestly offers it for the current
      // programme — hidden otherwise, never a dead control.
      const restartBtn = shell.querySelector<HTMLElement>("[data-options-restart]");
      if (restartBtn) restartBtn.hidden = true;
      currentStartMs = null;
      if (channel) {
        const nn = nowNextForChannel(channel, programmes, playlistId);
        setText("[data-programme-now-title]", nn.current?.title ?? "");
        const timeEl = osd.querySelector<HTMLElement>("[data-programme-now-time]");
        if (timeEl && nn.current) {
          const fmt = (ms: number) =>
            new Date(ms).toLocaleTimeString("en-IE", { hour: "2-digit", minute: "2-digit" });
          timeEl.textContent = `${fmt(nn.current.start)}–${fmt(nn.current.stop)}`;
        } else if (timeEl) {
          timeEl.textContent = "";
        }
        osd.setAttribute("data-osd-now-start", nn.current ? String(nn.current.start) : "");
        setText("[data-programme-next-title]", nn.next?.title ?? "");
        const nextTimeEl = osd.querySelector<HTMLElement>("[data-programme-next-time]");
        if (nextTimeEl && nn.next) {
          const fmt = (ms: number) =>
            new Date(ms).toLocaleTimeString("en-IE", { hour: "2-digit", minute: "2-digit" });
          nextTimeEl.textContent = `${fmt(nn.next.start)}–${fmt(nn.next.stop)}`;
        } else if (nextTimeEl) {
          nextTimeEl.textContent = "";
        }
        const nextBlock = osd.querySelector<HTMLElement>("[data-programme-next]");
        if (nextBlock) nextBlock.hidden = !nn.next;
        const bar = osd.querySelector<HTMLElement>("[data-programme-progress]");
        if (bar && nn.current) {
          bar.style.width = `${Math.round(programmeProgress(nn.current.start, nn.current.stop) * 100)}%`;
        }
        if (restartBtn && nn.current) {
          currentStartMs = nn.current.start;
          restartBtn.hidden =
            catchupActionForPlaybackChannel(channel, nn.current.start, nn.current.stop) !==
            "watch-from-start";
        }
        const logoSlot = osd.querySelector<HTMLElement>("[data-osd-logo]");
        if (logoSlot) {
          logoSlot.innerHTML = "";
          if (channel.logo) {
            const img = document.createElement("img");
            img.src = channel.logo;
            img.alt = "";
            logoSlot.appendChild(img);
          } else {
            // Logo-less channel: branded initial, not an empty tile
            // (the :has() fallback rule gives it the burgundy tile).
            const initial = document.createElement("span");
            initial.className = "rs-livetv-play-osd__initial";
            initial.setAttribute("aria-hidden", "true");
            initial.textContent = (channel.displayName || channel.name || "?").slice(0, 1);
            logoSlot.appendChild(initial);
          }
        }
      } else {
        osd.setAttribute("data-osd-now-start", "");
        setText("[data-programme-now-title]", "");
        setText("[data-programme-next-title]", "");
        const nextBlock = osd.querySelector<HTMLElement>("[data-programme-next]");
        if (nextBlock) nextBlock.hidden = true;
      }
    };

    // One honest line per engine-classified failure kind (the kind
    // comes from stream.ts's classifier, never guessed). Shown only
    // when the engine actually classified the failure.
    const FAILURE_REASONS: Record<string, string> = {
      hevc: "This channel uses HEVC video, which needs Microsoft's HEVC Video Extensions on this device.",
      "hevc-likely":
        "This channel looks like HEVC video, which needs Microsoft's HEVC Video Extensions on this device.",
      codec: "This channel uses a video format this device can't decode in the app.",
      audio: "The audio on this channel couldn't be decoded in the app.",
      parse: "This channel's stream couldn't be read.",
      "connection-limit": "The provider refused another connection.",
    };

    // The engine's own external-player launch button, created by
    // stream.ts on tune and wired with the real stream URL +
    // headers. The shell never rebuilds that launch — it only
    // clicks the button when it exists and is usable.
    const engineExternalButton = () => {
      const btn = document.getElementById("external-launch-btn") as HTMLButtonElement | null;
      return btn && !btn.hidden ? btn : null;
    };

    const showError = (streamId: string | number | null, kind: string | null) => {
      if (!errorEl) return;
      failedId = streamId;
      errorEl.dataset.errorKey = errorKeyForFailureKind(kind);
      errorEl.hidden = false;
      errorEl.dataset.hidden = "false";
      const reasonEl = errorEl.querySelector<HTMLElement>("[data-error-reason]");
      const reason = kind ? FAILURE_REASONS[kind] : undefined;
      if (reasonEl) {
        reasonEl.textContent = reason ?? "";
        reasonEl.hidden = !reason;
      }
      const retryBtn = errorEl.querySelector<HTMLElement>("[data-error-action='retry']");
      // No retry target (nothing ever played) -> hide Retry, Home is the way out.
      if (retryBtn) retryBtn.hidden = retryTarget(failedId, lastWorkingId) === null;
      const prevBtn = errorEl.querySelector<HTMLElement>("[data-error-action='previous']");
      if (prevBtn) prevBtn.hidden = previousChannelTarget(tunedId, previousId) === null;
      // Kind-aware recovery (0.11.0 W5): HEVC install and the
      // external player are offered only for the kinds they can
      // fix, and only when they are actually usable here.
      const recovery = recoveryActionsForFailureKind(kind);
      const hevcBtn = errorEl.querySelector<HTMLElement>("[data-error-action='hevc']");
      if (hevcBtn) hevcBtn.hidden = !(recovery.hevc && isWindowsDesktop());
      const extBtn = errorEl.querySelector<HTMLElement>("[data-error-action='external']");
      if (extBtn) {
        let usable = false;
        try {
          usable = recovery.external && hasAvailableExternalPlayer() && engineExternalButton() !== null;
        } catch {
          usable = false;
        }
        extBtn.hidden = !usable;
      }
      const focusTarget =
        (retryBtn && !retryBtn.hidden ? retryBtn : null) ??
        (hevcBtn && !hevcBtn.hidden ? hevcBtn : null) ??
        (extBtn && !extBtn.hidden ? extBtn : null) ??
        (prevBtn && !prevBtn.hidden ? prevBtn : null);
      focusTarget?.focus?.({ preventScroll: true });
    };

    const hideError = () => {
      if (!errorEl) return;
      errorEl.hidden = true;
      errorEl.dataset.hidden = "true";
    };

    const setMode = (mode: string) => {
      if (mode === "playback") {
        shell.hidden = false;
        shell.dataset.hidden = "false";
        document.documentElement.dataset.livetvMode = "playback";
        detectSession();
        void ensureData().then(() => {
          paintOsd();
          showOsd();
        });
      } else {
        // Leaving playback for the landing screen ENDS the stream
        // (0.11.2 W3): exiting used to only hide the shell, so the
        // tuned channel kept playing hidden and held the provider's
        // single connection — the next tune was refused as
        // connection-limit ("already open") and went black a second
        // after loading. Guide / browser keep the session by design
        // (the tuned session survives mode switches; the Guide
        // returns to playback), so only landing/home releases. The
        // release is the engine's own `livetv:release` path
        // (pause + reset + lastPlayContext=null); dispatching it
        // with no listener / no mount is a harmless no-op. The
        // shell's tuned state is cleared with the stream, so a later
        // error overlay can never offer retry to a dead channel and
        // Previous never points at a released session.
        const wasPlayback =
          document.documentElement.dataset.livetvMode === "playback";
        if (
          wasPlayback &&
          tunedId !== null &&
          shouldReleaseStreamOnModeLeave(mode)
        ) {
          dispatchRelease(tunedId);
          tunedId = null;
          previousId = null;
          lastWorkingId = null;
          failedId = null;
          shell.dataset.tunedChannelId = "";
          shell.dataset.previousChannelId = "";
        }
        shell.hidden = true;
        shell.dataset.hidden = "true";
        if (document.documentElement.dataset.livetvMode === "playback") {
          delete document.documentElement.dataset.livetvMode;
        }
        hideError();
        closeOptions();
        closeBrowser();
      }
    };

    // ── Events ──────────────────────────────────────────────────
    window.addEventListener("livetv:mode", (ev) => {
      setMode((ev as CustomEvent).detail?.mode ?? "home");
    });

    window.addEventListener("livetv:tune", async (ev) => {
      const channelId = (ev as CustomEvent).detail?.channelId;
      if (channelId === undefined || channelId === null) return;
      if (tunedId !== null && String(tunedId) !== String(channelId)) {
        previousId = tunedId;
      }
      tunedId = channelId;
      shell.dataset.tunedChannelId = String(channelId);
      shell.dataset.previousChannelId = previousId !== null ? String(previousId) : "";
      hideError();
      closeBrowser();
      await ensureData();
      paintOsd();
      showOsd();
    });

    window.addEventListener("livetv:playback-error", (ev) => {
      const detail = (ev as CustomEvent).detail ?? {};
      // Keep the previous working stream: it stays tuned underneath
      // the error overlay; only a failed tune of the *current*
      // channel leaves nothing to keep.
      const keep = streamToKeepOnFailure(detail.streamId ?? null, tunedId);
      if (keep !== null) lastWorkingId = keep;
      else if (tunedId !== null && detail.streamId === tunedId) lastWorkingId = null;
      showError(detail.streamId ?? null, detail.kind ?? null);
    });

    window.addEventListener("livetv:overlay", (ev) => {
      const overlay = (ev as CustomEvent).detail?.overlay;
      if (overlay === "options") {
        if (optionsEl?.hidden) openOptions();
      } else if (overlay === "none") {
        closeOptions();
        closeBrowser();
      } else if (overlay === "browser") {
        // W1's Channel Browser, mounted inside this shell on first
        // open (see openBrowser above). A tune from the browser
        // closes it via the livetv:tune listener.
        openBrowser();
      }
    });

    // B from the gamepad (W5 contract: gamepad resolves B/Escape to
    // "back" and dispatches `livetv:back {context:"playback"}`).
    // Ignored outside the playback context or for other contexts.
    window.addEventListener("livetv:back", (ev) => {
      if (!isPlaybackActive()) return;
      if ((ev as CustomEvent).detail?.context !== "playback") return;
      handleBack();
    });

    // OSD Favourite button: the shell owns the playlist + channel
    // objects, so the OSD asks and the shell toggles + repaints.
    window.addEventListener("livetv:osd-action", async (ev) => {
      const detail = (ev as CustomEvent).detail ?? {};
      if (detail.action !== "favourite") return;
      if (!isPlaybackActive()) return;
      await ensureData();
      const channel = channels.find((c) => String(c.id) === String(tunedId)) ?? null;
      if (!channel) return;
      await toggleFavourite(playlistId, channel);
      paintOsd();
      showOsd();
    });

    // Mouse movement reveals the OSD; the OSD hides itself after
    // OSD_AUTO_HIDE_MS of inactivity.
    let lastMouseShow = 0;
    window.addEventListener("pointermove", () => {
      if (!isPlaybackActive()) return;
      const now = Date.now();
      if (now - lastMouseShow < 500) return;
      lastMouseShow = now;
      showOsd();
    }, { passive: true });

    // Controller / keyboard in the playback context. Gamepad buttons
    // arrive as synthetic keys (gamepad.ts); View+Menu 2s
    // return-home is untouched (owned by gamepad.ts).
    window.addEventListener("keydown", (ev) => {
      if (!isPlaybackActive()) return;
      if (ev.defaultPrevented) return; // an overlay already handled it
      if (ev.target instanceof HTMLInputElement || ev.target instanceof HTMLTextAreaElement) return;
      const key = ev.key;
      if (key === "Escape") {
        // B (keyboard): same three-step sequence as `livetv:back`.
        // (Quick Surf's own listener preventDefaults Escape while it
        // is open, so this branch only runs when it did not.)
        handleBack();
        return;
      }
      if (key === "Enter") {
        // A with nothing focused / no overlay: reveal the OSD.
        const target = ev.target as HTMLElement | null;
        if (target && target.closest("button, a, [data-livetv-quicksurf], [data-livetv-options]")) return;
        if (overlayOpen() === "none") {
          ev.preventDefault();
          showOsd();
        }
        return;
      }
      if (key === "x" || key === "X") {
        requestLivetvMode("guide");
        return;
      }
      if (key === "y" || key === "Y") {
        window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay: "browser" } }));
        return;
      }
      if (key === "g" || key === "G") {
        requestLivetvMode("guide");
        return;
      }
      if (key === "c" || key === "C") {
        window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay: "browser" } }));
        return;
      }
      if (key === "v" || key === "V") {
        // Favourites live in the Channel Browser (W1); open it.
        window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay: "browser" } }));
        return;
      }
      if (key === "h" || key === "H") {
        requestLivetvMode("landing");
      }
    });

    // Options + error buttons. (The browser's own Close button is
    // wired through its onClose -> closeBrowser; Quick Surf handles
    // its own buttons.)
    shell.addEventListener("click", async (ev) => {
      const target = ev.target as HTMLElement | null;
      const keyBtn = target?.closest?.("[data-play-key]") as HTMLElement | null;
      if (keyBtn) {
        document.dispatchEvent(
          new KeyboardEvent("keydown", { key: keyBtn.dataset.playKey ?? "", bubbles: true, cancelable: true }),
        );
        return;
      }
      const actionBtn = target?.closest?.("[data-play-action]") as HTMLElement | null;
      if (actionBtn) {
        const action = actionBtn.dataset.playAction;
        if (action === "guide") requestLivetvMode("guide");
        else if (action === "browser") window.dispatchEvent(new CustomEvent("livetv:overlay", { detail: { overlay: "browser" } }));
        else if (action === "home") requestLivetvMode("landing");
        else if (action === "previous") {
          // 0.11.0 W5 — through the shell's own previous-channel
          // path (release-then-tune), NOT a synthetic "\" keydown:
          // the 0.9.0 OSD Previous button dispatched
          // data-osd-key="\\" whose dataset value is TWO backslashes
          // and never matched the engine's single-backslash check.
          const prev = previousChannelTarget(tunedId, previousId);
          if (prev !== null) {
            switchChannel(windowPlaybackEngine, tunedId, prev);
            closeOptions();
          }
        }
        else if (action === "restart") {
          // Restart the current programme from its start, through
          // the engine's `livetv:programme` path (catch-up resolved
          // honestly there). Only offered when paintOsd found a
          // current programme with catch-up.
          if (tunedId !== null && currentStartMs !== null) {
            window.dispatchEvent(
              new CustomEvent("livetv:programme", {
                detail: { channelId: tunedId, startMs: currentStartMs },
              }),
            );
            closeOptions();
          }
        }
        else if (action === "close") closeOptions();
        return;
      }
      const errorBtn = target?.closest?.("[data-error-action]") as HTMLElement | null;
      if (errorBtn) {
        const action = errorBtn.dataset.errorAction;
        if (action === "retry") {
          const targetId = retryTarget(failedId, lastWorkingId);
          // Release-then-open: the failed mount is released before
          // the retry opens its replacement.
          if (targetId !== null) switchChannel(windowPlaybackEngine, tunedId, targetId);
        } else if (action === "hevc") {
          // Same public call the legacy failure panel made: install
          // (or open the Store for) the HEVC Video Extensions, then
          // retry the failed channel. A Store deep-link returns
          // false (restart needed) — the overlay stays so the user
          // is not stranded.
          const targetId = retryTarget(failedId, lastWorkingId);
          try {
            if (await ensureHevcDecodable()) {
              hideError();
              if (targetId !== null) switchChannel(windowPlaybackEngine, tunedId, targetId);
            }
          } catch {}
        } else if (action === "external") {
          // Click the engine's own external-player button (wired
          // with the real stream URL + headers by stream.ts). The
          // engine handles release/restore around the handoff.
          engineExternalButton()?.click();
          hideError();
        } else if (action === "previous") {
          const prev = previousChannelTarget(tunedId, previousId);
          if (prev !== null) switchChannel(windowPlaybackEngine, tunedId, prev);
        } else if (action === "home") {
          requestLivetvMode("landing");
        }
        return;
      }
    });

    // Restore focus when returning from playback (couch-focus key
    // carried in sessionStorage by the W3 state module when present).
    try {
      const raw = sessionStorage.getItem("redsilk:livetv:state");
      const parsed = raw ? JSON.parse(raw) : null;
      if (parsed?.returnFocusKey) {
        document
          .querySelector<HTMLElement>(`[data-focus-key="${parsed.returnFocusKey}"]`)
          ?.focus?.({ preventScroll: true });
      }
    } catch {}

    // Keep the named constant referenced so the auto-hide value stays
    // a single source of truth with TvOsd.
    void OSD_AUTO_HIDE_MS;
  }
</script>
