---
// TvCategoryTile — Browse by Category tile (0.9.0 Landing).
//
// The presentational twin of buildCategoryTileElement() in
// src/scripts/lib/livetv-landing.ts (same classes, same structure):
// a fixed-size button (18.75rem × 10.625rem at 1920×1080, rem-scaled
// — see couch.css `.rs-livetv-landing-category-tile`), a
// deterministic burgundy gradient variant + one large initial motif
// as its artwork, label + real channel count, and a "Now on …" line
// from real EPG only (omitted when the guide covers nothing in the
// group). Contains NO <img> and NO channel logos — category artwork
// is deliberately NEVER a stack of channel logos.
//
// Props: groupId (provider group identity, verbatim), label
// (normalised display label), count, nowPlaying? ({channelName,
// programmeTitle} from collectionNowPlaying), variant (0..5,
// categoryTileVariant(groupId)).
// Click behaviour lives in the landing mount (openLandingCategory →
// `livetv:mode` {mode:"browser", browserFilter:{kind:"category",
// value: groupId}}); this component only renders the button.
interface Props {
  groupId: string;
  label: string;
  count: number;
  nowPlaying?: { channelName: string; programmeTitle: string } | null;
  variant?: number;
}
const { groupId, label, count, nowPlaying = null, variant = 0 } = Astro.props;
const focusKey = `landing-category-${groupId}`;
const motif = (label.trim()[0] ?? "•").toUpperCase();
---

<button
	type="button"
	class={`rs-livetv-landing-category-tile rs-livetv-landing-category-tile--v${variant}`}
	data-category-id={groupId}
	data-nylah-item
	data-couch-key={focusKey}
	data-focus-key={focusKey}
	aria-label={`${label}, ${count} channel${count === 1 ? "" : "s"}`}>
	<span class="rs-livetv-landing-category-tile__motif" aria-hidden="true">{motif}</span>
	<span class="rs-livetv-landing-category-tile__label">{label}</span>
	<span class="rs-livetv-landing-category-tile__count">{count} channel{count === 1 ? "" : "s"}</span>
	{
		nowPlaying && (
			<span class="rs-livetv-landing-category-tile__now">
				Now on <strong>{nowPlaying.channelName}</strong>: {nowPlaying.programmeTitle}
			</span>
		)
	}
</button>
