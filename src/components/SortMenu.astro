---
interface SortOption {
    value: string;
    label: string;
    key?: string;
}

interface ToggleOption {
    id: string;
    label: string;
    key?: string;
    ariaKey?: string;
}

interface SecondarySelect {
    id: string;
    label: string;
    labelKey: string;
}

interface Props {
    id: string;
    label?: string;
    labelKey?: string;
    options: SortOption[];
    defaultValue?: string;
    widthClass?: string;
    toggles?: ToggleOption[];
    selects?: SecondarySelect[];
}

const {
    id,
    label = "Sort",
    labelKey = "sort.label",
    options,
    defaultValue = options[0]?.value,
    widthClass = "sm:w-44 w-full",
    toggles,
    selects,
} = Astro.props;

const hasToggles = Boolean(toggles && toggles.length > 0);
const hasSelects = Boolean(selects && selects.length > 0);
const hasIcon = Astro.slots.has("icon");

const buttonId = `${id}-button`;
const menuId = `${id}-menu`;
const valueId = `${id}-value`;
const initialLabel =
    options.find((opt) => opt.value === defaultValue)?.label ??
    options[0]?.label ??
    "";
---

<div
    class:list={["sort-menu relative", widthClass]}
    data-sort-menu
    data-toggles-active={hasToggles ? "false" : undefined}>
    <select
        id={id}
        class="sr-only"
        tabindex="-1"
        aria-hidden="true"
        data-sort-menu-select>
        {
            options.map((opt) => (
                <option value={opt.value} selected={opt.value === defaultValue} data-i18n-key={opt.key}>
                    {opt.label}
                </option>
            ))
        }
    </select>

    {
        hasSelects &&
            selects!.map((secondary) => (
                <select
                    id={secondary.id}
                    class="sr-only"
                    tabindex="-1"
                    aria-hidden="true"
                    data-sort-menu-select-secondary>
                </select>
            ))
    }

    <button
        id={buttonId}
        type="button"
        aria-haspopup={hasToggles ? "menu" : "listbox"}
        aria-expanded="false"
        aria-controls={menuId}
        data-sort-menu-button
        class:list={[
            "rounded-xl border border-line bg-surface px-3.5 py-2 min-h-11 text-sm w-full",
            "flex items-center gap-2 text-left",
            "hover:bg-surface-2 focus-visible:bg-surface-2 focus-visible:border-accent",
            "aria-expanded:bg-surface-2 aria-expanded:border-accent",
            "transition-colors",
            hasToggles && "relative",
        ]}>
        {hasIcon && <slot name="icon" />}
        <span data-i18n={labelKey} class:list={[hasIcon ? "sr-only" : "text-fg-3 shrink-0"]}>{label}</span>
        <span
            id={valueId}
            class="text-fg truncate flex-1"
            data-i18n={options.find((opt) => opt.value === defaultValue)?.key}
            data-sort-menu-value>{initialLabel}</span>
        <svg
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-fg-3 shrink-0 sort-menu__chevron">
            <path d="M6 9l6 6 6-6"></path>
        </svg>
        {
            hasToggles && (
                <span aria-hidden="true" class="sort-menu__dot absolute top-2 right-2 size-1.5 rounded-full bg-accent pointer-events-none"></span>
            )
        }
    </button>

    <div
        id={menuId}
        role={hasToggles ? "menu" : "listbox"}
        aria-labelledby={buttonId}
        data-sort-menu-panel
        hidden
        class="sort-menu__panel absolute right-0 left-0 top-full mt-2 z-40
            rounded-xl border border-line bg-surface
            p-1 origin-top">
        {
            options.map((opt) => (
                <button
                    type="button"
                    role={hasToggles ? "menuitemradio" : "option"}
                    data-value={opt.value}
                    data-i18n-key={opt.key}
                    aria-selected={
                        opt.value === defaultValue ? "true" : "false"
                    }
                    aria-checked={
                        hasToggles
                            ? opt.value === defaultValue
                                ? "true"
                                : "false"
                            : undefined
                    }
                    class="sort-menu__option w-full text-left rounded-lg px-3 py-2 text-sm
                        flex items-center justify-between gap-3
                        text-fg-2 hover:text-fg hover:bg-surface-2
                        focus-visible:bg-surface-2 focus-visible:text-fg focus-visible:outline-none
                        aria-selected:text-fg aria-selected:bg-accent-soft
                        transition-colors">
                        <span data-i18n={opt.key} class="truncate">{opt.label}</span>
                        <svg
                            aria-hidden="true"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="text-accent shrink-0 sort-menu__check">
                            <path d="M5 12l5 5L20 7" />
                        </svg>
                </button>
            ))
        }
        {
            hasToggles && (
                <>
                    <div class="my-1 h-px bg-line" role="separator"></div>
                    {toggles!.map((toggle) => (
                        <button
                            type="button"
                            id={toggle.id}
                            role="menuitemcheckbox"
                            aria-checked="false"
                            aria-label={toggle.label}
                            data-i18n-attr={toggle.ariaKey ? `aria-label:${toggle.ariaKey}` : undefined}
                            data-sort-menu-toggle
                            data-i18n-key={toggle.key}
                            class="sort-menu__option w-full text-left rounded-lg px-3 py-2 text-sm
                                flex items-center justify-between gap-3
                                text-fg-2 hover:text-fg hover:bg-surface-2
                                focus-visible:bg-surface-2 focus-visible:text-fg focus-visible:outline-none
                                aria-checked:text-fg aria-checked:bg-accent-soft
                                transition-colors">
                                <span data-i18n={toggle.key} class="truncate">{toggle.label}</span>
                                <svg
                                    aria-hidden="true"
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    class="text-accent shrink-0 sort-menu__check">
                                    <path d="M5 12l5 5L20 7" />
                                </svg>
                        </button>
                    ))}
                </>
            )
        }
        {
            hasSelects &&
                selects!.map((secondary) => (
                    <div data-sort-menu-secondary-section={secondary.id} hidden>
                        <div class="my-1 h-px bg-line" role="separator"></div>
                        <div class="px-3 py-1.5 text-2xs font-semibold uppercase tracking-wider text-fg-3" data-i18n={secondary.labelKey}>
                            {secondary.label}
                        </div>
                        <div data-sort-menu-secondary-options={secondary.id} role="group"></div>
                    </div>
                ))
        }
    </div>
</div>

<script>
    import "@/scripts/lib/sort-menu.js";
</script>

<style>
    /* Nylah Studios v0.3.0 (w7) — RedSilk menu: warm gradient trigger +
       panel, layered shadow, wine focus glow. Behavior unchanged. */
    [data-sort-menu-button] {
        background: linear-gradient(180deg, var(--nylah-surface-warm, var(--color-surface)), var(--nylah-surface-2-warm, var(--color-surface-2)));
        box-shadow: var(--nylah-card-shadow, 0 8px 24px -12px var(--nylah-focus-glow));
    }
    [data-sort-menu-button]:hover,
    [data-sort-menu-button]:focus-visible,
    [data-sort-menu-button][aria-expanded="true"] {
        border-color: var(--nylah-focus-ring, var(--color-accent));
        box-shadow:
            0 0 0 1px var(--nylah-focus-ring, var(--color-accent)),
            0 0 20px 2px var(--nylah-focus-glow, var(--color-accent-soft));
    }
    .sort-menu__panel {
        background: linear-gradient(180deg, var(--nylah-surface-warm, var(--color-surface)), var(--nylah-surface-2-warm, var(--color-surface-2)));
        box-shadow:
            var(--nylah-card-shadow-lift, 0 24px 64px -16px var(--nylah-focus-glow)),
            0 0 0 1px var(--color-line);
    }
    .sort-menu__option:focus-visible {
        box-shadow:
            0 0 0 2px var(--nylah-focus-ring, var(--color-accent)),
            0 0 16px 2px var(--nylah-focus-glow, var(--color-accent-soft));
    }
    .sort-menu__option[aria-selected="true"],
    .sort-menu__option[aria-checked="true"] {
        box-shadow: 0 0 14px -2px var(--nylah-focus-glow, var(--color-accent-soft));
    }
    @media (prefers-reduced-motion: reduce) {
        [data-sort-menu-button],
        .sort-menu__panel {
            box-shadow: none;
        }
    }
</style>
